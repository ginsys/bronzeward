# Renderer versions for the Talos compatibility experiment (ginsys/bronzeward issue 5). Each is a
# talosctl release, checked against the SHA-256 pinned for it below, and the pkg/machinery module
# of the same tag (machinery/<version>/go.mod, go.sum). v1.13.6 is the fixture's own pin
# (fixtures/versions.env). Frozen: a change invalidates the evidence.
E3_RENDERERS="v1.12.12 v1.13.0 v1.13.6 v1.13.10 v1.14.1 v1.15.0-alpha.0"
E3_PINNED=v1.13.6
E3_SHA256_v1_12_12=3a3ad9fe02df94f8bcfe85a9d982991fbf510a2167fb0e5d1b2c149d6541090e
E3_SHA256_v1_13_0=4aa5cd191c708b8c1a3b358bfd7dd21fb0cc6bd4dc7a07f2aa925cd2a8473bae
E3_SHA256_v1_13_6=540c5e7cb0d3fa3a9b2e1c717ced212727b73bcaf0cf9cf9ba2472ec381041d4
E3_SHA256_v1_13_10=28e9ccd9aebd690fa03d8cf2582221d87ea38b2a1704f411d75a03589c58f2aa
E3_SHA256_v1_14_1=7233ece94c94296a033a6ddb5efe0baf508a94c71de7e6c7b286500705924208
E3_SHA256_v1_15_0_alpha_0=d0779b799815aeebccc18cf98851928ff1b050434c96831259b2e4ceafdb5399

# Target contracts: every minor from v1.10 to v1.15, then the version-string edges talosctl's
# --talos-version accepts or refuses. `current` is no --talos-version at all.
E3_CONTRACTS="v1.10.0 v1.11.0 v1.12.0 v1.13.0 v1.14.0 v1.15.0"
E3_EDGES="1.13 v1.13.6 v1.15.0-alpha.0 v1.99.0 bogus"

# Kubernetes: the renderer's default (no flag) and the fixture's version.
E3_K8S_FIXED=1.36.2
# Every generated configuration names the same installer image, so that outputs of different
# renderers compare byte for byte; the renderers' own defaults differ (v1.14 changed it).
E3_INSTALL_IMAGE=ghcr.io/siderolabs/installer:v1.13.6
