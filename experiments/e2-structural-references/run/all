#!/usr/bin/env bash
# Run the whole E2 matrix into E2_OUT: every case under cases/, the native reference-free
# composition, and each candidate (tag, marked, binding) resolved late (after composition) and
# early (each fragment before composition). Composition and validation are the pinned talosctl's:
# `machineconfig patch` (strategic merge) onto each of two bases (the running fixture's own
# control-plane configuration, and `gen config` output), and `validate --strict` in the base's mode
# (container for the fixture's, metal for gen config's). The prototype only finds, substitutes and
# records references.
#
# Outcomes per cell, in the order they are decided:
#   refused   the resolver refused (unknown reference, a binding it cannot place)
#   rejected  talosctl refused to compose, or to re-read the resolver's output (stage says which)
#   parity    the output is byte-identical to the native composition of the reference-free form
#   differs   it is not
# Validation is recorded beside the outcome for every output, native included.
#
# Phase-0 evidence for the structural-reference experiment (ginsys/bronzeward issue 3). Not v1 tooling.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=lib.sh
. "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"
need go git cmp diff sha256sum awk sed tr cut sort install

mkdir -p -- "$E2_OUT"
[ -z "$(ls -A -- "$E2_OUT")" ] || die "$E2_OUT is not empty; give each run a new directory, so evidence from two runs cannot mix"
printf 'E2 structural references, started %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$E2_MARK"
# Every path below is relative to E2_OUT, so that talosctl's messages name files the same way on
# every machine.
cd -- "$E2_OUT"

e2_build
e2_talosctl_ready
{
  printf 'commit\t%s\n' "$(git -C "$REPO_DIR" rev-parse HEAD)"
  # Uncommitted changes to what this run executes: the prototype, the cases, the scripts and the
  # fixture library. evidence/ is what a previous collection wrote and is not an input.
  printf 'uncommitted-inputs\t%s\n' "$(git -C "$REPO_DIR" status --porcelain -- experiments/e2-structural-references \
    ':!experiments/e2-structural-references/evidence' fixtures | wc -l)"
  printf 'talosctl\t%s\n' "$(talosctl version --client --short | tr '\n' ' ' | sed 's/ *$//')"
  printf 'talosctl-sha256\t%s\n' "$TALOSCTL_SHA256"
  printf 'go\t%s\n' "$(go version)"
} >run.txt

# Two bases, each a control-plane configuration from the pinned talosctl:
#   fixture    the running fixture's own machine configuration, as fixtures/bin/up read it back
#              from the node (a docker-mode cluster, so it is validated in container mode);
#   generated  `gen config` output for a metal node, without the documentation and examples it
#              would otherwise comment in, validated in metal mode.
# Controls, per base: re-reading it through the no-op patch changes nothing when it is talosctl's
# own output (so the same step can normalize the resolver's output), and it validates.
need_state
[ -s "$STATE/controlplane.yaml" ] || die "the fixture has no $STATE/controlplane.yaml; run fixtures/bin/up first"
mkdir base
printf 'machine: {}\n' >noop.yaml
: >controls.tsv
declare -A modes=([fixture]=container [generated]=metal)
bases=(fixture generated)
cp -- "$STATE/controlplane.yaml" base/fixture.source.yaml
talosctl gen secrets -o base/secrets.yaml 2>base/gen.err
talosctl gen config e2-structural "https://$TALOS_CONTROLPLANE_IP:6443" --with-secrets base/secrets.yaml \
  --output-types controlplane --with-docs=false --with-examples=false -o base/generated.source.yaml 2>>base/gen.err
for base in "${bases[@]}"; do
  talosctl machineconfig patch "base/$base.source.yaml" --patch @noop.yaml -o "base/$base.yaml" 2>>base/gen.err
  # The fixture's copy was written by the node's API, not by talosctl's encoder: a difference there
  # is formatting, recorded; every composition below starts from the re-read form either way.
  if cmp -s "base/$base.source.yaml" "base/$base.yaml"; then r=identical; else r=reformatted; fi
  [ "$base" = fixture ] || [ "$r" = identical ] ||
    die "control failed: the no-op patch changed talosctl's own output, so it cannot serve as the normalization step"
  printf 'control\t%s\tnoop-normalization\t%s\n' "$base" "$r" >>controls.tsv
  talosctl validate --config "base/$base.yaml" --mode "${modes[$base]}" --strict >"base/$base.validate.txt" 2>&1 ||
    die "control failed: the $base base does not validate in ${modes[$base]} mode"
  printf 'control\t%s\tvalidates-%s\tpass\n' "$base" "${modes[$base]}" >>controls.tsv
done

# Leak-refusal patterns: every long scalar of both bases' secrets bundles (keys, tokens,
# certificates; the fixture's is the bundle bin/up extracted from this same configuration with
# `gen secrets --from-controlplane-config`), and the fixture's own leak-scan list. None of them may
# reach collected evidence. The bases' other scalars (images, endpoints) are not secrets and are not
# patterns, so that the redacted bases collect-evidence writes keep them.
{
  bwref patterns base/secrets.yaml
  bwref patterns "$STATE/talos-secrets.yaml"
  cat -- "$STATE/scan-patterns.txt"
} | sort -u >"$E2_PATTERNS"
[ "$(wc -l <"$E2_PATTERNS")" -ge 10 ] || die "fewer than 10 leak-refusal patterns; a secrets bundle is not what talosctl writes"
# Control: no secret of a base is outside the list. A value of a base that looks like key material
# (base64, 40 characters or more) and holds no pattern fails the run. The check is first run with a
# list that covers nothing, and must then report the base's keys, or it proves nothing.
key_like() { # key_like <patterns> <config>: line numbers of key-like values no pattern covers
  awk 'NR == FNR { p[++n] = $0; next }
    {
      v = $NF
      if (length(v) < 40 || v !~ /^[A-Za-z0-9+\/=]+$/) next
      for (i = 1; i <= n; i++) if (index($0, p[i])) next
      print FNR
    }' "$1" "$2"
}
printf 'e2-covers-nothing\n' >covers-nothing.txt
for b in "${bases[@]}"; do
  unmatched=$(key_like covers-nothing.txt "base/$b.yaml")
  [ -n "$unmatched" ] || die "control failed: the key-material check finds nothing in base/$b.yaml even with no patterns"
  unmatched=$(key_like "$E2_PATTERNS" "base/$b.yaml")
  [ -z "$unmatched" ] ||
    die "control failed: base/$b.yaml has key-like values on lines $(tr '\n' ' ' <<<"$unmatched")that no leak-refusal pattern covers"
  printf 'control\t%s\tkey-material-covered\tyes (the check alone finds %d key-like lines)\n' "$b" \
    "$(key_like covers-nothing.txt "base/$b.yaml" | wc -l)" >>controls.tsv
done

# compose <out> <err> <fragment>...: talosctl's strategic merge of the fragments onto the base, in
# order. A fragment that is only `{}` is what the binding form leaves when every key it held was
# bound: it carries nothing, and talosctl refuses an empty patch ("config not found"), so it is left
# out and named in <out>.skipped. With nothing left, the composition is the base itself.
printf '{}\n' >empty.yaml
compose() {
  local out=$1 err=$2 f args=()
  shift 2
  for f in "$@"; do
    if cmp -s -- "$f" empty.yaml; then
      printf '%s\n' "$f" >>"$out.skipped"
    else
      args+=(--patch "@$f")
    fi
  done
  if [ "${#args[@]}" -eq 0 ]; then
    : >"$err"
    cp -- "base/$base.yaml" "$out"
    return
  fi
  talosctl machineconfig patch "base/$base.yaml" "${args[@]}" -o "$out" 2>"$err"
}
# normalize <in> <out> <err>: the resolver's output, re-read and re-written by talosctl.
normalize() {
  talosctl machineconfig patch "$1" --patch @noop.yaml -o "$2" 2>"$3"
}
# check <config> <file>: validation verdict, pass or fail; the whole message goes to <file>.
check() {
  if talosctl validate --config "$1" --mode "${modes[$base]}" --strict >"$2" 2>&1; then
    printf pass
  else
    printf fail
  fi
}
# udiff <label-a> <label-b> <a> <b> <out>: diff exits 1 on a difference, which is a result here.
udiff() {
  local rc=0
  diff -U0 --label "$1" --label "$2" -- "$3" "$4" >"$5" || rc=$?
  [ "$rc" -le 1 ] || die "diff of $3 and $4 failed"
}
refs() { # refs <tsv> [<column>]: the distinct references in that column (default 1), comma-separated, or -
  local r
  r=$(awk -F'\t' -v col="${2:-1}" '$1 != "unidentifiable" { print $col }' "$1" | sort -u |
    awk '{ printf "%s%s", sep, $0; sep = "," }')
  printf '%s' "${r:--}"
}
row() { # an empty cell is written as `-`, so no row ends in a tab
  local a cells=()
  for a in "$@"; do cells+=("${a:--}"); done
  (IFS=$'\t' && printf '%s\n' "${cells[*]}") >>"$E2_MATRIX"
}

printf 'base\tcase\tcandidate\torder\texpected\tobserved\tstage\tvalidate\tresolved\tsuperset\teffective\tmessage\n' >"$E2_MATRIX"

# run_case <case>: the case on the current base. Its fragment forms (gen/<case>) and expectations
# (gen/<case>/info.tsv) do not depend on the base and are generated once, by the loop below.
run_case() {
  local name=$1 g=gen/$1 d=cases/$base/$1 native native_expect superset
  mkdir -p -- "$d"
  mapfile -t frags < <(awk -F'\t' '$1 == "fragment" { print $2 }' "$g/info.tsv")
  native_expect=$(awk -F'\t' '$1 == "native" { print $2 }' "$g/info.tsv")
  superset=$(refs "$g/superset.tsv" 2) # superset.tsv: fragment, ref, document, path

  mkdir "$d/native"
  local v=- msg=''
  if compose "$d/native/out.yaml" "$d/native/compose.err" "${frags[@]/#/$g/literal/}"; then
    udiff base native "base/$base.yaml" "$d/native/out.yaml" "$d/native/diff-base"
    v=$(check "$d/native/out.yaml" "$d/native/validate.txt")
    if [ "$v" = pass ]; then native=pass; else native=invalid; msg=$(oneline "$d/native/validate.txt"); fi
  else
    native=rejected
    msg=$(oneline "$d/native/compose.err")
  fi
  row "$base" "$name" native - "$native_expect" "$native" - "$v" - "$superset" - "${msg:0:300}"

  local cand order
  for cand in tag marked binding; do
    for order in late early; do
      cell "$name" "$cand" "$order"
    done
  done
}

cell() {
  local name=$1 cand=$2 order=$3 cdir=$E2_DIR/cases/$1 g=gen/$1 d=cases/$base/$1 c=cases/$base/$1/$2-$3
  local outcome='' stage=- v=- msg='' effective=- f expect
  expect=$(awk -F'\t' -v c="$cand" -v o="$order" '$1 == "expect" && $2 == c && $3 == o { print $4 }' "$g/info.tsv")
  mkdir -p -- "$c"
  : >"$c/resolutions.tsv"
  if [ "$order" = late ]; then
    if ! compose "$c/composed.yaml" "$c/compose.err" "${frags[@]/#/$g/$cand/}"; then
      outcome=rejected stage=compose msg=$(oneline "$c/compose.err")
    elif ! bwref resolve "$cand" "$cdir" "$g" "$c/composed.yaml" "$c/resolved.yaml" >"$c/resolutions.tsv" 2>"$c/resolve.err"; then
      outcome=refused stage=resolve msg=$(oneline "$c/resolve.err")
    elif ! normalize "$c/resolved.yaml" "$c/out.yaml" "$c/normalize.err"; then
      outcome=rejected stage=normalize msg=$(oneline "$c/normalize.err")
    fi
    # Late, what the resolver found in the composed configuration is the effective set.
    [ "$stage" = compose ] || effective=$(refs "$c/resolutions.tsv")
  else
    mkdir "$c/fragments" "$c/sentinel"
    : >"$c/resolve.err"
    for f in "${frags[@]}"; do
      if ! bwref resolve "$cand" "$cdir" "$g" "$g/$cand/$f" "$c/fragments/$f" "$f" >>"$c/resolutions.tsv" 2>>"$c/resolve.err"; then
        outcome=refused stage=resolve msg=$(oneline "$c/resolve.err")
        break
      fi
    done
    if [ -z "$outcome" ] && ! compose "$c/out.yaml" "$c/compose.err" "${frags[@]/#/$c/fragments/}"; then
      outcome=rejected stage=compose msg=$(oneline "$c/compose.err")
    fi
    # Early, the resolver cannot see what survives composition; the effective set is measured by
    # composing sentinel values instead and finding which of them are left.
    # A sentinel run that fails (a sentinel is the wrong kind for its field, as in type-mismatch)
    # leaves the set unmeasured, with the reason in sentinel.err.
    if [ -z "$outcome" ]; then
      effective=unmeasured
      local sentinels=ok
      : >"$c/sentinel.err"
      for f in "${frags[@]}"; do
        bwref resolve -sentinel "$cand" "$cdir" "$g" "$g/$cand/$f" "$c/sentinel/$f" "$f" >/dev/null 2>>"$c/sentinel.err" || {
          sentinels=failed
          break
        }
      done
      if [ "$sentinels" = ok ] && compose "$c/sentinel.yaml" "$c/sentinel-compose.err" "${frags[@]/#/$c/sentinel/}" &&
        bwref find "$cdir" "$c/sentinel.yaml" >"$c/sentinel-found.tsv" 2>>"$c/sentinel.err"; then
        effective=$(refs "$c/sentinel-found.tsv")
        local unid
        unid=$(awk -F'\t' '$1 == "unidentifiable" { printf "%s%s", sep, $2; sep = "," }' "$c/sentinel-found.tsv")
        [ -z "$unid" ] || effective="$effective (+unidentifiable: $unid)"
      fi
    fi
  fi
  if [ -z "$outcome" ]; then
    if [ -f "$d/native/out.yaml" ] && [ -f "$d/native/validate.txt" ] && cmp -s "$d/native/out.yaml" "$c/out.yaml"; then
      outcome=parity
    else
      outcome=differs
    fi
    [ ! -f "$d/native/out.yaml" ] || udiff native "$cand-$order" "$d/native/out.yaml" "$c/out.yaml" "$c/diff-native"
    udiff base "$cand-$order" "base/$base.yaml" "$c/out.yaml" "$c/diff-base"
    v=$(check "$c/out.yaml" "$c/validate.txt")
    [ "$v" = pass ] || msg=$(oneline "$c/validate.txt")
  fi
  row "$base" "$name" "$cand" "$order" "$expect" "$outcome" "$stage" "$v" "$(wc -l <"$c/resolutions.tsv")" \
    "$superset" "$effective" "${msg:0:300}"
}

names=()
for dir in "$E2_DIR"/cases/*/; do
  names+=("$(basename -- "$dir")")
done
for name in "${names[@]}"; do
  mkdir -p -- "gen/$name"
  bwref info "$E2_DIR/cases/$name" >"gen/$name/info.tsv"
  bwref gen "$E2_DIR/cases/$name" "gen/$name"
done
for base in "${bases[@]}"; do
  for name in "${names[@]}"; do
    run_case "$name"
  done
done

# Completeness: per base, one native row and six candidate rows per case, and nothing else.
cases=${#names[@]}
rows=$(($(wc -l <"$E2_MATRIX") - 1))
[ "$rows" -eq $((cases * 7 * ${#bases[@]})) ] ||
  die "matrix has $rows rows for $cases cases on ${#bases[@]} bases; expected $((cases * 7 * ${#bases[@]}))"
unexpected=$(awk -F'\t' 'NR > 1 && $5 != $6' "$E2_MATRIX" | wc -l)
# The two bases must agree cell by cell on everything but the message, which names line numbers.
if cmp -s <(awk -F'\t' 'NR > 1 && $1 == "fixture" { $1 = $12 = ""; print }' "$E2_MATRIX") \
  <(awk -F'\t' 'NR > 1 && $1 == "generated" { $1 = $12 = ""; print }' "$E2_MATRIX"); then
  agree=yes
else
  agree=no
fi
{
  printf 'cases\t%d\n' "$cases"
  printf 'bases\t%s\n' "${bases[*]}"
  printf 'rows\t%d\n' "$rows"
  printf 'unexpected\t%d\n' "$unexpected"
  printf 'bases-agree\t%s\n' "$agree"
  awk -F'\t' 'NR > 1 && $3 != "native" { n[$1 " " $3 " " $4 " " $6]++ } END { for (k in n) print "outcome\t" k "\t" n[k] }' "$E2_MATRIX" | sort
} >summary.txt
# Digests of every materialized output. The outputs themselves carry the base's synthetic secrets
# and stay in E2_OUT; the digests tie the collected diffs to them.
find cases -name out.yaml -type f -print0 | sort -z | xargs -0 sha256sum -- >outputs.sha256
printf 'complete %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >complete
say "E2 matrix: $cases cases on ${#bases[@]} bases, $rows rows, $unexpected differing from the expectation, bases agree: $agree; see $E2_OUT/summary.txt"
