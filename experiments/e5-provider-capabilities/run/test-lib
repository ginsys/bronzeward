#!/usr/bin/env bash
# Self-test of lib.sh. Needs no running fixture, only the sops and age binaries fixtures/bin/up
# caches. It checks that the recorder writes a row for every cell, that the observed outcome is
# derived from the exit status and the transcript and not from the expectation, that a mismatch is
# recorded rather than hidden or fatal, and that e5_sops keeps sops away from the caller's own keys.
#
# Phase-0 evidence for the provider-capability experiment (ginsys/bronzeward issue 8). Not v1 tooling.
set -euo pipefail

[ -n "${E5_OUT:-}" ] || { printf 'set E5_OUT (see README.md)\n' >&2; exit 2; }
E5_OUT=$E5_OUT/test-lib
rm -rf -- "$E5_OUT"
export E5_OUT
# shellcheck source-path=SCRIPTDIR source=lib.sh
. "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"
e5_init

failures=0
check() { # check <description> <expected> <actual>
  if [ "$2" = "$3" ]; then
    printf 'ok   %s\n' "$1"
  else
    printf 'FAIL %s: expected [%s], got [%s]\n' "$1" "$2" "$3"
    failures=$((failures + 1))
  fi
}
field() { awk -F'\t' -v n="$1" -v f="$2" 'NR == n + 1 {print $f}' "$E5_CELLS"; }

cell t col1 nobody ok primitive -- true
cell t col1 nobody ok primitive -- false
cell t col2 nobody denied metadata -- sh -c 'echo "Code: 403. Errors: * permission denied" >&2; exit 2'
printf 'from-stdin\n' | cell t col3 nobody ok versioned -- cat
unsupported t col4 'no such operation in this candidate'

check 'header plus five rows' 6 "$(wc -l <"$E5_CELLS")"
check 'passing command observed ok' ok "$(field 1 7)"
check 'passing command matches' match "$(field 1 9)"
check 'failing command observed fail' fail "$(field 2 7)"
check 'failing command recorded as mismatch' mismatch "$(field 2 9)"
check 'failing command exit status kept' 1 "$(field 2 8)"
check 'a 403 is observed as denied' denied "$(field 3 7)"
check 'expected denial matches' match "$(field 3 9)"
check 'stdin reaches the command' from-stdin "$(cat "$E5_OUT/$(field 4 11)")"
check 'unsupported row kind' unsupported "$(field 5 5)"
check 'unsupported row is not a command' n/a "$(field 5 7)"
check 'mismatch count' 1 "$(e5_mismatches)"

# sops isolation. A file for a recipient nobody holds; sops's refusal lists every place it looked
# for an identity. Raw sops must name the caller's ~/.ssh keys (the control: the check can see
# them), and e5_sops must not.
if [ -x "$CACHE/sops" ] && [ -x "$CACHE/age-keygen" ]; then
  recipient=$("$CACHE/age-keygen" 2>/dev/null | awk '/^# public key:/ {print $4}')
  printf 'creation_rules:\n  - age: %s\n' "$recipient" >"$E5_OUT/sops.yaml"
  printf '{"k": "v"}\n' | e5_sops - --config "$E5_OUT/sops.yaml" encrypt --input-type json --output-type json \
    /dev/stdin >"$E5_OUT/nobody.enc.json"
  looked() { { "$@" --config "$E5_OUT/sops.yaml" decrypt "$E5_OUT/nobody.enc.json" >/dev/null; } 2>&1 || true; }
  names_home() { if looked "$@" | grep -qF -- "$HOME/.ssh/"; then echo yes; else echo no; fi; }
  check 'raw sops looks in the caller ~/.ssh (control)' yes "$(names_home "$CACHE/sops")"
  check 'e5_sops does not look in the caller ~/.ssh' no "$(names_home e5_sops -)"
else
  printf 'FAIL sops isolation: no sops/age-keygen in %s (run fixtures/bin/up once)\n' "$CACHE"
  failures=$((failures + 1))
fi

[ "$failures" -eq 0 ] || { printf '%d check(s) failed\n' "$failures"; exit 1; }
printf 'all checks passed\n'
