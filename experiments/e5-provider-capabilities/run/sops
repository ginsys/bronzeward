#!/usr/bin/env bash
# Candidate C: SOPS with age, as operator-maintained encrypted files (design §7.3: "an alternative or
# import/export mechanism"). The import/export role itself is exercised by run/migrate.
#
#   .state/data/sops/
#     .sops.yaml                     creation rules: secrets/ to compiler + recovery, artifacts/ to executor
#     keys/<identity>.key            age identities, one per role (0600)
#     secrets/<name>.enc.json        one file per logical secret; sops keeps no version history
#     artifacts/<id>.enc.json        a rendered artifact, encrypted whole (binary input type)
#
# Phase-0 evidence for the provider-capability experiment (ginsys/bronzeward issue 8). Not v1 tooling.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=lib.sh
. "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"
e5_init
e5_need_fixture

C=sops
D=$STATE/data/sops
W=$E5_WORK/sops
mkdir -p -- "$D/keys" "$D/secrets" "$D/artifacts" "$W"
chmod 700 "$D/keys"

age_keygen() { "$CACHE/age-keygen" "$@"; }
recipient() { age_keygen -y "$D/keys/$1.key"; }
# sops_as <identity> <sops-args...>: the identity is the key file sops is given; no other key is
# reachable (e5_sops).
sops_as() { e5_sops "$D/keys/$1.key" --config "$D/.sops.yaml" "${@:2}"; }
sops_nokey() { e5_sops - --config "$D/.sops.yaml" "$@"; }

# --- helpers: each prints a verdict or non-secret metadata, never a value ---------------------------

newkey() {
  (umask 077 && age_keygen -o "$D/keys/$1.key" 2>/dev/null) || return 1
  printf 'identity %s recipient %s\n' "$1" "$(recipient "$1")"
}
rules() { # rules <secret-recipients> <artifact-recipients>: comma-separated identities
  local s a
  s=$(for r in ${1//,/ }; do recipient "$r"; done | paste -sd, -)
  a=$(for r in ${2//,/ }; do recipient "$r"; done | paste -sd, -)
  printf 'creation_rules:\n  - path_regex: secrets/.*\n    age: %s\n  - path_regex: artifacts/.*\n    age: %s\n' "$s" "$a" \
    >"$D/.sops.yaml"
  echo "secrets to $1; artifacts to $2"
}
# shellcheck disable=SC2094 # --filename-override only names the file for rule matching; sops reads stdin
put() { # put <name> <value-name>: create-only, the value over stdin
  local f=$D/secrets/$1.enc.json
  { printf '{"value": '; jq -Rs . <"$(e5_value_file "$2")"; printf '}\n'; } |
    (set -C && sops_nokey encrypt --filename-override "$f" --input-type json --output-type json /dev/stdin >"$f") ||
    return 1
  echo "created $1"
}
set_value() { # set_value <identity> <name> <value-name>: overwrite in place, the value over stdin
  jq -Rs . <"$(e5_value_file "$3")" | sops_as "$1" set --value-stdin "$D/secrets/$2.enc.json" '["value"]'
}
get() { sops_as "$1" decrypt --extract '["value"]' "$D/secrets/$2.enc.json"; }
meta() { # meta <file>: what the file says about itself without any key
  jq -r '.sops | "lastmodified=\(.lastmodified) recipients=\([.age[].recipient] | length) mac_present=\(.mac != null) version=\(.version)"' "$1"
}
has_key() { # has_key <file> <key>: yes or no, the value itself discarded
  if sops_as compiler decrypt --extract "[\"$2\"]" "$1" >/dev/null 2>&1; then echo yes; else echo no; fi
}
race() { # race <name>: two writers each add their own key to one fresh file at once, ten times
  # A lost update is a file that still decrypts and holds exactly one of the two keys although both
  # writers exited 0. A file holding neither is counted apart: it may be unreadable, not a lost
  # update. The cell passes if a lost update happens at least once; every attempt is printed.
  local f=$D/secrets/$1.enc.json i a b ka kb lost=0 neither=0
  for i in $(seq 1 10); do
    rm -f -- "$f"
    put "$1" race-base >/dev/null || return 1
    a=0 b=0
    jq -Rs . <"$(e5_value_file race-a)" | sops_as compiler set --value-stdin "$f" '["a"]' 2>/dev/null &
    local pa=$!
    jq -Rs . <"$(e5_value_file race-b)" | sops_as compiler set --value-stdin "$f" '["b"]' 2>/dev/null &
    local pb=$!
    wait "$pa" || a=1
    wait "$pb" || b=1
    ka=$(has_key "$f" a) kb=$(has_key "$f" b)
    printf 'attempt %s: writer a rc=%s, writer b rc=%s, key a present=%s, key b present=%s\n' "$i" "$a" "$b" "$ka" "$kb"
    [ "$a$b" = 00 ] || continue
    case $ka$kb in
      yesno | noyes) lost=$((lost + 1)) ;;
      nono) neither=$((neither + 1)) ;;
    esac
  done
  printf 'lost updates with both writers told success: %s of 10\n' "$lost"
  printf 'files holding neither key, not counted as lost: %s of 10\n' "$neither"
  [ "$lost" -gt 0 ]
}
# graft <name> <old-copy> <identity>: the current file's values under the old copy's recipient
# stanzas, decrypted as <identity>. It opens only if the data key is still the old copy's.
graft() {
  local g=$W/graft.enc.json
  jq --slurpfile old "$2" '.sops.age = $old[0].sops.age' "$D/secrets/$1.enc.json" >"$g" || return 1
  sops_as "$3" decrypt --extract '["value"]' "$g"
}
# shellcheck disable=SC2094 # as for put
seal_artifact() {
  local f=$D/artifacts/$1.enc.json
  (set -C && sops_nokey encrypt --filename-override "$f" --input-type binary --output-type json /dev/stdin \
    <"$W/artifact.yaml" >"$f") || return 1
  echo "artifact $1 encrypted"
}
open_artifact() {
  check_digest "$(sha256sum <"$W/artifact.yaml" | cut -d' ' -f1)" \
    sops_as "$1" decrypt --input-type json --output-type binary "$D/artifacts/$2.enc.json"
}
updatekeys() { sops_as "$1" updatekeys -y "$D/secrets/$2.enc.json"; }
# The value's ciphertext, as a digest, read without any key: it changes only when sops encrypts the
# value again, which it does under a new data key. Whether an operation replaced the data key is
# therefore visible from the file alone.
ct_digest() { jq -r .value "$D/secrets/$1.enc.json" | sha256sum | cut -d' ' -f1; }
data_key() { # data_key <name> <digest-before> <same|new>: fails when the observation is the other one
  local seen=new
  [ "$(ct_digest "$1")" != "$2" ] || seen=same
  if [ "$seen" = same ]; then
    echo "value ciphertext unchanged: same data key"
  else
    echo "value ciphertext changed: new data key"
  fi
  [ "$seen" = "$3" ]
}

# --- inputs ------------------------------------------------------------------------------------------

for v in app-token-g1 app-token-g2 race-base race-a race-b artifact-token; do e5_secret "$v"; done
{
  printf 'machine:\n  token: '
  cat "$(e5_value_file artifact-token)"
  printf '\n'
} >"$W/artifact.yaml"

# --- key custody --------------------------------------------------------------------------------------

col='key-custody'
cell $C $col operator ok primitive -- newkey compiler
cell $C $col operator ok primitive -- newkey executor
cell $C $col operator ok primitive -- newkey recovery
cell $C $col operator ok - -- rules compiler,recovery executor
unsupported $C $col 'no permission boundary between identities in one uid: possession of a key file is the only control'

# --- create, read, versioning -------------------------------------------------------------------------

col='create-read-version'
cell $C $col publisher ok primitive -- put app-token app-token-g1
cell $C $col publisher fail primitive -- put app-token app-token-g2
cell $C $col compiler ok primitive -- check_digest "$(e5_digest app-token-g1)" get compiler app-token
cell $C $col recovery ok primitive -- check_digest "$(e5_digest app-token-g1)" get recovery app-token
cell $C $col executor fail primitive -- get executor app-token
cell $C $col compiler ok primitive -- set_value compiler app-token app-token-g2
cell $C $col compiler ok primitive -- check_digest "$(e5_digest app-token-g2)" get compiler app-token
unsupported $C $col 'no version history: an update replaces the only copy; generations exist only as separate files or in an outside history such as git'
cell $C $col compiler ok primitive -- race race
unsupported $C $col 'no compare-and-set and no locking: two writers of one file both succeed, and the later write discards the other'

# --- artifact encryption ------------------------------------------------------------------------------

col='artifact-encryption'
cell $C $col compiler ok primitive -- seal_artifact rel-1
cell $C $col executor ok primitive -- open_artifact executor rel-1
cell $C $col compiler fail primitive -- open_artifact compiler rel-1

# --- signing ------------------------------------------------------------------------------------------

unsupported $C signing 'sops has no signatures of its own; the MAC authenticates the file to key holders only'

# --- metadata-only checks -----------------------------------------------------------------------------

col='metadata-only'
cell $C $col metadata ok metadata -- meta "$D/secrets/app-token.enc.json"
cell $C $col metadata ok metadata -- meta "$D/artifacts/rel-1.enc.json"
cell $C $col metadata fail metadata -- sops_nokey decrypt --extract '["value"]' "$D/secrets/app-token.enc.json"

# --- rotation -----------------------------------------------------------------------------------------

col='rotation'
before=$(ct_digest app-token)
cp -- "$D/secrets/app-token.enc.json" "$W/pre-rotate.enc.json"
cell $C $col compiler ok primitive -- sops_as compiler rotate -i "$D/secrets/app-token.enc.json"
cell $C $col metadata ok metadata -- data_key app-token "$before" new
# A changed ciphertext alone could be the same key with a fresh nonce; the old stanzas must no
# longer open the new values if the data key really changed.
cell $C $col compiler fail primitive -- check_digest "$(e5_digest app-token-g2)" graft app-token "$W/pre-rotate.enc.json" compiler
cell $C $col compiler ok primitive -- check_digest "$(e5_digest app-token-g2)" get compiler app-token
cell $C $col operator ok primitive -- newkey compiler-2
cell $C $col operator ok - -- rules compiler-2,recovery executor
before=$(ct_digest app-token)
cp -- "$D/secrets/app-token.enc.json" "$W/pre-updatekeys.enc.json"
cell $C $col compiler ok primitive -- updatekeys compiler app-token
# Expected: removing a recipient re-wraps the same data key for the remaining ones, so a holder
# of the removed identity who kept an older copy of the file can still read the current value.
cell $C $col metadata ok metadata -- data_key app-token "$before" same
cell $C $col compiler ok primitive -- check_digest "$(e5_digest app-token-g2)" graft app-token "$W/pre-updatekeys.enc.json" compiler
cell $C $col compiler ok primitive -- check_digest "$(e5_digest app-token-g2)" get compiler-2 app-token
cell $C $col compiler fail primitive -- get compiler app-token
cell $C $col metadata ok metadata -- meta "$D/secrets/app-token.enc.json"
unsupported $C $col 'no reversible decryption floor: removing a recipient re-encrypts the data key, and restoring access means re-adding it with a key that can still decrypt'

# --- startup unlock -----------------------------------------------------------------------------------

col='startup-unlock'
cell $C $col compiler fail primitive -- sops_nokey decrypt "$D/secrets/app-token.enc.json"
cell $C $col compiler ok primitive -- check_digest "$(e5_digest app-token-g2)" get compiler-2 app-token

# --- backup and restore -------------------------------------------------------------------------------

col='backup-restore'
cell $C $col operator ok - -- "$FIXTURES_DIR/bin/inject" store-snapshot e5-sops
cell $C $col compiler ok primitive -- set_value compiler-2 app-token app-token-g1
cell $C $col compiler ok primitive -- check_digest "$(e5_digest app-token-g1)" get compiler-2 app-token
cell $C $col operator ok - -- "$FIXTURES_DIR/bin/inject" store-restore e5-sops
cell $C $col compiler ok primitive -- check_digest "$(e5_digest app-token-g2)" get compiler-2 app-token
cell $C $col executor ok primitive -- open_artifact executor rel-1

say "sops: $(e5_mismatches) mismatch(es) so far in $E5_CELLS"
