#!/usr/bin/env bash
# Usage: run/build <a|c|b-raw|2a|2b> <new directory outside the checkout>
# Export the base commit's tree into the directory and apply that build's committed patches.
#   a      the base: machinery v1.14.5
#   c      machinery v1.14.7
#   b-raw  machinery v1.15.0-beta.1, module files only
#   2a     b-raw and the one-call test-helper adaptation to the cosi-project/runtime it forces
#   2b     2a and the measurement-only change that keeps v1.14 the supported contract
# The module patches carry go.mod only, which pins every version. Go writes go.sum for the changed
# modules here and checks each new entry against the checksum database, so this refuses to run with
# that check off, and fails if writing go.sum changes go.mod. go.sum is not committed for these
# builds.
# It creates the directory and removes nothing.
set -euo pipefail

BASE=cf597ab98bf6a2d1758af3adb7d5d213b5e21a0a

[ $# -eq 2 ] || { echo "usage: $0 <a|c|b-raw|2a|2b> <new directory>" >&2; exit 2; }
here=$(cd "$(dirname "$0")/.." && pwd)
root=$(git -C "$here" rev-parse --show-toplevel)

case $1 in
a) patches=() ;;
c) patches=(c-machinery-1147) ;;
b-raw) patches=(b-machinery-beta1) ;;
2a) patches=(b-machinery-beta1 2a-talostest-cosi) ;;
2b) patches=(b-machinery-beta1 2a-talostest-cosi 2b-contract-v114) ;;
*) echo "$0: unknown build $1" >&2; exit 2 ;;
esac

mkdir -- "$2"
dir=$(cd -- "$2" && pwd)
case $dir/ in "$root"/*) echo "$0: $dir is inside the checkout" >&2; exit 2 ;; esac

git -C "$root" archive "$BASE" | tar -x -C "$dir"
for p in "${patches[@]}"; do
	(cd "$dir" && git apply --unidiff-zero "$here/patches/$p.patch")
done

if [ ${#patches[@]} -gt 0 ]; then
	(
		cd "$dir"
		sumdb=$(go env GOSUMDB)
		skipped=$(go env GONOSUMDB)$(go env GOPRIVATE)$(go env GOINSECURE)
		flags=$(go env GOFLAGS)
		# -v only makes go print more (the cluster pod sets it); any other flag refuses.
		if [ "$sumdb" != sum.golang.org ] || [ -n "$skipped" ] || { [ -n "$flags" ] && [ "$flags" != -v ]; }; then
			echo "build: checksum database verification may be off: GOSUMDB='$sumdb', GONOSUMDB, GOPRIVATE and GOINSECURE together='$skipped', GOFLAGS='$flags'" >&2
			exit 1
		fi
		cp go.mod go.mod.pinned
		go mod tidy
		cmp go.mod go.mod.pinned || { echo "build: go mod tidy changed the pinned go.mod" >&2; exit 1; }
	)
fi
(cd "$dir" && go mod verify >/dev/null)
echo "built $1 from $BASE with ${#patches[@]} patch(es)"
