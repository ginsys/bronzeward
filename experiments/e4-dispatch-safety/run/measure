#!/usr/bin/env bash
# The late-landing measurement (acceptance plan S6.2): how often, and when, a configuration apply
# abandoned by its client still lands on the fixture's worker. Each capture makes a fresh artifact
# (a node label unique to the capture), starts `talosctl apply-config --mode=no-reboot` with a fault
# already in place, kills talosctl at the transport deadline as e4x does (talos.go), heals the fault
# after the cell's partition length, then reads the worker's machine-configuration resource version
# once a second for the window. The version is the landing signal: it moves on every apply that
# lands and not on a refused one (the dispatch-safety report §3). A capture is landed yes, no, or
# unknown when the window's last read failed with no change seen.
#
# Cells (fault x partition length x connection state):
#   control-none: no fault, so the apply lands; the positive control of the landing signal;
#   netsplit-worker, pause-worker, pause-controlplane at 20, 45 and 90 s, sent through the control
#     plane's API proxy on a warm connection (the harness has just read the worker through it);
#   held-controlplane at 20, 45 and 90 s: a request the proxy already holds when its side is paused.
#     The worker is split off first, so apid's forward waits in the control plane's connection to it
#     (the one established connection the warm read leaves, pinned before the send); the control
#     plane is paused only once that connection holds unsent bytes, within the transport deadline
#     (the pin and each poll in the transcript), the split healed at 20 s after the send and the pause undone at the cell's
#     length. A pause after the forward reached a reachable worker would find nothing held: the
#     proxied apply completes in milliseconds, faster than a pause takes;
#   cold: the control plane restarted before the capture and the worker reached only directly, so
#     the proxy has no connection to the worker and must dial it during the partition;
#   direct: talosctl straight to the worker's endpoint, partitioned before the dial (step 3);
#   control-after: the control again, last, so that no-landing results above are not a path the
#     faults broke.
# Every read the window makes goes straight to the worker, never through the proxy, so the series
# does not share the connection it measures.
#
# Needs the fixture up (fixtures/bin/up); E4D_OUT names a new, empty directory outside the checkout.
# E4M_N=<captures per cell, 1-99> (5 by default); E4M_ONLY=<extended regex> runs only the matching cells
# and is recorded in run.txt. E4M_SOCKETS=1 also samples, once a second through each capture, the
# TCP connection between the control plane and the worker's API port from both nodes' network
# namespaces (/proc/net/tcp and tcp6: state, queues, timer, retransmissions), into its transcript.
#
# Evidence for ginsys/bronzeward issue 28 (S6.2). Not v1 tooling.
set -uo pipefail
# shellcheck source-path=SCRIPTDIR source=lib.sh
. "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"

E4M_N=${E4M_N:-5}
# Capture IDs carry a two-digit number, which collect-evidence relies on.
[[ $E4M_N =~ ^[1-9][0-9]?$ ]] || die "E4M_N must be an integer from 1 to 99"
# e4x's transport deadline in the dispatch-safety rows, and the window after the heal.
E4M_DEADLINE=15
E4M_WINDOW=60
# When a held-controlplane capture heals the worker's split, after the send: the netsplit cell
# whose requests landed.
E4M_SPLIT=20
E4M_CAPTURES=$E4D_OUT/captures.tsv

e4d_init
e4d_need_fixture

# Straight to the worker, for every read of a capture: bounded short, so a read that cannot get
# through costs a second of the window, not the window.
d_talos() { talosctl_timed "${D_LIMIT:-3}" -e "$TALOS_WORKER_IP" -n "$TALOS_WORKER_IP" "$@"; }
d_resource() {
  local yaml v u
  yaml=$(d_talos get machineconfig v1alpha1 -o yaml) || return 1
  v=$(awk '$1 == "version:" { print $2; exit }' <<<"$yaml")
  u=$(awk '$1 == "updated:" { print $2; exit }' <<<"$yaml")
  [[ $v =~ ^[0-9]+$ ]] || return 1
  printf '%s %s\n' "$v" "${u:-unknown}"
}
# d_applies_since <YYYY/MM/DD HH:MM:SS>: machined's ApplyConfiguration lines logged at or after that
# time (UTC, the worker's clock, the host's). The log talosctl returns is a bounded buffer, so a
# count over all of it is not monotonic; the lines themselves carry each request's status.
d_applies_since() {
  local log
  log=$(D_LIMIT=10 d_talos logs machined) || return 1
  awk -v since="$1" '/\[\/machine\.MachineService\/ApplyConfiguration\]/ && $2 " " $3 >= since' <<<"$log"
}

# A fault left in place by an interrupted run would make every later capture meaningless, and so
# would an apply still running after it: background jobs (BG) are ended and reaped first.
HEAL=()
BG=()
heal_all() {
  local h a p
  for p in "${BG[@]}"; do kill -TERM "$p" 2>/dev/null || true; done
  for p in "${BG[@]}"; do wait "$p" 2>/dev/null || true; done
  BG=()
  for h in "${HEAL[@]}"; do
    read -ra a <<<"$h"
    "$FIXTURES_DIR/bin/inject" "${a[@]}" >/dev/null 2>&1 || true
  done
  HEAL=()
}
trap heal_all EXIT

now_ms() { date -u +%FT%T.%3NZ; }

# hex4 <a.b.c.d>: the address as /proc/net/tcp prints it.
hex4() {
  local IFS=. o
  read -ra o <<<"$1"
  printf '%02X%02X%02X%02X' "${o[3]}" "${o[2]}" "${o[1]}" "${o[0]}"
}
# The control plane's connection to the worker's port 50000, as either end lists it.
SOCK_RE="$(hex4 "$TALOS_CONTROLPLANE_IP"):[0-9A-F]{4} [0-9A-F]*$(hex4 "$TALOS_WORKER_IP"):C350 |$(hex4 "$TALOS_WORKER_IP"):C350 [0-9A-F]*$(hex4 "$TALOS_CONTROLPLANE_IP"):"
# sockets_sample <container name> <seconds> <out>: that connection's lines, prefixed with the time,
# once a second, from a one-off curl-image container in the node's network namespace. Run in the
# background, its PID is then timeout's, and a TERM to it ends the container (--init passes it on).
sockets_sample() {
  local id
  id=$(container_id "$1") || return 1
  # shellcheck disable=SC2016 # expanded by the container's shell
  exec timeout $(($2 + 30)) docker run --rm --init --pull never --network "container:$id" --label "$TOOL_LABEL" \
    --entrypoint sh "$CURL_IMAGE" -c 'i=0
      while [ "$i" -lt "$1" ]; do
        t=$(date -u +%T)
        grep -ihE -- "$2" /proc/net/tcp /proc/net/tcp6 | sed "s/^/$t /"
        sleep 1
        i=$((i + 1))
      done' sh "$2" "$SOCK_RE" >"$3" 2>&1
}

# cp_tcp <seconds>: the control plane's /proc/net/tcp and tcp6, read within that many seconds.
cp_tcp() {
  local id
  id=$(container_id "$CP") || return 1
  timeout "$1" docker run --rm --pull never --network "container:$id" --label "$TOOL_LABEL" \
    --entrypoint cat "$CURL_IMAGE" /proc/net/tcp /proc/net/tcp6
}
# held_established: the control plane's established connections from its address to the worker's
# API port, as IPv4 or IPv4-mapped IPv6 addresses, exactly; one line each.
held_established() {
  awk -v cp="$(hex4 "$TALOS_CONTROLPLANE_IP")" -v w="$(hex4 "$TALOS_WORKER_IP")" '
    function is(addr, ip) { return addr == ip || addr == "0000000000000000FFFF0000" ip }
    { split($2, l, ":"); split($3, r, ":") }
    is(l[1], cp) && is(r[1], w) && r[2] == "C350" && $4 == "01"'
}
# held_pin: before the send, the one connection apid holds to the worker after the warm read, with
# nothing left unsent on it; it sets HELD_LOCAL, HELD_REMOTE and HELD_INODE. Two such connections,
# none, or one with a non-empty send queue refuse the capture.
held_pin() {
  local out n q
  out=$(cp_tcp 10 | held_established) || return 1
  n=$(grep -c . <<<"$out" || true)
  printf '%s held pin: %s\n' "$(now_ms)" "${out:-no established connection to the worker}" >>"$LOG"
  [ "$n" = 1 ] || return 1
  read -r _ HELD_LOCAL HELD_REMOTE _ q _ _ _ _ HELD_INODE _ <<<"$out"
  [ "$((16#${q%%:*}))" = 0 ]
}
# held_wait <send start> <bytes>: the synchronization point of a held-controlplane capture. Reads
# the control plane's /proc/net/tcp and tcp6 until the pinned connection, still established, holds
# at least <bytes> unsent, the size of the configuration sent: the apply has reached apid and been
# forwarded into the split connection, which a keepalive or a read's remains cannot fill. Every
# read goes to the transcript with its time. Each read is bounded by what is left of the send's
# transport deadline, and a read that ends past it is refused.
held_wait() {
  local deadline=$(($1 + E4M_DEADLINE)) left out line q
  while left=$((deadline - SECONDS)) && [ "$left" -gt 0 ]; do
    out=$(cp_tcp "$left") || return 1
    line=$(held_established <<<"$out" | awk -v l="$HELD_LOCAL" -v r="$HELD_REMOTE" -v i="$HELD_INODE" '
      $2 == l && $3 == r && $10 == i { print; exit }')
    printf '%s held check: %s\n' "$(now_ms)" "${line:-the pinned connection is gone}" >>"$LOG"
    [ -n "$line" ] || return 1
    [ "$SECONDS" -lt "$deadline" ] || return 1
    read -r _ _ _ _ q _ <<<"$line"
    [ "$((16#${q%%:*}))" -lt "$2" ] || return 0
  done
  return 1
}

# inject_logged <action> <target>: the fixture's injection; its output goes to the capture's log.
inject_logged() {
  printf '%s $ inject %s\n' "$(now_ms)" "$*" >>"$LOG"
  "$FIXTURES_DIR/bin/inject" "$@" >>"$LOG" 2>&1
}

# capture <cell> <n> <fault> <length> <route>: one capture; one line in captures.tsv.
#   fault: netsplit-worker | pause-worker | pause-controlplane; route: warm | cold | direct
capture() {
  local cell=$1 n=$2 fault=$3 length=$4 route=$5 action target undo endpoint
  local pre_v pre_u since send_at kill_at heal_at rc v u first='' last_v start i applies ok other
  local landed=no spids=() side tpid sent_ms
  ROW_N=$(printf '%s-%02d' "$cell" "$n") ROW_ID=$ROW_N ROW_PARTS=$E4D_PARTS/$ROW_N
  mkdir -p -- "$ROW_PARTS"
  LOG=$E4D_T/$ROW_N.txt
  : >"$LOG"
  action=${fault%%-*} target=${fault#*-}
  case $action in
    netsplit) undo=netjoin ;;
    pause) undo=unpause ;;
    held) undo=unpause ;;
    none) undo=none ;;
    *) die "capture $ROW_N: unknown fault $fault" ;;
  esac
  endpoint=$TALOS_CONTROLPLANE_IP
  [ "$route" = direct ] && endpoint=$TALOS_WORKER_IP

  if [ "$route" = cold ]; then
    # A restarted control plane holds no proxy connection to the worker. Nothing below reaches
    # the worker through it before the send: the artifact and the reads go straight to the worker.
    HEAL=("start controlplane")
    inject_logged kill controlplane || die "capture $ROW_N: could not kill the control plane"
    inject_logged start controlplane || die "capture $ROW_N: could not start the control plane"
    HEAL=()
  fi
  # The artifact: the worker's configuration with a node label unique to this capture.
  d_talos get machineconfig v1alpha1 -o jsonpath='{.spec}' >"$ROW_PARTS/base.yaml" ||
    die "capture $ROW_N: could not read the worker's configuration"
  talosctl_timed 20 machineconfig patch "$ROW_PARTS/base.yaml" --output "$ROW_PARTS/art.yaml" \
    --patch "{\"machine\":{\"nodeLabels\":{\"bronzeward.test/e4m\":\"$ROW_N\"}}}" >/dev/null ||
    die "capture $ROW_N: could not make the artifact"
  read -r pre_v pre_u < <(d_resource) || die "capture $ROW_N: could not read the worker's resource"
  # A landing after the previous capture's window shows here, as a version it did not end on.
  if [ -n "${PREV_V:-}" ] && [ "$pre_v" != "$PREV_V" ]; then
    printf '%s\tlanded after its window: version %s at the next capture, %s at its window end\n' \
      "$PREV_ID" "$pre_v" "$PREV_V" >>"$E4D_OUT/after-window.tsv"
  fi
  # Warm: the harness's own read through the proxy, so it holds a live connection to the worker.
  if [ "$route" = warm ]; then
    w_talos version --short >>"$LOG" 2>&1 || die "capture $ROW_N: the worker is not readable through the control plane"
  fi
  printf 'pre version=%s updated=%s\n' "$pre_v" "$pre_u" >>"$LOG"

  # Whole seconds: an apply logged in the second the fault went in is counted, not lost.
  since=$(date -u '+%Y/%m/%d %H:%M:%S')
  if [ "${E4M_SOCKETS:-0}" = 1 ]; then
    i=$((length > E4M_DEADLINE ? length : E4M_DEADLINE))
    sockets_sample "$CP" $((i + E4M_WINDOW + 5)) "$ROW_PARTS/sockets-controlplane.txt" &
    spids+=($!)
    sockets_sample "$WORKER" $((i + E4M_WINDOW + 5)) "$ROW_PARTS/sockets-worker.txt" &
    spids+=($!)
    BG=("${spids[@]}")
  fi
  if [ "$action" = held ]; then
    held_pin || die "capture $ROW_N: not exactly one connection from the control plane to the worker"
    # The worker split off first; the pause comes after the send.
    HEAL=("netjoin worker")
    inject_logged netsplit worker || die "capture $ROW_N: could not netsplit worker"
  elif [ "$action" != none ]; then
    # Armed first: an injection that fails halfway, or an interruption, still gets its undo.
    HEAL=("$undo $target")
    inject_logged "$action" "$target" || die "capture $ROW_N: could not $action $target"
  fi
  start=$SECONDS
  sent_ms=$(date +%s%3N)
  send_at=$(now_ms)
  rc=0
  timeout --signal=KILL "$E4M_DEADLINE" "$CACHE/talosctl" -e "$endpoint" -n "$TALOS_WORKER_IP" \
    apply-config --mode=no-reboot --file "$ROW_PARTS/art.yaml" >>"$LOG" 2>&1 &
  tpid=$!
  BG+=("$tpid")
  if [ "$action" = held ]; then
    held_wait "$start" "$(stat -c %s -- "$ROW_PARTS/art.yaml")" ||
      die "capture $ROW_N: the pinned connection did not hold the request before the deadline"
    HEAL=("netjoin worker" "unpause $target")
    inject_logged pause "$target" || die "capture $ROW_N: could not pause $target"
    # Measured from before talosctl started, so never shorter than its own run.
    [ $(($(date +%s%3N) - sent_ms)) -lt $((E4M_DEADLINE * 1000)) ] ||
      die "capture $ROW_N: the pause completed after the transport deadline"
  fi
  wait "$tpid" || rc=$?
  BG=("${spids[@]}")
  kill_at=$(now_ms)
  printf '%s talosctl exited %s\n' "$kill_at" "$rc" >>"$LOG"
  if [ "$action" = held ]; then
    i=$((E4M_SPLIT - (SECONDS - start)))
    [ "$i" -le 0 ] || sleep "$i"
    inject_logged netjoin worker || die "capture $ROW_N: could not netjoin worker"
    HEAL=("unpause $target")
  fi
  if [ "$action" != none ]; then
    i=$((length - (SECONDS - start)))
    [ "$i" -le 0 ] || sleep "$i"
    inject_logged "$undo" "$target" || die "capture $ROW_N: could not $undo $target"
    HEAL=()
  fi
  heal_at=$(now_ms)

  # The window: one read a second, straight to the worker.
  last_v=$pre_v
  start=$SECONDS
  while [ $((SECONDS - start)) -lt "$E4M_WINDOW" ]; do
    if read -r v u < <(d_resource); then
      printf '%s version=%s updated=%s\n' "$(now_ms)" "$v" "$u" >>"$LOG"
      last_v=$v
      if [ -z "$first" ] && [ "$v" != "$pre_v" ]; then first=$(now_ms) landed=yes; fi
    else
      printf '%s unreadable\n' "$(now_ms)" >>"$LOG"
    fi
    sleep 1
  done
  # The last read counts like the others; with it unreadable, the result is unknown, not no.
  if read -r v u < <(d_resource); then
    printf '%s version=%s updated=%s\n' "$(now_ms)" "$v" "$u" >>"$LOG"
    if [ -z "$first" ] && [ "$v" != "$pre_v" ]; then first=$(now_ms) landed=yes; fi
  else
    printf '%s unreadable\n' "$(now_ms)" >>"$LOG"
    v=$last_v u=unknown
    [ "$landed" = yes ] || landed=unknown
  fi
  if applies=$(d_applies_since "$since"); then
    printf 'machined ApplyConfiguration since %s:\n%s\n' "$since" "$applies" >>"$LOG"
    ok=$(grep -c ' OK \[' <<<"$applies")
    other=$(grep -c . <<<"$applies")
    other=$((other - ok))
  else
    printf 'machined log unreadable\n' >>"$LOG"
    ok=unknown other=unknown
  fi
  if [ "${#spids[@]}" -gt 0 ]; then
    wait "${spids[@]}" || printf 'a socket sampler failed\n' >>"$LOG"
    BG=()
    for side in controlplane worker; do
      printf 'sockets in the %s namespace (time sl local remote st tx:rx tr:when retransmits ...):\n' "$side" >>"$LOG"
      cat -- "$ROW_PARTS/sockets-$side.txt" >>"$LOG"
    done
  fi
  PREV_V=$v PREV_ID=$ROW_N
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$ROW_N" "$fault" "$length" \
    "$route" "$send_at" "$rc" "$kill_at" "$heal_at" "$pre_v" "$v" "$landed" "${first:--}" \
    "$([ "$v" != "$pre_v" ] && printf '%s' "$u" || printf -- '-')" "$ok" "$other" \
    "$(git -C "$REPO_DIR" rev-parse --short HEAD)" "transcripts/$ROW_N.txt" >>"$E4M_CAPTURES"
  say "capture $ROW_N: talosctl rc=$rc landed=$landed${first:+ first seen $first}"
}

uncommitted=$(git -C "$REPO_DIR" status --porcelain -- experiments/e4-dispatch-safety fixtures \
  ':!experiments/e4-dispatch-safety/evidence*')
{
  printf 'commit\t%s\n' "$(git -C "$REPO_DIR" rev-parse HEAD)"
  printf 'uncommitted inputs\t%s\n' "$(printf '%s' "$uncommitted" | grep -c .)"
  [ -z "$uncommitted" ] || printf '%s\n' "$uncommitted" | sed 's/^/uncommitted\t/'
  [ -z "${E4M_ONLY:-}" ] || printf 'only\t%s\n' "$E4M_ONLY"
  printf 'started\t%s\n' "$(date -u +%FT%TZ)"
  printf 'talosctl\t%s\n' "$(talosctl_timed 10 version --client --short | tr '\n' ' ')"
  printf 'talos worker\t%s\n' "$(w_talos version --short | tr '\n' ' ')"
  printf 'captures per cell\t%s\n' "$E4M_N"
  printf 'transport deadline\t%ss\n' "$E4M_DEADLINE"
  printf 'window\t%ss\n' "$E4M_WINDOW"
  printf 'socket samples\t%s\n' "$([ "${E4M_SOCKETS:-0}" = 1 ] && echo yes || echo no)"
} >"$E4D_OUT/run.txt"
printf 'capture\tfault\tlength\troute\tsent\ttalosctl_rc\tkilled\thealed\tpre_version\tend_version\tlanded\tfirst_seen\tworker_updated\tmachined_ok\tmachined_other\tcommit\ttranscript\n' \
  >"$E4M_CAPTURES"

# The control first and last: with no fault the apply lands, the version moves and machined logs one
# OK, or a no-landing result between them would prove nothing about the signal or the path.
cells=("control-none:none-none:0:warm")
for fault in netsplit-worker pause-worker pause-controlplane held-controlplane; do
  for length in 20 45 90; do cells+=("$fault-$length:$fault:$length:warm"); done
done
cells+=("cold-netsplit-worker-20:netsplit-worker:20:cold" "direct-netsplit-worker-20:netsplit-worker:20:direct")
cells+=("control-after:none-none:0:warm")
for c in "${cells[@]}"; do
  IFS=: read -r cell fault length route <<<"$c"
  [[ -z ${E4M_ONLY:-} || $cell =~ $E4M_ONLY ]] || continue
  for ((k = 1; k <= E4M_N; k++)); do capture "$cell" "$k" "$fault" "$length" "$route"; done
done

install -m 600 -- "$STATE/scan-patterns.txt" "$E4D_PATTERNS"
cp -- "$STATE/injections.log" "$E4D_OUT/injections.log"
count=$(($(wc -l <"$E4M_CAPTURES") - 1))
landed=$(awk -F'\t' 'NR > 1 && $11 == "yes"' "$E4M_CAPTURES" | wc -l)
printf 'finished\t%s\n' "$(date -u +%FT%TZ)" >>"$E4D_OUT/run.txt"
printf 'captures %s, landed %s\n' "$count" "$landed" >"$E4D_OUT/complete"
say "measure: $count captures, $landed landed, in $E4M_CAPTURES"
