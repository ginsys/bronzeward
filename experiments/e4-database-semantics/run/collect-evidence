#!/usr/bin/env bash
# Copy the committable text of one run into evidence/: the cell table, the run record, the
# fixture's injection timeline, and every row's transcript (each client's output, each injection,
# each reader's output), packed one file per scenario and backend. The SQLite files, the
# PostgreSQL dumps and the fixture's evidence bundle stay in E4_OUT. Absolute paths are rewritten,
# and the result is refused if it holds any of the fixture's leak-scan patterns (this run's
# password, canary and tokens); a planted control file proves the scan matches before the real
# scan runs.
#
# Phase-0 evidence for the database-semantics experiment (ginsys/bronzeward issue 6). Not v1 tooling.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=lib.sh
. "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"
need grep sed find sort sha256sum cut
[ -s "$E4_MARK" ] || die "$E4_OUT is not an E4 run directory ($E4_MARK is missing)"
[ -s "$E4_OUT/complete" ] || die "$E4_OUT/complete is missing: run/all did not finish"
[ -s "$E4_PATTERNS" ] || die "$E4_PATTERNS is missing or empty"

dest=$E4_DIR/evidence
incoming=$(mktemp -d "$E4_DIR/.evidence-incoming.XXXXXX")
trap 'rm -rf -- "$incoming"' EXIT

rewrite() { # rewrite <in> <out>: the checkout, E4_OUT and the fixture state become placeholders
  mkdir -p -- "$(dirname -- "$2")"
  sed -e "s#$REPO_DIR#<repo>#g" -e "s#$E4_OUT#<E4_OUT>#g" -e "s#$STATE#<fixture-state>#g" -- "$1" >"$2"
}
for f in run.txt cells.tsv injections.log; do
  rewrite "$E4_OUT/$f" "$incoming/$f"
done

# The fixture's evidence bundle, copied to E4_OUT/bundle before teardown (README), stays there: it
# holds dumps and data. What is committed is its summary and a manifest of what was copied.
bundle=$E4_OUT/bundle
[ -s "$bundle/versions.txt" ] || die "$bundle/versions.txt is missing: copy the fixture's bundle there first"
{
  printf '# fixtures/bin/evidence bundle, captured after run/all with E4_OUT as an extra scan path\n'
  printf '## versions.txt\n'
  cat -- "$bundle/versions.txt"
  printf '## leak-scan.txt (files matched; canary-control files are the planted positive controls, scan-patterns.txt is the pattern list itself)\n'
  cat -- "$bundle/leak-scan.txt"
  printf '## fixtures-diff.txt lines: %s; up-fixtures-diff.txt lines: %s\n' \
    "$(wc -l <"$bundle/fixtures-diff.txt")" "$(wc -l <"$bundle/up-fixtures-diff.txt")"
  if [ -e "$bundle/unavailable.txt" ]; then
    printf '## unavailable.txt\n'
    cat -- "$bundle/unavailable.txt"
  else
    printf '## unavailable.txt: absent\n'
  fi
} >"$E4_OUT/bundle-summary.txt"
rewrite "$E4_OUT/bundle-summary.txt" "$incoming/bundle-summary.txt"
# The full manifest stays in E4_OUT. The committed one lists every file outside postgres-data/ and
# gives that data directory one line, the digest of its part of the full manifest: its
# 2000-odd per-file lines made the diff hunk too large for the pull-request review to read.
(cd -- "$bundle" && find . -type f -print0 | sort -z | xargs -0 sha256sum) >"$E4_OUT/bundle-manifest.txt"
{
  grep -v '  \./postgres-data/' -- "$E4_OUT/bundle-manifest.txt" || true
  pgdata=$(grep '  \./postgres-data/' -- "$E4_OUT/bundle-manifest.txt" || true)
  if [ -n "$pgdata" ]; then
    printf '%s  ./postgres-data/ (%s files: the sha256 of their lines in the full manifest, kept in E4_OUT)\n' \
      "$(printf '%s\n' "$pgdata" | sha256sum | cut -d' ' -f1)" "$(printf '%s\n' "$pgdata" | wc -l)"
  fi
} >"$E4_OUT/bundle-manifest-committed.txt"
rewrite "$E4_OUT/bundle-manifest-committed.txt" "$incoming/bundle-manifest.txt"

# One file per scenario and backend rather than one per row: GitHub serves no pull-request diff of
# more than 300 files, and a review that cannot read the diff reviews nothing. Each row's
# transcript follows a `==> <row> <==` line, in row order; the pack ends with `==> end <==`.
packs=0
while IFS= read -r key; do
  out=$incoming/transcripts/$key.txt
  mkdir -p -- "$(dirname -- "$out")"
  {
    while IFS= read -r -d '' f; do
      printf '==> %s <==\n' "$(basename -- "$f" .txt)"
      sed -e "s#$REPO_DIR#<repo>#g" -e "s#$E4_OUT#<E4_OUT>#g" -e "s#$STATE#<fixture-state>#g" -- "$f"
      [ -z "$(tail -c 1 -- "$f")" ] || printf '\n'
    done < <(find "$E4_T" -type f -name "[0-9][0-9][0-9]-$key-*.txt" -print0 | sort -z)
    printf '==> end <==\n'
  } >"$out"
  packs=$((packs + 1))
done < <(awk -F'\t' 'NR > 1 { print $2 "-" $3 }' "$E4_CELLS" | sort -u)
[ "$packs" -gt 0 ] || die "no rows in $E4_CELLS"

# scan <fixed-strings-file> [dir]: the files under dir (incoming by default) that hold any of the
# strings. grep exits 1 for no match; any other failure (an unreadable file) ends the run rather
# than reading as clean.
scan() {
  local rc=0
  grep -rlF -f "$1" -- "${2:-$incoming}" || rc=$?
  [ "$rc" -le 1 ] || die "the leak scan failed (grep exit $rc)"
}

# The control: a file holding one pattern, in a directory of its own so that a real leak cannot
# be mistaken for a failed control, must be found, or the scan below proves nothing. It lives in
# E4_OUT, outside the checkout, because the pattern it holds is one of the run's secrets.
ctl=$(mktemp -d "$E4_OUT/.evidence-control.XXXXXX")
trap 'rm -rf -- "$incoming" "$ctl"' EXIT
head -n 1 -- "$E4_PATTERNS" >"$ctl/leak-control"
hits=$(scan "$E4_PATTERNS" "$ctl")
[ "$hits" = "$ctl/leak-control" ] && control=fired || control="did not fire as expected"
rm -rf -- "$ctl"
[ "$control" = fired ] || die "leak-scan control $control; the scan cannot be trusted"

# Refusals. A match is reported by file only, never by content.
hits=$(scan "$E4_PATTERNS")
[ -z "$hits" ] || die "collected evidence matches a leak-scan pattern in: $hits"
hits=$(scan <(printf '%s/\n' "$HOME"))
[ -z "$hits" ] || die "collected evidence names a path in the operator's home in: $hits"
printf 'leak-scan\t%s patterns\tcontrol %s\t0 hits in %s files\n' "$(wc -l <"$E4_PATTERNS")" "$control" \
  "$(find "$incoming" -type f | wc -l)" >"$incoming/leak-scan.tsv"

rm -rf -- "$dest"
mv -T -- "$incoming" "$dest"
trap - EXIT
say "evidence collected in $dest: $(find "$dest" -type f | wc -l) files"
