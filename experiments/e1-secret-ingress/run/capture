#!/usr/bin/env bash
# Tier B: one run, one evidence bundle, asserted.
#
# Usage: E1_OUT=<dir> run/capture <run-id> <expectation> <surfaces|-> -- <e1 flags and subcommand>
#
#   <expectation> is what the bundle's leak scan must show:
#     clean   exactly the two controls and nothing else
#     leak    more than the two controls: a deliberate control that must be visible
#     miss    exactly the two controls, although a value really was written: the transformed
#             control, which demonstrates what the instrument cannot see
#     residue more than the two controls, none of them written by this run: an honest run taken
#             after the deliberate controls, whose database still holds their plaintext
#
# The run root is handed to fixtures/bin/evidence as an extra scan path, and the bundle is copied
# out of .state immediately: fixtures/bin/down destroys .state, and a bundle captured before a
# teardown has to outlive it.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=lib.sh
. "$(dirname -- "$0")/lib.sh"

need docker grep sed awk wc cp find sort tail go sleep

[ $# -ge 5 ] || die "usage: run/capture <run-id> clean|leak|miss|residue <surfaces|-> -- <e1 arguments>"
run_id=$1
expectation=$2
# Comma-separated path fragments the hits must and, with a ! prefix, must not appear at; - requires
# nothing. See run/assert-bundle: a count alone cannot tell a control's own write from an earlier
# control's residue in the shared database.
surfaces=$3
shift 3
[ "$1" = -- ] || die "expected -- before the e1 arguments"
shift

case $expectation in
  clean | leak | miss | residue) ;;
  *) die "unknown expectation $expectation; want clean, leak, miss or residue" ;;
esac
# The run id names the directories removed below. An empty one would make them $E1_RUNS/ and
# $E1_BUNDLES/ themselves, deleting every earlier run and bundle; a / or a dot segment would reach
# outside them.
case $run_id in
  '' | . | .. | */*) die "run id '$run_id' must be one non-empty path segment" ;;
esac
[ -n "$surfaces" ] || die "surfaces is empty; pass - to require none"

e1_need_fixture
e1_build

run_root=$E1_RUNS/$run_id
rm -rf -- "$run_root"
mkdir -p -- "$run_root"

held=no
for arg in "$@"; do
  case $arg in
    --hold-at=none) ;;
    --hold-at=*) held=yes ;;
  esac
done

status=ok
if [ "$held" = yes ]; then
  # A held run is captured while it is paused, which is the only reason to hold it. The first
  # version ran it in the foreground like every other run, so the bundle was taken after the hold
  # had expired, the change had been resumed and released and the draft persisted: the two
  # held-in-review bundles, reported as showing a claim outstanding, showed a finished run.
  e1_env "$E1_BIN" --run-root="$run_root" --run-id="$run_id" "$@" >"$run_root/stdout.txt" 2>"$run_root/stderr.txt" &
  pid=$!
  waited=0
  until grep -q 'reached: holding' "$run_root/stderr.txt" 2>/dev/null; do
    kill -0 "$pid" 2>/dev/null || die "capture: $run_id exited before announcing its hold; see $run_root/stderr.txt"
    [ "$waited" -lt 120 ] || die "capture: $run_id did not announce its hold within 60s"
    sleep 0.5
    waited=$((waited + 1))
  done
  say "capture: $run_id is holding; taking the bundle now"
fi
if [ "$held" = no ]; then
  e1_env "$E1_BIN" --run-root="$run_root" --run-id="$run_id" "$@" >"$run_root/stdout.txt" 2>"$run_root/stderr.txt" ||
    status=exit-$?
  say "capture: $run_id finished $status"
fi

# A flushed capture forces a PostgreSQL CHECKPOINT after the run and before the bundle, so a clean
# data directory cannot be dismissed as "not flushed yet". The first version took a db-snapshot
# before the run instead, which is a pg_dump: it flushed nothing, and certainly not this run's rows.
if [ "${E1_FLUSH:-}" = 1 ]; then
  pg psql --username=bronzeward --dbname=bronzeward --no-password -Atc CHECKPOINT >/dev/null ||
    die "capture: the CHECKPOINT before $run_id's bundle failed; a flushed capture without the flush is not one"
  say "capture: CHECKPOINT issued after $run_id, before its bundle"
fi

# bundles are directories named for the UTC instant of their capture, so sorting them by name is
# sorting them by time.
#
# The directory is created here rather than assumed. fixtures/bin/evidence makes it on its first
# run, so before that find fails, and under `set -e` with pipefail a failing pipeline inside a
# command substitution aborts this script with no message at all: every capture of a first matrix
# exited silently between the run and the bundle, the harness recorded 23 unexplained failures, and
# nothing in the log said why. `|| true` keeps a later unreadable directory from doing it again.
mkdir -p -- "$STATE/evidence"
bundle_names() {
  find "$STATE/evidence" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort || true
}

# The bundle is taken whatever the run did. A crashed run is the interesting case, and one that
# failed for an unexpected reason still has to be looked at rather than discarded.
before=$(bundle_names | wc -l)
"$FIXTURES_DIR/bin/evidence" "$run_root" || die "the capture itself failed; results void"
after=$(bundle_names | wc -l)
[ "$after" -gt "$before" ] || die "fixtures/bin/evidence wrote no new bundle"

if [ "$held" = yes ]; then
  # Still holding when the bundle finished, or it is not a mid-flight capture: a hold shorter than
  # the capture would reproduce the original defect silently.
  grep -q 'hold over' "$run_root/stderr.txt" &&
    die "capture: $run_id's hold ended before its bundle was complete; lengthen --hold-for"
  if wait "$pid"; then status=ok; else status=exit-$?; fi
  say "capture: $run_id finished $status after its hold"
fi

latest=$(bundle_names | tail -n 1)
dest=$E1_BUNDLES/$run_id
rm -rf -- "$dest"
cp -a -- "$STATE/evidence/$latest" "$dest" || die "could not copy the bundle out of .state"
printf '%s\n' "$status" >"$dest/e1-run-status.txt"
printf '%s\n' "$expectation" >"$dest/e1-expectation.txt"

"$E1_RUN_DIR/assert-bundle" "$dest" "$expectation" "$surfaces"
