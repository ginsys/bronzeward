# blank lines, and sops pads blank lines with spaces. Keep them byte-exact rather than tidied.
experiments/e5-provider-capabilities/evidence/transcripts/*.txt -whitespace conflict-marker-size=64
experiments/e5-retention-classification/evidence/transcripts/*.txt -whitespace conflict-marker-size=64
experiments/e5-key-loss-restoration/evidence/transcripts/*.txt -whitespace conflict-marker-size=64

# The web console's Talos schema files are byte copies of the pinned machinery module's own schema
# (`mise run web-schema`), proven equal to it by a Go test in internal/compile. The advisory
# review, which reads this attribute from the base commit, leaves them out of its diff: each is one
# hunk far over its size ceiling.
web/src/talos-schema/*.json linguist-generated=true
