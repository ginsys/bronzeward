# go-kure/.github checkout made by `mise run upstream-sync` for the action-pin checker.
# Anchored: unanchored, the pattern would hide a directory of that name anywhere in the tree.
/upstream/

# The documentation site: mkdocs build output and the virtualenv `mise run site` installs into.
/site/
/.venv-site/
__pycache__/

# The operator guide's configuration copy: it holds the database password.
/bronzeward.yaml

# mise run build's binaries and mise run dev's synthetic OIDC key. Anchored, so fixtures/bin/ stays.
/bin/
/.dev/

# mise run package's output: GoReleaser's archives in dist/, the web tarball and notices in build/.
# Ignored, so a release build's binaries still record vcs.modified=false.
/dist/
/build/

# The web package's dependencies, build output, generated API types and browser-run artifacts.
/web/node_modules/
/web/dist/
/web/src/api/v1.d.ts
/web/e2e/out/
