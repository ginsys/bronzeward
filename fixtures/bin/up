#!/usr/bin/env bash
# Create the disposable fixture: synthetic secrets, PostgreSQL, OpenBao, a two-node Talos cluster.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../lib.sh
. "$(dirname "$0")/../lib.sh"

need docker curl jq tar sha256sum install awk timeout mktemp git find comm
docker compose version >/dev/null || die "missing prerequisite: docker compose v2"
[ "$(uname -sm)" = "Linux x86_64" ] || die "pinned CLI assets are linux/amd64 only"
[ ! -e "$STATE" ] || die "$STATE exists: run fixtures/bin/down first"

# One fixture per Docker daemon: names, ports and subnet are pinned. Resources that exist without
# a state directory here belong to another checkout, or to a run whose state was lost. Volumes
# matter as much as containers: PostgreSQL keeps the password of whoever initialized the volume.
foreign=$(
  claim_names &&
    docker ps --all --filter "label=com.docker.compose.project=$FIXTURE_NAME" --format '{{.Names}}' &&
    docker ps --all --filter "label=talos.cluster.name=$FIXTURE_NAME" --format '{{.Names}}' &&
    docker network ls --filter "label=com.docker.compose.project=$FIXTURE_NAME" --format '{{.Name}}' &&
    docker network ls --filter "label=talos.cluster.name=$FIXTURE_NAME" --format '{{.Name}}' &&
    docker volume ls --filter "label=com.docker.compose.project=$FIXTURE_NAME" --format '{{.Name}}'
) || die "cannot ask Docker for existing fixture resources"
[ -z "$foreign" ] || die "a fixture already exists on this Docker daemon ($(tr '\n' ' ' <<<"$foreign")). \
Run fixtures/bin/down in the checkout that created it; see 'Known limits' in fixtures/README.md"
# The named volumes compose.yaml declares get fixed names, and Compose reuses a volume of that name
# it did not create, with a warning only: the services would then run on someone's data, and the
# down that a failed start calls for would remove it with `--volumes`. Labelled ones were listed
# above; one that remains under the name carries no fixture label and is refused by name.
compose_volumes=$(compose_volume_names) || die "could not read the volume names from compose.yaml"
for taken in $compose_volumes; do
  present=$(docker volume ls --quiet --filter "name=^${taken}$") || die "cannot ask Docker whether the volume $taken exists"
  [ -z "$present" ] ||
    die "the volume $taken exists on this Docker daemon without this fixture's label; Compose would reuse it and down would remove it. Remove or rename it first"
done
unset compose_volumes taken present

# The random part is assigned and measured before it is used: as a printf argument a failed read of
# /dev/urandom would leave the constant prefix as this run's password, with exit status 0.
synthetic() {
  local hex
  hex=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n') || return 1
  [ "${#hex}" -eq 32 ] || return 1
  printf 'BWSYNTH-%s' "$hex"
}

umask 077
# The checks above are only a look, and of two `up` started together both can pass them, from one
# checkout or from two. The claim container is what only one of them can create; the plain mkdir
# then cannot race any more, and stays plain so that it never adopts a directory it did not make.
attempt=$(synthetic) || die "could not generate the attempt identity"
claim_error=$(claim_take "$attempt" 2>&1) || {
  # Docker can create the container and still answer with an error, as a connection lost after
  # the request went through does. A claim that then carries this attempt's label is this up's own
  # and no one else's, and it would refuse every next up from here for good. One with this
  # checkout's path and another attempt is another up's from here, started together with this
  # one, which the name conflict is for: a hint to run down would tear that one's fixture down.
  if [ "$(claim_label "$CLAIM_ATTEMPT_LABEL" 2>/dev/null)" = "$attempt" ]; then
    die "Docker answered the fixture claim with an error, but the claim $CLAIM exists and is this up's; run fixtures/bin/down to remove it, then up again. Docker said: $claim_error"
  fi
  die "could not take the fixture claim $CLAIM on this Docker daemon, which another fixtures/bin/up may hold; nothing was created. Docker said: $claim_error"
}
unset attempt
mkdir "$STATE" 2>/dev/null || {
  claim_drop
  die "$STATE appeared meanwhile; nothing was created"
}
# From here on a failure leaves something behind. Not earlier: an `up` that was refused created
# nothing, and the hint would send its caller to tear down a fixture that is not theirs.
# EXIT, not ERR: `die` leaves through `exit 1` and a failure inside a function does not inherit an
# ERR trap, so neither would print the hint.
# The hint names the down that works: until every record below is published, a plain down refuses
# a labelled volume, container or network it finds without one, and what it asks for is --adopt.
recovery='run fixtures/bin/down to remove what was created'
trap 'rc=$?; [ "$rc" -eq 0 ] || say "fixtures: up failed; $recovery"' EXIT
mkdir "$STATE/data" "$STATE/backups"
# The commit the fixture is made from, and how fixtures/ differs from it now: bin/evidence records
# the commit it captures under, and a checkout switched or committed in between would have the
# bundle name a commit the running fixture, its generated configuration and its cached tools were
# not made from. Evidence reads this record, carries it and says when the two are not the same.
# The same checks evidence makes before it ties a bundle to what ran (fixtures_tree_check in
# lib.sh): a tree with an untracked file hidden by an excludes file outside the repository, a
# symlink, or a directory git cannot open is refused here too, since the commit plus the diff
# recorded would not say what the fixture was made from.
fixtures_tree_check "$STATE" "$STATE/up-fixtures-diff.txt" tree_name
printf '%s\n' "$manifest" >"$STATE/up-manifest"
unset manifest differs
recovery='run fixtures/bin/down --adopt to remove what was created (a plain down refuses what it finds without its record, and the records were not all published)'
# The named volumes compose.yaml declares are made here, first of all, with a label that names this
# run. Compose reuses a volume of that name whatever made it, and the look above is only a look: a
# volume made by anyone between it and `compose up` would be run on and, at teardown, removed. Nor
# is `docker volume create` a claim: on a name that exists it returns the name, without a word.
# What settles it is the label read back: the run whose create made the volume sees its own value,
# any other run sees another's, or none, and refuses. bin/down removes a volume of these names
# only as the run recorded here.
run_id=$(synthetic) || die "could not generate the run identity"
compose_volumes=$(compose_volume_names) || die "could not read the volume names from compose.yaml"
# shellcheck disable=SC2094  # the record is renamed on the failure path, never read: the loop's open file keeps writing to it
for compose_volume in $compose_volumes; do
  docker volume create --label "com.docker.compose.project=$FIXTURE_NAME" \
    --label "com.docker.compose.volume=${compose_volume#"${FIXTURE_NAME}_"}" \
    --label "$CLAIM_OWNER_LABEL=$FIXTURES" --label "$RUN_LABEL=$run_id" "$compose_volume" >/dev/null ||
    die "could not create the volume $compose_volume"
  made_by=$(docker volume inspect --format "{{index .Labels \"$RUN_LABEL\"}}" "$compose_volume") ||
    die "could not read back the volume $compose_volume"
  if [ "$made_by" != "$run_id" ]; then
    # The volumes made so far are published as the record, so that the plain down removes those
    # and holds this one, which is someone's, against it. Not --adopt: with no record it would
    # remove this one by the label, as the fixture's.
    mv --no-target-directory -- "$STATE/down-compose-volumes.partial" "$STATE/down-compose-volumes" ||
      say "fixtures: could not publish the record of the volumes made so far"
    recovery="remove or rename the volume $compose_volume by hand, then run fixtures/bin/down; not --adopt, which would remove that volume as this fixture's"
    die "the volume $compose_volume existed before this run made it, or another run made it meanwhile; it is not this fixture's, and nothing more is created. Remove or rename it by hand"
  fi
  printf '%s %s\n' "$compose_volume" "$run_id"
done >"$STATE/down-compose-volumes.partial"
mv --no-target-directory -- "$STATE/down-compose-volumes.partial" "$STATE/down-compose-volumes"
unset compose_volumes compose_volume made_by run_id
canary=$(synthetic) || die "could not generate the synthetic canary"
password=$(synthetic) || die "could not generate the synthetic PostgreSQL password"
# secrets_publish: the whole file from the values in hand, written under a temporary name and
# renamed into place. A write cut short, on a full filesystem say, then leaves the file that was
# there before, never a cut line, which lib.sh refuses for every later command, down included.
secrets_publish() {
  local tmp
  tmp=$(mktemp "$STATE/secrets.env.XXXXXX") || die "could not write $STATE/secrets.env"
  {
    printf 'BW_CANARY=%s\n' "$canary"
    printf 'BW_POSTGRES_PASSWORD=%s\n' "$password"
    [ -z "${BW_BAO_ROOT_TOKEN:-}" ] || printf 'BW_BAO_ROOT_TOKEN=%s\n' "$BW_BAO_ROOT_TOKEN"
    [ -z "${metadata_token:-}" ] || printf 'BW_BAO_METADATA_TOKEN=%s\n' "$metadata_token"
  } >"$tmp" || {
    rm -f -- "$tmp"
    die "could not write $STATE/secrets.env"
  }
  # The rename replaces the name, not the file: a second name made for the earlier file between
  # two stages would keep that file, and its password, reachable past teardown. Refused, and the
  # values in hand are not published.
  if [ -L "$STATE/secrets.env" ] || { [ -e "$STATE/secrets.env" ] &&
    { [ ! -f "$STATE/secrets.env" ] || [ "$(stat --format=%h -- "$STATE/secrets.env" 2>/dev/null)" != 1 ]; }; }; then
    rm -f -- "$tmp"
    die "$STATE/secrets.env is not the regular file this run wrote, with that one name; nothing more is published"
  fi
  mv --no-target-directory -- "$tmp" "$STATE/secrets.env" || {
    rm -f -- "$tmp"
    die "could not publish $STATE/secrets.env"
  }
}
secrets_publish
set -a
# shellcheck disable=SC1091  # just generated
. "$STATE/secrets.env"
set +a

fetch_tools

say "starting postgres and openbao"
compose up --detach --quiet-pull --wait postgres
compose up --detach --quiet-pull openbao
# The Compose network carries only the project's labels, which any network can be given, and its
# name is fixed: with the containers gone by hand, anyone's network can take the name and the
# labels, and `compose down` would remove it as this project's. Recorded by ID, exactly the one
# the project has, and bin/down and inject hold the labelled network to it, as for the Talos one.
compose_network_ids=$(docker network ls --quiet --no-trunc --filter "label=com.docker.compose.project=$FIXTURE_NAME") ||
  die "could not list the Compose networks"
[ "$(sed '/^$/d' <<<"$compose_network_ids" | wc -l)" -eq 1 ] ||
  die "expected one Compose network to record; teardown could not tell it from another's"
printf '%s\n' "$compose_network_ids" >"$STATE/down-compose-networks.partial"
mv --no-target-directory -- "$STATE/down-compose-networks.partial" "$STATE/down-compose-networks"
unset compose_network_ids

bao_answers() {
  local rc=0
  bao status >/dev/null 2>&1 || rc=$?
  [ "$rc" -eq 0 ] || [ "$rc" -eq 2 ] # 2 = reachable but sealed
}
wait_for 60 "the OpenBao API" bao_answers

say "initializing openbao (one synthetic unseal key)"
bao operator init -key-shares=1 -key-threshold=1 -format=json >"$STATE/bao-init.json"
BW_BAO_ROOT_TOKEN=$(jq -er .root_token "$STATE/bao-init.json") || die "OpenBao init returned no root token"
export BW_BAO_ROOT_TOKEN
secrets_publish
bao_unseal
wait_for 60 "an active OpenBao node" bao token lookup

bao secrets enable -path=secret -version=2 kv >/dev/null
bao secrets enable transit >/dev/null
bao write -force transit/keys/bw-artifact >/dev/null
bao kv put secret/fixture/inline value="$BW_CANARY" >/dev/null

# A metadata-only identity: the classification experiment must not be able to read values.
timeout "$REQUEST_LIMIT" docker exec -i -e BAO_TOKEN="$BW_BAO_ROOT_TOKEN" "$BAO" bao policy write bw-metadata-only - >/dev/null <<'POLICY'
path "secret/metadata/*" { capabilities = ["read", "list"] }
path "transit/keys/*"    { capabilities = ["read", "list"] }
POLICY
# Assigned first: a command substitution that is only a printf argument cannot fail the script.
metadata_token=$(bao token create -policy=bw-metadata-only -format=json | jq -er .auth.client_token) ||
  die "could not create the metadata-only OpenBao token"
secrets_publish

say "creating the talos cluster (several minutes on a cold image cache)"
# Before the first node volume can exist, the marker bin/down reads as "not every node volume is
# known": an up interrupted from here until the record below is published leaves volumes that
# only the record would name, and a down that found no container left must still not claim
# that none remain. Removed once the records are in place.
if ! marker=$(mktemp "$STATE/down-node-volumes-incomplete.XXXXXX") ||
  ! mv --no-target-directory -- "$marker" "$STATE/down-node-volumes-incomplete"; then
  die "could not mark $STATE as having an unrecorded cluster"
fi
talosctl cluster create docker \
  --name "$FIXTURE_NAME" \
  --state "$STATE/talos" \
  --image "$TALOS_IMAGE" \
  --kubernetes-version "$KUBERNETES_VERSION" \
  --subnet "$TALOS_SUBNET" \
  --workers 1 \
  --talosconfig-destination "$TALOSCONFIG"
# The Talos containers carry only the cluster name, which any container can be labelled with. Their
# IDs, recorded here, are what bin/down holds every container of that label to before removing it.
container_ids=$(docker ps --all --quiet --no-trunc --filter "label=talos.cluster.name=$FIXTURE_NAME") ||
  die "could not list the Talos containers"
[ "$(sed '/^$/d' <<<"$container_ids" | wc -l)" -eq 2 ] ||
  die "expected two Talos containers to record; teardown could not tell them from another's"
# While the containers certainly exist, and from those two alone: a stranger's container under the
# label, listed and gone between two looks, would otherwise have its volumes recorded as this
# fixture's and removed with them. See talos_volume_names in lib.sh.
# shellcheck disable=SC2086  # one ID per word
volume_names=$(talos_volume_names $container_ids) || die "could not list the Talos node volumes"
[ -n "$volume_names" ] || die "the Talos nodes have no volumes to record; teardown could not verify them"
# Under its final name only when complete: bin/down takes a record that exists for the whole list.
printf '%s\n' "$volume_names" >"$STATE/down-node-volumes.partial"
mv --no-target-directory -- "$STATE/down-node-volumes.partial" "$STATE/down-node-volumes"
printf '%s\n' "$container_ids" >"$STATE/down-node-containers.partial"
mv --no-target-directory -- "$STATE/down-node-containers.partial" "$STATE/down-node-containers"
# The cluster network carries the same label, and bin/down removes networks by it just the same.
network_ids=$(docker network ls --quiet --no-trunc --filter "label=talos.cluster.name=$FIXTURE_NAME") ||
  die "could not list the Talos networks"
# Exactly the one the cluster has: a second network of that label, made by someone else while the
# cluster was being created, must not be recorded as this fixture's and removed with it.
[ "$(sed '/^$/d' <<<"$network_ids" | wc -l)" -eq 1 ] ||
  die "expected one Talos network to record; teardown could not tell it from another's"
printf '%s\n' "$network_ids" >"$STATE/down-node-networks.partial"
mv --no-target-directory -- "$STATE/down-node-networks.partial" "$STATE/down-node-networks"
rm -- "$STATE/down-node-volumes-incomplete" || die "could not clear the unrecorded-cluster marker in $STATE"
# Every record is published: a plain down now holds what it finds to them.
recovery='run fixtures/bin/down to remove what was created'

# The cluster's own secrets bundle, for import experiments and as leak-scan patterns.
talosctl -e "$TALOS_CONTROLPLANE_IP" -n "$TALOS_CONTROLPLANE_IP" \
  get machineconfig v1alpha1 -o jsonpath='{.spec}' >"$STATE/controlplane.yaml"
talosctl gen secrets --from-controlplane-config "$STATE/controlplane.yaml" \
  --output-file "$STATE/talos-secrets.yaml"

# Leak-scan patterns: every synthetic secret this run produced (scan_patterns in lib.sh, which
# bin/evidence runs again to check the file). The list must hold more than the prefix.
scan_patterns >"$STATE/scan-patterns.txt"
[ "$(wc -l <"$STATE/scan-patterns.txt")" -ge 8 ] ||
  die "only $(wc -l <"$STATE/scan-patterns.txt") leak-scan patterns were collected; the Talos bundle was not read"

# Positive control: the scan must find this, or an empty result elsewhere proves nothing.
control_content >"$STATE/data/canary-control.txt"

# Something outside the fixture may have stopped a container meanwhile, for example a host hook
# that restarts the Docker daemon when a new bridge appears. Never report a half-dead fixture as up.
for c in "$PG" "$BAO" "$CP" "$WORKER"; do
  [ "$(docker inspect --format '{{.State.Running}}' "$c")" = true ] ||
    die "$c stopped while the fixture was starting (see 'Known limits' in fixtures/README.md)"
done
# Running is not usable. Several minutes of Talos creation have passed since both services were
# last asked, so ask again, with credentials: an OpenBao that sealed itself and a PostgreSQL that
# does not accept this run's password both still count as running.
bao token lookup >/dev/null 2>&1 || die "OpenBao no longer answers an authenticated request"
[ "$(pg_client -Atc 'select 1')" = 1 ] || die "PostgreSQL does not accept this run's password over the network"

cat >&2 <<EOF
fixture is up
  postgres      127.0.0.1:$POSTGRES_PORT  db/user bronzeward, password in .state/secrets.env
  openbao       http://127.0.0.1:$OPENBAO_PORT  root and metadata-only tokens in .state/secrets.env
  talos         controlplane $TALOS_CONTROLPLANE_IP, worker $TALOS_WORKER_IP
                TALOSCONFIG=$TALOSCONFIG
  local stores  $STATE/data (SQLite files, age/SOPS stores)
EOF
