#!/usr/bin/env bash
# Create the disposable fixture: synthetic secrets, PostgreSQL, OpenBao, a two-node Talos cluster.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../lib.sh
. "$(dirname "$0")/../lib.sh"

need docker curl jq tar sha256sum install awk timeout mktemp git find comm
docker compose version >/dev/null || die "missing prerequisite: docker compose v2"
[ "$(uname -sm)" = "Linux x86_64" ] || die "pinned CLI assets are linux/amd64 only"
[ ! -e "$STATE" ] || die "$STATE exists: run fixtures/bin/down first"

# One fixture per Docker daemon: names, ports and subnet are pinned. Resources that exist without
# a state directory here belong to another checkout, or to a run whose state was lost. Volumes
# matter as much as containers: PostgreSQL keeps the password of whoever initialized the volume.
foreign=$(
  claim_names &&
    docker ps --all --filter "label=com.docker.compose.project=$FIXTURE_NAME" --format '{{.Names}}' &&
    docker ps --all --filter "label=talos.cluster.name=$FIXTURE_NAME" --format '{{.Names}}' &&
    docker network ls --filter "label=com.docker.compose.project=$FIXTURE_NAME" --format '{{.Name}}' &&
    docker network ls --filter "label=talos.cluster.name=$FIXTURE_NAME" --format '{{.Name}}' &&
    docker volume ls --filter "label=com.docker.compose.project=$FIXTURE_NAME" --format '{{.Name}}'
) || die "cannot ask Docker for existing fixture resources"
[ -z "$foreign" ] || die "a fixture already exists on this Docker daemon ($(tr '\n' ' ' <<<"$foreign")). \
Run fixtures/bin/down in the checkout that created it; see 'Known limits' in fixtures/README.md"
# The named volumes compose.yaml declares get fixed names, and Compose reuses a volume of that name
# it did not create, with a warning only: the services would then run on someone's data, and the
# down that a failed start calls for would remove it with `--volumes`. Labelled ones were listed
# above; one that remains under the name carries no fixture label and is refused by name.
compose_volumes=$(compose_volume_names) || die "could not read the volume names from compose.yaml"
for taken in $compose_volumes; do
  present=$(docker volume ls --quiet --filter "name=^${taken}$") || die "cannot ask Docker whether the volume $taken exists"
  [ -z "$present" ] ||
    die "the volume $taken exists on this Docker daemon without this fixture's label; Compose would reuse it and down would remove it. Remove or rename it first"
done
unset compose_volumes taken present

# The random part is assigned and measured before it is used: as a printf argument a failed read of
# /dev/urandom would leave the constant prefix as this run's password, with exit status 0.
synthetic() {
  local hex
  hex=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n') || return 1
  [ "${#hex}" -eq 32 ] || return 1
  printf 'BWSYNTH-%s' "$hex"
}

umask 077
# The checks above are only a look, and of two `up` started together both can pass them, from one
# checkout or from two. The claim container is what only one of them can create; the plain mkdir
# then cannot race any more, and stays plain so that it never adopts a directory it did not make.
# The daemon's ID before the claim is made on it: asked after, a docker that did not answer would
# leave the claim with no record of where it is.
daemon_id=$(docker info --format '{{.ID}}') && [ -n "$daemon_id" ] ||
  die "could not read the Docker daemon's ID; nothing was created"
attempt=$(synthetic) || die "could not generate the attempt identity"
# From the claim on a failure leaves something behind, so the handler is armed before it is
# taken: a signal between Docker creating the claim and the create returning would otherwise
# leave a claim that refuses every next up from here for good. The handler knows the claim as
# this up's by the attempt label, which no other up carries: an `up` that was refused the claim,
# or ended before asking for it, created nothing, and a hint would send its caller to tear down
# a fixture that is not theirs. Until the identity records below are published, what exists is
# the claim and what this stage put under the state directory, and the handler removes exactly
# that, so that a failure or a signal there created nothing: a directory left without its daemon
# record is one every command refuses, down among them. From the records on, the hint names the
# down that works: until every record is published, a plain down refuses a labelled volume,
# container or network it finds without one, and what it asks for is --adopt.
# EXIT, not ERR: `die` leaves through `exit 1` and a failure inside a function does not inherit an
# ERR trap, so neither would run the handler.
recovery=
state_made=0
up_failed() {
  if [ -n "$recovery" ]; then
    # The record of the Compose volumes made so far, when the stage that makes them was cut short
    # before publishing it: a plain down then holds those to it, and refuses the one in question,
    # which the hint names.
    if [ -e "$STATE/down-compose-volumes.partial" ] && [ ! -e "$STATE/down-compose-volumes" ]; then
      volumes_publish || recovery="$recovery; and $(volumes_unpublished)"
    fi
    say "fixtures: up failed; $recovery"
    return 0
  fi
  # The flag is set before the mkdir, so a signal between the two finds the directory not there,
  # or there and this up's. A directory that holds another's daemon record (an up from this
  # checkout on another daemon, whose mkdir won, in the moment before this one's failure is
  # noted) is left as it is, its records untouched.
  if [ "$state_made" -eq 1 ] && [ -d "$STATE" ]; then
    rm -f -- "$STATE/up-daemon.partial" "$STATE/up-fixture-name.partial" "$STATE/up-versions.env.partial" "$STATE/up-compose.yaml.partial" 2>/dev/null
    if [ "$(cat -- "$STATE/up-daemon" 2>/dev/null)" = "${daemon_id:-}" ]; then
      rm -f -- "$STATE/up-daemon" "$STATE/up-fixture-name" "$STATE/up-versions.env" "$STATE/up-compose.yaml" 2>/dev/null
    fi
    rmdir -- "$STATE" 2>/dev/null || say "fixtures: up failed; $STATE is not this up's, or holds more than it put there, and is left"
  fi
  # The claim only as this attempt's: one another up holds, or none, is not this up's to remove.
  if [ "$(claim_label "$CLAIM_ATTEMPT_LABEL" 2>/dev/null)" != "$attempt" ]; then
    say "fixtures: up failed; nothing of this up's was created"
  elif claim_drop "$FIXTURES" 2>/dev/null; then
    say "fixtures: up failed; nothing was created"
  else
    say "fixtures: up failed; the claim $CLAIM could not be removed, run fixtures/bin/down to remove it"
  fi
}
# A signal that ends the shell between two commands leaves the status of the command before it,
# 0 as a rule, so the status alone would have the handler take an up cut short for one that
# completed; the flag set once the fixture is up tells the two apart.
up_completed=0
trap 'rc=$?; if [ "$rc" -ne 0 ] || [ "$up_completed" -ne 1 ]; then up_failed; fi' EXIT
claim_error=$(claim_take "$attempt" 2>&1) || {
  # Docker can create the container and still answer with an error, as a connection lost after
  # the request went through does. A claim that then carries this attempt's label is this up's own
  # and no one else's, and the handler removes it. One with this checkout's path and another
  # attempt is another up's from here, started together with this one, which the name conflict is
  # for: the handler leaves it, and a hint to run down would tear that one's fixture down.
  if [ "$(claim_label "$CLAIM_ATTEMPT_LABEL" 2>/dev/null)" = "$attempt" ]; then
    die "Docker answered the fixture claim with an error, but the claim $CLAIM exists and is this up's; it is removed. Docker said: $claim_error"
  fi
  die "could not take the fixture claim $CLAIM on this Docker daemon, which another fixtures/bin/up may hold. Docker said: $claim_error"
}
state_made=1
mkdir "$STATE" 2>/dev/null || { state_made=0; die "$STATE appeared meanwhile; nothing was created"; }
# The identity every later command derives its names, labels and daemon from, recorded before
# anything is made under the directory: lib.sh refuses every command while versions.env names
# another fixture, and need_state and down refuse while the shell reaches another Docker daemon,
# or while the daemon record is missing. Each written whole under a temporary name and renamed
# into place: a record cut short would have every command refuse, down among them.
record() { # record <name> <value>
  if ! printf '%s\n' "$2" >"$STATE/$1.partial" || ! mv --no-target-directory -- "$STATE/$1.partial" "$STATE/$1"; then
    rm -f -- "$STATE/$1.partial"
    return 1
  fi
}
if ! record up-daemon "$daemon_id" || ! record up-fixture-name "$FIXTURE_NAME"; then
  die "could not record the fixture's identity in $STATE"
fi
# And the whole of versions.env, the bytes lib.sh read and this run's values come from, not a
# second reading of the file: lib.sh holds what it read to this copy, byte for byte, for every
# later command, since the ports, addresses and pins the commands use come from it.
if ! printf '%s\n' "$versions_env" >"$STATE/up-versions.env.partial" ||
  ! mv --no-target-directory -- "$STATE/up-versions.env.partial" "$STATE/up-versions.env"; then
  rm -f -- "$STATE/up-versions.env.partial"
  die "could not record versions.env in $STATE"
fi
# And compose.yaml, read once here and recorded from that reading: the services are created from
# the record (compose in lib.sh), well after this, and the checkout's file read then could differ
# from the one the tree check below ties to the commit. The fetch of the tools lies in between.
compose_yaml=$(cat -- "$FIXTURES/compose.yaml") || die "cannot read $FIXTURES/compose.yaml"
if ! printf '%s\n' "$compose_yaml" >"$STATE/up-compose.yaml.partial" ||
  ! mv --no-target-directory -- "$STATE/up-compose.yaml.partial" "$STATE/up-compose.yaml"; then
  rm -f -- "$STATE/up-compose.yaml.partial"
  die "could not record compose.yaml in $STATE"
fi
unset compose_yaml
recovery='run fixtures/bin/down to remove what was created'
unset daemon_id
mkdir "$STATE/data" "$STATE/backups"
# The commit the fixture is made from, and how fixtures/ differs from it now: bin/evidence records
# the commit it captures under, and a checkout switched or committed in between would have the
# bundle name a commit the running fixture, its generated configuration and its cached tools were
# not made from. Evidence reads this record, carries it and says when the two are not the same.
# The same checks evidence makes before it ties a bundle to what ran (fixtures_tree_check in
# lib.sh): a tree with an untracked file hidden by an excludes file outside the repository, a
# symlink, or a directory git cannot open is refused here too, since the commit plus the diff
# recorded would not say what the fixture was made from.
fixtures_tree_check "$STATE" "$STATE/up-fixtures-diff.txt" tree_name
# The two file records against the files now: both were taken before the inventory above, and a
# file edited in between would have the inventory carry bytes the services are not created from.
# Unchanged from before the inventory to after it is unchanged during it.
cmp --silent -- "$STATE/up-compose.yaml" "$FIXTURES/compose.yaml" ||
  die "compose.yaml changed while fixtures/ was being inventoried; run again"
printf '%s\n' "$versions_env" | cmp --silent -- - "$FIXTURES/versions.env" ||
  die "versions.env changed while fixtures/ was being inventoried; run again"
printf '%s\n' "$manifest" >"$STATE/up-manifest"
unset manifest differs
# The named volumes compose.yaml declares are made here, first of all, with a label that names this
# run. Compose reuses a volume of that name whatever made it, and the look above is only a look: a
# volume made by anyone between it and `compose up` would be run on and, at teardown, removed. Nor
# is `docker volume create` a claim: on a name that exists it returns the name, without a word.
# What settles it is the label read back: the run whose create made the volume sees its own value,
# any other run sees another's, or none, and refuses. bin/down removes a volume of these names
# only as the run recorded here.
run_id=$(synthetic) || die "could not generate the run identity"
compose_volumes=$(compose_volume_names) || die "could not read the volume names from compose.yaml"
# volume_stop <recovery> <message>: a volume that is not known to be this run's stops the run
# here. The volumes made so far are published as the record, so that a plain down removes those
# and holds the one in question against it. Never --adopt: with no record it would remove a
# volume of the name by the label, whosever it is.
volume_stop() {
  recovery=$1
  volumes_publish || recovery="$recovery; and $(volumes_unpublished)"
  die "$2"
}
# volumes_publish: the record of the volumes made so far, renamed into place. When that fails, a
# plain down would refuse those volumes as well, so the hint names each of them for inspection by
# hand: the one in question is no longer the only volume without a record.
volumes_publish() {
  mv --no-target-directory -- "$STATE/down-compose-volumes.partial" "$STATE/down-compose-volumes" 2>/dev/null ||
    { say "fixtures: could not publish the record of the volumes made so far"; return 1; }
}
volumes_unpublished() {
  local made
  made=$(cut -d ' ' -f 1 -- "$STATE/down-compose-volumes.partial" 2>/dev/null | tr '\n' ' ')
  printf 'inspect the volumes %sby hand as well (this run'"'"'s carry %s=%s), remove those that are this run'"'"'s, then run fixtures/bin/down; not --adopt' "$made" "$RUN_LABEL" "$run_id"
}
# shellcheck disable=SC2094  # the record is renamed on the failure path, never read: the loop's open file keeps writing to it
for compose_volume in $compose_volumes; do
  # A create that fails may have made the volume all the same, as a connection lost after the
  # request went through does: the same way out as one that could not be read back. And a signal
  # between the create and the label read back leaves the same question, so the hint names that
  # volume from before the create until its label is this run's: the --adopt hint of the stages
  # after would remove it by the label, whosever it is.
  recovery="inspect the volume $compose_volume by hand, if it exists (this run's carries $RUN_LABEL=$run_id), remove it if it is this run's, then run fixtures/bin/down; not --adopt, which would remove that volume whosever it is"
  docker volume create --label "com.docker.compose.project=$FIXTURE_NAME" \
    --label "com.docker.compose.volume=${compose_volume#"${FIXTURE_NAME}_"}" \
    --label "$CLAIM_OWNER_LABEL=$FIXTURES" --label "$RUN_LABEL=$run_id" "$compose_volume" >/dev/null ||
    volume_stop "inspect the volume $compose_volume by hand, if it exists (this run's carries $RUN_LABEL=$run_id), remove it if it is this run's, then run fixtures/bin/down; not --adopt, which would remove that volume whosever it is" \
      "could not create the volume $compose_volume; whether it exists, and is this fixture's, is not known, and nothing more is created"
  made_by=$(docker volume inspect --format "{{index .Labels \"$RUN_LABEL\"}}" "$compose_volume") ||
    volume_stop "inspect the volume $compose_volume by hand (this run's carries $RUN_LABEL=$run_id), remove it if it is this run's, then run fixtures/bin/down; not --adopt, which would remove that volume whosever it is" \
      "the volume $compose_volume could not be read back after this run made it, or found it made; whether it is this fixture's is not known, and nothing more is created"
  [ "$made_by" = "$run_id" ] ||
    volume_stop "remove or rename the volume $compose_volume by hand, then run fixtures/bin/down; not --adopt, which would remove that volume as this fixture's" \
      "the volume $compose_volume existed before this run made it, or another run made it meanwhile; it is not this fixture's, and nothing more is created. Remove or rename it by hand"
  printf '%s %s\n' "$compose_volume" "$run_id"
done >"$STATE/down-compose-volumes.partial"
mv --no-target-directory -- "$STATE/down-compose-volumes.partial" "$STATE/down-compose-volumes"
recovery='run fixtures/bin/down --adopt to remove what was created (a plain down refuses what it finds without its record, and the records were not all published)'
unset compose_volumes compose_volume made_by run_id
canary=$(synthetic) || die "could not generate the synthetic canary"
password=$(synthetic) || die "could not generate the synthetic PostgreSQL password"
# secrets_publish: the whole file from the values in hand, written under a temporary name and
# renamed into place. A write cut short, on a full filesystem say, then leaves the file that was
# there before, never a cut line, which lib.sh refuses for every later command, down included.
secrets_publish() {
  local tmp
  tmp=$(mktemp "$STATE/secrets.env.XXXXXX") || die "could not write $STATE/secrets.env"
  {
    printf 'BW_CANARY=%s\n' "$canary"
    printf 'BW_POSTGRES_PASSWORD=%s\n' "$password"
    [ -z "${BW_BAO_ROOT_TOKEN:-}" ] || printf 'BW_BAO_ROOT_TOKEN=%s\n' "$BW_BAO_ROOT_TOKEN"
    [ -z "${metadata_token:-}" ] || printf 'BW_BAO_METADATA_TOKEN=%s\n' "$metadata_token"
  } >"$tmp" || {
    rm -f -- "$tmp"
    die "could not write $STATE/secrets.env"
  }
  # The rename replaces the name, not the file: a second name made for the earlier file between
  # two stages would keep that file, and its password, reachable past teardown. Refused, and the
  # values in hand are not published.
  if [ -L "$STATE/secrets.env" ] || { [ -e "$STATE/secrets.env" ] &&
    { [ ! -f "$STATE/secrets.env" ] || [ "$(stat --format=%h -- "$STATE/secrets.env" 2>/dev/null)" != 1 ]; }; }; then
    rm -f -- "$tmp"
    die "$STATE/secrets.env is not the regular file this run wrote, with that one name; nothing more is published"
  fi
  mv --no-target-directory -- "$tmp" "$STATE/secrets.env" || {
    rm -f -- "$tmp"
    die "could not publish $STATE/secrets.env"
  }
}
secrets_publish
# The values in hand, not the file read back: the file is data that lib.sh parses for every other
# command, and sourcing it here would run whatever replaced it between the rename and the read.
export BW_CANARY=$canary BW_POSTGRES_PASSWORD=$password

fetch_tools

# The client image inject runs inside the OpenBao container's network namespace, pulled here so
# that inject never pulls: it runs with --pull never, and fails before sending when the image is
# not there.
docker image pull --quiet "$CURL_IMAGE" >/dev/null || die "could not pull the client image $CURL_IMAGE"

say "starting postgres and openbao"
compose up --detach --quiet-pull --wait postgres
compose up --detach --quiet-pull openbao
# The Compose containers carry the project's labels, which any container can be given under the
# fixed names once the real one is gone by hand. Recorded by ID under each name, as the Talos
# nodes are below: containers_own (lib.sh) holds the name to the ID before inject or evidence act
# on it, and bin/down holds every labelled container to the record before removing any. This run
# acts on them by these IDs too (bao and pg in lib.sh take the ID the name was verified under).
for name in "$PG" "$BAO"; do
  # The one Compose made, told by its labels, as containers_own tells it: the name alone could
  # be a replacement's, made once the real one was gone between compose up and this look.
  answer=$(docker inspect --type container --format \
    '{{.Id}} {{index .Config.Labels "com.docker.compose.project"}} {{index .Config.Labels "com.docker.compose.project.working_dir"}}' \
    "$name") || die "could not read the ID of the container $name"
  [ "${answer#* }" = "$FIXTURE_NAME $FIXTURES" ] ||
    die "the container named $name is not the one Compose made: its labels do not name this project and checkout. Remove it by hand"
  id=${answer%% *}
  verified_container_ids["$name"]=$id
  printf '%s %s\n' "$id" "$name"
done >"$STATE/down-compose-containers.partial"
mv --no-target-directory -- "$STATE/down-compose-containers.partial" "$STATE/down-compose-containers"
unset name id answer
# attached_network <what> <label> <value> <container id>...: the ID of the one network every given
# container is attached to, which must carry the label with that value. From the verified
# containers, not from a listing by the label: the label is one any network can be given, and a
# network made under it once the real one was gone by hand would be listed, and counted, as the
# fixture's, then recorded and removed as its own. A container is attached to what it was started
# on; a network it is not on is not the fixture's, whatever its labels say.
attached_network() {
  local what=$1 label=$2 value=$3 id networks network found
  shift 3
  network=
  for id; do
    networks=$(docker inspect --type container --format \
      '{{range $n, $e := .NetworkSettings.Networks}}{{$e.NetworkID}}{{"\n"}}{{end}}' "$id") ||
      die "could not read the networks of the container $id"
    [ "$(sed '/^$/d' <<<"$networks" | wc -l)" -eq 1 ] ||
      die "the container $id is attached to $(sed '/^$/d' <<<"$networks" | wc -l) networks, not the one $what network; teardown could not tell which is the fixture's"
    networks=$(sed '/^$/d' <<<"$networks")
    [ -z "$network" ] || [ "$network" = "$networks" ] ||
      die "the containers are not all on one $what network; teardown could not tell which is the fixture's"
    network=$networks
  done
  found=$(docker network inspect --format "{{.Id}} {{index .Labels \"$label\"}}" "$network") ||
    die "could not inspect the $what network $network the containers are attached to"
  [ "$found" = "$network $value" ] ||
    die "the $what network the containers are attached to does not carry $label=$value; not recorded as the fixture's"
  printf '%s\n' "$network"
}
# The Compose network carries only the project's labels, which any network can be given, and its
# name is fixed: with the containers gone by hand, anyone's network can take the name and the
# labels, and a removal by them would take it as this project's. Recorded by ID, the one the
# verified containers are attached to, and bin/down and inject hold the labelled network to it,
# as for the Talos one.
compose_network_id=$(attached_network Compose com.docker.compose.project "$FIXTURE_NAME" \
  "${verified_container_ids[$PG]}" "${verified_container_ids[$BAO]}") || exit 1
printf '%s\n' "$compose_network_id" >"$STATE/down-compose-networks.partial"
mv --no-target-directory -- "$STATE/down-compose-networks.partial" "$STATE/down-compose-networks"
unset compose_network_id

bao_answers() {
  local rc=0
  bao status >/dev/null 2>&1 || rc=$?
  [ "$rc" -eq 0 ] || [ "$rc" -eq 2 ] # 2 = reachable but sealed
}
wait_for 60 "the OpenBao API" bao_answers

say "initializing openbao (one synthetic unseal key)"
bao operator init -key-shares=1 -key-threshold=1 -format=json >"$STATE/bao-init.json"
BW_BAO_ROOT_TOKEN=$(jq -er .root_token "$STATE/bao-init.json") || die "OpenBao init returned no root token"
export BW_BAO_ROOT_TOKEN
secrets_publish
bao_unseal
wait_for 60 "an active OpenBao node" bao token lookup

bao secrets enable -path=secret -version=2 kv >/dev/null
bao secrets enable transit >/dev/null
bao write -force transit/keys/bw-artifact >/dev/null
# The canary over stdin, not on the CLI's command line: it is what the leak scan looks for.
printf '%s' "$BW_CANARY" | bao_stdin kv put secret/fixture/inline value=- >/dev/null

# A metadata-only identity: the classification experiment must not be able to read values.
bao_id=$(container_id "$BAO") || die "the OpenBao container was not recorded above"
BAO_TOKEN=$BW_BAO_ROOT_TOKEN timeout "$REQUEST_LIMIT" docker exec -i -e BAO_TOKEN "$bao_id" bao policy write bw-metadata-only - >/dev/null <<'POLICY'
path "secret/metadata/*" { capabilities = ["read", "list"] }
path "transit/keys/*"    { capabilities = ["read", "list"] }
POLICY
# Assigned first: a command substitution that is only a printf argument cannot fail the script.
metadata_token=$(bao token create -policy=bw-metadata-only -format=json | jq -er .auth.client_token) ||
  die "could not create the metadata-only OpenBao token"
export BW_BAO_METADATA_TOKEN=$metadata_token
secrets_publish

say "creating the talos cluster (several minutes on a cold image cache)"
# Before the first node volume can exist, the marker bin/down reads as "not every node volume is
# known": an up interrupted from here until the record below is published leaves volumes that
# only the record would name, and a down that found no container left must still not claim
# that none remain. Removed once the records are in place.
if ! marker=$(mktemp "$STATE/down-node-volumes-incomplete.XXXXXX") ||
  ! mv --no-target-directory -- "$marker" "$STATE/down-node-volumes-incomplete"; then
  die "could not mark $STATE as having an unrecorded cluster"
fi
talosctl cluster create docker \
  --name "$FIXTURE_NAME" \
  --state "$STATE/talos" \
  --image "$TALOS_IMAGE" \
  --kubernetes-version "$KUBERNETES_VERSION" \
  --subnet "$TALOS_SUBNET" \
  --workers 1 \
  --talosconfig-destination "$TALOSCONFIG"
# The Talos containers carry only the cluster name, which any container can be labelled with. Their
# IDs, recorded here, are what bin/down holds every container of that label to before removing it.
container_ids=$(docker ps --all --quiet --no-trunc --filter "label=talos.cluster.name=$FIXTURE_NAME") ||
  die "could not list the Talos containers"
[ "$(sed '/^$/d' <<<"$container_ids" | wc -l)" -eq 2 ] ||
  die "expected two Talos containers to record; teardown could not tell them from another's"
# While the containers certainly exist, and from those two alone: a stranger's container under the
# label, listed and gone between two looks, would otherwise have its volumes recorded as this
# fixture's and removed with them. See talos_volume_names in lib.sh.
# shellcheck disable=SC2086  # one ID per word
volume_names=$(talos_volume_names $container_ids) || die "could not list the Talos node volumes"
[ -n "$volume_names" ] || die "the Talos nodes have no volumes to record; teardown could not verify them"
# Under its final name only when complete: bin/down takes a record that exists for the whole list.
printf '%s\n' "$volume_names" >"$STATE/down-node-volumes.partial"
mv --no-target-directory -- "$STATE/down-node-volumes.partial" "$STATE/down-node-volumes"
# Each ID under its name: containers_own (lib.sh) holds the name to the ID, not to the list, so
# that the two nodes' names swapped do not pass as each other.
for name in "$CP" "$WORKER"; do
  id=$(docker inspect --type container --format '{{.Id}}' "$name") || die "could not read the ID of the Talos container $name"
  grep --quiet --line-regexp --fixed-strings -- "$id" <<<"$container_ids" ||
    die "the container named $name is not one of the two the cluster's label lists; teardown could not tell it from another's"
  verified_container_ids["$name"]=$id
  printf '%s %s\n' "$id" "$name"
done >"$STATE/down-node-containers.partial"
unset name id
mv --no-target-directory -- "$STATE/down-node-containers.partial" "$STATE/down-node-containers"
# The cluster network carries the same label, and bin/down removes networks by it just the same.
# The one the two verified nodes are attached to, as above: a second network of that label, made
# by someone else while the cluster was being created, is not the one they are on, and must not
# be recorded as this fixture's and removed with it.
network_id=$(attached_network Talos talos.cluster.name "$FIXTURE_NAME" \
  "${verified_container_ids[$CP]}" "${verified_container_ids[$WORKER]}") || exit 1
printf '%s\n' "$network_id" >"$STATE/down-node-networks.partial"
mv --no-target-directory -- "$STATE/down-node-networks.partial" "$STATE/down-node-networks"
unset network_id
rm -- "$STATE/down-node-volumes-incomplete" || die "could not clear the unrecorded-cluster marker in $STATE"
# Every record is published: a plain down now holds what it finds to them.
recovery='run fixtures/bin/down to remove what was created'

# The cluster's own secrets bundle, for import experiments and as leak-scan patterns.
talosctl -e "$TALOS_CONTROLPLANE_IP" -n "$TALOS_CONTROLPLANE_IP" \
  get machineconfig v1alpha1 -o jsonpath='{.spec}' >"$STATE/controlplane.yaml"
talosctl gen secrets --from-controlplane-config "$STATE/controlplane.yaml" \
  --output-file "$STATE/talos-secrets.yaml"

# Leak-scan patterns: every synthetic secret this run produced (scan_patterns in lib.sh, which
# bin/evidence runs again to check the file). The list must hold more than the prefix.
scan_patterns >"$STATE/scan-patterns.txt"
[ "$(wc -l <"$STATE/scan-patterns.txt")" -ge 8 ] ||
  die "only $(wc -l <"$STATE/scan-patterns.txt") leak-scan patterns were collected; the Talos bundle was not read"

# Positive control: the scan must find this, or an empty result elsewhere proves nothing.
control_content >"$STATE/data/canary-control.txt"

# Something outside the fixture may have stopped a container meanwhile, for example a host hook
# that restarts the Docker daemon when a new bridge appears. Never report a half-dead fixture as up.
# Each asked by the ID recorded under its name: by name, a replacement made meanwhile would
# answer for one that stopped. Running and not paused: a paused container is still running, with
# every process in it frozen.
for c in "$PG" "$BAO" "$CP" "$WORKER"; do
  id=$(container_id "$c") || die "$c was not recorded under its name; the fixture is not known to be up"
  case $(docker inspect --type container --format '{{.State.Running}} {{.State.Paused}}' "$id") in
    'true false') ;;
    'true true') die "$c was paused while the fixture was starting" ;;
    *) die "$c stopped while the fixture was starting (see 'Known limits' in fixtures/README.md)" ;;
  esac
done
unset c id
# Running is not usable. Several minutes of Talos creation have passed since both services were
# last asked, so ask again, with credentials: an OpenBao that sealed itself and a PostgreSQL that
# does not accept this run's password both still count as running. And each Talos node, bounded:
# the control plane was last asked for its config before the checks above, the worker never.
bao token lookup >/dev/null 2>&1 || die "OpenBao no longer answers an authenticated request"
[ "$(pg_client -Atc 'select 1')" = 1 ] || die "PostgreSQL does not accept this run's password over the network"
for node in "$TALOS_CONTROLPLANE_IP" "$TALOS_WORKER_IP"; do
  talosctl_timed "$REQUEST_LIMIT" -e "$node" -n "$node" version --short >/dev/null 2>&1 ||
    die "the Talos node $node no longer answers a request"
done
unset node
# The scripts as they were loaded, once more: the inventory above compared them at its moment,
# and an edit since would have the rest of this run made by code the inventory does not say.
scripts_unchanged_since_load
up_completed=1

cat >&2 <<EOF
fixture is up
  postgres      127.0.0.1:$POSTGRES_PORT  db/user bronzeward, password in .state/secrets.env
  openbao       http://127.0.0.1:$OPENBAO_PORT  root and metadata-only tokens in .state/secrets.env
  talos         controlplane $TALOS_CONTROLPLANE_IP, worker $TALOS_WORKER_IP
                TALOSCONFIG=$TALOSCONFIG
  local stores  $STATE/data (SQLite files, age/SOPS stores)
EOF
