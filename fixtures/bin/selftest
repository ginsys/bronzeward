#!/usr/bin/env bash
# Prove the fixture end to end: up, every injection once with an assertion, evidence, down.
# Usage: selftest [--keep]   (--keep skips up and down, to rerun against a running fixture)
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
# shellcheck source-path=SCRIPTDIR source=../lib.sh
. "$here/../lib.sh"

need docker curl jq timeout sha256sum
keep=${1:-}
passed=0
ok() {
  passed=$((passed + 1))
  say "ok $passed - $*"
}
fail() { die "selftest FAILED: $*"; }

worker_talos() { timeout 10 "$CACHE/talosctl" -e "$TALOS_CONTROLPLANE_IP" -n "$TALOS_WORKER_IP" "$@"; }
worker_digest() {
  local config
  config=$(worker_talos get machineconfig v1alpha1 -o jsonpath='{.spec}')
  printf '%s\n' "$config" | sha256sum | cut -d' ' -f1
}
sql() { pg psql -U bronzeward -d bronzeward -v ON_ERROR_STOP=1 -Atc "$1"; }
kv_version() { # kv_version <field>: a field of version 1 of the test secret's metadata
  bao kv metadata get -mount=secret -format=json selftest/item | jq -r ".data.versions[\"1\"].$1"
}

if [ "$keep" != --keep ]; then
  "$here/up"
  # lib.sh was sourced before the secrets existed
  set -a
  # shellcheck disable=SC1091
  . "$STATE/secrets.env"
  set +a
fi
need_state

for c in "$PG" "$BAO" "$CP" "$WORKER"; do
  [ "$(docker inspect --format '{{.State.Running}}' "$c")" = true ] ||
    fail "$c is not running after up (see 'Known limits' in fixtures/README.md)"
done
ok "all four containers are running"

# Talos: a full-config no-reboot apply on the worker lands byte for byte.
before=$(worker_digest)
worker_talos get machineconfig v1alpha1 -o jsonpath='{.spec}' >"$STATE/data/selftest-worker.yaml"
talosctl machineconfig patch "$STATE/data/selftest-worker.yaml" \
  --patch "{\"machine\":{\"nodeLabels\":{\"bronzeward.test/selftest\":\"r$RANDOM\"}}}" \
  --output "$STATE/data/selftest-worker-next.yaml"
sent=$(sha256sum <"$STATE/data/selftest-worker-next.yaml" | cut -d' ' -f1)
worker_talos apply-config --mode=no-reboot --file "$STATE/data/selftest-worker-next.yaml" >/dev/null
after=$(worker_digest)
[ "$after" = "$sent" ] && [ "$after" != "$before" ] || fail "observed digest $after, sent $sent, before $before"
rm -f "$STATE/data/selftest-worker.yaml" "$STATE/data/selftest-worker-next.yaml"
ok "no-reboot apply: observed config digest equals the sent one"

# PostgreSQL: snapshot, diverge, restore.
sql "drop table if exists bw_selftest; create table bw_selftest (v text); insert into bw_selftest values ('$BW_CANARY')" >/dev/null
"$here/inject" db-snapshot selftest
sql "insert into bw_selftest values ('after-snapshot')" >/dev/null
"$here/inject" db-restore selftest
[ "$(sql 'select count(*) from bw_selftest')" = 1 ] || fail "db-restore did not return to the snapshot"
ok "db-snapshot / db-restore"

# OpenBao: snapshot, soft delete, destroy, key loss, restore.
bao kv put -mount=secret selftest/item value="$BW_CANARY" >/dev/null
bao write -force transit/keys/selftest >/dev/null
"$here/inject" bao-snapshot selftest
"$here/inject" bao-soft-delete selftest/item 1
[ -n "$(kv_version deletion_time)" ] && [ "$(kv_version destroyed)" = false ] || fail "soft delete not visible in metadata"
ok "bao-soft-delete is visible as a reversible state"
"$here/inject" bao-destroy selftest/item 1
[ "$(kv_version destroyed)" = true ] || fail "destroy not visible in metadata"
ok "bao-destroy is visible as a permanent state"
"$here/inject" bao-delete-key selftest
! bao read transit/keys/selftest >/dev/null 2>&1 || fail "transit key still present after bao-delete-key"
ok "bao-delete-key removes the transit key"
"$here/inject" bao-restore selftest
[ "$(kv_version destroyed)" = false ] || fail "bao-restore did not bring back the destroyed secret version"
bao read transit/keys/selftest >/dev/null || fail "bao-restore did not bring back the deleted transit key"
ok "bao-snapshot / bao-restore"

# Local stores.
printf 'x\n' >"$STATE/data/selftest-store"
"$here/inject" store-snapshot selftest
rm "$STATE/data/selftest-store"
"$here/inject" store-restore selftest
[ -f "$STATE/data/selftest-store" ] || fail "store-restore did not bring the file back"
rm "$STATE/data/selftest-store"
ok "store-snapshot / store-restore"

# Crash and restart.
"$here/inject" kill postgres
! sql 'select 1' >/dev/null 2>&1 || fail "postgres answers after kill"
degraded=$("$here/evidence") || fail "evidence aborted while postgres was down"
grep --quiet 'live database dump' "$degraded/unavailable.txt" || fail "evidence did not say the database dump is missing"
grep --quiet --fixed-strings "$degraded/backups/pg-selftest.dump.sql" "$degraded/leak-scan.txt" ||
  fail "evidence did not scan the database backup while postgres was down"
ok "evidence still captures and scans while postgres is down, and names what is missing"
"$here/inject" start postgres
[ "$(sql 'select count(*) from bw_selftest')" = 1 ] || fail "postgres lost committed data over a crash"
ok "kill / start postgres keeps committed data"
"$here/inject" kill openbao
degraded=$("$here/evidence") || fail "evidence aborted while openbao was down"
grep --quiet 'openbao metadata' "$degraded/unavailable.txt" || fail "evidence did not say the OpenBao metadata is missing"
jq -e 'has("unknown")' "$degraded/openbao-metadata.jsonl" >/dev/null ||
  fail "OpenBao metadata reads as empty instead of unknown while openbao was down"
ok "evidence records OpenBao state as unknown, not empty, while openbao is down"
"$here/inject" start openbao
[ "$(kv_version destroyed)" = false ] || fail "openbao state differs after crash and unseal"
ok "kill / start openbao comes back sealed, unseals, keeps state"

# Partitioned provider: clients lose it, the out-of-band observer does not, and the bundle says both.
bao_published() { curl --silent --max-time 5 --output /dev/null "http://127.0.0.1:$OPENBAO_PORT/v1/sys/health"; }
"$here/inject" netsplit openbao
! bao_published || fail "partitioned openbao still answers on its published port"
split=$("$here/evidence") || fail "evidence aborted while openbao was partitioned"
grep --quiet '^unreachable' "$split/openbao-client-view.txt" || fail "evidence did not record that clients cannot reach openbao"
jq -es 'any(.[]; .path == "selftest/item")' "$split/openbao-metadata.jsonl" >/dev/null ||
  fail "evidence lost the true provider state while openbao was partitioned"
"$here/inject" netjoin openbao
wait_for 60 "openbao on its published port after netjoin" bao_published
ok "netsplit / netjoin openbao: bundle holds the client view (unreachable) and the true metadata"

# A hung control plane must not make the healthy worker look dead in the evidence.
"$here/inject" pause controlplane
hung=$("$here/evidence") || fail "evidence aborted while the control plane was paused"
"$here/inject" unpause controlplane
grep --quiet "^UNAVAILABLE $TALOS_CONTROLPLANE_IP\$" "$hung/talos-config-sha256.txt" || fail "evidence claims to have read the paused control plane"
grep --quiet --extended-regexp "^[0-9a-f]{64} $TALOS_WORKER_IP\$" "$hung/talos-config-sha256.txt" ||
  fail "evidence could not read the worker while only the control plane was paused"
wait_for 60 "the worker through the control plane after unpause" worker_talos version --short
ok "evidence reads each Talos node on its own address: paused control plane, worker still read"

# Hung and unreachable Talos peer.
"$here/inject" pause worker
! worker_talos version --short >/dev/null 2>&1 || fail "paused worker still answers"
"$here/inject" unpause worker
wait_for 60 "the worker after unpause" worker_talos version --short
ok "pause / unpause worker"
"$here/inject" netsplit worker
! worker_talos version --short >/dev/null 2>&1 || fail "partitioned worker still answers"
"$here/inject" netjoin worker
wait_for 120 "the worker after netjoin" worker_talos version --short
ok "netsplit / netjoin worker returns on the same address"

# Evidence: the scan must see the canary that was deliberately written to the database, and a
# secret the fixture did not choose itself.
! "$here/evidence" "$STATE/no-such-path" >/dev/null 2>&1 || fail "evidence accepted a scan path that does not exist"
ok "evidence refuses a scan path it cannot read"
printf 'token=%s\n' "$BW_BAO_METADATA_TOKEN" >"$STATE/data/selftest-token-leak"
printf 'plain=%s\n' "$BW_CANARY" >"$STATE/backups/selftest-plain-backup"
# Two inputs find would mishandle if passed along as they are: a file reached only through a
# symlink, and a relative scan path whose name find reads as an action.
mkdir -p "$STATE/selftest-outside"
printf 'linked=%s\n' "$BW_CANARY" >"$STATE/selftest-outside/linked-target"
ln -sf "$STATE/selftest-outside/linked-target" "$STATE/data/selftest-link"
printf 'dashed=%s\n' "$BW_CANARY" >"$STATE/selftest-outside/-delete"
bundle=$(cd "$STATE/selftest-outside" && "$here/evidence" -delete)
grep --quiet --fixed-strings "$STATE/data/selftest-link" "$bundle/leak-scan.txt" || fail "leak scan skipped a symlinked file"
grep --quiet --fixed-strings "$STATE/selftest-outside/-delete" "$bundle/leak-scan.txt" ||
  fail "leak scan mishandled a scan path named like a find action"
rm -r "$STATE/selftest-outside" "$STATE/data/selftest-link"
grep --quiet --fixed-strings "$STATE/data/selftest-token-leak" "$bundle/leak-scan.txt" || fail "leak scan missed the OpenBao metadata token"
grep --quiet --fixed-strings "$STATE/backups/selftest-plain-backup" "$bundle/leak-scan.txt" ||
  fail "leak scan does not cover .state/backups as written (OpenBao snapshots live there)"
rm "$STATE/data/selftest-token-leak" "$STATE/backups/selftest-plain-backup"
jq -es 'any(.[]; .transit_key == "bw-artifact" and .latest >= 1)' "$bundle/openbao-metadata.jsonl" >/dev/null ||
  fail "OpenBao metadata does not list the Transit key"
grep --quiet '^reachable' "$bundle/openbao-client-view.txt" || fail "evidence says clients cannot reach a healthy openbao"
[ ! -e "$bundle/unavailable.txt" ] || fail "evidence reports missing sources on a healthy fixture: $(cat "$bundle/unavailable.txt")"
grep --quiet --fixed-strings "$bundle/postgres.sql" "$bundle/leak-scan.txt" || fail "leak scan missed the canary in the database dump"
grep --quiet --fixed-strings "$bundle/backups/pg-selftest.dump.sql" "$bundle/leak-scan.txt" || fail "leak scan missed the canary in the database backup"
! grep --quiet --fixed-strings "$bundle/logs/" "$bundle/leak-scan.txt" || fail "a container log contains synthetic secret material"
ok "evidence bundle complete; leak scan finds the planted canary and token, nothing in the logs"

if [ "$keep" != --keep ]; then
  "$here/down" || fail "down reported leftovers"
  ok "down left nothing behind"
fi
say "selftest PASSED: $passed checks"
