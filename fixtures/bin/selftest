#!/usr/bin/env bash
# Prove the fixture end to end: up, every injection once with an assertion, evidence, down.
# Usage: selftest [--keep]   (--keep skips up and down, to rerun against a running fixture)
set -euo pipefail
here=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
# shellcheck source-path=SCRIPTDIR source=../lib.sh
. "$here/../lib.sh"

need docker curl jq tar find timeout sha256sum comm stat head
keep=${1:-}
passed=0
ok() {
  passed=$((passed + 1))
  say "ok $passed - $*"
}
fail() { die "selftest FAILED: $*"; }

worker_talos() { timeout 10 "$CACHE/talosctl" -e "$TALOS_CONTROLPLANE_IP" -n "$TALOS_WORKER_IP" "$@"; }
worker_digest() {
  local config
  config=$(worker_talos get machineconfig v1alpha1 -o jsonpath='{.spec}')
  printf '%s\n' "$config" | sha256sum | cut -d' ' -f1
}
sql() { pg psql -U bronzeward -d bronzeward -v ON_ERROR_STOP=1 -Atc "$1"; }
kv_version() { # kv_version <field>: a field of version 1 of the test secret's metadata
  bao kv metadata get -mount=secret -format=json selftest/item | jq -r ".data.versions[\"1\"].$1"
}

if [ "$keep" != --keep ]; then
  # Every volume on the daemon, to tell afterwards whether the run left one that no label finds.
  volumes_before=$(docker volume ls --quiet | sort) || fail "cannot list the Docker volumes"
  # A volume under a name compose.yaml gives its own, without the label Compose puts on the ones
  # it makes: Compose would reuse it, and the fixture would run on someone's data.
  docker volume create "${FIXTURE_NAME}_postgres-data" >/dev/null || fail "cannot create a volume for the test"
  went=0
  "$here/up" >/dev/null 2>&1 && went=1
  docker volume rm "${FIXTURE_NAME}_postgres-data" >/dev/null 2>&1 || true # gone already in the failing case
  [ "$went" -eq 0 ] || fail "up ran on a volume under a Compose name that is not the fixture's"
  [ ! -e "$STATE" ] || fail "the refused up left a state directory"
  "$here/up"
  # lib.sh was sourced before the secrets existed
  set -a
  # shellcheck disable=SC1091
  . "$STATE/secrets.env"
  set +a
fi
need_state

for c in "$PG" "$BAO" "$CP" "$WORKER"; do
  [ "$(docker inspect --format '{{.State.Running}}' "$c")" = true ] ||
    fail "$c is not running after up (see 'Known limits' in fixtures/README.md)"
done
ok "all four containers are running"

# The state directory alone is not ownership: with the claim gone, or held by another checkout, the
# fixed container names may be someone else's fixture, and nothing here may touch them.
refused=0
claim_drop
"$here/inject" pause postgres 2>/dev/null || refused=$((refused + 1))
"$here/evidence" >/dev/null 2>&1 || refused=$((refused + 1))
# Nor does it let down remove anything: the state may be stale, and what exists another checkout's.
down_said=$("$here/down" 2>&1) || refused=$((refused + 1))
docker create --quiet --name "$CLAIM" --label "$CLAIM_LABEL" --label "$CLAIM_OWNER_LABEL=/another/checkout/fixtures" \
  --network none "$POSTGRES_IMAGE" true >/dev/null
"$here/inject" pause postgres 2>/dev/null || refused=$((refused + 1))
"$here/evidence" >/dev/null 2>&1 || refused=$((refused + 1))
claim_drop
claim_take # this checkout's claim again, before anything can fail
if [ "$refused" -ne 5 ]; then
  docker unpause "$PG" >/dev/null 2>&1 || true
  fail "inject, evidence or down ran without this checkout's claim ($refused of 5 refused)"
fi
[ "$(docker inspect --format '{{.State.Paused}}' "$PG")" = false ] || fail "a refused inject paused postgres all the same"
grep --quiet --fixed-strings 'no claim taken from this checkout' <<<"$down_said" ||
  fail "down failed without the claim, but not by refusing: $(tail -n 1 <<<"$down_said")"
ok "inject and evidence refuse when the claim is missing or names another checkout; down refuses when it is missing"

# Talos: a full-config no-reboot apply on the worker lands byte for byte.
before=$(worker_digest)
worker_talos get machineconfig v1alpha1 -o jsonpath='{.spec}' >"$STATE/data/selftest-worker.yaml"
talosctl machineconfig patch "$STATE/data/selftest-worker.yaml" \
  --patch "{\"machine\":{\"nodeLabels\":{\"bronzeward.test/selftest\":\"r$(date -u +%s%N)\"}}}" \
  --output "$STATE/data/selftest-worker-next.yaml"
sent=$(sha256sum <"$STATE/data/selftest-worker-next.yaml" | cut -d' ' -f1)
worker_talos apply-config --mode=no-reboot --file "$STATE/data/selftest-worker-next.yaml" >/dev/null
after=$(worker_digest)
[ "$after" = "$sent" ] && [ "$after" != "$before" ] || fail "observed digest $after, sent $sent, before $before"
rm -f "$STATE/data/selftest-worker.yaml" "$STATE/data/selftest-worker-next.yaml"
ok "no-reboot apply: observed config digest equals the sent one"

# PostgreSQL: snapshot, diverge, restore.
sql "drop table if exists bw_selftest; create table bw_selftest (v text); insert into bw_selftest values ('$BW_CANARY')" >/dev/null
"$here/inject" db-snapshot selftest
sql "insert into bw_selftest values ('after-snapshot')" >/dev/null
"$here/inject" db-restore selftest
[ "$(sql 'select count(*) from bw_selftest')" = 1 ] || fail "db-restore did not return to the snapshot"
# A dump that cannot be restored must not cost the live database. Removed at once: evidence expands
# every dump in backups and rightly fails on one it cannot read.
sql "insert into bw_selftest values ('after-restore')" >/dev/null
head --bytes=$(($(stat --format=%s "$STATE/backups/pg-selftest.dump") / 2)) "$STATE/backups/pg-selftest.dump" \
  >"$STATE/backups/pg-selftest-corrupt.dump"
rc=0
"$here/inject" db-restore selftest-corrupt 2>/dev/null || rc=$?
rm "$STATE/backups/pg-selftest-corrupt.dump"
[ "$rc" -ne 0 ] || fail "db-restore accepted a truncated dump"
[ "$(sql 'select count(*) from bw_selftest')" = 2 ] || fail "a failed db-restore cost the live database"
[ -z "$(sql "select 1 from pg_database where datname = 'bronzeward_restore'")" ] ||
  fail "a failed db-restore left its scratch database behind"
"$here/inject" db-restore selftest
[ "$(sql 'select count(*) from bw_selftest')" = 1 ] || fail "db-restore did not return to the snapshot a second time"
# A snapshot name that is a symlink to a dump outside .state: the restore would install what
# nothing here wrote. Refused before anything is read.
sql "insert into bw_selftest values ('after-restore')" >/dev/null
mkdir "$STATE/selftest-elsewhere"
cp "$STATE/backups/pg-selftest.dump" "$STATE/selftest-elsewhere/dump"
ln -s "$STATE/selftest-elsewhere/dump" "$STATE/backups/pg-selftest-link.dump"
rc=0
"$here/inject" db-restore selftest-link 2>/dev/null || rc=$?
rm "$STATE/backups/pg-selftest-link.dump"
[ "$rc" -ne 0 ] || fail "db-restore read a snapshot name that is a symlink"
[ "$(sql 'select count(*) from bw_selftest')" = 2 ] || fail "db-restore from the symlinked name reached the live database"
# And one with a second hard-linked name.
ln "$STATE/backups/pg-selftest.dump" "$STATE/selftest-elsewhere/alias"
rc=0
"$here/inject" db-restore selftest 2>/dev/null || rc=$?
rm -r "$STATE/selftest-elsewhere"
[ "$rc" -ne 0 ] || fail "db-restore read a snapshot that has a second name"
[ "$(sql 'select count(*) from bw_selftest')" = 2 ] || fail "db-restore from the hard-linked snapshot reached the live database"
"$here/inject" db-restore selftest
[ "$(sql 'select count(*) from bw_selftest')" = 1 ] || fail "db-restore did not return to the snapshot a third time"
ok "db-snapshot / db-restore; a truncated dump leaves the live database alone; a symlinked or hard-linked snapshot is refused unread"

# OpenBao: snapshot, soft delete, destroy, key loss, restore.
bao kv put -mount=secret selftest/item value="$BW_CANARY" >/dev/null
bao write -force transit/keys/selftest >/dev/null
"$here/inject" bao-snapshot selftest
# A curlrc of the caller must not reach the request: with `output` set there, curl would exit 0 and
# the snapshot published under its final name would be empty.
mkdir "$STATE/selftest-curl-home"
printf 'output = "%s"\n' "$STATE/selftest-curl-home/stolen" >"$STATE/selftest-curl-home/.curlrc"
CURL_HOME=$STATE/selftest-curl-home "$here/inject" bao-snapshot selftest-curlrc
stolen=0
[ ! -e "$STATE/selftest-curl-home/stolen" ] || stolen=1
size=$(stat --format=%s "$STATE/backups/bao-selftest-curlrc.snap")
rm -r "$STATE/selftest-curl-home" "$STATE/backups/bao-selftest-curlrc.snap"
[ "$stolen" -eq 0 ] && [ "$size" -gt 0 ] || fail "a curlrc from the caller's environment redirected the OpenBao snapshot"
# A path with a '..' component would reach another API path than the one the log names.
! "$here/inject" bao-destroy 'selftest/../selftest/item' 1 2>/dev/null || fail "inject accepted a KV path with a '..' component"
! grep --quiet --fixed-strings 'selftest/../selftest' "$STATE/injections.log" || fail "a refused KV path was logged"
[ "$(kv_version destroyed)" = false ] || fail "the refused destroy reached the secret"
"$here/inject" bao-soft-delete selftest/item 1
[ -n "$(kv_version deletion_time)" ] && [ "$(kv_version destroyed)" = false ] || fail "soft delete not visible in metadata"
ok "bao-soft-delete is visible as a reversible state; a path with '..' is refused unlogged"
"$here/inject" bao-destroy selftest/item 1
[ "$(kv_version destroyed)" = true ] || fail "destroy not visible in metadata"
ok "bao-destroy is visible as a permanent state"
"$here/inject" bao-delete-key selftest
! bao read transit/keys/selftest >/dev/null 2>&1 || fail "transit key still present after bao-delete-key"
ok "bao-delete-key removes the transit key"
"$here/inject" bao-restore selftest
[ "$(kv_version destroyed)" = false ] || fail "bao-restore did not bring back the destroyed secret version"
bao read transit/keys/selftest >/dev/null || fail "bao-restore did not bring back the deleted transit key"
ok "bao-snapshot / bao-restore; the caller's curlrc ignored"

# Local stores.
printf 'x\n' >"$STATE/data/selftest-store"
"$here/inject" store-snapshot selftest
rm "$STATE/data/selftest-store"
"$here/inject" store-restore selftest
[ -f "$STATE/data/selftest-store" ] || fail "store-restore did not bring the file back"
# A snapshot that cannot be read must not cost the live directory.
printf 'not a tar archive\n' >"$STATE/backups/store-selftest-corrupt.tgz"
! "$here/inject" store-restore selftest-corrupt 2>/dev/null || fail "store-restore accepted a corrupt archive"
[ -f "$STATE/data/selftest-store" ] && [ -f "$STATE/data/canary-control.txt" ] ||
  fail "a failed store-restore destroyed the live store directory"
rm "$STATE/backups/store-selftest-corrupt.tgz"
# A snapshot whose final name has a second name: publishing over it would leave the earlier archive
# alive under the other name, past teardown.
ln "$STATE/backups/store-selftest.tgz" "$STATE/selftest-snapshot-alias"
rc=0
"$here/inject" store-snapshot selftest 2>/dev/null || rc=$?
same=0
[ "$STATE/backups/store-selftest.tgz" -ef "$STATE/selftest-snapshot-alias" ] && same=1
[ "$rc" -ne 0 ] && [ "$same" -eq 1 ] || fail "store-snapshot replaced a snapshot that has a second name"
[ -z "$(find "$STATE/backups" -name 'store-selftest.tgz.partial.*')" ] || fail "a refused store-snapshot left its partial file"
# Nor is a snapshot with a second name restored from: the other name is not one the fixture wrote.
rm "$STATE/data/selftest-store"
rc=0
"$here/inject" store-restore selftest 2>/dev/null || rc=$?
rm "$STATE/selftest-snapshot-alias"
[ "$rc" -ne 0 ] && [ ! -e "$STATE/data/selftest-store" ] || fail "store-restore read a snapshot that has a second name"
# And a snapshot name that is a symlink to an archive outside .state.
mkdir "$STATE/selftest-elsewhere"
cp "$STATE/backups/store-selftest.tgz" "$STATE/selftest-elsewhere/archive"
ln -s "$STATE/selftest-elsewhere/archive" "$STATE/backups/store-selftest-link.tgz"
rc=0
"$here/inject" store-restore selftest-link 2>/dev/null || rc=$?
rm -r "$STATE/backups/store-selftest-link.tgz" "$STATE/selftest-elsewhere"
[ "$rc" -ne 0 ] && [ ! -e "$STATE/data/selftest-store" ] || fail "store-restore read a snapshot name that is a symlink"
[ -z "$(find "$STATE" -maxdepth 1 -name 'store-restore.*')" ] || fail "a refused store-restore left its staging directory"
"$here/inject" store-restore selftest
[ -f "$STATE/data/selftest-store" ] || fail "store-restore did not bring the file back a second time"
# Defaults for tar in the caller's shell must not reach the snapshot: this one would leave the file
# out without any error.
TAR_OPTIONS=--exclude=data/selftest-store "$here/inject" store-snapshot selftest-env
listing=$(tar -tzf "$STATE/backups/store-selftest-env.tgz") || fail "cannot list store-selftest-env.tgz"
rm "$STATE/backups/store-selftest-env.tgz"
grep --quiet --line-regexp 'data/selftest-store' <<<"$listing" ||
  fail "a TAR_OPTIONS from the caller's shell left a file out of the store snapshot"
# A name with a slash would put the snapshot under another directory, which may be a link to anywhere.
! "$here/inject" store-snapshot selftest-escape/out 2>/dev/null || fail "store-snapshot accepted a name with a slash"
[ ! -e "$STATE/backups/store-selftest-escape" ] || fail "store-snapshot created a directory for a name with a slash"
# A name or an action with a newline would write records of its own into injections.log, and an
# action that does not exist is refused before it is recorded.
records=$(wc -l <"$STATE/injections.log")
! "$here/inject" store-snapshot $'selftest-line\nbreak' 2>/dev/null || fail "store-snapshot accepted a name with a newline"
! "$here/inject" $'store-snapshot\nselftest-line' 2>/dev/null || fail "inject accepted an action with a newline"
! "$here/inject" selftest-no-such-action 2>/dev/null || fail "inject accepted an action that does not exist"
[ "$(wc -l <"$STATE/injections.log")" -eq "$records" ] || fail "a refused action or name was still recorded"
[ -z "$(find "$STATE/backups" -name 'store-selftest-line*')" ] || fail "store-snapshot wrote a snapshot for a name with a newline"
# A name spelled like an interrupted snapshot's temporary file would be read as one by evidence.
! "$here/inject" store-snapshot selftest.partial.x 2>/dev/null || fail "store-snapshot accepted a name that holds .partial."
[ -z "$(find "$STATE/backups" -name 'store-selftest.partial.x*')" ] || fail "store-snapshot wrote a snapshot for a name that holds .partial."
# The log itself: through a link, the arguments, a snapshot name among them, would be written
# outside .state; a second name keeps them past teardown.
mv "$STATE/injections.log" "$STATE/selftest-log-aside"
printf 'keep\n' >"$FIXTURES/.selftest-log-target"
ln -s "$FIXTURES/.selftest-log-target" "$STATE/injections.log"
linked=0
"$here/inject" store-snapshot selftest-logged >/dev/null 2>&1 && linked=1
kept=$(cat "$FIXTURES/.selftest-log-target")
rm -f "$FIXTURES/.selftest-log-target" "$STATE/injections.log"
mv "$STATE/selftest-log-aside" "$STATE/injections.log" # before anything can fail
[ "$linked" -eq 0 ] || fail "inject ran with a symlinked log"
[ "$kept" = keep ] || fail "inject wrote its log through a link"
ln "$STATE/injections.log" "$STATE/selftest-log-alias"
aliased=0
"$here/inject" store-snapshot selftest-logged >/dev/null 2>&1 && aliased=1
rm "$STATE/selftest-log-alias"
[ "$aliased" -eq 0 ] || fail "inject appended to a log that has a second name"
[ ! -e "$STATE/backups/store-selftest-logged.tgz" ] || fail "inject took a snapshot it could not log"
[ "$(wc -l <"$STATE/injections.log")" -eq "$records" ] || fail "a refused action was still recorded"
# A final name that is a symlink to a directory must not receive the snapshot inside that directory.
mkdir "$STATE/selftest-snapshot-dir"
ln -s "$STATE/selftest-snapshot-dir" "$STATE/backups/store-selftest-symlinked.tgz"
"$here/inject" store-snapshot selftest-symlinked
escaped=$(find "$STATE/selftest-snapshot-dir" -mindepth 1 | wc -l)
published=0
[ ! -f "$STATE/backups/store-selftest-symlinked.tgz" ] || [ -L "$STATE/backups/store-selftest-symlinked.tgz" ] || published=1
rm -rf "$STATE/selftest-snapshot-dir" "$STATE/backups/store-selftest-symlinked.tgz"
[ "$escaped" -eq 0 ] && [ "$published" -eq 1 ] ||
  fail "a snapshot whose final name was a symlink to a directory was written through the link"
# An archive whose data is a symlink is no store: installed, it would cost the live directory and
# leave a fixture that every command refuses.
mkdir "$STATE/selftest-linked-archive"
ln -s "$STATE/backups" "$STATE/selftest-linked-archive/data"
tar -czf "$STATE/backups/store-selftest-linked.tgz" -C "$STATE/selftest-linked-archive" data
rm -r "$STATE/selftest-linked-archive"
rc=0
"$here/inject" store-restore selftest-linked 2>/dev/null || rc=$?
rm "$STATE/backups/store-selftest-linked.tgz"
if [ -L "$STATE/data" ]; then
  rm "$STATE/data"
  mkdir "$STATE/data" # so that down is not refused
  fail "store-restore installed a symlink as the store directory"
fi
[ "$rc" -ne 0 ] && [ -f "$STATE/data/selftest-store" ] || fail "store-restore accepted an archive whose data is a symlink"
# The loss a store snapshot exists for: the live directory gone altogether.
mv "$STATE/data" "$STATE/selftest-data-aside"
rc=0
"$here/inject" store-restore selftest || rc=$?
if [ "$rc" -ne 0 ] || [ ! -f "$STATE/data/selftest-store" ]; then
  rm -rf "$STATE/data"
  mv "$STATE/selftest-data-aside" "$STATE/data"
  fail "store-restore did not bring back a store directory that was gone"
fi
rm -r "$STATE/selftest-data-aside"
# An archive holding an entry named previous, restored while the live directory is gone: refused,
# and the exit handler must not take the archive's entry for a live directory this run moved aside.
mkdir -p "$STATE/selftest-previous-archive/data" "$STATE/selftest-previous-archive/previous"
printf 'from the archive\n' >"$STATE/selftest-previous-archive/previous/planted"
tar -czf "$STATE/backups/store-selftest-previous.tgz" -C "$STATE/selftest-previous-archive" data previous
rm -r "$STATE/selftest-previous-archive"
mv "$STATE/data" "$STATE/selftest-data-aside"
rc=0
"$here/inject" store-restore selftest-previous 2>/dev/null || rc=$?
installed=0
[ ! -e "$STATE/data" ] || installed=1
rm -rf "$STATE/data" "$STATE/backups/store-selftest-previous.tgz"
mv "$STATE/selftest-data-aside" "$STATE/data" # before anything can fail
[ "$rc" -ne 0 ] || fail "store-restore accepted an archive with an entry named previous while the live directory was gone"
[ "$installed" -eq 0 ] || fail "a refused archive's previous entry was installed as the store directory"
[ -z "$(find "$STATE" -maxdepth 1 -name 'store-restore.*')" ] || fail "a refused store-restore left its staging directory"
rm "$STATE/data/selftest-store"
# A container that only bears a fixture name: the names are fixed, so once the real one was removed
# by hand anything can take the name while the claim still stands, and a kill would go to it.
docker rename "$PG" "$PG-selftest-aside" >/dev/null
docker create --quiet --name "$PG" --network none "$POSTGRES_IMAGE" true >/dev/null
records=$(wc -l <"$STATE/injections.log")
impostor=0
"$here/inject" kill postgres >/dev/null 2>&1 && impostor=1
docker rm --force --volumes "$PG" >/dev/null
docker rename "$PG-selftest-aside" "$PG" >/dev/null # before anything can fail
[ "$impostor" -eq 0 ] || fail "inject acted on a container that only bears the fixture's name"
[ "$(wc -l <"$STATE/injections.log")" -eq "$records" ] || fail "inject recorded an action it refused"
# A Talos node's name and label both: the label is a cluster name anything can be created with, so
# only the ID bin/up recorded says the container is the node.
docker rename "$WORKER" "$WORKER-selftest-aside" >/dev/null
docker create --quiet --name "$WORKER" --label "talos.cluster.name=$FIXTURE_NAME" --network none "$POSTGRES_IMAGE" true >/dev/null
impostor=0
"$here/inject" pause worker >/dev/null 2>&1 && impostor=1
docker rm --force --volumes "$WORKER" >/dev/null
docker rename "$WORKER-selftest-aside" "$WORKER" >/dev/null # before anything can fail
[ "$impostor" -eq 0 ] || fail "inject acted on a container that bears a Talos node's name and label but is not the node"
[ "$(wc -l <"$STATE/injections.log")" -eq "$records" ] || fail "inject recorded an action it refused"
ok "store-snapshot / store-restore; the caller's TAR_OPTIONS ignored, a name with a slash, a newline or .partial. refused, no write through a symlinked or a hard-linked final name or log, no restore from one, a container that only bears a fixture name, or a Talos node's name and label, refused, a corrupt or symlinked snapshot leaves the live directory alone, a missing one is restored and never replaced by an archive's own previous entry"

# Crash and restart.
"$here/inject" kill postgres
! sql 'select 1' >/dev/null 2>&1 || fail "postgres answers after kill"
degraded=$("$here/evidence") || fail "evidence aborted while postgres was down"
grep --quiet 'live database dump' "$degraded/unavailable.txt" || fail "evidence did not say the database dump is missing"
grep --quiet --fixed-strings "$degraded/backups/pg-selftest.dump.sql" "$degraded/leak-scan.txt" ||
  fail "evidence did not scan the database backup while postgres was down"
# The server is dead, its storage is not: that is the state a crash leaves for an extraction to be
# judged on, and it must be read from the stopped container.
grep --quiet --fixed-strings "$degraded/postgres-data/" "$degraded/leak-scan.txt" ||
  fail "evidence did not read what PostgreSQL wrote to disk while postgres was down"
ok "evidence still captures and scans while postgres is down, reads the server's storage, and names what is missing"
# A snapshot that fails must not leave a file a later restore would accept, and the timeline must
# tell it apart from the kill above, which did happen.
! "$here/inject" db-snapshot selftest-broken 2>/dev/null || fail "db-snapshot succeeded while postgres was down"
[ -z "$(find "$STATE/backups" -name 'pg-selftest-broken*')" ] || fail "a failed db-snapshot left a file behind"
grep --quiet --extended-regexp ' failed rc=[0-9]+ db-snapshot selftest-broken$' "$STATE/injections.log" ||
  fail "injections.log does not record the failed db-snapshot as failed"
grep --quiet ' done kill postgres$' "$STATE/injections.log" || fail "injections.log does not record the kill as done"
ok "a failed snapshot leaves no file behind, and injections.log records done and failed apart"
"$here/inject" start postgres
[ "$(sql 'select count(*) from bw_selftest')" = 1 ] || fail "postgres lost committed data over a crash"
ok "kill / start postgres keeps committed data"
"$here/inject" kill openbao
degraded=$("$here/evidence") || fail "evidence aborted while openbao was down"
grep --quiet 'openbao metadata' "$degraded/unavailable.txt" || fail "evidence did not say the OpenBao metadata is missing"
jq -es 'any(.[]; has("unknown"))' "$degraded/openbao-metadata.jsonl" >/dev/null ||
  fail "OpenBao metadata reads as empty instead of unknown while openbao was down"
ok "evidence records OpenBao state as unknown, not empty, while openbao is down"
"$here/inject" start openbao
[ "$(kv_version destroyed)" = false ] || fail "openbao state differs after crash and unseal"
ok "kill / start openbao comes back sealed, unseals, keeps state"

# Hung provider: a paused OpenBao still accepts the connection and never answers. The action must
# end on its own and say that it failed.
"$here/inject" pause openbao
rc=0
"$here/inject" bao-snapshot selftest-hung 2>/dev/null || rc=$?
"$here/inject" unpause openbao
[ "$rc" -ne 0 ] || fail "bao-snapshot succeeded against a paused openbao"
[ -z "$(find "$STATE/backups" -name 'bao-selftest-hung*')" ] || fail "a failed bao-snapshot left a file behind"
grep --quiet --extended-regexp ' failed rc=[0-9]+ bao-snapshot selftest-hung$' "$STATE/injections.log" ||
  fail "injections.log does not record the hung bao-snapshot as failed"
wait_for 60 "openbao after unpause" bao token lookup
ok "bao-snapshot against a paused openbao ends, is recorded as failed and leaves no file"

# The same from inside the container, where a pause does not reach: with the server process
# stopped, `docker exec` still runs the CLI, which connects and is never answered. A wait must end
# at its deadline even though the attempt itself never returns.
# shellcheck disable=SC2016  # expanded by the shell in the container
docker exec "$BAO" sh -c 'kill -STOP $(pidof bao)'
began=$SECONDS
rc=0
(wait_for 5 "an OpenBao that never answers" bao token lookup) 2>/dev/null || rc=$?
# shellcheck disable=SC2016
docker exec "$BAO" sh -c 'kill -CONT $(pidof bao)'
[ "$rc" -ne 0 ] || fail "a stopped openbao answered"
[ $((SECONDS - began)) -le 10 ] || fail "wait_for 5 took $((SECONDS - began))s against an openbao that never answers"
wait_for 60 "openbao after SIGCONT" bao token lookup
ok "wait_for ends at its deadline when the attempt itself hangs"

# Partitioned provider: clients lose it, the out-of-band observer does not, and the bundle says both.
bao_published() { curl --noproxy '*' --silent --max-time 5 --output /dev/null "http://127.0.0.1:$OPENBAO_PORT/v1/sys/health"; }
"$here/inject" netsplit openbao
! bao_published || fail "partitioned openbao still answers on its published port"
rc=0
split=$("$here/evidence") || rc=$?
"$here/inject" netjoin openbao # before anything can fail
[ "$rc" -eq 0 ] || fail "evidence aborted while openbao was partitioned"
grep --quiet '^unreachable' "$split/openbao-client-view.txt" || fail "evidence did not record that clients cannot reach openbao"
jq -es 'any(.[]; .path == "selftest/item")' "$split/openbao-metadata.jsonl" >/dev/null ||
  fail "evidence lost the true provider state while openbao was partitioned"
wait_for 60 "openbao on its published port after netjoin" bao_published
ok "netsplit / netjoin openbao: bundle holds the client view (unreachable) and the true metadata"

# A hung control plane must not make the healthy worker look dead in the evidence.
"$here/inject" pause controlplane
rc=0
hung=$("$here/evidence") || rc=$?
"$here/inject" unpause controlplane # before anything can fail
[ "$rc" -eq 0 ] || fail "evidence aborted while the control plane was paused"
grep --quiet "^UNAVAILABLE $TALOS_CONTROLPLANE_IP\$" "$hung/talos-config-sha256.txt" || fail "evidence claims to have read the paused control plane"
grep --quiet --extended-regexp "^[0-9a-f]{64} $TALOS_WORKER_IP\$" "$hung/talos-config-sha256.txt" ||
  fail "evidence could not read the worker while only the control plane was paused"
wait_for 60 "the worker through the control plane after unpause" worker_talos version --short
ok "evidence reads each Talos node on its own address: paused control plane, worker still read"

# Crashed, hung and unreachable Talos peer. `start` returns only once the node answers on its own
# address, so the very next request must succeed without a wait of its own.
"$here/inject" kill worker
"$here/inject" start worker
timeout 10 "$CACHE/talosctl" -e "$TALOS_WORKER_IP" -n "$TALOS_WORKER_IP" version --short >/dev/null 2>&1 ||
  fail "inject start worker returned before the worker answered"
wait_for 60 "the worker through the control plane after its restart" worker_talos version --short
"$here/inject" pause worker
! worker_talos version --short >/dev/null 2>&1 || fail "paused worker still answers"
"$here/inject" unpause worker
wait_for 60 "the worker after unpause" worker_talos version --short
ok "kill / start and pause / unpause worker"
"$here/inject" netsplit worker
! worker_talos version --short >/dev/null 2>&1 || fail "partitioned worker still answers"
# Off its network, the node would be given its address on whatever network carries the name: the
# network is held to the one up recorded, and without the record nothing is joined.
mv "$STATE/down-node-networks" "$STATE/selftest-networks-aside"
joined=0
"$here/inject" netjoin worker 2>/dev/null && joined=1
mv "$STATE/selftest-networks-aside" "$STATE/down-node-networks" # before anything can fail
[ "$joined" -eq 0 ] || fail "netjoin worker joined a network no record vouches for"
! worker_talos version --short >/dev/null 2>&1 || fail "the refused netjoin connected the worker all the same"
"$here/inject" netjoin worker
wait_for 120 "the worker after netjoin" worker_talos version --short
ok "netsplit / netjoin worker returns on the same address, and only on the recorded network"

# Evidence: the scan must see the canary that was deliberately written to the database, and a
# secret the fixture did not choose itself.
! "$here/evidence" "$STATE/no-such-path" >/dev/null 2>&1 || fail "evidence accepted a scan path that does not exist"
# The refusal itself must not leak: a file the scan cannot read, whose name holds a secret, is
# reported without that name. root reads a mode-000 file, so there the case cannot be built.
if [ "$(id -u)" -ne 0 ]; then
  mkdir "$STATE/selftest-unreadable"
  printf 'nothing to see\n' >"$STATE/selftest-unreadable/named-$BW_BAO_METADATA_TOKEN"
  chmod 000 "$STATE/selftest-unreadable/named-$BW_BAO_METADATA_TOKEN"
  rc=0
  "$here/evidence" "$STATE/selftest-unreadable" >/dev/null 2>"$STATE/selftest-evidence.err" || rc=$?
  rm -rf "$STATE/selftest-unreadable"
  [ "$rc" -ne 0 ] || fail "evidence accepted a file it could not read"
  grep --quiet 'could not read (a path whose name holds secret material' "$STATE/selftest-evidence.err" ||
    fail "evidence did not fail on the unreadable file: $(grep --invert-match --fixed-strings --file="$STATE/scan-patterns.txt" "$STATE/selftest-evidence.err" | tail -n 1)"
  ! grep --quiet --fixed-strings --file="$STATE/scan-patterns.txt" "$STATE/selftest-evidence.err" ||
    fail "evidence wrote a secret-bearing file name into its error message"
  # A backup that cannot be opened for expansion, before the scan: bash names the file it cannot
  # redirect from, and that name must not reach stderr either.
  printf 'not a dump\n' >"$STATE/backups/pg-named-$BW_BAO_METADATA_TOKEN.dump"
  chmod 000 "$STATE/backups/pg-named-$BW_BAO_METADATA_TOKEN.dump"
  rc=0
  "$here/evidence" >/dev/null 2>"$STATE/selftest-evidence.err" || rc=$?
  rm -f "$STATE/backups/pg-named-$BW_BAO_METADATA_TOKEN.dump"
  [ "$rc" -ne 0 ] || fail "evidence accepted a backup it could not expand"
  ! grep --quiet --fixed-strings --file="$STATE/scan-patterns.txt" "$STATE/selftest-evidence.err" ||
    fail "evidence wrote a secret-bearing backup name into its error message"
  rm "$STATE/selftest-evidence.err"
else
  say "skipped as root: the unreadable-file case"
fi
ok "evidence refuses a scan path it cannot read, and withholds a secret-bearing name when it does"
# The positive control as a symlink to a file outside the scanned paths that holds exactly the
# planted content: the canary then lives where teardown does not reach, so it is not the control,
# and without a control the capture is void.
mv "$STATE/data/canary-control.txt" "$STATE/selftest-control-target"
ln -s "$STATE/selftest-control-target" "$STATE/data/canary-control.txt"
rc=0
"$here/evidence" >/dev/null 2>"$STATE/selftest-evidence.err" || rc=$?
rm "$STATE/data/canary-control.txt"
mv "$STATE/selftest-control-target" "$STATE/data/canary-control.txt" # before anything can fail
[ "$rc" -ne 0 ] || fail "evidence accepted a positive control that is a symlink to a file outside .state/data"
grep --quiet 'did not find its positive control' "$STATE/selftest-evidence.err" ||
  fail "evidence failed on the symlinked control for another reason: $(tail -n 1 "$STATE/selftest-evidence.err")"
# The same through a hard link: a second name for the control outside the scanned paths.
ln "$STATE/data/canary-control.txt" "$STATE/selftest-control-alias"
rc=0
"$here/evidence" >/dev/null 2>"$STATE/selftest-evidence.err" || rc=$?
rm "$STATE/selftest-control-alias" # before anything can fail
[ "$rc" -ne 0 ] || fail "evidence accepted a positive control that has a second name outside .state/data"
grep --quiet 'did not find its positive control' "$STATE/selftest-evidence.err" ||
  fail "evidence failed on the hard-linked control for another reason: $(tail -n 1 "$STATE/selftest-evidence.err")"
rm "$STATE/selftest-evidence.err"
# A managed directory that is a symlink: bundles would be written where teardown does not reach.
mv "$STATE/evidence" "$STATE/selftest-evidence-aside"
ln -s "$STATE/selftest-evidence-aside" "$STATE/evidence"
bundles_before=$(find "$STATE/selftest-evidence-aside" -mindepth 1 -maxdepth 1 | sort)
rc=0
"$here/evidence" >/dev/null 2>&1 || rc=$?
bundles_after=$(find "$STATE/selftest-evidence-aside" -mindepth 1 -maxdepth 1 | sort)
rm "$STATE/evidence"
mv "$STATE/selftest-evidence-aside" "$STATE/evidence" # before anything can fail
[ "$rc" -ne 0 ] || fail "evidence accepted an evidence directory that is a symlink"
[ "$bundles_before" = "$bundles_after" ] || fail "evidence wrote a bundle through a symlinked evidence directory"
# The generated secrets are data, never code: a secrets.env that is a link, or that holds a line
# the fixture did not write, stops every command before it is read.
mv "$STATE/secrets.env" "$STATE/selftest-secrets-aside"
ln -s "$STATE/selftest-secrets-aside" "$STATE/secrets.env"
linked=0
! "$here/evidence" >/dev/null 2>&1 || linked=1
rm "$STATE/secrets.env"
cp "$STATE/selftest-secrets-aside" "$STATE/secrets.env"
printf 'EXTRA=%s(true)\n' '$' >>"$STATE/secrets.env" # a command substitution, were the file sourced
extra=0
! "$here/evidence" >/dev/null 2>&1 || extra=1
mv "$STATE/selftest-secrets-aside" "$STATE/secrets.env" # before anything can fail
[ "$linked" -eq 0 ] || fail "a symlinked secrets.env was read"
[ "$extra" -eq 0 ] || fail "a secrets.env with a line the fixture never writes was accepted"
# And with a second name, which would keep the secrets past teardown wherever it is.
ln "$STATE/secrets.env" "$STATE/selftest-secrets-alias"
aliased=0
! "$here/evidence" >/dev/null 2>&1 || aliased=1
rm "$STATE/selftest-secrets-alias"
[ "$aliased" -eq 0 ] || fail "a secrets.env with a second name was accepted"
# The other generated credential files likewise: a second name for bao-init.json keeps the root
# token and the unseal key past teardown, and the scan roots never reach the source itself.
ln "$STATE/bao-init.json" "$STATE/selftest-init-alias"
aliased=0
! "$here/evidence" >/dev/null 2>&1 || aliased=1
rm "$STATE/selftest-init-alias"
[ "$aliased" -eq 0 ] || fail "a bao-init.json with a second name was accepted"
# And the injection log, which names snapshots and becomes the bundle's timeline.
ln "$STATE/injections.log" "$STATE/selftest-log-alias"
aliased=0
! "$here/evidence" >/dev/null 2>&1 || aliased=1
rm "$STATE/selftest-log-alias"
[ "$aliased" -eq 0 ] || fail "an injections.log with a second name was accepted"
# Without the manifest commit the bundle cannot be tied to the pins it was captured under.
nogit=0
! GIT_DIR=$STATE/selftest-no-git "$here/evidence" >/dev/null 2>&1 || nogit=1
[ "$nogit" -eq 0 ] || fail "evidence wrote a bundle without the manifest commit"
# The control itself with its canary replaced by another secret: still one hit, no longer the
# control, and without the control the capture is void.
cp "$STATE/data/canary-control.txt" "$STATE/selftest-control-as-planted"
printf 'planted on purpose: %s\n' "$BW_BAO_METADATA_TOKEN" >"$STATE/data/canary-control.txt"
rc=0
"$here/evidence" >/dev/null 2>"$STATE/selftest-evidence.err" || rc=$?
mv "$STATE/selftest-control-as-planted" "$STATE/data/canary-control.txt" # before anything can fail
[ "$rc" -ne 0 ] || fail "evidence accepted a positive control whose canary had been replaced by another secret"
grep --quiet 'did not find its positive control' "$STATE/selftest-evidence.err" ||
  fail "evidence failed on the replaced control for another reason: $(tail -n 1 "$STATE/selftest-evidence.err")"
rm "$STATE/selftest-evidence.err"
# The pattern list thinned after up: a scan against it would pass while a token goes unmatched.
cp "$STATE/scan-patterns.txt" "$STATE/selftest-patterns-aside"
printf 'BWSYNTH-\n' >"$STATE/scan-patterns.txt"
thinned=0
! "$here/evidence" >/dev/null 2>&1 || thinned=1
mv "$STATE/selftest-patterns-aside" "$STATE/scan-patterns.txt" # before anything can fail
[ "$thinned" -eq 0 ] || fail "evidence scanned with a pattern list that was changed after up"
# A secrets.env short of one assignment, as an up interrupted while writing it leaves it, while
# the caller's shell holds that variable: the value must not come from there.
cp "$STATE/secrets.env" "$STATE/selftest-secrets-aside"
grep --invert-match '^BW_CANARY=' "$STATE/selftest-secrets-aside" >"$STATE/secrets.env"
inherited=0
! BW_CANARY=$BW_CANARY "$here/evidence" >/dev/null 2>&1 || inherited=1
mv "$STATE/selftest-secrets-aside" "$STATE/secrets.env" # before anything can fail
[ "$inherited" -eq 0 ] || fail "an incomplete secrets.env was completed from the caller's environment"
# .cache likewise a real directory: through a link the CLIs would be downloaded elsewhere, and
# `down --purge` would remove the link alone.
mv "$CACHE" "$FIXTURES/.selftest-cache-aside"
ln -s "$FIXTURES/.selftest-cache-aside" "$CACHE"
linked=0
! "$here/evidence" >/dev/null 2>&1 || linked=1
rm "$CACHE"
mv "$FIXTURES/.selftest-cache-aside" "$CACHE" # before anything can fail
[ "$linked" -eq 0 ] || fail "a symlinked cache directory was accepted"
# What an interruption leaves, each holding the canary: a dump and two archives under their
# temporary names, one complete and one truncated, a store-restore staging directory, and a
# database under a db-restore scratch name. Each is scanned; the truncated archive marks the
# bundle incomplete, not void; the control's copy in the complete archive is the control still.
cp "$STATE/backups/pg-selftest.dump" "$STATE/backups/pg-selftest.dump.partial.selftest"
cp "$STATE/backups/store-selftest.tgz" "$STATE/backups/store-selftest.tgz.partial.whole"
head --bytes=64 "$STATE/backups/store-selftest.tgz" >"$STATE/backups/store-selftest.tgz.partial.selftest"
mkdir -p "$STATE/store-restore.selftest/data"
cp "$STATE/data/canary-control.txt" "$STATE/store-restore.selftest/data/canary-control.txt"
pg createdb -U bronzeward --maintenance-db=postgres --template=bronzeward bronzeward_previous
rc=0
bundle=$("$here/evidence" 2>"$STATE/selftest-evidence.err") || rc=$?
rm -r "$STATE/backups/pg-selftest.dump.partial.selftest" "$STATE/backups/store-selftest.tgz.partial.whole" \
  "$STATE/backups/store-selftest.tgz.partial.selftest" "$STATE/store-restore.selftest"
pg dropdb --force -U bronzeward --maintenance-db=postgres bronzeward_previous # before anything can fail
[ "$rc" -eq 0 ] || fail "evidence aborted on what an interruption leaves: $(tail -n 1 "$STATE/selftest-evidence.err")"
grep --quiet --fixed-strings "$bundle/backups/pg-selftest.dump.partial.selftest.sql" "$bundle/leak-scan.txt" ||
  fail "leak scan missed the canary in a dump left under its temporary name"
grep --quiet --fixed-strings 'store-selftest.tgz.partial.selftest' "$bundle/unavailable.txt" ||
  fail "a truncated archive left under its temporary name was not named as incompletely scanned"
! grep --quiet --fixed-strings '/backups/store-selftest.tgz.partial.whole/data/canary-control.txt' "$STATE/selftest-evidence.err" ||
  fail "leak scan reported the control's copy from a complete archive under its temporary name as a leak"
grep --quiet --line-regexp --fixed-strings "1 $STATE/store-restore.selftest/data/canary-control.txt" "$bundle/leak-scan.txt" ||
  fail "leak scan skipped a store-restore staging directory, or excused the control's copy in it"
grep --quiet --fixed-strings "$bundle/postgres-bronzeward_previous.sql" "$bundle/leak-scan.txt" ||
  fail "leak scan missed the canary in a database left by an interrupted db-restore"
rm "$STATE/selftest-evidence.err"
# The live store gone, as a store-restore killed between its two renames leaves it: aside under
# the staging directory, where the control still counts as found, and the capture goes on.
mkdir "$STATE/store-restore.selftest"
mv "$STATE/data" "$STATE/store-restore.selftest/previous"
rc=0
bundle=$("$here/evidence" 2>"$STATE/selftest-evidence.err") || rc=$?
mv "$STATE/store-restore.selftest/previous" "$STATE/data" # before anything can fail
rm -r "$STATE/store-restore.selftest"
[ "$rc" -eq 0 ] || fail "evidence aborted with the live store directory moved aside: $(tail -n 1 "$STATE/selftest-evidence.err")"
grep --quiet --fixed-strings "$STATE/data is absent" "$bundle/unavailable.txt" ||
  fail "evidence did not name the absent live store directory"
! grep --quiet --fixed-strings "$STATE/store-restore.selftest/previous/canary-control.txt" "$STATE/selftest-evidence.err" ||
  fail "leak scan reported the control moved aside by an interrupted store-restore as a leak"
rm "$STATE/selftest-evidence.err"
# A staging directory that is a symlink to elsewhere: the walk would follow it out of .state, and a
# copy of the control planted at the far end would be excused.
mkdir -p "$STATE/selftest-outside-staging/previous"
cp "$STATE/data/canary-control.txt" "$STATE/selftest-outside-staging/previous/canary-control.txt"
ln -s "$STATE/selftest-outside-staging" "$STATE/store-restore.selftest-link"
linked=0
! "$here/evidence" >/dev/null 2>&1 || linked=1
rm "$STATE/store-restore.selftest-link"
rm -r "$STATE/selftest-outside-staging"
[ "$linked" -eq 0 ] || fail "evidence scanned through a symlinked store-restore staging directory"
# A store archive with a second name outside .state keeps the canary where teardown does not reach:
# the control's copy expanded from it is no longer excused.
ln "$STATE/backups/store-selftest.tgz" "$STATE/selftest-archive-alias"
rc=0
"$here/evidence" >/dev/null 2>"$STATE/selftest-evidence.err" || rc=$?
rm "$STATE/selftest-archive-alias" # before anything can fail
[ "$rc" -eq 0 ] || fail "evidence aborted on a hard-linked store archive: $(tail -n 1 "$STATE/selftest-evidence.err")"
grep --quiet --fixed-strings '/backups/store-selftest/data/canary-control.txt' "$STATE/selftest-evidence.err" ||
  fail "leak scan excused the control's copy from a store archive that has a second name outside .state"
rm "$STATE/selftest-evidence.err"
printf 'token=%s\n' "$BW_BAO_METADATA_TOKEN" >"$STATE/data/selftest-token-leak"
printf 'plain=%s\n' "$BW_CANARY" >"$STATE/backups/selftest-plain-backup"
# A leaking file whose name holds a newline: the report is one entry per line, so the name must
# be written in a form that stays on one.
printf 'broken=%s\n' "$BW_CANARY" >"$STATE/data/"$'selftest-line\nbreak'
# Two inputs find would mishandle if passed along as they are: a file reached only through a
# symlink, and a relative scan path whose name find reads as an action.
mkdir -p "$STATE/selftest-outside"
printf 'linked=%s\n' "$BW_CANARY" >"$STATE/selftest-outside/linked-target"
ln -sf "$STATE/selftest-outside/linked-target" "$STATE/data/selftest-link"
printf 'dashed=%s\n' "$BW_CANARY" >"$STATE/selftest-outside/-delete"
# And a leak in a file that only shares the positive control's name: it is not the control.
mkdir -p "$STATE/selftest-outside/-delete.d"
printf 'imposter=%s\n' "$BW_CANARY" >"$STATE/selftest-outside/-delete.d/canary-control.txt"
# A secret in a file name, over benign content.
printf 'nothing to see\n' >"$STATE/selftest-outside/-delete.d/named-$BW_BAO_METADATA_TOKEN"
# And one with a secret in its name and another in its content: one file, one entry.
printf 'both=%s\n' "$BW_CANARY" >"$STATE/selftest-outside/-delete.d/both-$BW_BAO_METADATA_TOKEN"
# And in the name of a scan path that is itself a symlink, to an empty directory: resolving the
# path before the scan would lose the only place the secret is in.
mkdir "$STATE/selftest-outside/empty"
ln -s empty "$STATE/selftest-outside/link-$BW_BAO_METADATA_TOKEN"
# And in the text of a symlink alone: a benign name, benign content at the other end, and the secret
# in the path the link stores. That path lies outside everything scanned.
mkdir "$STATE/selftest-target-$BW_BAO_METADATA_TOKEN"
printf 'nothing to see\n' >"$STATE/selftest-target-$BW_BAO_METADATA_TOKEN/file"
ln -s "$STATE/selftest-target-$BW_BAO_METADATA_TOKEN/file" "$STATE/data/selftest-textlink"
# A client private key from the generated talosconfig, which the secrets bundle does not hold.
awk '$1 == "key:" {print "client-key=" $2}' "$TALOSCONFIG" >"$STATE/data/selftest-client-key-leak"
# An untracked symlink: the bundle would carry the target's name, not the bytes that ran.
ln -s /etc/hostname "$FIXTURES/.selftest-untracked-link"
went=0
"$here/evidence" >/dev/null 2>&1 && went=1
rm "$FIXTURES/.selftest-untracked-link"
[ "$went" -eq 0 ] || fail "evidence recorded an untracked symlink as the file that ran"
# A tracked file replaced by a symlink: the diff would carry the target's name, and what the
# scripts read is at the far end.
mv "$FIXTURES/README.md" "$FIXTURES/.selftest-readme-aside"
ln -s "$FIXTURES/.selftest-readme-aside" "$FIXTURES/README.md"
went=0
"$here/evidence" >/dev/null 2>&1 && went=1
rm "$FIXTURES/README.md"
mv "$FIXTURES/.selftest-readme-aside" "$FIXTURES/README.md" # before anything can fail
[ "$went" -eq 0 ] || fail "evidence recorded a tracked file replaced by a symlink as the file that ran"
# An untracked file hidden by an excludes file outside the repository: neither the status nor the
# listing sees it, and the bundle would claim to say what ran without it. With a secret in its
# name, which the refusal must not print.
printf '.selftest-hidden-%s\n' "$BW_BAO_METADATA_TOKEN" >"$FIXTURES/.selftest-excludes"
printf '[core]\n\texcludesFile = %s\n' "$FIXTURES/.selftest-excludes" >"$FIXTURES/.selftest-gitconfig"
: >"$FIXTURES/.selftest-hidden-$BW_BAO_METADATA_TOKEN"
went=0
GIT_CONFIG_GLOBAL=$FIXTURES/.selftest-gitconfig "$here/evidence" >/dev/null 2>"$STATE/selftest-evidence.err" && went=1
rm "$FIXTURES/.selftest-excludes" "$FIXTURES/.selftest-gitconfig" "$FIXTURES/.selftest-hidden-$BW_BAO_METADATA_TOKEN"
[ "$went" -eq 0 ] || fail "evidence captured while an untracked file under fixtures/ was hidden by an excludes file outside the repository"
grep --quiet 'hidden from git by an excludes file' "$STATE/selftest-evidence.err" ||
  fail "evidence failed on the hidden file for another reason: $(grep --invert-match --fixed-strings --file="$STATE/scan-patterns.txt" "$STATE/selftest-evidence.err" | tail -n 1)"
! grep --quiet --fixed-strings --file="$STATE/scan-patterns.txt" "$STATE/selftest-evidence.err" ||
  fail "evidence printed the secret-bearing name of a hidden file"
# An untracked directory git cannot open, named with a secret: git and find warn on stderr with
# the name as it is, and the listing is incomplete. Then the directory of bundles writable but not
# readable: the captures that ended before their scan cannot be listed, and this one must not
# report a scan. root opens both, so there neither case can be built.
if [ "$(id -u)" -ne 0 ]; then
  mkdir "$FIXTURES/.selftest-closed-$BW_BAO_METADATA_TOKEN"
  chmod 000 "$FIXTURES/.selftest-closed-$BW_BAO_METADATA_TOKEN"
  went=0
  "$here/evidence" >/dev/null 2>"$STATE/selftest-evidence.err" && went=1
  chmod 700 "$FIXTURES/.selftest-closed-$BW_BAO_METADATA_TOKEN" # before anything can fail
  rmdir "$FIXTURES/.selftest-closed-$BW_BAO_METADATA_TOKEN"
  [ "$went" -eq 0 ] || fail "evidence captured while git could not open an untracked directory under fixtures/"
  grep --quiet 'warned while listing fixtures/' "$STATE/selftest-evidence.err" ||
    fail "evidence failed on the closed directory for another reason: $(grep --invert-match --fixed-strings --file="$STATE/scan-patterns.txt" "$STATE/selftest-evidence.err" | tail -n 1)"
  ! grep --quiet --fixed-strings --file="$STATE/scan-patterns.txt" "$STATE/selftest-evidence.err" ||
    fail "evidence printed the secret-bearing name of a directory git could not open"
  chmod 300 "$STATE/evidence"
  went=0
  "$here/evidence" >/dev/null 2>&1 && went=1
  chmod 700 "$STATE/evidence" # before anything can fail
  [ "$went" -eq 0 ] || fail "evidence reported a scan while the earlier captures could not be listed"
else
  say "skipped as root: the closed-directory and the unreadable-bundle-directory cases"
fi
rc=0
# An untracked file in the checkout: the commit alone does not say what ran, and the bundle must
# carry the file's content, not its name alone.
# What a capture ended before its leak scan leaves: a bundle still marked incomplete, holding
# material nothing scanned. The next capture scans it as one more root.
mkdir "$STATE/evidence/selftest-interrupted"
: >"$STATE/evidence/selftest-interrupted/.incomplete"
printf 'left=%s\n' "$BW_CANARY" >"$STATE/evidence/selftest-interrupted/leftover.txt"
# Two control copies inside that bundle, each as an expanded store snapshot with the archive's
# digest recorded next to it: one whose digest is the archive's now is the control's copy, and one
# whose digest is not was expanded from some other archive and is a leak, exact content or not.
mkdir -p "$STATE/evidence/selftest-interrupted/backups/store-selftest-kept/data" \
  "$STATE/evidence/selftest-interrupted/backups/store-selftest-stale/data"
cp "$STATE/data/canary-control.txt" "$STATE/evidence/selftest-interrupted/backups/store-selftest-kept/data/"
cp "$STATE/data/canary-control.txt" "$STATE/evidence/selftest-interrupted/backups/store-selftest-stale/data/"
cp "$STATE/backups/store-selftest.tgz" "$STATE/backups/store-selftest-kept.tgz"
cp "$STATE/backups/store-selftest.tgz" "$STATE/backups/store-selftest-stale.tgz"
sha256sum "$STATE/backups/store-selftest-kept.tgz" | cut -d' ' -f1 >"$STATE/evidence/selftest-interrupted/backups/store-selftest-kept.sha256"
printf '%064d\n' 0 >"$STATE/evidence/selftest-interrupted/backups/store-selftest-stale.sha256"
printf 'selftest-untracked-content %s\n' "$$" >"$FIXTURES/.selftest-untracked"
# And one that is not text: carried as a binary patch, not as "differ".
printf 'selftest-binary\0%s\n' "$$" >"$FIXTURES/.selftest-untracked.bin"
# The live store given as an extra path as well: it is a root already, and a file under it must
# still be counted once. Under a diff helper that prints nothing: the bundle must carry git's own
# patch, not the helper's silence.
bundle=$(cd "$STATE/selftest-outside" &&
  GIT_EXTERNAL_DIFF=/bin/true "$here/evidence" -delete -delete.d "link-$BW_BAO_METADATA_TOKEN" "$STATE/data" 2>"$STATE/selftest-evidence.err") || rc=$?
# The sibling's marks, read before it is removed: scanned once, by this capture, and named as such.
sibling_marked=0
[ ! -e "$STATE/evidence/selftest-interrupted/.incomplete" ] || sibling_marked=1
sibling_scanned_by=$(cat "$STATE/evidence/selftest-interrupted/scanned-by.txt" 2>/dev/null || printf none)
rm -r "$STATE/data/selftest-textlink" "$STATE/selftest-target-$BW_BAO_METADATA_TOKEN" "$FIXTURES/.selftest-untracked" "$FIXTURES/.selftest-untracked.bin" \
  "$STATE/evidence/selftest-interrupted" "$STATE/backups/store-selftest-kept.tgz" "$STATE/backups/store-selftest-stale.tgz"
[ "$rc" -eq 0 ] || fail "evidence aborted on a healthy fixture: $(cat "$STATE/selftest-evidence.err")"
[ ! -e "$bundle/.incomplete" ] || fail "a completed capture left its bundle marked incomplete"
grep --quiet --fixed-strings "$STATE/evidence/selftest-interrupted/leftover.txt" "$bundle/leak-scan.txt" ||
  fail "leak scan skipped what a capture that ended before its scan left behind"
[ "$sibling_marked" -eq 0 ] && [ "$sibling_scanned_by" = "$bundle" ] ||
  fail "the capture that scanned an earlier incomplete bundle did not mark it as scanned by this bundle (marked: $sibling_marked, scanned by: $sibling_scanned_by)"
# The report on stderr, not leak-scan.txt: the file lists every hit, the control's copies included,
# and the report is what leaves the control out.
grep --quiet --fixed-strings '/evidence/selftest-interrupted/backups/store-selftest-stale/data/canary-control.txt' "$STATE/selftest-evidence.err" ||
  fail "leak scan excused a control copy in an incomplete sibling whose recorded archive digest is not the archive's now"
! grep --quiet --fixed-strings '/evidence/selftest-interrupted/backups/store-selftest-kept/data/canary-control.txt' "$STATE/selftest-evidence.err" ||
  fail "leak scan reported a control copy in an incomplete sibling whose recorded archive digest is the archive's"
[ -z "$(sort "$bundle/leak-scan.txt" | uniq --repeated)" ] || fail "leak scan reported a file twice: for a scan path under a root it has anyway, or for a secret in its name and another in its content"
grep --quiet 'differs from it' "$bundle/versions.txt" || fail "versions.txt does not say fixtures/ differs from the commit while an untracked file is there"
grep --quiet "^created at      $(git -C "$FIXTURES" rev-parse HEAD)" "$bundle/versions.txt" ||
  fail "versions.txt does not name the commit the fixture was created at"
grep --quiet --fixed-strings "+selftest-untracked-content $$" "$bundle/fixtures-diff.txt" ||
  fail "fixtures-diff.txt does not carry the content of an untracked file"
grep --quiet '^GIT binary patch$' "$bundle/fixtures-diff.txt" ||
  fail "fixtures-diff.txt does not carry the content of an untracked file that is not text"
! grep --quiet '^Binary files .* differ$' "$bundle/fixtures-diff.txt" ||
  fail "fixtures-diff.txt only says that an untracked file that is not text differs"
# Relative scan paths are made absolute from the working directory; only the tail is compared, so
# the assertion does not depend on how the checkout path is spelled.
grep --quiet --fixed-strings "/.state/selftest-outside/-delete.d/canary-control.txt" "$STATE/selftest-evidence.err" ||
  fail "leak scan took a file named like its positive control for the control"
[ "$(grep --count 'a path whose name holds secret material' "$bundle/leak-scan.txt")" -eq 3 ] ||
  fail "leak scan did not report exactly the three secret-bearing names: a file, a file that also leaks in its content, and a scan path that is a symlink"
# The control's copy inside the expanded store snapshot is the control too, whatever characters the
# checkout path holds.
! grep --quiet --fixed-strings '/backups/store-selftest/data/canary-control.txt' "$STATE/selftest-evidence.err" ||
  fail "leak scan reported the positive control's copy in a store snapshot as a leak"
! grep --quiet --fixed-strings --file="$STATE/scan-patterns.txt" "$bundle/leak-scan.txt" "$STATE/selftest-evidence.err" ||
  fail "the leak scan wrote a secret into its own report"
rm "$STATE/selftest-evidence.err"
grep --quiet --fixed-strings "$STATE/data/selftest-client-key-leak" "$bundle/leak-scan.txt" ||
  fail "leak scan missed a client private key from the talosconfig"
rm "$STATE/data/selftest-client-key-leak"
grep --quiet --fixed-strings "$STATE/data/selftest-link" "$bundle/leak-scan.txt" || fail "leak scan skipped a symlinked file"
grep --quiet --line-regexp --fixed-strings "1 $STATE/data/selftest-textlink" "$bundle/leak-scan.txt" ||
  fail "leak scan missed a secret held only in the target path of a symlink"
grep --quiet --extended-regexp '^[0-9]+ .*/\.state/selftest-outside/-delete$' "$bundle/leak-scan.txt" ||
  fail "leak scan mishandled a scan path named like a find action"
rm -r "$STATE/selftest-outside" "$STATE/data/selftest-link"
grep --quiet --fixed-strings "$STATE/data/selftest-token-leak" "$bundle/leak-scan.txt" || fail "leak scan missed the OpenBao metadata token"
grep --quiet --fixed-strings "$STATE/backups/selftest-plain-backup" "$bundle/leak-scan.txt" ||
  fail "leak scan does not cover .state/backups as written (OpenBao snapshots live there)"
rm "$STATE/data/selftest-token-leak" "$STATE/backups/selftest-plain-backup" "$STATE/data/"$'selftest-line\nbreak'
grep --quiet --fixed-strings 'selftest-line\nbreak' "$bundle/leak-scan.txt" ||
  fail "leak scan did not report the file whose name holds a newline, or not in a quoted form"
! grep --quiet --invert-match --extended-regexp '^[0-9]+ ' "$bundle/leak-scan.txt" ||
  fail "the leak report holds a line that is not an entry: a name was written across lines"
jq -es 'any(.[]; .transit_key == "bw-artifact" and .latest >= 1)' "$bundle/openbao-metadata.jsonl" >/dev/null ||
  fail "OpenBao metadata does not list the Transit key"
grep --quiet '^reachable' "$bundle/openbao-client-view.txt" || fail "evidence says clients cannot reach a healthy openbao"
[ ! -e "$bundle/unavailable.txt" ] || fail "evidence reports missing sources on a healthy fixture: $(cat "$bundle/unavailable.txt")"
grep --quiet --fixed-strings "$bundle/postgres.sql" "$bundle/leak-scan.txt" || fail "leak scan missed the canary in the database dump"
grep --quiet --fixed-strings "$bundle/backups/pg-selftest.dump.sql" "$bundle/leak-scan.txt" || fail "leak scan missed the canary in the database backup"
# The canary was committed, so the server's own files hold it: in the write-ahead log at the least.
[ -d "$bundle/postgres-data/pg_wal" ] || fail "evidence did not copy the PostgreSQL data directory"
grep --quiet --fixed-strings "$bundle/postgres-data/" "$bundle/leak-scan.txt" || fail "leak scan missed the canary in what PostgreSQL wrote to disk"
! grep --quiet --fixed-strings "$bundle/logs/" "$bundle/leak-scan.txt" || fail "a container log contains synthetic secret material"
ok "evidence bundle complete under a silent diff helper and names the creating commit, refuses a symlink in the tree, withholds a hidden file's name and a closed directory's; leak scan finds the planted canary and token, holds a sibling's control copy to its archive's digest, nothing in the logs"

if [ "$keep" != --keep ]; then
  # up marks the state directory before it creates the cluster and clears the mark once the
  # records are published; a mark still there would have down keep .state as uncertain.
  [ ! -e "$STATE/down-node-volumes-incomplete" ] || fail "up left its unrecorded-cluster marker in .state"
  # The record of node volumes is what down removes by name: a link there is refused, before
  # anything is removed.
  mv "$STATE/down-node-volumes" "$STATE/selftest-record-aside"
  ln -s "$STATE/selftest-record-aside" "$STATE/down-node-volumes"
  # And the marker down writes when the node volumes are not all known, which it does before the
  # record is refused: through a link it would truncate someone else's file.
  printf 'keep\n' >"$FIXTURES/.selftest-marker-target"
  ln -s "$FIXTURES/.selftest-marker-target" "$STATE/down-node-volumes-incomplete"
  went=0
  "$here/down" >/dev/null 2>&1 && went=1
  kept=$(cat "$FIXTURES/.selftest-marker-target")
  rm -f "$FIXTURES/.selftest-marker-target" "$STATE/down-node-volumes-incomplete"
  if [ "$went" -eq 1 ] || [ ! -d "$STATE" ] || [ "$(docker inspect --format '{{.State.Running}}' "$PG" 2>/dev/null)" != true ]; then
    fail "down read a symlinked node-volume record"
  fi
  [ "$kept" = keep ] || fail "down wrote its incomplete-volumes marker through a link"
  rm "$STATE/down-node-volumes"
  mv "$STATE/selftest-record-aside" "$STATE/down-node-volumes"
  # A hard link is no symlink and is a regular file; it is a second name all the same.
  ln "$STATE/down-node-volumes" "$STATE/selftest-record-alias"
  went=0
  "$here/down" >/dev/null 2>&1 && went=1
  rm -f "$STATE/selftest-record-alias"
  if [ "$went" -eq 1 ] || [ ! -d "$STATE" ] || [ "$(docker inspect --format '{{.State.Running}}' "$PG" 2>/dev/null)" != true ]; then
    fail "down read a node-volume record that has a second name"
  fi
  # A marker that is a dangling symlink: `-e` reads it as absent, and the uncertainty an earlier
  # run recorded would be dropped with it.
  ln -s "$FIXTURES/.selftest-no-such-marker" "$STATE/down-node-volumes-incomplete"
  went=0
  "$here/down" >/dev/null 2>&1 && went=1
  rm "$STATE/down-node-volumes-incomplete"
  if [ "$went" -eq 1 ] || [ ! -d "$STATE" ] || [ "$(docker inspect --format '{{.State.Running}}' "$PG" 2>/dev/null)" != true ]; then
    fail "down took a dangling symlinked marker for no marker"
  fi
  # And the record's content: each name is held against what Docker says of a Talos node volume.
  # A name that is no anonymous volume's, then a volume of such a name that carries a label.
  cp "$STATE/down-node-volumes" "$STATE/selftest-record-copy"
  printf 'selftest-not-a-volume\n' >>"$STATE/down-node-volumes"
  went=0
  "$here/down" >/dev/null 2>&1 && went=1
  if [ "$went" -eq 1 ] || [ ! -d "$STATE" ] || [ "$(docker inspect --format '{{.State.Running}}' "$PG" 2>/dev/null)" != true ]; then
    fail "down accepted a recorded name that is no anonymous volume's"
  fi
  selftest_volume=$(printf '%064d' 7)
  docker volume create --label bronzeward.selftest=1 "$selftest_volume" >/dev/null || fail "cannot create a volume for the test"
  cat "$STATE/selftest-record-copy" >"$STATE/down-node-volumes"
  printf '%s\n' "$selftest_volume" >>"$STATE/down-node-volumes"
  went=0
  "$here/down" >/dev/null 2>&1 && went=1
  labelled=$(docker volume ls --quiet --filter "name=^${selftest_volume}$")
  docker volume rm "$selftest_volume" >/dev/null 2>&1 || true # gone already in the failing case
  mv "$STATE/selftest-record-copy" "$STATE/down-node-volumes" # before anything can fail
  if [ "$went" -eq 1 ] || [ -z "$labelled" ] || [ ! -d "$STATE" ] || [ "$(docker inspect --format '{{.State.Running}}' "$PG" 2>/dev/null)" != true ]; then
    fail "down removed, or did not refuse, a recorded volume that carries a label"
  fi
  # The Talos label alone: a container that only carries the cluster name is not one up created,
  # and down must not remove it with the fixture's own.
  docker create --quiet --name "$FIXTURE_NAME-selftest-impostor" --label "talos.cluster.name=$FIXTURE_NAME" \
    --network none "$POSTGRES_IMAGE" true >/dev/null || fail "cannot create a container for the test"
  went=0
  "$here/down" >/dev/null 2>&1 && went=1
  impostor=$(docker ps --all --quiet --filter "name=^${FIXTURE_NAME}-selftest-impostor$")
  docker rm --force --volumes "$FIXTURE_NAME-selftest-impostor" >/dev/null 2>&1 || true # gone already in the failing case
  if [ "$went" -eq 1 ] || [ -z "$impostor" ] || [ ! -d "$STATE" ] || [ "$(docker inspect --format '{{.State.Running}}' "$PG" 2>/dev/null)" != true ]; then
    fail "down removed, or did not refuse, a container that only carries the Talos label"
  fi
  # And without the record, as an up interrupted right after creating the cluster leaves it: the
  # label is all there is, and removing by it is for --adopt.
  mv "$STATE/down-node-containers" "$STATE/selftest-containers-aside"
  went=0
  "$here/down" >/dev/null 2>&1 && went=1
  mv "$STATE/selftest-containers-aside" "$STATE/down-node-containers" # before anything can fail
  if [ "$went" -eq 1 ] || [ ! -d "$STATE" ] || [ "$(docker inspect --format '{{.State.Running}}' "$PG" 2>/dev/null)" != true ] ||
    [ "$(docker ps --all --quiet --filter "label=talos.cluster.name=$FIXTURE_NAME" | wc -l)" -ne 2 ]; then
    fail "down removed by the Talos label alone, without the record of which containers up created"
  fi
  # The Compose volumes carry the project label, which any Compose run of that name puts there;
  # down holds each to the run up labelled it with and recorded. Without the record, and with a
  # record naming another run, down refuses.
  mv "$STATE/down-compose-volumes" "$STATE/selftest-compose-volumes-aside"
  went=0
  "$here/down" >/dev/null 2>&1 && went=1
  awk '{print $1, "BWSYNTH-selftest-not-this-run"}' "$STATE/selftest-compose-volumes-aside" >"$STATE/down-compose-volumes"
  stale=0
  "$here/down" >/dev/null 2>&1 && stale=1
  # With a record, --adopt changes nothing: a volume the record does not name is someone's.
  adopted=0
  "$here/down" --adopt >/dev/null 2>&1 && adopted=1
  mv "$STATE/selftest-compose-volumes-aside" "$STATE/down-compose-volumes" # before anything can fail
  if [ "$went" -eq 1 ] || [ "$stale" -eq 1 ] || [ "$adopted" -eq 1 ] || [ ! -d "$STATE" ] || [ "$(docker inspect --format '{{.State.Running}}' "$PG" 2>/dev/null)" != true ] ||
    [ -z "$(docker volume ls --quiet --filter "name=^${FIXTURE_NAME}_postgres-data$")" ]; then
    fail "down removed the Compose volumes by the project label alone, without the record of the ones up created or, with --adopt, against it"
  fi
  # A network with the label, which down removes by label just as it does containers.
  docker network create --label "talos.cluster.name=$FIXTURE_NAME" "$FIXTURE_NAME-selftest-net" >/dev/null || fail "cannot create a network for the test"
  went=0
  "$here/down" >/dev/null 2>&1 && went=1
  impostor=$(docker network ls --quiet --filter "name=^${FIXTURE_NAME}-selftest-net$")
  docker network rm "$FIXTURE_NAME-selftest-net" >/dev/null 2>&1 || true # gone already in the failing case
  if [ "$went" -eq 1 ] || [ -z "$impostor" ] || [ ! -d "$STATE" ] || [ "$(docker inspect --format '{{.State.Running}}' "$PG" 2>/dev/null)" != true ]; then
    fail "down removed, or did not refuse, a network that only carries the Talos label"
  fi
  # And one with the Compose project's labels, which are only a name: down holds the labelled
  # network to the ID up recorded.
  docker network create --label "com.docker.compose.project=$FIXTURE_NAME" --label "com.docker.compose.network=default" \
    "$FIXTURE_NAME-selftest-cnet" >/dev/null || fail "cannot create a network for the test"
  went=0
  "$here/down" >/dev/null 2>&1 && went=1
  impostor=$(docker network ls --quiet --filter "name=^${FIXTURE_NAME}-selftest-cnet$")
  docker network rm "$FIXTURE_NAME-selftest-cnet" >/dev/null 2>&1 || true # gone already in the failing case
  if [ "$went" -eq 1 ] || [ -z "$impostor" ] || [ ! -d "$STATE" ] || [ "$(docker inspect --format '{{.State.Running}}' "$PG" 2>/dev/null)" != true ]; then
    fail "down removed, or did not refuse, a network that only carries the Compose labels"
  fi
  # A snapshot with a second name outside .state would keep its content past the teardown; so
  # would one whose name in .state/backups starts with a dot, which a glob does not list.
  ln "$STATE/backups/pg-selftest.dump" "$FIXTURES/.selftest-backup-alias"
  went=0
  "$here/down" >/dev/null 2>&1 && went=1
  rm -f "$FIXTURES/.selftest-backup-alias"
  if [ "$went" -eq 1 ] || [ ! -d "$STATE" ] || [ "$(docker inspect --format '{{.State.Running}}' "$PG" 2>/dev/null)" != true ]; then
    fail "down tore down while a snapshot had a second name outside .state"
  fi
  ln -s "$FIXTURES/versions.env" "$STATE/backups/.selftest-dotlink"
  went=0
  "$here/down" >/dev/null 2>&1 && went=1
  rm -f "$STATE/backups/.selftest-dotlink"
  if [ "$went" -eq 1 ] || [ ! -d "$STATE" ] || [ "$(docker inspect --format '{{.State.Running}}' "$PG" 2>/dev/null)" != true ]; then
    fail "down tore down while a dot-named link sat in .state/backups"
  fi
  # The Talos state directory through a link: `talosctl cluster destroy` would act on the state
  # at the far end.
  mv "$STATE/talos" "$FIXTURES/.selftest-talos-aside"
  ln -s "$FIXTURES/.selftest-talos-aside" "$STATE/talos"
  went=0
  "$here/down" >/dev/null 2>&1 && went=1
  rm "$STATE/talos"
  mv "$FIXTURES/.selftest-talos-aside" "$STATE/talos" # before anything can fail
  if [ "$went" -eq 1 ] || [ ! -d "$STATE" ] || [ "$(docker inspect --format '{{.State.Running}}' "$PG" 2>/dev/null)" != true ]; then
    fail "down followed a symlinked Talos state directory"
  fi
  # The cluster state file with a second name: destroy would act on what it describes while the
  # other name survives.
  ln "$STATE/talos/$FIXTURE_NAME/state.yaml" "$FIXTURES/.selftest-state-alias"
  went=0
  "$here/down" >/dev/null 2>&1 && went=1
  rm -f "$FIXTURES/.selftest-state-alias"
  if [ "$went" -eq 1 ] || [ ! -d "$STATE" ] || [ "$(docker inspect --format '{{.State.Running}}' "$PG" 2>/dev/null)" != true ]; then
    fail "down tore down while the Talos cluster state file had a second name"
  fi
  # A record whose last name lacks its newline, as an append cut short leaves it: read whole,
  # not appended onto.
  printf '%s' "$(cat "$STATE/down-node-volumes")" >"$STATE/down-node-volumes"
  "$here/down" || fail "down reported leftovers"
  # With the fixture gone, a volume under a Compose name without the label is someone's data that
  # `compose down --volumes` would remove: down refuses, whatever else is there.
  docker volume create "${FIXTURE_NAME}_openbao-data" >/dev/null || fail "cannot create a volume for the test"
  went=0
  "$here/down" >/dev/null 2>&1 && went=1
  stranger=$(docker volume ls --quiet --filter "name=^${FIXTURE_NAME}_openbao-data$")
  docker volume rm "${FIXTURE_NAME}_openbao-data" >/dev/null 2>&1 || true # gone already in the failing case
  [ "$went" -eq 0 ] && [ -n "$stranger" ] || fail "down removed, or did not refuse, a volume under a Compose name that is not the fixture's"
  # down looks for what it can name. A volume no label or record points at, such as the anonymous
  # one Docker makes for the claim container, only shows up as a difference on the whole daemon.
  volumes_after=$(docker volume ls --quiet | sort) || fail "cannot list the Docker volumes"
  new_volumes=$(comm -13 <(printf '%s\n' "$volumes_before") <(printf '%s\n' "$volumes_after"))
  [ -z "$new_volumes" ] || fail "volumes exist that did not before up (this run's, unless something else used the daemon meanwhile): $(tr '\n' ' ' <<<"$new_volumes")"
  ok "down refuses a linked node-volume record, writes no marker through a link, holds every recorded name, every Talos-labelled container and network and the Compose-labelled network against the records and refuses by label alone, holds the Compose volumes to the run recorded with and without --adopt, refuses a snapshot with a second name, a dot-named link among the snapshots, a linked Talos state directory and a cluster state file with a second name, reads a record cut short of its last newline, then leaves nothing behind and refuses a stranger's volume under a Compose name, and no volume exists that did not before up"
  # A .state that is a symlink, here a dangling one that `[ -e ]` reads as absent, must stop every
  # command before it reads or writes through the link.
  ln -s "$FIXTURES/.selftest-no-such-dir" "$STATE"
  for cmd in up evidence down; do
    if "$here/$cmd" >/dev/null 2>&1; then
      rm -f -- "$STATE"
      fail "$cmd accepted a symlinked state directory"
    fi
  done
  rm -f -- "$STATE"
  [ ! -e "$FIXTURES/.selftest-no-such-dir" ] || fail "a command wrote through the symlinked state directory"
  ok "a symlinked state directory is refused by up, evidence and down"
fi
say "selftest PASSED: $passed checks"
