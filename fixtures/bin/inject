#!/usr/bin/env bash
# Failure injection and backup/restore primitives. Every action is logged to .state/injections.log
# with a UTC timestamp, once when it begins and once with its outcome, so an experiment's timeline
# can be reconstructed.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../lib.sh
. "$(dirname "$0")/../lib.sh"

usage() {
  cat >&2 <<'EOF'
usage: inject <action> [args]

  targets: postgres | openbao | controlplane | worker

  kill <target>                 SIGKILL the container (crash, no shutdown hooks)
  start <target>                start it again and wait until it answers; openbao comes back
                                sealed and is unsealed
  pause <target>                freeze every process (hung peer, connections stay open)
  unpause <target>
  netsplit <target>             detach from its network (unreachable, process keeps running)
  netjoin <target>              reattach with the same address

  db-snapshot <name>            pg_dump of the bronzeward database to .state/backups
  db-restore <name>             drop the database and restore that dump
  bao-snapshot <name>           OpenBao Raft snapshot to .state/backups
  bao-restore <name>            force-restore that snapshot
  store-snapshot <name>         tar of .state/data (SQLite files, age/SOPS stores)
  store-restore <name>          replace .state/data with that tar

  bao-soft-delete <kv-path> <version>    reversible KV v2 delete
  bao-destroy <kv-path> <version>        permanent KV v2 version destruction
  bao-delete-key <transit-key>           permanent loss of a Transit key
EOF
  exit 2
}

[ $# -ge 1 ] || usage
need docker curl jq tar mktemp timeout stat
need_state
action=$1
shift
# The log below holds one record per line, the action and its arguments included: a word with a
# newline in it, or any other control character, would write records of its own. Refused before
# anything is recorded, as is an action that does not exist.
for arg in "$action" "$@"; do
  [[ $arg != *[[:cntrl:]]* ]] || die "the action and its arguments must not hold control characters"
done
unset arg

network_of() {
  case $1 in
    postgres | openbao) printf '%s_default\n' "$FIXTURE_NAME" ;;
    *) printf '%s\n' "$FIXTURE_NAME" ;;
  esac
}

# network_own <target> <network>: the network under the fixture's name must be the fixture's own
# before a container is connected to it. Once every container is off it, the name is free for
# anyone's network, and a Talos node would be given its fixed address on that one. The Talos
# network is held to the ID bin/up recorded; the Compose network to the project's labels.
network_own() {
  local id labels
  case $1 in
    controlplane | worker)
      id=$(docker network inspect --format '{{.Id}}' "$2") || die "cannot inspect the network $2"
      [ -f "$STATE/down-node-networks" ] ||
        die "no record of the Talos network in $STATE; run fixtures/bin/down --adopt, then up"
      grep --quiet --line-regexp --fixed-strings -- "$id" "$STATE/down-node-networks" ||
        die "the network $2 is not the one bin/up recorded; refusing to touch it"
      ;;
    *)
      labels=$(docker network inspect \
        --format '{{index .Labels "com.docker.compose.project"}}/{{index .Labels "com.docker.compose.network"}}' "$2") ||
        die "cannot inspect the network $2"
      [ "$labels" = "$FIXTURE_NAME/default" ] ||
        die "the network $2 does not carry this fixture's Compose labels; refusing to touch it"
      ;;
  esac
}

bao_http() { # bao_http <method> <api-path> [curl args]
  local method=$1 path=$2
  shift 2
  # --noproxy: a proxy from the caller's shell must never stand between this and localhost.
  # --max-time: a paused OpenBao accepts the connection and never answers; the action must end,
  # and be logged as failed, all the same.
  # --path-as-is: no '.' or '..' is let through above; this keeps curl from resolving one anyway.
  curl --noproxy '*' --path-as-is --connect-timeout 5 --max-time 30 --fail --silent --show-error --request "$method" \
    --header "X-Vault-Token: $BW_BAO_ROOT_TOKEN" "http://127.0.0.1:$OPENBAO_PORT/v1/$path" "$@"
}

# Resolve the target in an assignment: `die` inside a command substitution only ends the subshell,
# and as a bare argument that failure would be lost.
case $action in
  kill | start | pause | unpause | netsplit | netjoin)
    [ $# -eq 1 ] || usage
    target=$(container "$1")
    ;;
  db-snapshot | db-restore | bao-snapshot | bao-restore | store-snapshot | store-restore)
    [ $# -eq 1 ] || usage
    # One path component, so that the snapshot lands in .state/backups itself: a name with a
    # slash would put it under some other directory, which may be a link to anywhere. And not
    # spelled like a snapshot that was interrupted, which bin/evidence tells by that suffix.
    case $1 in
      '' | . | .. | */*) die "snapshot names are one path component without a slash, not '$1'" ;;
      *.partial.*) die "snapshot names must not hold '.partial.', which marks an interrupted snapshot" ;;
    esac
    ;;
  # A KV path or key name reaches OpenBao inside a URL path: slash-separated components of
  # letters, digits, '_', '-' and '.', none being '.' or '..', which curl would resolve into
  # another API path than the one the log names. Refused before anything is logged.
  bao-soft-delete | bao-destroy | bao-delete-key)
    if [ "$action" = bao-delete-key ]; then [ $# -eq 1 ] || usage; else [ $# -eq 2 ] || usage; fi
    [[ $1 =~ ^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$ && /$1/ != */./* && /$1/ != */../* ]] ||
      die "a KV path or key is slash-separated components without '.' or '..' among them, not '$1'"
    [ "$action" = bao-delete-key ] || [[ $2 =~ ^[0-9]+$ ]] || die "a version is a number, not '$2'"
    ;;
  *) usage ;;
esac
# Two records per action. The first is written when the action starts, so the timeline shows when a
# failure began, not when it returned. The second says how it ended: without it a kill that Docker
# refused reads exactly like one that happened. EXIT, not ERR: `die` leaves through `exit`.
# The log is appended to only as the regular file with one name that inject itself made: through a
# link, the arguments, which may hold a snapshot name that is a secret, would be written outside
# .state. Absent, the append creates it, following nothing.
record() {
  local log=$STATE/injections.log
  if [ -L "$log" ] || { [ -e "$log" ] && { [ ! -f "$log" ] || [ "$(stat --format=%h -- "$log" 2>/dev/null)" != 1 ]; }; }; then
    say "fixtures: $log is not the regular file inject writes, with that one name; nothing was recorded"
    return 1
  fi
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$log"
}
partial=
published=
published_inode=
staging=
moved_aside=0
committing=0
db_swapping=0
bao_dispatched=0
finish() {
  local rc=$? left status=failed
  # A signal that arrives while bash waits for a rename has it finish the child and run this
  # handler before the line that would have cleared the flags. The rename is the commit of a
  # snapshot and of a store restore, so one that did complete is recorded as done, whatever the
  # signal made of the status: the artifact it left is what a later restore acts on.
  if [ -n "$partial" ] && [ ! -e "$partial" ] && [ -n "$published_inode" ] &&
    [ "$(stat --format=%i -- "$published" 2>/dev/null)" = "$published_inode" ]; then
    partial=
    [ "$rc" -eq 0 ] || say "fixtures: interrupted after the snapshot was published; recorded as done"
    rc=0
  fi
  # With the staging name already cleared, the interruption came during the cleanup after the swap.
  if [ "$committing" -eq 1 ] && [ -e "$STATE/data" ] && { [ -z "$staging" ] || [ ! -e "$staging/data" ]; }; then
    [ "$rc" -eq 0 ] || say "fixtures: interrupted after the restored store was in place; recorded as done"
    rc=0
  fi
  # The database swap is one transaction that the server may commit while the signal ends the
  # client: afterwards the scratch database no longer exists under its name, and the restore is
  # in place. Asked only when the status says failure, and only while the server answers; a
  # query that fails leaves the status as it was.
  if [ "$db_swapping" -eq 1 ] && [ "$rc" -ne 0 ] &&
    left=$(pg psql -U bronzeward -d postgres -Atc "select count(*) from pg_database where datname = 'bronzeward_restore'" 2>/dev/null) &&
    [ "$left" = 0 ]; then
    say "fixtures: interrupted after the restored database was swapped in; recorded as done. bronzeward_previous is left; the next db-restore drops it"
    rc=0
  fi
  # A mutating request that OpenBao may have received and applied without answering: curl's own
  # status tells a request that never reached the server (7, no connection) or that the server
  # refused (22, an HTTP error) from a timeout, a dropped connection or a signal, after which
  # the provider's state is whatever the request made of it. Recorded as unknown, not failed.
  if [ "$bao_dispatched" -eq 1 ] && [ "$rc" -ne 0 ] && [ "$rc" -ne 7 ] && [ "$rc" -ne 22 ]; then
    status=unknown
    say "fixtures: the request was sent and not answered; whether OpenBao applied it is not known"
  fi
  # A removal that fails must not end the handler before the outcome is recorded: each is guarded.
  if [ -n "$partial" ]; then
    rm -f -- "$partial" || say "fixtures: could not remove the partial file $partial"
  fi
  if [ -n "$staging" ]; then
    # store-restore ended between its two renames: the earlier store goes back before the staging
    # directory is removed. If it cannot, the staging directory stays, because it holds the only copy.
    # Only a directory this run moved there: an archive may hold an entry named previous of its
    # own, and with the live directory gone that entry is not the store.
    if [ "$moved_aside" -eq 1 ] && [ -d "$staging/previous" ] && [ ! -e "$STATE/data" ]; then
      mv --no-target-directory -- "$staging/previous" "$STATE/data" || staging=
    fi
    if [ -n "$staging" ]; then
      rm -rf -- "$staging" || say "fixtures: could not remove the staging directory $staging"
    fi
  fi
  # An outcome that could not be recorded is a failure of its own; the action's status stands
  # otherwise, and is restated here so that nothing above decides it.
  if [ "$rc" -eq 0 ]; then record "done $action $logged" || rc=1; else record "$status rc=$rc $action $logged" || true; fi
  exit "$rc"
}
logged=$*
record "begin $action $logged" || exit 1
trap finish EXIT

# snapshot <file> <command...>: the command writes the snapshot to stdout. It reaches its final name
# only when the command succeeded, so a restore can never pick up a truncated one.
snapshot() {
  local file=$1
  shift
  partial=$(mktemp "$file.partial.XXXXXX")
  "$@" >"$partial"
  # A final name that exists with a second name: the rename would replace this entry alone, and
  # the earlier snapshot would live on under the other name, past teardown, with nothing left here
  # to show it.
  if [ -e "$file" ] && [ ! -L "$file" ] && [ "$(stat --format=%h -- "$file" 2>/dev/null)" != 1 ]; then
    die "$file has a second name; the snapshot was not published"
  fi
  # --no-target-directory: a final name that is a symlink to a directory, left by an earlier run or
  # a prototype, would otherwise receive the snapshot inside that directory, outside .state, with
  # the action logged as done. The rename replaces the link itself, and fails on a real directory.
  # The inode first: it is how the exit handler tells a rename that completed under a signal from
  # a final name that was there before.
  published_inode=$(stat --format=%i -- "$partial") || die "could not stat $partial"
  published=$file
  mv --no-target-directory -- "$partial" "$file"
  partial=
}

case $action in
  kill)
    docker kill --signal KILL "$target" >/dev/null
    ;;
  start)
    docker start "$target" >/dev/null
    case $1 in
      postgres) wait_for 60 "postgres" pg pg_isready -h 127.0.0.1 -U bronzeward -d bronzeward ;;
      openbao)
        bao_sealed() {
          local rc=0
          bao status >/dev/null 2>&1 || rc=$?
          [ "$rc" -eq 2 ]
        }
        wait_for 60 "a sealed OpenBao" bao_sealed
        bao_unseal
        wait_for 60 "an active OpenBao node" bao token lookup
        ;;
      controlplane | worker)
        # A started container is a node that is still booting. Asked on its own address, like
        # bin/evidence does: a capture right after `done` must not find the node unavailable.
        node=$TALOS_WORKER_IP
        [ "$1" = worker ] || node=$TALOS_CONTROLPLANE_IP
        talos_answers() { timeout "$REQUEST_LIMIT" "$CACHE/talosctl" -e "$node" -n "$node" version --short; }
        wait_for 180 "the Talos API on $node" talos_answers
        ;;
    esac
    ;;
  pause | unpause)
    docker "$action" "$target" >/dev/null
    ;;
  netsplit)
    network=$(network_of "$1")
    network_own "$1" "$network"
    docker network disconnect "$network" "$target"
    ;;
  netjoin)
    network=$(network_of "$1")
    network_own "$1" "$network"
    case $1 in
      controlplane) docker network connect --ip "$TALOS_CONTROLPLANE_IP" "$network" "$target" ;;
      worker) docker network connect --ip "$TALOS_WORKER_IP" "$network" "$target" ;;
      *) docker network connect --alias "$1" "$network" "$target" ;;
    esac
    ;;
  db-snapshot)
    [ $# -eq 1 ] || usage
    PG_LIMIT=600 snapshot "$STATE/backups/pg-$1.dump" pg pg_dump --format=custom -U bronzeward bronzeward
    ;;
  db-restore)
    [ $# -eq 1 ] || usage
    [ -f "$STATE/backups/pg-$1.dump" ] || die "no such snapshot: pg-$1.dump"
    # Restored aside first: a dump that cannot be read must not cost the live database. The swap is
    # then two renames in one transaction, so at every moment a database named bronzeward exists
    # and it is either the old one or the new one. What an interrupted run leaves under the two
    # other names is dropped here, at the start of the next.
    pg dropdb --if-exists --force -U bronzeward --maintenance-db=postgres bronzeward_previous
    pg dropdb --if-exists --force -U bronzeward --maintenance-db=postgres bronzeward_restore
    pg createdb -U bronzeward --maintenance-db=postgres bronzeward_restore
    if ! timeout 600 docker exec -i -e PGPASSWORD="$BW_POSTGRES_PASSWORD" "$PG" \
      pg_restore -U bronzeward --dbname=bronzeward_restore --exit-on-error <"$STATE/backups/pg-$1.dump"; then
      pg dropdb --if-exists --force -U bronzeward --maintenance-db=postgres bronzeward_restore ||
        say "fixtures: the half-restored database bronzeward_restore could not be dropped"
      die "pg-$1.dump could not be restored; the live database was left alone"
    fi
    # A database cannot be renamed while anyone is connected to it, so its sessions are ended in
    # the same transaction, and each is waited for: the signal alone returns before the backend
    # has gone, and the rename right after it would then fail on a session already told to leave.
    # A client that reconnects in between makes the rename fail, and the transaction then leaves
    # the live database as it was. The flag first: a signal during the transaction has the exit
    # handler ask the server whether it committed all the same.
    db_swapping=1
    pg psql -U bronzeward -d postgres -v ON_ERROR_STOP=1 --quiet --single-transaction --output=/dev/null \
      -c "select pg_terminate_backend(pid, 5000) from pg_stat_activity where datname = 'bronzeward'" \
      -c 'alter database bronzeward rename to bronzeward_previous' \
      -c 'alter database bronzeward_restore rename to bronzeward' ||
      die "could not swap the restored database in; the live database was left alone"
    # The swap above is what decides. A superseded database that cannot be dropped must not make
    # the log say the restore failed; the next db-restore drops it.
    pg dropdb --force -U bronzeward --maintenance-db=postgres bronzeward_previous ||
      say "fixtures: the superseded database bronzeward_previous could not be dropped; the restore itself succeeded"
    ;;
  bao-snapshot)
    [ $# -eq 1 ] || usage
    snapshot "$STATE/backups/bao-$1.snap" bao_http GET sys/storage/raft/snapshot
    ;;
  bao-restore)
    [ $# -eq 1 ] || usage
    [ -f "$STATE/backups/bao-$1.snap" ] || die "no such snapshot: bao-$1.snap"
    # The flag first: once the request is on its way, a failure without an answer from OpenBao
    # says nothing about whether the snapshot was applied, and the exit handler records that.
    bao_dispatched=1
    bao_http POST sys/storage/raft/snapshot-force --data-binary "@$STATE/backups/bao-$1.snap" --output /dev/null
    bao_dispatched=0
    wait_for 60 "an active OpenBao node" bao token lookup
    ;;
  store-snapshot)
    [ $# -eq 1 ] || usage
    snapshot "$STATE/backups/store-$1.tgz" tar -czf - -C "$STATE" data
    ;;
  store-restore)
    [ $# -eq 1 ] || usage
    [ -f "$STATE/backups/store-$1.tgz" ] || die "no such snapshot: store-$1.tgz"
    # An earlier run that was killed outright between its two renames left the only copy of the
    # store there. It is not guessed at.
    for left in "$STATE"/store-restore.*/previous; do
      [ ! -e "$left" ] || die "an interrupted store-restore left the earlier store at $left; move it back to $STATE/data or remove it"
    done
    # Extracted aside first: an archive that cannot be read must not cost the live directory. The
    # live directory is then renamed aside, not removed, and goes only once the new one is in place;
    # if the action ends in between, `finish` puts it back.
    staging=$(mktemp -d "$STATE/store-restore.XXXXXX")
    tar -xzf "$STATE/backups/store-$1.tgz" -C "$staging"
    # A real directory: `-d` alone follows a link, and a `data` that is a symlink would be installed
    # as the store, which every command then refuses, after the real one had been removed for it.
    [ -d "$staging/data" ] && [ ! -L "$staging/data" ] ||
      die "store-$1.tgz holds no data directory; the live one was left alone"
    [ ! -e "$staging/previous" ] && [ ! -L "$staging/previous" ] ||
      die "store-$1.tgz holds an entry named previous next to data; the live one was left alone"
    # The live directory may be gone already: losing it is what a store snapshot is for.
    # --no-target-directory: a destination that exists must fail the rename, never receive the source.
    # The flag goes first: a signal during the rename has bash finish the child and run the exit
    # handler before the next line, and the handler must then know the live directory was moved.
    # Set with nothing moved yet, it is harmless: the handler only moves back a previous that exists
    # while data does not.
    if [ -e "$STATE/data" ]; then
      moved_aside=1
      mv --no-target-directory -- "$STATE/data" "$staging/previous"
    fi
    # The flag first, for the same reason as moved_aside above: the exit handler recognizes a rename
    # that completed under a signal by the restored directory being in place and the staging one
    # empty of it, which without the flag would also describe an archive refused above.
    committing=1
    mv --no-target-directory -- "$staging/data" "$STATE/data"
    # The rename above is the commit: the restored store is in place. Cleaning up after it must not
    # turn a restore that succeeded into one the log says failed; the leftover is named instead,
    # and bin/evidence scans it like the live directory.
    staging_left=$staging
    staging=
    rm -rf -- "$staging_left" ||
      say "fixtures: the restore is in place; its staging directory $staging_left could not be removed and holds the earlier store under previous"
    ;;
  # The three mutations below go over HTTP like bao-restore, for the same reason: a request that
  # went out and got no answer may have been applied, and curl's status tells that case from a
  # refused or unreachable one; the CLI's does not. The path and version are held to what an
  # API path can carry unencoded.
  bao-soft-delete | bao-destroy)
    verb=delete
    [ "$action" = bao-soft-delete ] || verb=destroy
    bao_dispatched=1
    bao_http POST "secret/$verb/$1" --data "{\"versions\":[$2]}" --output /dev/null
    bao_dispatched=0
    ;;
  bao-delete-key)
    bao_dispatched=1
    bao_http POST "transit/keys/$1/config" --data '{"deletion_allowed":true}' --output /dev/null
    bao_http DELETE "transit/keys/$1" --output /dev/null
    bao_dispatched=0
    ;;
  *) usage ;;
esac
