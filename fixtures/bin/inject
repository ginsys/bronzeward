#!/usr/bin/env bash
# Failure injection and backup/restore primitives. Every action is logged to .state/injections.log
# with a UTC timestamp, once when it begins and once with its outcome, so an experiment's timeline
# can be reconstructed.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../lib.sh
. "$(dirname "$0")/../lib.sh"

usage() {
  cat >&2 <<'EOF'
usage: inject <action> [args]

  targets: postgres | openbao | controlplane | worker

  kill <target>                 SIGKILL the container (crash, no shutdown hooks)
  start <target>                start it again and wait until it answers; openbao comes back
                                sealed and is unsealed
  pause <target>                freeze every process (hung peer, connections stay open)
  unpause <target>
  netsplit <target>             detach from its network (unreachable, process keeps running)
  netjoin <target>              reattach: a Talos node on its fixed address, a service under its name

  db-snapshot <name>            pg_dump of the bronzeward database to .state/backups
  db-restore <name>             drop the database and restore that dump
  bao-snapshot <name>           OpenBao Raft snapshot to .state/backups
  bao-restore <name>            force-restore that snapshot
  store-snapshot <name>         tar of .state/data (SQLite files, age/SOPS stores)
  store-restore <name>          replace .state/data with that tar

  bao-soft-delete <kv-path> <version>    reversible KV v2 delete
  bao-destroy <kv-path> <version>        permanent KV v2 version destruction
  bao-delete-key <transit-key>           permanent loss of a Transit key
EOF
  exit 2
}

[ $# -ge 1 ] || usage
need docker jq tar mktemp timeout stat
need_state
# Alone: two injections at once would share the scratch names a restore swaps through, and a
# teardown under one would remove what it is changing.
fixture_lock exclusive
action=$1
shift
# The log below holds one record per line, the action and its arguments included: a word with a
# newline in it, or any other control character, would write records of its own. Refused before
# anything is recorded, as is an action that does not exist.
for arg in "$action" "$@"; do
  [[ $arg != *[[:cntrl:]]* ]] || die "the action and its arguments must not hold control characters"
done
unset arg

network_of() {
  case $1 in
    postgres | openbao) printf '%s_default\n' "$FIXTURE_NAME" ;;
    *) printf '%s\n' "$FIXTURE_NAME" ;;
  esac
}

# network_own <target> <network>: the network under the fixture's name must be the fixture's own
# before a container is connected to it. Once every container is off it, the name is free for
# anyone's network, and a Talos node would be given its fixed address on that one. Each network is
# held to the ID bin/up recorded; the Compose network's labels are only the project's, which any
# network can be given, so they are no mark. The ID it held is left in network_id, and the
# connect, the disconnect and the read-back take that, not the name: by name, they would reach
# whatever network carries it by then.
network_id=
network_own() {
  local record
  case $1 in
    controlplane | worker) record=$STATE/down-node-networks ;;
    *) record=$STATE/down-compose-networks ;;
  esac
  network_id=$(docker network inspect --format '{{.Id}}' "$2") || die "cannot inspect the network $2"
  [ -f "$record" ] ||
    die "no record of the network $2 in $STATE; run fixtures/bin/down --adopt, then up"
  grep --quiet --line-regexp --fixed-strings -- "$network_id" "$record" ||
    die "the network $2 is not the one bin/up recorded; refusing to touch it"
}

bao_http() { # bao_http <method> <api-path> [curl args]
  local method=$1 path=$2
  shift 2
  # Sent from inside the network namespace of the container verified under the name, by the
  # pinned curl image: from the host, the published port is an address, and whatever holds it by
  # then answers, a replacement bound to it once the verified container was gone included, and
  # would be handed the root token. Inside the namespace, 127.0.0.1:8200 is that container's own
  # listener whatever network it is on, and a container stopped or gone has no namespace to join:
  # docker run then fails with 125 before anything is sent (the ID itself was resolved above,
  # before the action began). The status is curl's own when the
  # client ran (7 never connected, 22 an HTTP error, 28 timed out) and Docker's 125 to 127 when it
  # did not. The token goes in through the environment (the client copies a name given without a
  # value from its own) and curl expands it into the header, so that it is on no command line,
  # neither the client's nor curl's. Stdin is handed through, for a body from a file.
  # --max-time: a paused OpenBao accepts the connection and never answers; the action must end,
  # and be logged as failed, all the same.
  # --path-as-is: no '.' or '..' is let through above; this keeps curl from resolving one anyway.
  BAO_TOKEN=$BW_BAO_ROOT_TOKEN docker run --rm --interactive --pull never --network "container:$bao_id" --env BAO_TOKEN "$CURL_IMAGE" \
    --disable --path-as-is --connect-timeout 5 --max-time 30 --fail --silent --show-error --request "$method" \
    --variable '%BAO_TOKEN' --expand-header 'X-Vault-Token: {{BAO_TOKEN}}' "http://127.0.0.1:8200/v1/$path" "$@"
}
# bao_refused <rc>: the request did not reach OpenBao, or OpenBao answered it with an error, so
# nothing was applied: curl's 7 (never connected) or 22 (an HTTP error), or Docker's 125 to 127
# (the client was not run: no such container, not running, no image). Any other status is a
# request that went out and got no answer.
bao_refused() {
  case $1 in
    7 | 22 | 125 | 126 | 127) return 0 ;;
    *) return 1 ;;
  esac
}

# Resolve the target in an assignment: `die` inside a command substitution only ends the subshell,
# and as a bare argument that failure would be lost.
case $action in
  kill | start | pause | unpause | netsplit | netjoin)
    [ $# -eq 1 ] || usage
    target=$(container "$1")
    # Acted on by the ID need_state verified under that name (containers_own in lib.sh), not by
    # the name: a container removed and the name taken by another between the check and the
    # action would otherwise be the one killed, paused or moved. An ID names one container ever.
    target_id=${verified_container_ids[$target]:-}
    [ -n "$target_id" ] || die "no container named $target exists; nothing to act on"
    ;;
  db-snapshot | db-restore | bao-snapshot | bao-restore | store-snapshot | store-restore)
    [ $# -eq 1 ] || usage
    # One path component, so that the snapshot lands in .state/backups itself: a name with a
    # slash would put it under some other directory, which may be a link to anywhere. And not
    # spelled like a snapshot that was interrupted, which bin/evidence tells by that suffix.
    case $1 in
      '' | . | .. | */*) die "snapshot names are one path component without a slash, not '$1'" ;;
      # With the suffix the file name gets, a name that ends in '.partial' would carry it too.
      *.partial.* | *.partial) die "snapshot names must not hold '.partial.' or end in '.partial', which marks an interrupted snapshot" ;;
    esac
    ;;
  # A KV path or key name reaches OpenBao inside a URL path: slash-separated components of
  # letters, digits, '_', '-' and '.', none being '.' or '..', which curl would resolve into
  # another API path than the one the log names. Refused before anything is logged.
  bao-soft-delete | bao-destroy | bao-delete-key)
    if [ "$action" = bao-delete-key ]; then [ $# -eq 1 ] || usage; else [ $# -eq 2 ] || usage; fi
    [[ $1 =~ ^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$ && /$1/ != */./* && /$1/ != */../* ]] ||
      die "a KV path or key is slash-separated components without '.' or '..' among them, not '$1'"
    [ "$action" = bao-delete-key ] || [[ $2 =~ ^[0-9]+$ ]] || die "a version is a number, not '$2'"
    ;;
  *) usage ;;
esac
# The OpenBao container's ID, for every request to it, resolved before the dispatch flag can be
# set: a name no container answered to when need_state checked is a request never sent, refused
# here, before anything is logged, not recorded as one that went out and got no answer.
case $action in
  bao-*) bao_id=$(container_id "$BAO") || die "no container named $BAO was verified; nothing was sent" ;;
esac
# Two records per action. The first is written when the action starts, so the timeline shows when a
# failure began, not when it returned. The second says how it ended: without it a kill that Docker
# refused reads exactly like one that happened. EXIT, not ERR: `die` leaves through `exit`.
# The log is appended to only as the regular file with one name that inject itself made: through a
# link, the arguments, which may hold a snapshot name that is a secret, would be written outside
# .state. Absent, the append creates it, following nothing.
record() {
  local log=$STATE/injections.log
  if [ -L "$log" ] || { [ -e "$log" ] && { [ ! -f "$log" ] || [ "$(stat --format=%h -- "$log" 2>/dev/null)" != 1 ]; }; }; then
    say "fixtures: $log is not the regular file inject writes, with that one name; nothing was recorded"
    return 1
  fi
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$log"
}
partial=
published=
published_inode=
staging=
moved_aside=0
committing=0
db_swapping=0
restore_oid=
bao_dispatched=0
# bao_answered: OpenBao answered the mutating request with success; set before the dispatch flag
# is cleared, so that no moment has neither. A signal after it is a signal after the mutation.
bao_answered=0
docker_dispatched=0
started=0
# ready_probe: the bounded request a start waits on, kept for finish to ask once more.
ready_probe=
# docker_expect: the state the Docker request in flight asks for, set before the request: "<field>
# <value>" for a container state field, "network out" for no membership of the network held under
# network_id, "network ip <address>" for membership at that address and "network alias <name>" for
# membership under that alias. Membership alone is not the state a netjoin asks for: a container attached at
# another address, or without its alias, is a member the connect refuses, and the node is not
# where its address promises.
docker_expect=
# docker_applied: whether that state holds, read back from the daemon; asked a few times over, since
# a kill is answered before the container has stopped. 0 when it holds, 1 when it does not, 2 when
# the daemon cannot say.
docker_applied() {
  local kind=${docker_expect%% *} want=${docker_expect#* } got _
  for _ in 1 2 3 4 5; do
    case $kind in
      network)
        # "in <address> <alias>..." from the endpoint whose network is the ID held, or nothing,
        # which is "out": the endpoints are keyed by network name, and the name is no mark.
        # shellcheck disable=SC2016  # a Go template, not a shell expansion
        got=$(docker inspect --type container --format "{{range \$n, \$e := .NetworkSettings.Networks}}{{if eq \$e.NetworkID \"$network_id\"}}in {{\$e.IPAddress}}{{range \$e.Aliases}} {{.}}{{end}}{{end}}{{end}}" "$target_id" 2>/dev/null) || return 2
        [ -n "$got" ] || got=out
        case $want in
          out) [ "$got" != out ] || return 0 ;;
          ip\ *) [[ $got != "in ${want#ip }" && $got != "in ${want#ip } "* ]] || return 0 ;;
          alias\ *) [[ $got != in\ * || " ${got#in * } " != *" ${want#alias } "* ]] || return 0 ;;
        esac
        ;;
      *)
        got=$(docker inspect --type container --format "{{.State.$kind}}" "$target_id" 2>/dev/null) || return 2
        [ "$got" != "$want" ] || return 0
        ;;
    esac
    sleep 1
  done
  return 1
}
finish() {
  local rc=$? left status=failed applied signalled=0 mounted
  # A signal that ends the shell between two commands, or during a builtin, leaves the status of
  # the command before it, which is 0 as a rule (observed: the handler sees 0 on a TERM during a
  # function's sleep, and the shell still exits 143). Without the flag the last line sets, that 0
  # would have an action the signal ended before it completed recorded as done. The commit checks
  # below still turn it back into done where the artifact shows the commit went through. A status
  # past 128 is a child ended by the signal it shared: the same case.
  if [ "$rc" -eq 0 ] && [ "$completed" -ne 1 ]; then
    rc=1
    signalled=1
    say "fixtures: ended by a signal before the action completed"
  fi
  [ "$rc" -le 128 ] || signalled=1
  # A signal that arrives while bash waits for a rename has it finish the child and run this
  # handler before the line that would have cleared the flags. The rename is the commit of a
  # snapshot and of a store restore, so one that did complete is recorded as done, whatever the
  # signal made of the status: the artifact it left is what a later restore acts on.
  if [ -n "$partial" ] && [ ! -e "$partial" ] && [ -n "$published_inode" ] &&
    [ "$(stat --format=%i -- "$published" 2>/dev/null)" = "$published_inode" ]; then
    partial=
    [ "$rc" -eq 0 ] || say "fixtures: interrupted after the snapshot was published; recorded as done"
    rc=0
  fi
  # With the staging name already cleared, the interruption came during the cleanup after the swap.
  if [ "$committing" -eq 1 ] && [ -e "$STATE/data" ] && { [ -z "$staging" ] || [ ! -e "$staging/data" ]; }; then
    [ "$rc" -eq 0 ] || say "fixtures: interrupted after the restored store was in place; recorded as done"
    rc=0
  fi
  # The database swap is one transaction that the server may commit while the signal ends the
  # client: afterwards the database under the live name is the restored one. Told by its OID,
  # which a rename keeps, and which was read from the restored copy before the swap: that the
  # scratch name is gone would say as much of a drop by someone else. Asked only when the status
  # says failure, and only while the server answers; a query that fails leaves the status as it was.
  if [ "$db_swapping" -eq 1 ] && [ "$rc" -ne 0 ] && [ -n "$restore_oid" ] &&
    live=$(pg psql -U bronzeward -d postgres -Atc "select oid from pg_database where datname = 'bronzeward'" 2>/dev/null) &&
    [ "$live" = "$restore_oid" ]; then
    say "fixtures: interrupted after the restored database was swapped in; recorded as done. bronzeward_previous is left; the next db-restore drops it"
    rc=0
  fi
  # A mutating request OpenBao answered with success, then a failure before the last line, a
  # signal or bao-restore's wait for an active node giving up: the mutation is made, and the log
  # must not deny it. Recorded as done; what came after the answer was not seen to finish, and is
  # said so (the wait's own message above says what).
  if [ "$bao_answered" -eq 1 ] && [ "$rc" -ne 0 ]; then
    say "fixtures: OpenBao answered the request before the action ended (rc=$rc); recorded as done (what followed the answer, if anything, was not seen to finish)"
    rc=0
  fi
  # A mutating request that OpenBao may have received and applied without answering: the status
  # tells a request that never reached the server or that the server refused (bao_refused) from
  # a timeout, a dropped connection or a signal, after which the provider's state is whatever the
  # request made of it. Recorded as unknown, not failed.
  if [ "$bao_dispatched" -eq 1 ] && [ "$rc" -ne 0 ] && ! bao_refused "$rc"; then
    status=unknown
    say "fixtures: the request was sent and not answered; whether OpenBao applied it is not known"
  fi
  # A Docker mutation the daemon may have carried out whatever the CLI's status: a signal ends the
  # client with the signal's status, a connection that closed before the answer came with an
  # ordinary failure, the same as a refusal, and one at a command boundary after the request
  # returned with the flag still set, since it is cleared only by the action completing. What
  # decides is the state read back: the one asked for, and the action is done (a start is not:
  # the service was not seen to answer); not the one asked for, and it failed; none to be had,
  # and it is unknown.
  if [ "$docker_dispatched" -eq 1 ] && [ "$rc" -ne 0 ]; then
    applied=0
    docker_applied || applied=$?
    case $applied in
      0)
        if [ "$action" = start ]; then
          status=unknown
          say "fixtures: the action ended (rc=$rc) after the start was sent; the container runs, but was not seen to answer; recorded as unknown"
        else
          say "fixtures: the action ended (rc=$rc) after the Docker request was sent, and the state read back is the one asked for; recorded as done"
          rc=0
        fi
        ;;
      1) say "fixtures: the action ended (rc=$rc) after the Docker request was sent, and the state read back is not the one asked for; recorded as failed" ;;
      *)
        status=unknown
        say "fixtures: the action ended (rc=$rc) after the Docker request was sent, and the daemon cannot say what it made of it; recorded as unknown"
        ;;
    esac
  fi
  # A start the daemon answered, then a signal during the wait for the service, or right after
  # the wait was answered and before the last line: the container was started, and whether the
  # service answers is decided by asking it once more, bounded: it answers, and the start is done;
  # it does not, and whether it did is not known. A wait that ran to its limit is a failure of
  # the start, and says so itself.
  if [ "$started" -eq 1 ] && [ "$rc" -ne 0 ] && [ "$signalled" -eq 1 ]; then
    if [ -n "$ready_probe" ] && REQUEST_LIMIT=5 PG_LIMIT=5 "$ready_probe" >/dev/null 2>&1; then
      say "fixtures: the container was started and the wait for the service was ended by a signal, and the service answers; recorded as done"
      rc=0
    else
      status=unknown
      say "fixtures: the container was started and the wait for the service was ended by a signal; whether it answers is not known; recorded as unknown"
    fi
  fi
  # A removal that fails must not end the handler before the outcome is recorded: each is guarded.
  if [ -n "$partial" ]; then
    rm -f -- "$partial" || say "fixtures: could not remove the partial file $partial"
  fi
  if [ -n "$staging" ]; then
    # store-restore ended between its two renames: the earlier store goes back before the staging
    # directory is removed. If it cannot, the staging directory stays, because it holds the only
    # copy; so does it when a data directory that this restore did not install is in the way,
    # made there since the earlier one was moved aside, since the earlier store is not moved back
    # over it and is not to be removed under it either. The store is removed with the staging
    # directory only once the restore's own data directory is in place. Only a directory this run
    # moved there: an archive may hold an entry named previous of its own, and with the live
    # directory gone that entry is not the store.
    if [ "$moved_aside" -eq 1 ] && [ -d "$staging/previous" ]; then
      if [ ! -e "$STATE/data" ]; then
        mv --no-target-directory -- "$staging/previous" "$STATE/data" || {
          say "fixtures: the earlier store could not be moved back to $STATE/data; $staging/previous is its only copy, and the staging directory is left"
          staging=
        }
      elif [ "$committing" -ne 1 ] || [ -e "$staging/data" ]; then
        say "fixtures: $STATE/data exists and is not the one this restore installed; the earlier store is not moved back over it, $staging/previous is its only copy, and the staging directory is left"
        staging=
      fi
    fi
    if [ -n "$staging" ]; then
      # Not into a filesystem mounted below it meanwhile (mounted_under in lib.sh).
      if ! mounted=$(mounted_under "$staging") || [ -n "$mounted" ]; then
        say "fixtures: the staging directory $staging is left: a filesystem is mounted below it, or the mount table cannot be read"
      elif ! rm -rf -- "$staging"; then
        say "fixtures: could not remove the staging directory $staging"
      fi
    fi
  fi
  # An outcome that could not be recorded is a failure of its own; the action's status stands
  # otherwise, and is restated here so that nothing above decides it. No outcome without a begin:
  # the handler is armed before the begin line is written, and a signal is held from before the
  # line until the flag below is set, so that none leaves a begin with no outcome; one before the
  # line is written leaves nothing.
  [ "$begun" -eq 1 ] || exit "$rc"
  if [ "$rc" -eq 0 ]; then record "done $action $logged" || rc=1; else record "$status rc=$rc $action $logged" || true; fi
  exit "$rc"
}
logged=$*
begun=0
completed=0
trap finish EXIT
# The begin line and the flag that arms the outcome are two commands, and a signal between them
# would run finish with the line written and the flag not set, leaving a begin with no outcome.
# The three signals a shell can be ended by are held until the flag is set, then delivered as they
# came, and finish sees the flag.
deferred=
trap 'deferred=TERM' TERM
trap 'deferred=HUP' HUP
trap 'deferred=INT' INT
record "begin $action $logged" || exit 1
begun=1
trap - TERM HUP INT
[ -z "$deferred" ] || kill -s "$deferred" $$

# snapshot <file> <command...>: the command writes the snapshot to stdout. It reaches its final name
# only when the command succeeded, so a restore can never pick up a truncated one.
snapshot() {
  local file=$1
  shift
  partial=$(mktemp "$file.partial.XXXXXX")
  "$@" >"$partial"
  # A final name that exists with a second name: the rename would replace this entry alone, and
  # the earlier snapshot would live on under the other name, past teardown, with nothing left here
  # to show it.
  if [ -e "$file" ] && [ ! -L "$file" ] && [ "$(stat --format=%h -- "$file" 2>/dev/null)" != 1 ]; then
    die "$file has a second name; the snapshot was not published"
  fi
  # --no-target-directory: a final name that is a symlink to a directory, left by an earlier run or
  # a prototype, would otherwise receive the snapshot inside that directory, outside .state, with
  # the action logged as done. The rename replaces the link itself, and fails on a real directory.
  # The inode first: it is how the exit handler tells a rename that completed under a signal from
  # a final name that was there before.
  published_inode=$(stat --format=%i -- "$partial") || die "could not stat $partial"
  published=$file
  mv --no-target-directory -- "$partial" "$file"
  # The partial name is not cleared here: a signal between the rename and this line would have the
  # handler see it cleared and record failed for a snapshot that is published. The handler clears
  # it itself where the final name holds the inode recorded above, and records done.
}
# restore_source <file> <name>: the snapshot a restore reads is the regular file snapshot published,
# with no second name. A symlink there would have the restore read a file outside .state, and a
# hard link a file that also exists under another name, neither of which anything here wrote; and
# what the restore then installs as the live store, database or provider state is not one of the
# fixture's snapshots.
restore_source() {
  [ -e "$1" ] || [ -L "$1" ] || die "no such snapshot: $2"
  [ ! -L "$1" ] && [ -f "$1" ] && [ "$(stat --format=%h -- "$1" 2>/dev/null)" = 1 ] ||
    die "$2 is not the regular file a snapshot published, or has a second name; nothing was restored"
}

case $action in
  # Each Docker mutation is flagged from its request until the action completes, the flag never
  # cleared by a line of its own: a signal between the request returning and that line would run
  # finish with the mutation made and the flag down, and record failed with nothing read back.
  # See docker_dispatched in finish. A start is the exception: the daemon's answer settles the
  # mutation, and what follows is the wait for the service, flagged as started.
  kill)
    docker_expect='Running false'
    docker_dispatched=1
    docker kill --signal KILL "$target_id" >/dev/null
    ;;
  start)
    docker_expect='Running true'
    docker_dispatched=1
    docker start "$target_id" >/dev/null
    # started first: a signal between the two would otherwise find neither flag, and record
    # failed for a container the daemon started.
    started=1
    docker_dispatched=0
    case $1 in
      # An authenticated query on the fixture's database, not pg_isready, which answers as soon as
      # the server accepts connections, whatever the parameters: a database dropped or a password
      # changed would then have the start recorded done on a database no client can use. Through
      # pg_client, to the container's address on the Compose network, since the image trusts
      # loopback and a query there would prove nothing about the password.
      postgres)
        pg_answers() { pg_client -Atc 'select 1'; }
        ready_probe=pg_answers
        wait_for 60 "postgres" pg_answers
        ;;
      openbao)
        bao_sealed() {
          local rc=0
          bao status >/dev/null 2>&1 || rc=$?
          [ "$rc" -eq 2 ]
        }
        bao_active() { bao token lookup; }
        ready_probe=bao_active
        wait_for 60 "a sealed OpenBao" bao_sealed
        bao_unseal
        wait_for 60 "an active OpenBao node" bao_active
        ;;
      controlplane | worker)
        # A started container is a node that is still booting. Asked on its own address, like
        # bin/evidence does: a capture right after `done` must not find the node unavailable.
        node=$TALOS_WORKER_IP
        [ "$1" = worker ] || node=$TALOS_CONTROLPLANE_IP
        talos_answers() { talosctl_timed "$REQUEST_LIMIT" -e "$node" -n "$node" version --short; }
        ready_probe=talos_answers
        wait_for 180 "the Talos API on $node" talos_answers
        ;;
    esac
    ;;
  pause | unpause)
    docker_expect='Paused true'
    [ "$action" = pause ] || docker_expect='Paused false'
    docker_dispatched=1
    docker "$action" "$target_id" >/dev/null
    ;;
  netsplit)
    network=$(network_of "$1")
    network_own "$1" "$network"
    docker_expect='network out'
    docker_dispatched=1
    docker network disconnect "$network_id" "$target_id"
    ;;
  netjoin)
    network=$(network_of "$1")
    network_own "$1" "$network"
    case $1 in
      controlplane) docker_expect="network ip $TALOS_CONTROLPLANE_IP" ;;
      worker) docker_expect="network ip $TALOS_WORKER_IP" ;;
      *) docker_expect="network alias $1" ;;
    esac
    docker_dispatched=1
    case $1 in
      controlplane) docker network connect --ip "$TALOS_CONTROLPLANE_IP" "$network_id" "$target_id" ;;
      worker) docker network connect --ip "$TALOS_WORKER_IP" "$network_id" "$target_id" ;;
      *) docker network connect --alias "$1" "$network_id" "$target_id" ;;
    esac
    ;;
  db-snapshot)
    [ $# -eq 1 ] || usage
    PG_LIMIT=600 snapshot "$STATE/backups/pg-$1.dump" pg pg_dump --format=custom -U bronzeward bronzeward
    ;;
  db-restore)
    [ $# -eq 1 ] || usage
    restore_source "$STATE/backups/pg-$1.dump" "pg-$1.dump"
    # Restored aside first: a dump that cannot be read must not cost the live database. The swap is
    # then two renames in one transaction, so at every moment a database named bronzeward exists
    # and it is either the old one or the new one. What an interrupted run leaves under the two
    # other names is dropped here, at the start of the next.
    pg dropdb --if-exists --force -U bronzeward --maintenance-db=postgres bronzeward_previous
    pg dropdb --if-exists --force -U bronzeward --maintenance-db=postgres bronzeward_restore
    pg createdb -U bronzeward --maintenance-db=postgres bronzeward_restore
    # The scratch database's identity, read as soon as it exists and before anything is put in
    # it, for the exit handler: an OID survives the rename, so the database found under the live
    # name afterwards is told to be this very one, not merely not the scratch name any more, and
    # not whatever else came to carry the scratch name meanwhile.
    restore_oid=$(pg psql -U bronzeward -d postgres -Atc "select oid from pg_database where datname = 'bronzeward_restore'") &&
      [ -n "$restore_oid" ] ||
      die "could not read the identity of the scratch database bronzeward_restore; the live database was left alone, and the scratch one is dropped by the next db-restore"
    pg_id=$(container_id "$PG") || die "the PostgreSQL container was not verified under its name; nothing was changed"
    if ! PGPASSWORD=$BW_POSTGRES_PASSWORD timeout 600 docker exec -i -e PGPASSWORD "$pg_id" \
      pg_restore -U bronzeward --dbname=bronzeward_restore --exit-on-error <"$STATE/backups/pg-$1.dump"; then
      pg dropdb --if-exists --force -U bronzeward --maintenance-db=postgres bronzeward_restore ||
        say "fixtures: the half-restored database bronzeward_restore could not be dropped"
      die "pg-$1.dump could not be restored; the live database was left alone"
    fi
    # A database cannot be renamed while anyone is connected to it, so its sessions are ended in
    # the same transaction, and each is waited for: the signal alone returns before the backend
    # has gone, and the rename right after it would then fail on a session already told to leave.
    # A client that reconnects in between makes the rename fail, and the transaction then leaves
    # the live database as it was. A live database that is gone, the loss a snapshot is for, is
    # nothing to rename: the first rename runs only while one of the name exists, decided inside
    # the same transaction. The flag first: a signal during the transaction has the exit handler
    # ask the server whether it committed all the same.
    db_swapping=1
    pg psql -U bronzeward -d postgres -v ON_ERROR_STOP=1 --quiet --single-transaction --output=/dev/null \
      -c "select pg_terminate_backend(pid, 5000) from pg_stat_activity where datname = 'bronzeward'" \
      -c "do \$\$ begin if exists (select 1 from pg_database where datname = 'bronzeward') then execute 'alter database bronzeward rename to bronzeward_previous'; end if; end \$\$" \
      -c 'alter database bronzeward_restore rename to bronzeward' ||
      die "could not swap the restored database in; the live database, if there is one, was left alone, and the restored copy is bronzeward_restore until the next db-restore"
    # The swap above is what decides. A superseded database that cannot be dropped must not make
    # the log say the restore failed; the next db-restore drops it. With no live database before
    # the swap there is none to drop.
    pg dropdb --if-exists --force -U bronzeward --maintenance-db=postgres bronzeward_previous ||
      say "fixtures: the superseded database bronzeward_previous could not be dropped; the restore itself succeeded"
    ;;
  bao-snapshot)
    [ $# -eq 1 ] || usage
    snapshot "$STATE/backups/bao-$1.snap" bao_http GET sys/storage/raft/snapshot
    ;;
  bao-restore)
    [ $# -eq 1 ] || usage
    restore_source "$STATE/backups/bao-$1.snap" "bao-$1.snap"
    # The flag first: once the request is on its way, a failure without an answer from OpenBao
    # says nothing about whether the snapshot was applied, and the exit handler records that.
    bao_dispatched=1
    bao_http POST sys/storage/raft/snapshot-force --data-binary @- --output /dev/null <"$STATE/backups/bao-$1.snap"
    bao_answered=1
    bao_dispatched=0
    wait_for 60 "an active OpenBao node" bao token lookup
    ;;
  store-snapshot)
    [ $# -eq 1 ] || usage
    snapshot "$STATE/backups/store-$1.tgz" tar -czf - -C "$STATE" data
    ;;
  store-restore)
    [ $# -eq 1 ] || usage
    restore_source "$STATE/backups/store-$1.tgz" "store-$1.tgz"
    # An earlier run that was killed outright between its two renames left the only copy of the
    # store there. It is not guessed at. One killed after its commit, while removing the staging
    # directory, left the earlier store next to a live directory that is the restored one: that
    # earlier store is not to be moved back over it.
    for left in "$STATE"/store-restore.*/previous; do
      [ -e "$left" ] || continue
      if [ -e "$STATE/data" ] && [ ! -e "${left%/previous}/data" ]; then
        die "a completed store-restore left the store it replaced at $left; the restore it came from is in place. Remove it"
      fi
      die "an interrupted store-restore left the earlier store at $left; move it back to $STATE/data or remove it"
    done
    # Extracted aside first: an archive that cannot be read must not cost the live directory. The
    # live directory is then renamed aside, not removed, and goes only once the new one is in place;
    # if the action ends in between, `finish` puts it back.
    staging=$(mktemp -d "$STATE/store-restore.XXXXXX")
    tar -xzf "$STATE/backups/store-$1.tgz" -C "$staging"
    # A real directory: `-d` alone follows a link, and a `data` that is a symlink would be installed
    # as the store, which every command then refuses, after the real one had been removed for it.
    [ -d "$staging/data" ] && [ ! -L "$staging/data" ] ||
      die "store-$1.tgz holds no data directory; the live one was left alone"
    [ ! -e "$staging/previous" ] && [ ! -L "$staging/previous" ] ||
      die "store-$1.tgz holds an entry named previous next to data; the live one was left alone"
    # The live directory may be gone already: losing it is what a store snapshot is for.
    # --no-target-directory: a destination that exists must fail the rename, never receive the source.
    # The flag goes first: a signal during the rename has bash finish the child and run the exit
    # handler before the next line, and the handler must then know the live directory was moved.
    # Set with nothing moved yet, it is harmless: the handler only moves back a previous that exists
    # while data does not.
    if [ -e "$STATE/data" ]; then
      moved_aside=1
      mv --no-target-directory -- "$STATE/data" "$staging/previous"
    fi
    # The flag first, for the same reason as moved_aside above: the exit handler recognizes a rename
    # that completed under a signal by the restored directory being in place and the staging one
    # empty of it, which without the flag would also describe an archive refused above.
    committing=1
    mv --no-target-directory -- "$staging/data" "$STATE/data"
    # The rename above is the commit: the restored store is in place. Cleaning up after it must not
    # turn a restore that succeeded into one the log says failed; the leftover is named instead,
    # and bin/evidence scans it like the live directory. The staging name stays set until the
    # directory is gone: a signal during the removal has the exit handler finish it, and the
    # handler moves nothing back while the live directory is there.
    # Not into a filesystem mounted below it since it was made (mounted_under in lib.sh).
    if ! mounted=$(mounted_under "$staging") || [ -n "$mounted" ]; then
      say "fixtures: the restore is in place; its staging directory $staging is left, a filesystem being mounted below it or the mount table unreadable, and holds the earlier store under previous"
    elif rm -rf -- "$staging"; then
      staging=
    else
      say "fixtures: the restore is in place; its staging directory $staging could not be removed and holds the earlier store under previous"
    fi
    ;;
  # The three mutations below go over HTTP like bao-restore, for the same reason: a request that
  # went out and got no answer may have been applied, and curl's status tells that case from a
  # refused or unreachable one; the CLI's does not. The path and version are held to what an
  # API path can carry unencoded.
  bao-soft-delete | bao-destroy)
    verb=delete
    [ "$action" = bao-soft-delete ] || verb=destroy
    bao_dispatched=1
    bao_http POST "secret/$verb/$1" --data "{\"versions\":[$2]}" --output /dev/null
    bao_answered=1
    bao_dispatched=0
    ;;
  bao-delete-key)
    # Two requests, after a read. A DELETE refused after the setting that allows deletion was
    # applied leaves the key deletable, which `failed` would deny: the setting is put back to what
    # the read found, and the action fails with the key as it was; a key already deletable is left
    # so, since nothing was changed. When the setting cannot be put back, what the key is left as
    # is not known. Refused is bao_refused's reading of the status (never reached, or answered
    # with an error), as for every request above: a DELETE that went out and got no answer may
    # have taken the key, and is unknown, whatever the setting was.
    deletable=$(bao_http GET "transit/keys/$1" | jq --raw-output '.data.deletion_allowed') ||
      die "cannot read the Transit key $1; nothing was changed"
    case $deletable in
      true | false) ;;
      *) die "the Transit key $1 has no deletion_allowed setting to read back; nothing was changed" ;;
    esac
    bao_dispatched=1
    [ "$deletable" = true ] || bao_http POST "transit/keys/$1/config" --data '{"deletion_allowed":true}' --output /dev/null
    delete_rc=0
    bao_http DELETE "transit/keys/$1" --output /dev/null || delete_rc=$?
    if [ "$delete_rc" -ne 0 ]; then
      # Refused: the key is there. A setting this action applied is put back, and the action
      # failed; one that cannot be put back leaves the key deletable or not, which is not known.
      if bao_refused "$delete_rc"; then
        if [ "$deletable" = true ]; then
          bao_dispatched=0
          die "the Transit key $1 could not be deleted (rc=$delete_rc); it was deletable before and is left so"
        fi
        if bao_http POST "transit/keys/$1/config" --data '{"deletion_allowed":false}' --output /dev/null; then
          bao_dispatched=0
          die "the Transit key $1 could not be deleted (rc=$delete_rc); its deletion_allowed setting was put back to false"
        fi
        say "fixtures: the Transit key $1 could not be deleted (rc=$delete_rc), and its deletion_allowed setting could not be put back; whether it is left deletable is not known"
        exit 1
      fi
      # Went out and got no answer: the key may be gone, whatever the setting, and the outcome is
      # unknown either way. A setting this action applied is put back all the same, so that a key
      # that survived is left as it was found; on a key that is gone the request fails, and says
      # nothing more than the deletion did.
      if [ "$deletable" != true ]; then
        bao_http POST "transit/keys/$1/config" --data '{"deletion_allowed":false}' --output /dev/null ||
          say "fixtures: the deletion_allowed setting of the Transit key $1 could not be put back (the key may be gone)"
      fi
      say "fixtures: the deletion of the Transit key $1 went out and got no answer (rc=$delete_rc); whether the key is gone is not known"
      exit 1
    fi
    bao_answered=1
    bao_dispatched=0
    ;;
  *) usage ;;
esac
completed=1
