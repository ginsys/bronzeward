#!/usr/bin/env bash
# Capture an evidence bundle into .state/evidence/<utc>/ and scan it for leaked synthetic secrets.
# Usage: evidence [extra-path-to-scan ...]   e.g. a prototype's temp, staging or log directory
#
# Works while parts of the fixture are killed, paused or partitioned: a source that cannot be read
# is named in <bundle>/unavailable.txt and the rest is still captured and scanned.
# Exit 1 when the scan itself is not trustworthy: a path or file it could not read, or a positive
# control it did not find. An empty scan would then prove nothing.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../lib.sh
. "$(dirname "$0")/../lib.sh"

need docker curl jq tar sha256sum git find comm awk timeout realpath readlink mktemp cmp stat flock
need_state
# The cached tools against the manifest, before any is run: the bundle cites the manifest, and a
# replaced talosctl could report the pinned version.
tools_verify
# The pattern list every match below relies on is rebuilt from the generated credentials and must
# be what bin/up wrote: thinned after up, a scan against it would pass while a token or key goes
# unmatched, and `shown` would print a name that holds one.
# Into a file, not a process substitution, whose exit status bash would not report: a source that
# fails halfway would leave a list short in the same way as a file cut to match it.
rebuilt=$(mktemp "$STATE/scan-patterns.rebuilt.XXXXXX")
if ! scan_patterns >"$rebuilt"; then
  rm -f -- "$rebuilt"
  die "the leak-scan patterns could not be rebuilt from this run's credentials; results void"
fi
if ! cmp --silent -- "$rebuilt" "$STATE/scan-patterns.txt"; then
  rm -f -- "$rebuilt"
  die "$STATE/scan-patterns.txt is not the list this run's credentials give; results void"
fi
rm -f -- "$rebuilt"
# shown <path>: the path as a message or the bundle may record it. A name that holds a secret is
# never written out, for the same reason a matched line is not; the entry is identified by its inode
# instead. That holds for error messages as much as for the report, so every path this command
# prints goes through here. It runs inside command substitutions, where `die` would only end the
# subshell, so it decides for itself and withholds the name whenever the match did not plainly say
# "no secret".
shown() {
  local rc=0
  grep --quiet --fixed-strings --file="$STATE/scan-patterns.txt" <<<"$1" || rc=$?
  if [ "$rc" -eq 1 ]; then
    # The report is one entry per line. A name with a newline or another control character in it
    # is printed in bash's quoted form ($'...'), one line, rather than as the lines it holds.
    if [[ $1 == *[[:cntrl:]]* ]]; then
      printf '%q' "$1"
    else
      printf '%s' "$1"
    fi
  else
    printf '(a path whose name holds secret material, withheld; inode %s)' \
      "$(stat --format=%i -- "$1" 2>/dev/null || printf unknown)"
  fi
}
# Extra scan paths become absolute: find would read a relative name such as -delete as an
# expression, not as a path. Absolute, not resolved (--no-symlinks): a path that is a symlink keeps
# its own name, which may hold a secret and is matched like any other; find -L follows it from there.
extras=()
for extra in "$@"; do
  [ -e "$extra" ] || die "extra scan path does not exist: $(shown "$extra")"
  # 2>/dev/null here and on tar, find and grep below: each names the path it fails on in its own
  # message, which would bypass `shown`. The exit status still decides, and the message that
  # follows says what failed.
  resolved=$(realpath --no-symlinks -- "$extra" 2>/dev/null) || die "cannot resolve extra scan path: $(shown "$extra")"
  extras+=("$resolved")
done

# mkdir without -p is atomic, so two captures started in the same second get a directory each.
mkdir -p "$STATE/evidence"
stamp=$(date -u +%Y%m%dT%H%M%SZ)
out=$STATE/evidence/$stamp
attempt=1
until mkdir "$out" 2>/dev/null; do
  attempt=$((attempt + 1))
  [ "$attempt" -le 50 ] || die "cannot create a bundle directory under $STATE/evidence"
  out=$STATE/evidence/$stamp-$attempt
done
mkdir "$out/logs" "$out/backups"
# Marked incomplete until the leak scan has run over it: a capture ended before that, by a signal
# or a refusal, leaves a bundle that holds secret material nothing scanned, and the next capture
# whose scan completes takes such a sibling as one more root, then marks it scanned (scanned-by.txt
# in the sibling names this bundle, whose leak-scan.txt holds the hits). Removed as the last step,
# so a kill leaves it in place.
: >"$out/.incomplete" || die "cannot mark the bundle $out as incomplete"
# The marker is held locked for the life of this capture: a later capture takes a sibling still
# marked only if it can lock the marker, so one still writing, whose bundle is not yet all there
# to scan, is left to its own scan and never marked scanned by another. The lock goes with the
# process, so a capture killed leaves its marker free.
exec {own_lock}<>"$out/.incomplete"
flock --nonblock "$own_lock" || die "cannot lock the marker of $out"

unavailable() {
  printf '%s\n' "$*" >>"$out/unavailable.txt"
  say "evidence: unavailable: $*"
}
# Every container is read by the ID need_state verified its name under (container_id in lib.sh),
# never by the name: by name, the logs, the dump and the data directory would be whatever carries
# the name by now. A name no container answered to when checked is unavailable.
running() {
  local id
  id=$(container_id "$1" 2>/dev/null) || return 1
  [ "$(docker inspect --format '{{.State.Running}}' "$id" 2>/dev/null)" = true ]
}
# Evidence is captured while things are broken on purpose. bao and pg from lib.sh are bounded, so
# a provider paused between two requests cannot hang the capture: the request times out and fails,
# and a failed one is recorded as unknown or unavailable like any other.
# reported <command...>: the command's one-line output, or UNAVAILABLE
reported() {
  local value
  if value=$("$@" 2>/dev/null) && [ -n "$value" ]; then
    printf '%s' "$value" | tr '\n' ' '
  else
    printf 'UNAVAILABLE'
  fi
}
# Each node is asked on its own address, not through the control plane, so that a dead control
# plane does not make a healthy worker look dead. Bounded, so a paused or partitioned node cannot
# hang the capture.
node_tag() { # node_tag <ip>
  talosctl_timed 20 -e "$1" -n "$1" version --short | awk '/Tag:/ {print $2}'
}

# The commit captured under and how fixtures/ differs from it, the difference into the bundle
# (fixtures_tree_check in lib.sh, the same checks bin/up made before recording the commit the
# fixture was created at): a bundle without the commit cannot be tied to the pins it was captured
# under, and a tree with a hidden untracked file, a symlink or a directory git cannot open is
# refused, since the commit plus the diff would not say what ran. Every name through shown.
fixtures_tree_check "$out" "$out/fixtures-diff.txt" shown
# The commit the fixture was created at, which bin/up recorded with how fixtures/ differed from it
# then: a checkout switched or committed since would have the bundle name a commit the running
# fixture, its generated configuration and its cached tools were not made from. Both are in the
# bundle, and versions.txt says when they are not the same.
created=$(cat "$STATE/up-manifest" 2>/dev/null) ||
  die "no record in $STATE of the commit the fixture was created at, as an up interrupted early leaves it; the bundle could not be tied to what ran"
# Required, not taken as "the tree was the commit's" when absent: bin/up writes it empty then,
# and one removed since would leave a fixture made from a dirty tree passing for the commit's.
[ -e "$STATE/up-fixtures-diff.txt" ] ||
  die "no record in $STATE of how fixtures/ differed at creation, which bin/up writes with the commit; the bundle could not be tied to what ran"
cp -- "$STATE/up-fixtures-diff.txt" "$out/up-fixtures-diff.txt" ||
  die "cannot copy the record of how fixtures/ differed at creation into the bundle"
{
  printf 'captured        %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf 'manifest commit %s%s\n' "$manifest" "$([ -z "$differs" ] || printf ' (fixtures/ differs from it: see fixtures-diff.txt)')"
  printf 'created at      %s%s%s\n' "$created" \
    "$([ ! -s "$STATE/up-fixtures-diff.txt" ] || printf ' (fixtures/ differed from it then: see up-fixtures-diff.txt)')" \
    "$([ "$created" = "$manifest" ] || printf ' (not the commit captured under: what runs was made from this one)')"
  printf 'host            %s\n' "$(uname -srm)"
  printf 'docker          %s\n' "$(reported docker version --format 'client {{.Client.Version}} server {{.Server.Version}}')"
  printf 'compose         %s\n' "$(reported docker compose version --short)"
  printf 'tools           talosctl, sops, age, age-keygen in .cache checked against the manifest digests\n'
  printf 'talosctl        %s\n' "$(reported talosctl version --client --short)"
  printf 'talos nodes     %s %s, %s %s\n' "$TALOS_CONTROLPLANE_IP" "$(reported node_tag "$TALOS_CONTROLPLANE_IP")" \
    "$TALOS_WORKER_IP" "$(reported node_tag "$TALOS_WORKER_IP")"
  printf 'kubernetes      %s (requested)\n' "$KUBERNETES_VERSION"
  printf 'openbao         %s\n' "$(reported bao version)"
  printf 'postgres        %s\n' "$(reported pg psql -U bronzeward -d bronzeward -Atc 'show server_version')"
  printf 'sops            %s\n' "$(reported "$CACHE/sops" --version --disable-version-check)"
  printf 'age             %s\n' "$(reported "$CACHE/age" --version)"
  for c in "$PG" "$BAO" "$CP" "$WORKER"; do
    if id=$(container_id "$c" 2>/dev/null); then
      # shellcheck disable=SC2016  # $name is a Go template variable, not a shell one
      printf 'image          %s %s\n' "$c" "$(reported docker inspect --format '{{.Config.Image}} -> {{.Image}} running={{.State.Running}} paused={{.State.Paused}} networks=[{{range $name, $_ := .NetworkSettings.Networks}}{{$name}} {{end}}]' "$id")"
    else
      printf 'image          %s UNAVAILABLE (no container under the name when checked)\n' "$c"
    fi
  done
} >"$out/versions.txt"

# Logs survive a kill, so they are read from stopped containers too.
for c in "$PG" "$BAO" "$CP" "$WORKER"; do
  { id=$(container_id "$c" 2>/dev/null) && docker logs "$id" >"$out/logs/$c.log" 2>&1; } || unavailable "logs of $c"
done
unset id

dump_db() { # dump_db <database> <file>
  local id
  id=$(container_id "$PG" 2>/dev/null) || return 1
  timeout 60 docker exec -e PGPASSWORD="$BW_POSTGRES_PASSWORD" "$id" pg_dump -U bronzeward "$1" >"$2" 2>/dev/null ||
    { rm -f "$2"; return 1; }
}
if ! { running "$PG" && dump_db bronzeward "$out/postgres.sql"; }; then
  unavailable "live database dump (postgres stopped, paused or unreachable): current database content NOT scanned"
fi
# What an interrupted db-restore leaves under its two other names holds data too: the previous
# live database among it, with rows the current one and the backup may both lack.
if ! { running "$PG" && scratch=$(pg psql -U bronzeward -d postgres -Atc \
  "select datname from pg_database where datname in ('bronzeward_previous', 'bronzeward_restore')" 2>/dev/null); }; then
  unavailable "databases left by an interrupted db-restore, if any: NOT scanned"
else
  for db in $scratch; do
    dump_db "$db" "$out/postgres-$db.sql" ||
      unavailable "dump of $db, left by an interrupted db-restore: its content NOT scanned"
  done
fi
# A dump is what the server chooses to show. What it wrote to disk, the heap and index files, the
# write-ahead log, a temporary file it did not remove, is what an extraction has to be judged on,
# and it is read from the container's storage whether the server runs or not. Copied as files, so
# that the scan below covers it with the rest of the bundle.
if ! { pg_id=$(container_id "$PG" 2>/dev/null) && timeout 120 docker cp --quiet "$pg_id:/var/lib/postgresql/data" "$out/postgres-data" 2>/dev/null; }; then
  rm -rf -- "$out/postgres-data"
  unavailable "PostgreSQL data directory (container gone or its storage unreadable): what the server wrote to disk NOT scanned"
fi

# Backups are compressed; a scan of the raw files would be clean for the wrong reason. Expanding a
# dump needs no server, so it runs in a throwaway container and works while postgres is down.
# A dump or archive that an interrupted action left under its temporary name holds the same
# material as a finished one and is expanded too. One that cannot be, being truncated, marks the
# bundle incomplete rather than void: that is what an interruption leaves, and whatever part of it
# did expand is scanned all the same.
# A dump or archive that is a symlink or has a second name is not one the fixture wrote: what is
# under the other name, whatever it holds, would be expanded into the bundle. Refused, as bin/down
# refuses it at teardown.
one_name() { # one_name <file>
  [ ! -L "$1" ] && [ -f "$1" ] && [ "$(stat --format=%h -- "$1" 2>/dev/null)" = 1 ] ||
    die "$(shown "$1") is not a regular file with that one name; the fixture never makes one there, and what the other name holds would be copied into the bundle. Results void"
}
for dump in "$STATE"/backups/pg-*.dump "$STATE"/backups/pg-*.dump.partial.*; do
  [ -e "$dump" ] || [ -L "$dump" ] || continue
  one_name "$dump"
  as_sql=$out/backups/$(basename "$dump").sql
  # In a group with stderr closed: a dump that cannot be opened has bash name it, with the full
  # path, before any message below could go through `shown`.
  if ! { docker run --rm --interactive --network none "$POSTGRES_IMAGE" pg_restore --file=- <"$dump" >"$as_sql"; } 2>/dev/null; then
    case $dump in
      *.partial.*) unavailable "interrupted dump $(shown "$dump") could not be expanded in full: scanned only as far as it did expand, and as written" ;;
      *) die "could not expand $(shown "$dump"): the backup would go unscanned" ;;
    esac
  fi
done
for store in "$STATE"/backups/store-*.tgz "$STATE"/backups/store-*.tgz.partial.*; do
  [ -e "$store" ] || [ -L "$store" ] || continue
  one_name "$store"
  expanded=$out/backups/$(basename "$store")
  expanded=${expanded%.tgz}
  # The archive's digest, recorded before it is expanded, next to the expansion: a control copy
  # found in an expanded archive is excused only while the archive under that name still has
  # these bytes (store_archive_is_own below). An archive replaced between the two commands is
  # then a mismatch, and its copy a leak, which is the safe side.
  # From standard input: given the name, sha256sum escapes a backslash in it and marks the line
  # with one, which would put a 65th character before the digest.
  { sha256sum <"$store" | cut -d' ' -f1 >"$expanded.sha256"; } 2>/dev/null ||
    die "could not take the digest of $(shown "$store"): its copies could not be told from a leak"
  mkdir -p "$expanded"
  if ! tar -xzf "$store" -C "$expanded" 2>/dev/null; then
    case $store in
      *.partial.*) unavailable "interrupted archive $(shown "$store") could not be expanded in full: scanned only as far as it did expand, and as written" ;;
      *) die "could not expand $(shown "$store"): the backup would go unscanned" ;;
    esac
  fi
done

# Provider state through the metadata-only identity: names and versions, never values. A provider
# that cannot be asked yields an explicit unknown record, never an empty file that reads as "no
# secrets".
# This is an out-of-band observer: it asks from inside the container, so it still answers while
# `inject netsplit openbao` has the provider unreachable for every client. That is deliberate. An
# experiment needs the true provider state to judge what its own client concluded from outside.
# openbao-client-view.txt records what a client gets at the same moment, and versions.txt each
# container's network attachments, so a partition cannot be missed.
(
  export BAO_TOKEN=$BW_BAO_METADATA_TOKEN
  if ! running "$BAO" || ! bao token lookup >/dev/null 2>&1; then
    jq -cn '{unknown: "openbao stopped, sealed, paused or unreachable; no metadata could be read"}'
    exit 3
  fi
  # The CLI uses one exit code for "nothing here" and for a failed request, so a listing that
  # returns non-zero is recorded as unknown and the bundle is marked incomplete. An empty list is
  # never assumed.
  incomplete=0
  walk() {
    local prefix=$1 entry listing entries rc=0
    listing=$(bao kv list -mount=secret -format=json "$prefix" 2>/dev/null) || rc=$?
    if [ "$rc" -ne 0 ]; then
      jq -cn --arg path "$prefix" --argjson rc "$rc" '{path: $path, unknown: "listing empty or failed", exit_code: $rc}'
      incomplete=1
      return 0
    fi
    # Parsed first, its status looked at: a listing that is not the JSON array the CLI writes, cut
    # short or otherwise, would feed the loop nothing from a process substitution, and read as
    # empty. So would a jq that fails.
    # Held to an array: `.[]` iterates an object's values just as well, and an empty object would
    # read as an empty listing.
    if ! entries=$(jq -r 'if type == "array" then .[] else error("not an array") end' <<<"$listing" 2>/dev/null); then
      jq -cn --arg path "$prefix" '{path: $path, unknown: "listing could not be parsed"}'
      incomplete=1
      return 0
    fi
    while IFS= read -r entry; do
      [ -n "$entry" ] || continue
      case $entry in
        */) walk "$prefix$entry" ;;
        *)
          bao kv metadata get -mount=secret -format=json "$prefix$entry" 2>/dev/null |
            jq -c --arg path "$prefix$entry" '{path: $path, versions: .data.versions}' || {
            jq -cn --arg path "$prefix$entry" '{path: $path, unknown: "metadata read failed"}'
            incomplete=1
          }
          ;;
      esac
    done <<<"$entries"
  }
  walk ""
  rc=0
  keys=$(bao list -format=json transit/keys 2>/dev/null) || rc=$?
  if [ "$rc" -ne 0 ]; then
    jq -cn --argjson rc "$rc" '{transit_keys: null, unknown: "listing empty or failed", exit_code: $rc}'
    incomplete=1
    keys='[]'
  fi
  if ! key_names=$(jq -r 'if type == "array" then .[] else error("not an array") end' <<<"$keys" 2>/dev/null); then
    jq -cn '{transit_keys: null, unknown: "listing could not be parsed"}'
    incomplete=1
    key_names=
  fi
  while IFS= read -r key; do
    [ -n "$key" ] || continue
    bao read -format=json "transit/keys/$key" 2>/dev/null |
      jq -c --arg key "$key" '{transit_key: $key, latest: .data.latest_version, min_decryption: .data.min_decryption_version, deletion_allowed: .data.deletion_allowed}' || {
      jq -cn --arg key "$key" '{transit_key: $key, unknown: "key read failed"}'
      incomplete=1
    }
  done <<<"$key_names"
  [ "$incomplete" -eq 0 ] || exit 4
) >"$out/openbao-metadata.jsonl" || unavailable "openbao metadata incomplete (see the unknown records in openbao-metadata.jsonl)"

# The client view of the same provider: what anything outside the container gets on the published
# port. It sits next to the out-of-band metadata so that nobody reading healthy metadata can miss
# that clients could not reach the provider at that moment.
rc=0
# --noproxy: with http_proxy set in the caller's shell the request would go to the proxy, and any
# answer from the proxy would read as a reachable provider.
health=$(curl --noproxy '*' --silent --max-time 5 --output /dev/null --write-out '%{http_code}' \
  "http://127.0.0.1:$OPENBAO_PORT/v1/sys/health") || rc=$?
if [ "$rc" -eq 0 ]; then
  printf 'reachable: sys/health answered HTTP %s on the published port\n' "$health"
else
  printf 'unreachable: curl exit %s on the published port\n' "$rc"
fi >"$out/openbao-client-view.txt"
[ "$rc" -eq 0 ] || say "evidence: clients cannot reach openbao on its published port (curl exit $rc)"

# Digest of each node's machine config, normalized to exactly one trailing newline (the jsonpath
# output adds one). The config itself holds cluster secrets and is not copied into the bundle.
for node in "$TALOS_CONTROLPLANE_IP" "$TALOS_WORKER_IP"; do
  if config=$(talosctl_timed 20 -e "$node" -n "$node" \
    get machineconfig v1alpha1 -o jsonpath='{.spec}' 2>/dev/null) && [ -n "$config" ]; then
    printf '%s %s\n' "$(printf '%s\n' "$config" | sha256sum | cut -d' ' -f1)" "$node"
  else
    printf 'UNAVAILABLE %s\n' "$node"
    unavailable "machine config digest of $node"
  fi
done >"$out/talos-config-sha256.txt"
unset config

[ ! -f "$STATE/injections.log" ] || cp "$STATE/injections.log" "$out/injections.log"

# Leak scan. Counts only: a matched line is never printed. Any path or file the scan cannot read
# is fatal, because a skipped file reads exactly like a clean one.
scan=$out/leak-scan.txt
list=$(mktemp "$STATE/scan-list.XXXXXX")
trap 'rm -f -- "$list"' EXIT
# .state/backups is scanned as written too: that is the only form in which OpenBao snapshots, which
# OpenBao encrypts, are covered.
# -L: a symlinked path or file is followed and its target scanned. Without it find skips the link
# silently and the target reads as clean. A link that cannot be followed is therefore fatal too.
# The extra paths come last (below): of two spellings of one place the first is walked.
roots=("$out" "$STATE/backups")
# The live store may be gone: a store-restore killed between its two renames leaves it aside as
# store-restore.*/previous, and losing it is what a store snapshot is for. A root that does not
# exist fails the walk, which would void the scan of everything else.
if [ -e "$STATE/data" ]; then
  roots+=("$STATE/data")
else
  unavailable "live store directory $STATE/data is absent: nothing of it scanned but what a store-restore left aside"
fi
# What a store-restore killed outright leaves aside: the extracted store and, past its first
# rename, the earlier live one. Plaintext copies of the store both, scanned like the live directory.
# Never through a link: a staging directory that points outside .state would have the walk follow
# it there, and a copy of the control planted at the far end excused.
for staging in "$STATE"/store-restore.*; do
  [ ! -L "$staging" ] || die "$(shown "$staging") is a symlink; the fixture never makes one there. Results void"
  [ ! -e "$staging" ] || roots+=("$staging")
done
# What a capture that ended before its scan left: the bundle still marked incomplete holds the
# dump, the logs and the data directory of its moment, none of it scanned. Listed by find, so a
# dot-named entry counts; never through a link, as above. Listed into a file first: a listing
# that fails inside a process substitution would read as an empty one, and a sibling holding
# secret material would go unscanned while this capture reports a clean scan.
# Scanned once: at the end, once this scan ran, each such sibling is marked scanned by this
# bundle. A sibling scanned at every later capture would have the copy of a store archive it
# expanded reported as a leak from the first snapshot taken under that name since, although the
# capture that scanned it, and its report, were there before.
find "$STATE/evidence" -mindepth 1 -maxdepth 1 -print0 >"$out/.siblings" 2>/dev/null ||
  die "cannot list $STATE/evidence for captures that ended before their scan; results void"
siblings=()
while IFS= read -r -d '' sibling; do
  [ ! -L "$sibling" ] || die "$(shown "$sibling") is a symlink; the fixture never makes one there. Results void"
  # A marker that is a link: one that resolves is refused below as not a file to open, and one
  # that does not would read as no marker at all, the bundle taken for a completed capture and
  # left out of the scan. Neither is anything the fixture makes.
  [ "$sibling" = "$out" ] || [ ! -L "$sibling/.incomplete" ] ||
    die "the marker of the earlier capture $(shown "$sibling") is a symlink; the fixture never makes one there. Results void"
  [ "$sibling" = "$out" ] || [ ! -e "$sibling/.incomplete" ] || {
    # The marker locked, or the capture that made it is still running: its bundle is not all
    # there yet, and it scans itself. Held until the marker is removed below, so that no other
    # capture takes the same sibling meanwhile. A marker that cannot be opened cannot be told
    # either way, and a sibling left out by guess would go unscanned.
    # Looked at before exec opens it: on a redirection that fails, exec ends the shell with bash's
    # own message, which names the path.
    [ -f "$sibling/.incomplete" ] && [ ! -L "$sibling/.incomplete" ] && [ -r "$sibling/.incomplete" ] ||
      die "the marker of the earlier capture $(shown "$sibling") is not a file this capture can open; results void"
    # The mark this capture would leave there once its scan ran, if one is there already (a kill
    # between the mark and the marker's removal leaves one): the fixture writes a regular file
    # with that one name, and a link there would be written through, into whatever it names.
    # Refused now, before anything is scanned, rather than at the end with the scan done.
    if [ -L "$sibling/scanned-by.txt" ] || { [ -e "$sibling/scanned-by.txt" ] &&
      { [ ! -f "$sibling/scanned-by.txt" ] || [ "$(stat --format=%h -- "$sibling/scanned-by.txt" 2>/dev/null)" != 1 ]; }; }; then
      die "$(shown "$sibling/scanned-by.txt") is not the regular file evidence writes, with that one name; the fixture never makes anything else there. Results void"
    fi
    # Read-only, which flock locks all the same: opened for writing, a marker its capture removed
    # between the test above and here, its scan complete, would be made again, and that bundle
    # scanned once more at every capture after. One gone by now is a capture that completed.
    if ! { exec {sibling_lock}<"$sibling/.incomplete"; } 2>/dev/null; then
      say "evidence: the earlier capture $(shown "$sibling") completed meanwhile; it scanned itself"
      continue
    fi
    if flock --nonblock "$sibling_lock"; then
      say "evidence: an earlier capture ended before its leak scan; $(shown "$sibling") is scanned with this one"
      roots+=("$sibling")
      siblings+=("$sibling")
    else
      exec {sibling_lock}>&-
      say "evidence: another capture is still writing $(shown "$sibling"); it is left to its own scan"
    fi
  }
done <"$out/.siblings"
rm -- "$out/.siblings" || die "cannot remove the sibling listing from $out; results void"
roots+=("${extras[@]}")
dangling=$(find -L "${roots[@]}" -type l -print -quit 2>/dev/null) ||
  die "leak scan could not walk every path (a directory it may not read, most likely); results void"
[ -z "$dangling" ] || die "leak scan cannot follow the symlink $(shown "$dangling"); results void"
# Each root once by what it names, not by its spelling: an extra path that is a symlink to a root
# the scan has anyway, or lies under one, would have every file under it walked twice, counted
# twice, and the control's copy under the other spelling reported as a leak, since it is the
# control at one name only. Of two spellings the first is walked, the fixture's own names before
# the extra paths, and a root that holds one kept earlier takes its place, walked by the name it
# resolves to: the fixture's own roots are spelled as they resolve, and the control under a
# symlinked parent of the checkout would otherwise be met at the parent's spelling and not known.
# A root dropped, and the given spelling of one walked as it resolves, keep their own names for
# the name pass below, which may hold a secret. A symlink inside a walked directory is still
# followed, as before.
kept=() kept_at=() dropped=()
for root in "${roots[@]}"; do
  resolved=$(realpath -- "$root" 2>/dev/null) || die "leak scan cannot resolve $(shown "$root"); results void"
  keep=1 holds=0
  for i in "${!kept_at[@]}"; do
    if [ "$resolved" = "${kept_at[$i]}" ] || [ "${resolved#"${kept_at[$i]}"/}" != "$resolved" ]; then
      keep=0
      break
    fi
    if [ "${kept_at[$i]#"$resolved"/}" != "${kept_at[$i]}" ]; then
      dropped+=("${kept[$i]}")
      unset "kept[$i]" "kept_at[$i]"
      holds=1
    fi
  done
  if [ "$keep" -eq 1 ]; then
    if [ "$holds" -eq 1 ] && [ "$root" != "$resolved" ]; then
      dropped+=("$root")
      root=$resolved
    fi
    kept+=("$root")
    kept_at+=("$resolved")
  else
    dropped+=("$root")
  fi
done
roots=("${kept[@]}")
unset kept kept_at root resolved keep holds i

# The positive control is one file, plus its copy at the same place inside an expanded store
# snapshot, and only while it holds exactly what bin/up planted. A file that merely shares the
# name is a leak like any other, and so is a control whose content changed: one that gained a
# second secret, or whose canary was replaced by another credential.
control=$STATE/data/canary-control.txt
# is_store_copy <file>: the control's place inside one expanded store snapshot. Compared as strings,
# not as a regular expression: the bundle path holds the checkout path, and a `+` or a `.` in it
# would be read as an operator.
# The place may be in this bundle or in an incomplete sibling scanned with it: a copy expanded
# there by the capture that ended is the same control.
store_middle() { # store_middle <file>: the snapshot name, for the control's place in a bundle
  local rest=${1#"$STATE/evidence/"} bundle inside
  [ "$rest" != "$1" ] || return 1
  bundle=${rest%%/*}
  inside=${rest#"$bundle/backups/store-"}
  [ "$inside" != "$rest" ] || return 1
  [ "${inside%/data/canary-control.txt}" != "$inside" ] || return 1
  inside=${inside%/data/canary-control.txt}
  [ -n "$inside" ] && [[ $inside != */* ]] && printf '%s\n' "$inside"
}
is_store_copy() { store_middle "$1" >/dev/null; }
# store_archive_is_own <file>: the archive the store copy was expanded from is the regular file
# inject wrote, with no second name, and still the archive it was expanded from. Hard-linked
# outside .state, its compressed bytes match no pattern here, and the canary would survive
# teardown inside it while its copy was excused. And the copy in an incomplete sibling bundle
# was expanded from whatever carried the name then: the digest recorded next to the expansion
# must be the archive's now, or the copy is of some other archive, one that may be gone, or that
# had a second name when it was expanded, and is reported like any other hit.
store_archive_is_own() {
  local middle archive bundle recorded
  middle=$(store_middle "$1") || return 1
  # A complete archive that an interrupted store-snapshot left under its temporary name expands
  # under that name, which ends in .tgz.partial.<suffix> already. Unambiguous, because inject
  # refuses a snapshot name that holds `.partial.`; a file spelled that way was not published.
  case $middle in
    *.tgz.partial.*) archive=$STATE/backups/store-$middle ;;
    *) archive=$STATE/backups/store-$middle.tgz ;;
  esac
  [ ! -L "$archive" ] && [ -f "$archive" ] && [ "$(stat --format=%h -- "$archive" 2>/dev/null)" = 1 ] || return 1
  bundle=${1#"$STATE/evidence/"}
  bundle=${bundle%%/*}
  recorded=$STATE/evidence/$bundle/backups/store-$middle.sha256
  [ ! -L "$recorded" ] && [ -f "$recorded" ] || return 1
  recorded=$(cat -- "$recorded" 2>/dev/null) || return 1
  [[ $recorded =~ ^[0-9a-f]{64}$ ]] || return 1
  [ "$recorded" = "$(sha256sum <"$archive" 2>/dev/null | cut -d' ' -f1)" ]
}
# is_live_control <file>: the control's own place, or, while the live directory is gone, the
# place a store-restore killed between its two renames moved it to.
is_live_control() {
  local rest
  [ "$1" != "$control" ] || return 0
  [ ! -e "$STATE/data" ] || return 1
  rest=${1#"$STATE/store-restore."}
  [ "$rest" != "$1" ] || return 1
  [ "${rest%/previous/canary-control.txt}" != "$rest" ] || return 1
  rest=${rest%/previous/canary-control.txt}
  [ -n "$rest" ] && [[ $rest != */* ]]
}
is_control() { # is_control <file>
  if ! is_live_control "$1"; then
    is_store_copy "$1" && store_archive_is_own "$1" || return 1
  fi
  # Not a symlink: find -L and cmp both follow one, and a control that points at a file outside
  # .state would excuse a canary that lives there and survives teardown. The same goes for its
  # data directory; everything above that is the fixture's own.
  [ ! -L "$1" ] && [ ! -L "$(dirname -- "$1")" ] || return 1
  # Nor a second name for a file that also exists elsewhere: a hard link passes both tests above,
  # and the other name survives teardown just the same. A link count that cannot be read is not 1.
  [ "$(stat --format=%h -- "$1" 2>/dev/null)" = 1 ] || return 1
  cmp --silent -- "$1" <(control_content)
}
secret_in_name() { # secret_in_name <path>
  local rc=0
  grep --quiet --fixed-strings --file="$STATE/scan-patterns.txt" <<<"$1" || rc=$?
  [ "$rc" -le 1 ] || die "leak scan could not match a path name against the patterns; results void"
  [ "$rc" -eq 0 ]
}

# Each path once: a path given twice under one spelling is listed once.
find -L "${roots[@]}" -type f -print0 2>/dev/null | sort --zero-terminated --unique >"$list" ||
  die "leak scan could not walk every path; results void"
: >"$scan"
control_seen=0
others=
# Files the content pass reported, so that the name pass below does not report one of them again:
# a file with a secret in its name and one in its content is one file.
declare -A reported=()
while IFS= read -r -d '' file; do
  [ "$file" != "$scan" ] || continue
  # Occurrences, not matching lines: two secrets on one line are two hits.
  rc=0
  # --no-messages: grep names the file it cannot read, and that name may hold a secret. Its exit
  # status says the same, and the message below goes through `shown`.
  found=$(grep --no-messages --text --fixed-strings --only-matching --file="$STATE/scan-patterns.txt" "$file") || rc=$?
  [ "$rc" -le 1 ] || die "leak scan could not read $(shown "$file"); results void"
  hits=$(sed '/^$/d' <<<"$found" | wc -l)
  unset found
  [ "$hits" -gt 0 ] || continue
  reported[$file]=1
  printf '%s %s\n' "$hits" "$(shown "$file")" >>"$scan"
  # The control counts as found only once its content is the planted one: overwritten with another
  # secret it has hits, and is a leak, not the control.
  if is_control "$file"; then
    ! is_live_control "$file" || control_seen=1
  else
    others+="$hits $(shown "$file")"$'\n'
  fi
done <"$list"

# A secret can sit in a name as well as in a file: every directory entry under the same paths,
# directories included, is matched too, and the own name of a root not walked for being another
# spelling of one that was.
{ find -L "${roots[@]}" -print0 2>/dev/null &&
  { [ "${#dropped[@]}" -eq 0 ] || printf '%s\0' "${dropped[@]}"; }; } | sort --zero-terminated --unique >"$list" ||
  die "leak scan could not walk every path; results void"
while IFS= read -r -d '' entry; do
  [ -z "${reported[$entry]:-}" ] || continue
  hit=0
  ! secret_in_name "$entry" || hit=1
  # The text of a symlink is stored data too: the content pass reads what the link points at and
  # the test above reads what the link is called, so a secret in the target path is in neither.
  if [ "$hit" -eq 0 ] && [ -L "$entry" ]; then
    target=$(readlink -- "$entry" 2>/dev/null) || die "leak scan could not read the link $(shown "$entry"); results void"
    ! secret_in_name "$target" || hit=1
    unset target
  fi
  [ "$hit" -eq 1 ] || continue
  printf '1 %s\n' "$(shown "$entry")" >>"$scan"
  others+="1 $(shown "$entry")"$'\n'
done <"$list"
rm -f "$list"

[ "$control_seen" -eq 1 ] ||
  die "leak scan did not find its positive control $control: the scan is broken, results void"
leaks=$(sed '/^$/d' <<<"$others" | wc -l)
others=${others%$'\n'}

say "leak scan: positive control found; $leaks other file(s) contain synthetic secret material"
[ "$leaks" -eq 0 ] || say "$others"
rm -- "$out/.incomplete" || die "the scan ran, but the bundle $out could not be marked complete; the next capture scans it again"
# The siblings scanned with this bundle: marked scanned by it, the marker removed last, so that a
# kill in between leaves the sibling to be scanned again rather than marked without the name. The
# mark is written aside and renamed into place: a rename replaces whatever entry is under the name,
# a link put there since the check above included, and never writes through it.
for sibling in "${siblings[@]}"; do
  mark=
  { mark=$(mktemp "$sibling/scanned-by.XXXXXX") && printf '%s\n' "$out" >"$mark" &&
    mv --no-target-directory -- "$mark" "$sibling/scanned-by.txt" && rm -- "$sibling/.incomplete"; } 2>/dev/null || {
    rm -f -- "${mark:-$sibling/scanned-by.none}"
    die "the scan ran, but the earlier capture $(shown "$sibling") could not be marked scanned; the next capture scans it again"
  }
done
[ ! -f "$out/unavailable.txt" ] || say "evidence: INCOMPLETE, see $out/unavailable.txt"
printf '%s\n' "$out" # the only line on stdout: the bundle path
