#!/usr/bin/env bash
# Remove everything bin/up created, including after a failed or interrupted up, then prove it.
# Usage: down [--purge] [--adopt]
#   --purge  also delete the downloaded CLI cache
#   --adopt  also remove a fixture this checkout cannot show to be its own (see below)
set -uo pipefail
# shellcheck source-path=SCRIPTDIR source=../lib.sh
. "$(dirname "$0")/../lib.sh"

purge=0
adopt=0
for arg in "$@"; do
  case $arg in
    --purge) purge=1 ;;
    --adopt) adopt=1 ;;
    *) die "usage: down [--purge] [--adopt]" ;;
  esac
done

need docker stat mktemp
# Every removal and every check below asks Docker. If it does not answer, nothing can be removed
# or verified, and the state directory that names what to remove must survive.
docker info >/dev/null 2>&1 || die "the Docker daemon does not answer; nothing was removed"
# And it is the daemon up created the fixture on: another would be verified clean and the state
# removed while the fixture runs on.
daemon_own
talos_label=talos.cluster.name=$FIXTURE_NAME
compose_label=com.docker.compose.project=$FIXTURE_NAME

# Names, ports and subnet are pinned, so every checkout on one Docker daemon shares them, and the
# labels above select another checkout's fixture just as well. Compose records the directory a
# project was started from; the Talos containers carry no such mark, so for them the only sign of
# ownership is a state directory here.
# Networks and named volumes count too: they outlive containers that were removed by hand, and
# `compose down --volumes` would delete them just the same.
existing=$(
  claim_names &&
    docker ps --all --quiet --filter "label=$compose_label" &&
    docker ps --all --quiet --filter "label=$talos_label" &&
    docker network ls --quiet --filter "label=$compose_label" &&
    docker network ls --quiet --filter "label=$talos_label" &&
    docker volume ls --quiet --filter "label=$compose_label"
) || die "could not list the fixture's Docker resources; nothing was removed"
claimed_by=$(claim_owner) || die "could not read who holds the fixture claim; nothing was removed"
# A container carrying the claim label under another name is not the claim, whatever else it
# carries, and someone's: refused before anything is removed, --adopt or not, since the claim is
# dropped by its label's name at the end and the label alone would select this one too.
strangers=$(claim_strangers) || die "could not list the containers carrying the fixture claim label; nothing was removed"
[ -z "$strangers" ] ||
  die "$(tr '\n' ' ' <<<"$strangers")carries the fixture claim label without being the claim $CLAIM; it is not the fixture's, and nothing was removed. Remove or relabel it first"
owners=$(
  printf '%s\n' "$claimed_by" &&
    docker ps --all --quiet --filter "label=$compose_label" |
    xargs --no-run-if-empty docker inspect \
      --format '{{index .Config.Labels "com.docker.compose.project.working_dir"}}'
) || die "could not read who owns the fixture containers; nothing was removed"
foreign=$(grep --invert-match --line-regexp --fixed-strings -- "$FIXTURES" <<<"$owners" | sed '/^$/d' | sort -u)
if [ "$adopt" -eq 0 ] && [ -n "$existing" ]; then
  [ -z "$foreign" ] ||
    die "the fixture on this Docker daemon was started from $foreign, not from here; nothing was removed. Run its own fixtures/bin/down, or pass --adopt if that checkout is gone"
  # The claim `up` took here is the one mark that shows the resources to be this checkout's own, and
  # it is dropped last, below, so a teardown that could not finish still holds it. A state directory
  # is no such mark: it can be left over from a fixture whose resources were removed by hand, while
  # what exists now is the rest of another checkout's fixture.
  [ "$claimed_by" = "$FIXTURES" ] ||
    die "fixture containers, networks or volumes exist, but no claim taken from this checkout shows them to belong to it; nothing was removed. Pass --adopt to remove them anyway"
fi
# A credential file with a second name would keep its secret past this teardown. Refused before
# anything is removed, so that the fixture stays there to be looked at.
state_files_own

# The Talos label is a cluster name, and any container or network can be created with it; the
# removal below selects by that label. bin/up recorded the IDs of the containers and the network it
# created (held to the one-name rule by state_files_own above), so everything carrying the label
# must be among them. With labelled resources and no record, as an up interrupted right after
# creating the cluster leaves it, the label is all there is, and removing by it is what --adopt
# asks for, not a plain down. With a record, --adopt changes nothing: a labelled resource the
# record does not name is someone's, and is not removed as the fixture's by any down. The Compose
# network is the same case: its labels are only the project's, which any network can be given,
# and `compose down` removes it as the project's.
# recorded_only <kind> <mark> <record> <listing...>: every ID the listing gives is in the record.
# The IDs it held to the record are left in `held`: the removals below take those, not a fresh
# listing by the label, which would take in a resource given the label since this check.
recorded_only() {
  local kind=$1 mark=$2 record=$3 labelled recorded id
  shift 3
  labelled=$("$@") || die "could not list the $mark ${kind}s; nothing was removed"
  held=$labelled
  if [ -f "$record" ]; then
    # The first field: a container record names each ID under its container name.
    recorded=$(cut -d' ' -f1 -- "$record") || die "could not read the recorded $mark $kind IDs; nothing was removed"
    for id in $labelled; do
      grep --quiet --line-regexp --fixed-strings -- "$id" <<<"$recorded" ||
        die "the $kind $id carries this fixture's $mark label but is not one bin/up created; nothing was removed. Remove it by hand"
    done
  elif [ -n "$labelled" ] && [ "$adopt" -eq 0 ]; then
    die "${kind}s carry this fixture's $mark label but bin/up left no record of which it created, as an up interrupted right after creating them leaves it; nothing was removed. Pass --adopt to remove every $kind with the label"
  fi
}
held=
recorded_only container Talos "$STATE/down-node-containers" docker ps --all --quiet --no-trunc --filter "label=$talos_label"
talos_containers=$held
recorded_only container Compose "$STATE/down-compose-containers" docker ps --all --quiet --no-trunc --filter "label=$compose_label"
recorded_only network Talos "$STATE/down-node-networks" docker network ls --quiet --no-trunc --filter "label=$talos_label"
talos_networks=$held
recorded_only network Compose "$STATE/down-compose-networks" docker network ls --quiet --no-trunc --filter "label=$compose_label"
unset held
# A snapshot with a second name, or one that is a symlink, keeps its secret past this teardown:
# the removal of .state below takes the one name here and leaves the other. The one-name rule
# for the files bin/up generated is checked in state_files_own; the snapshots inject published
# are checked here, where the secret would otherwise be left behind.
# Asked of find, not a glob: a glob skips names that start with a dot, and a dot is no defence.
# Without -L a symlink is not a regular file, so the one test covers links of both kinds.
if [ -d "$STATE/backups" ]; then
  backup=$(find "$STATE/backups" -mindepth 1 -maxdepth 1 \( ! -type f -o -links +1 \) -print -quit) ||
    die "could not list $STATE/backups; nothing was removed"
  [ -z "$backup" ] ||
    die "$backup is not a regular file with that one name; its content would outlive this teardown under the other name. Remove that name first; nothing was removed"
  unset backup
fi
# The Talos state directory names what `talosctl cluster destroy` acts on. Through a link, that
# would be someone else's state. .state/talos itself is refused as a link by lib.sh.
for talos_state in "$STATE/talos/$FIXTURE_NAME" "$STATE/talos/$FIXTURE_NAME/state.yaml"; do
  [ ! -L "$talos_state" ] || die "$talos_state is a symlink; the fixture never makes one there. Nothing was removed"
done
# And the file itself with one name: `talosctl cluster destroy` acts on what it describes, and a
# hard link to someone else's state would have it act on theirs while the other name survives.
talos_state=$STATE/talos/$FIXTURE_NAME/state.yaml
if [ -e "$talos_state" ] && { [ ! -f "$talos_state" ] || [ "$(stat --format=%h -- "$talos_state" 2>/dev/null)" != 1 ]; }; then
  die "$talos_state is not a regular file with that one name; the fixture never makes one there. Nothing was removed"
fi
unset talos_state
# A volume under one of the names compose.yaml gives its own, without the project label, is not
# the fixture's and never was: Compose does not make one without the label. `compose down
# --volumes` below would remove it all the same, so it stops the teardown, --adopt or not.
# The project label itself is only the project name, which any Compose run of that name from
# anywhere puts on the volumes it makes, and a volume has no ID: with this run's volume removed
# by hand, a name could be taken again under the same label. bin/up made the volumes itself,
# labelled with the run, and recorded name and run (held to the one-name rule by state_files_own
# above); a labelled volume is removed only as the run recorded, --adopt or not: one the record
# does not name is someone's, made under the name while this fixture's was gone, or the one an up
# that lost the race for the name found there. Without the record, as an up interrupted right
# after making the volumes leaves it, the label is all there is, and that is for --adopt.
compose_volumes=$(compose_volume_names) || die "could not read the volume names from compose.yaml; nothing was removed"
if [ -f "$STATE/down-compose-volumes" ]; then
  compose_volume_record=$(cat "$STATE/down-compose-volumes") || die "could not read the recorded Compose volumes; nothing was removed"
else
  compose_volume_record=
fi
for compose_volume in $compose_volumes; do
  if identity=$(docker volume inspect --format "{{index .Labels \"com.docker.compose.project\"}} {{.Name}} {{index .Labels \"$RUN_LABEL\"}}" "$compose_volume" 2>&1); then
    [ "${identity%% *}" = "$FIXTURE_NAME" ] ||
      die "the volume $compose_volume carries no fixture label and is someone's data under a name compose.yaml uses; nothing was removed. Remove or rename it by hand"
    if [ -n "$compose_volume_record" ]; then
      grep --quiet --line-regexp --fixed-strings -- "${identity#* }" <<<"$compose_volume_record" ||
        die "the volume $compose_volume carries this fixture's label but is not the one bin/up made (it does not carry the run recorded); nothing was removed. Remove it by hand"
    elif [ "$adopt" -eq 0 ]; then
      die "the volume $compose_volume carries this fixture's label but bin/up left no record of the volumes it made, as an up interrupted right after making them leaves it; nothing was removed. Pass --adopt to remove it by the label"
    fi
  else
    case $identity in
      *[Nn]o\ such\ volume*) ;;
      *) die "could not inspect the volume $compose_volume: $identity; nothing was removed" ;;
    esac
  fi
done
unset compose_volumes compose_volume compose_volume_record identity

# Talos node volumes are anonymous and unlabelled, so collect their names while the containers
# still exist. After a create that failed before the container existed they cannot be attributed:
# see "Known limits" in fixtures/README.md.
# shellcheck disable=SC2119  # of every labelled container: no IDs on purpose
volume_names=$(talos_volume_names) || die "could not list the Talos node volumes; nothing was removed"
# Held to what a Talos node's volume is, an anonymous one, before the names go into the record
# below: a labelled container that mounts a named volume (under --adopt, with no record to hold
# the containers to, the label is all there is) would otherwise put that name into the record,
# and every down after would refuse the record as not the fixture's.
for volume in $volume_names; do
  [[ $volume =~ ^[0-9a-f]{64}$ ]] ||
    die "a container carrying this fixture's Talos label mounts the volume '$volume', which is no anonymous volume of a Talos node; nothing was removed. Remove that container by hand"
done
# Without the record bin/up writes once the cluster exists, which a checkout that adopts another's
# fixture never has, only the nodes whose containers still exist name their volumes. With fewer
# than both of them, this run cannot say that no node volume is left, and must not. Remembered in
# the state directory as well: the list written below would pass for the record on a second run.
# The containers counted are the ones recorded_only held above, not a fresh listing.
# A marker that is a link, dangling or not: `-e` reads a dangling one as absent, and the
# uncertainty an earlier run recorded would be dropped. The fixture never makes one there.
[ ! -L "$STATE/down-node-volumes-incomplete" ] ||
  die "$STATE/down-node-volumes-incomplete is a symlink; the fixture never makes one there. Nothing was removed"
volumes_known=1
if [ -e "$STATE/down-node-volumes-incomplete" ] ||
  { [ -n "$existing" ] && [ ! -f "$STATE/down-node-volumes" ] && [ "$(sed '/^$/d' <<<"$talos_containers" | wc -l)" -lt 2 ]; }; then
  volumes_known=0
  # Published by rename: a marker that is a hard link must not have the write go through it into
  # someone else's file.
  if [ -d "$STATE" ]; then
    marker=
    if ! marker=$(mktemp "$STATE/down-node-volumes-incomplete.XXXXXX") ||
      ! mv --no-target-directory -- "$marker" "$STATE/down-node-volumes-incomplete"; then
      rm -f -- "${marker:-$STATE/down-node-volumes-incomplete.none}"
      die "could not record in $STATE that the Talos node volumes are not all known; nothing was removed"
    fi
  fi
fi
# Remembered in the state directory, where bin/up already put the names it saw after creating the
# cluster: containers that were removed by hand, or by an earlier down that could not finish, leave
# volumes that only this list still ties to the fixture.
if [ -d "$STATE" ]; then
  # The record is what the removal loop below trusts with `docker volume rm`. Only the regular
  # file bin/up wrote, under that one name: through a link, symbolic or hard, someone else's file
  # would name the volumes to remove.
  if [ -L "$STATE/down-node-volumes" ] || { [ -e "$STATE/down-node-volumes" ] &&
    { [ ! -f "$STATE/down-node-volumes" ] || [ "$(stat --format=%h -- "$STATE/down-node-volumes" 2>/dev/null)" != 1 ]; }; }; then
    die "$STATE/down-node-volumes is not the regular file bin/up writes, with that one name; nothing was removed"
  fi
  # Merged, then published by rename: an append cut short by a signal or a full disk would leave
  # a name without its newline for the next run to append onto, and the record it trusts would
  # then hold a name that is no volume's. A record whose last line lacks its newline (the same
  # interruption, before this change) is read with one supplied.
  if [ -f "$STATE/down-node-volumes" ]; then
    recorded=$(cat "$STATE/down-node-volumes") ||
      die "could not read the recorded Talos node volumes; nothing was removed"
  else
    recorded=
  fi
  merged=$(mktemp "$STATE/down-node-volumes.XXXXXX") ||
    die "could not record the Talos node volumes in $STATE; nothing was removed"
  if ! printf '%s\n%s\n' "$recorded" "$volume_names" | sed '/^$/d' | sort -u >"$merged" ||
    ! mv --no-target-directory -- "$merged" "$STATE/down-node-volumes"; then
    rm -f -- "$merged"
    die "could not record the Talos node volumes in $STATE; nothing was removed"
  fi
  volume_names=$(cat "$STATE/down-node-volumes") ||
    die "could not read the recorded Talos node volumes; nothing was removed"
fi
mapfile -t node_volumes < <(sed '/^$/d' <<<"$volume_names" | sort -u)
# The record names what `docker volume rm` below removes, and its content can be written by anyone
# who can write under .state. Each name is held to what the daemon itself says of a Talos node
# volume: an anonymous one, so a 64-digit hex name, with no label. A name that fails is refused
# with nothing removed; one that names no volume any more is what an earlier removal leaves and
# passes. Not the volume's age against the claim's: selftest re-takes the claim after the cluster
# exists, and so would any recovery that did. What stays open is in fixtures/README.md.
for volume in "${node_volumes[@]}"; do
  [[ $volume =~ ^[0-9a-f]{64}$ ]] ||
    die "the recorded node volume '$volume' is not an anonymous volume's name; the record was not written by the fixture. Nothing was removed"
  # A name that names no volume any more is what an earlier removal leaves and passes; any other
  # failure to ask is not that, and must not read as it.
  if ! labels=$(docker volume inspect --format '{{len .Labels}}' "$volume" 2>&1); then
    case $labels in
      *[Nn]o\ such\ volume*) continue ;;
      *) die "could not inspect the recorded node volume $volume: $labels; nothing was removed" ;;
    esac
  fi
  [ "$labels" = 0 ] ||
    die "the recorded node volume $volume carries labels, which a Talos node volume never does; nothing was removed"
done
unset labels

# Name the project, its directory and its file, so that neither a compose.yaml in the caller's
# working directory nor a COMPOSE_PROJECT_NAME in the caller's shell can choose what is torn down.
# The file and the environment are the copies bin/up recorded, the ones the services were created
# from (compose_inputs in lib.sh). The password is only interpolated, never used, by `down`.
compose_inputs
BW_POSTGRES_PASSWORD=${BW_POSTGRES_PASSWORD:-unused} docker compose --project-name "$FIXTURE_NAME" \
  --project-directory "$FIXTURES" --file "$compose_file" --env-file "$compose_env" \
  down --volumes --remove-orphans 2>&1 | sed 's/^/  /' >&2
unset compose_file compose_env

# talosctl here is the function from lib.sh, that is the cached binary the guard tests. Its status,
# like that of every removal below, is not what decides: the probes further down are.
if [ -x "$CACHE/talosctl" ] && [ -f "$STATE/talos/$FIXTURE_NAME/state.yaml" ]; then
  talosctl cluster destroy --name "$FIXTURE_NAME" --state "$STATE/talos" 2>&1 | sed 's/^/  /' >&2
fi
# What talosctl cannot see: a create that failed before it wrote state.yaml. Exactly the IDs held to
# the record above (or, without one, listed under --adopt): a listing taken now would take in a
# container or network given the label since, which no record vouches for. One removed already, by
# talosctl, fails as no such container, which the probes below do not read as left.
for id in $talos_containers; do
  docker rm --force --volumes "$id" >/dev/null 2>&1
done
for id in $talos_networks; do
  docker network rm "$id" >/dev/null 2>&1
done
unset talos_containers talos_networks
for volume in "${node_volumes[@]}"; do
  docker volume rm "$volume" >/dev/null 2>&1
done

# A query that fails lists nothing, which reads exactly like "nothing left". Keep the two apart.
left=
unverified=0
probe() { # probe <kind> <command...>: the command lists names, one per line
  local kind=$1 names name
  shift
  if names=$("$@"); then
    while IFS= read -r name; do
      [ -z "$name" ] || left+="$kind $name"$'\n'
    done <<<"$names"
  else
    unverified=1
  fi
}
# verdict: leaves with status 1 unless everything probed so far is verifiably gone. The state
# directory then stays: it names the node volumes for the next run.
verdict() {
  if [ -n "$left" ]; then
    say "fixtures: leftovers after down:"
    say "${left%$'\n'}"
  fi
  [ "$unverified" -eq 0 ] || say "fixtures: a Docker query failed, so what is left could not be verified"
  if [ -n "$left" ] || [ "$unverified" -ne 0 ]; then
    [ ! -e "$STATE" ] || say "fixtures: $STATE is kept, so that down can be run again"
    exit 1
  fi
}
probe container docker ps --all --filter "label=$talos_label" --format '{{.Names}}'
probe container docker ps --all --filter "label=$compose_label" --format '{{.Names}}'
probe network docker network ls --filter "label=$talos_label" --format '{{.Name}}'
probe network docker network ls --filter "label=$compose_label" --format '{{.Name}}'
probe volume docker volume ls --filter "label=$compose_label" --format '{{.Name}}'
# volume_exact <name>: the name, if a volume of exactly that name exists. Docker documents its name
# filter as matching part of a name too (observed to take an anchored regular expression, which
# the documentation does not promise), so the listing is held to the whole name here.
volume_exact() {
  local names
  names=$(docker volume ls --quiet --filter "name=$1") || return 1
  grep --line-regexp --fixed-strings -- "$1" <<<"$names" || [ $? -eq 1 ]
}
for volume in "${node_volumes[@]}"; do
  probe volume volume_exact "$volume"
done
verdict
# The claim goes only now. It is what shows a second run that leftovers are this checkout's own, so
# a teardown that could not finish keeps it, and the next plain down is not refused.
claim_drop
probe container claim_names
verdict
# The state directory goes last of all, after a verified clean teardown. The daemon record goes
# last within it, and the two Compose records with it: a removal cut short in the middle (a
# signal, a file that would not go) leaves a directory that up refuses as existing and, without
# the daemon record, down would refuse as not one up left, so that what is left, evidence and
# secrets among it, could only be removed by hand. With the record still there, the next plain
# down removes the rest. The Compose records go together, the compose file first: Compose is run
# from the recorded compose file whenever it is there, with the recorded environment beside it,
# and a cut that left the one without the other would have the next down fail before it could
# start; one that left the environment alone has the checkout's files taken, which the guard at
# load holds to that record.

case $STATE in
  */fixtures/.state)
    find "$STATE" -mindepth 1 -maxdepth 1 ! -name up-daemon ! -name up-compose.yaml ! -name up-versions.env -exec rm -rf -- {} + &&
      rm -f -- "$STATE/up-compose.yaml" "$STATE/up-versions.env" "$STATE/up-daemon" &&
      rmdir -- "$STATE"
    ;;
  *) die "refusing to delete unexpected state path $STATE" ;;
esac
if [ "$purge" -eq 1 ]; then
  case $CACHE in
    */fixtures/.cache) rm -rf -- "$CACHE" ;;
    *) die "refusing to delete unexpected cache path $CACHE" ;;
  esac
  [ ! -e "$CACHE" ] || die "the fixture is down, but could not remove $CACHE"
fi
[ ! -e "$STATE" ] || die "could not remove $STATE"
if [ "$volumes_known" -eq 1 ]; then
  say "fixture is down: no containers, networks, volumes or state left"
else
  say "fixture is down: no containers, networks, labelled volumes or state left. Not looked for, because nothing recorded their names: Talos node volumes whose containers were gone before down ran. \`docker volume ls --filter dangling=true\` lists every candidate on this daemon"
fi
