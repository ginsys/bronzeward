# The configuration of fixture instances A and B, rendered by bin/up into .state/server/{a,b}/
# with @DSN@ replaced (mode 0600). The DSN reaches PostgreSQL by its service name on the Compose
# network; the password in it is this run's synthetic one, a leak-scan pattern.
listen: 0.0.0.0:8080
database:
  dsn: @DSN@
auth:
  oidc:
    issuer: http://issuer:5556
    plainHTTPHosts: [issuer]
    audience: bronzeward
    groupsClaim: groups
    maxTokenLifetime: 15m
  roles: # the fixture issuer's groups (fixtures/oidc/issuer, Humans)
    viewer: [bw-viewers]
    author: [bw-authors]
    publisher: [bw-publishers]
    approver: [bw-approvers]
    recovery-admin: [bw-recovery]
  deniedSubjects: []
execution:
  settleFloor: 30s
  maxTransportDeadline: 5m
# The fixture's OpenBao, by its service name, and the keys and ingestion token bin/up made for
# this instance (openbao-ingestion.token sits beside this file, mode 0600, one per instance).
provider:
  address: http://openbao:8200
  plainHTTPHosts: [openbao]
  keys: {baseline: bw-baseline, staging: bw-staging, digest: bw-digest}
  ingestionTokenFile: /etc/bronzeward/openbao-ingestion.token
# The staging claims' timers (compilation.md §3.2: only heartbeat < lease < absolute expiry is
# required) and this instance's name, which starts its claims' owner identity.
ingestion:
  instance: @INSTANCE@
  heartbeat: 5s
  lease: 15s
  absoluteExpiry: 10m
  sweep: 15s
