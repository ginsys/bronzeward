# Every HTTP read of T9 is t9_auth | t9_get, and every answer passes t9_head_ok. curl exits 0 on an
# HTTP error, so only the answer's status line and content type tell a refused or wrong read from
# an event stream. scripts/test/participant-session-test.sh runs t9_open and t9_read against a stub.
t9_op='' t9_reader=''
# t9_auth: the automation token's header line, which A accepts on either issuer, for curl's stdin.
# The builtin printf keeps the token off every command line.
t9_auth() { printf 'Authorization: Bearer %s\n' "$(<"$STATE/automation-token")"; }
# t9_get <file> <seconds> [last event ID]: the event stream of t9_op on A, with the header line on
# stdin. The body goes to <file>, the answer's headers to <file>.headers. It replaces its shell with
# curl, so it runs only as the last command of a pipeline: in the background, $! is then curl's.
# Its callers remove an earlier read's files first, in their own shell, so that those cannot pass
# for this read's.
t9_get() {
  local resume=()
  [ -z "${3:-}" ] || resume=(--header "Last-Event-ID: $3")
  exec curl --disable --noproxy '*' --silent --no-buffer --max-time "$2" --output "$1" --dump-header "$1.headers" \
    --header @- --header 'Accept: text/event-stream' ${resume[@]+"${resume[@]}"} \
    "http://127.0.0.1:$SERVER_A_PORT/api/v1/operations/$t9_op/events"
}
# t9_head_ok <what> <file>: the step fails unless the last answer in <file>.headers is 200 with an
# event stream. curl writes the headers as they arrive, so a stream still open can be checked.
t9_head_ok() {
  local got
  [ -s "$2.headers" ] || die "$1 got no answer from A"
  got=$(tr -d '\r' <"$2.headers" | awk '
    tolower($0) ~ /^http\// { code = $2; type = "" }
    tolower($0) ~ /^content-type:/ { sub(/^[^:]*: */, ""); type = tolower($0) }
    END { if (code != "") print code " " type }')
  case $got in
    '200 text/event-stream' | '200 text/event-stream;'*) ;;
    *) die "$1 was refused: HTTP ${got:-no answer}, not 200 with an event stream" ;;
  esac
}
# t9_read <what> <file> <seconds> [last event ID]: a read that must end by itself, with 200 and an
# event stream.
t9_read() {
  local what=$1 rc=0
  shift
  rm -f -- "$1" "$1.headers"
  t9_auth | t9_get "$@" || rc=$?
  t9_head_ok "$what" "$1"
  [ "$rc" -eq 0 ] || die "$what did not end by itself (curl $rc)"
}
# t9_open <file>: the reader before the stop, in the background as t9_reader. The step fails unless
# A answered 200 with an event stream, sent an event within 20 s, and the stream is still open.
t9_open() {
  rm -f -- "$1" "$1.headers"
  t9_auth | t9_get "$1" 600 >/dev/null 2>&1 &
  t9_reader=$!
  for _ in $(seq 20); do
    [ -n "$(t9_ids "$1" 2>/dev/null)" ] && break
    kill -0 "$t9_reader" 2>/dev/null || break
    sleep 1
  done
  t9_head_ok "the stream on A" "$1"
  [ -n "$(t9_ids "$1")" ] || die "the stream on A sent no event within 20 s"
  # The reader must still be open at the stop: one that already ended, by the apply's end or a
  # failure of its own, met no stop.
  kill -0 "$t9_reader" 2>/dev/null || die "the stream on A ended before the stop; run t9 disconnect right after the t9 setup"
}
# t9_ids <file>...: the IDs of the complete events the streams sent, in order. An event is complete
# at its blank line; one that the stop cut off is not counted, so its resumption must send it.
# Each file is parsed alone, so an unfinished event at a file's end is dropped, never completed by
# the next file's lines.
t9_ids() {
  local f
  for f in "$@"; do
    tr -d '\r' <"$f" | awk '/^id:/ { sub(/^id: */, ""); id = $0 } /^$/ { if (id != "") print id; id = "" }'
  done
}
# t9_clean: on any exit of t9 disconnect, the reader ends and A runs again with its forwarder to
# Zitadel, so that the participant's server is never left stopped or unable to sign anyone in. A
# start of A that failed or was interrupted can leave A running with no forwarder in its namespace.
# Each repair runs in a subshell, because forward_idp ends the shell on a failure, and the message
# to recreate the fixture must still be printed.
t9_clean() {
  if [ -n "$t9_reader" ]; then
    kill "$t9_reader" 2>/dev/null || true
    wait "$t9_reader" 2>/dev/null || true
    t9_reader=''
  fi
  if ! running "$BW_A"; then
    echo "t9 disconnect: A is started again" >&2
    (restart_a) >>"$log" 2>&1 || echo "A could not be started again; recreate the fixture" >&2
  elif ! idp_reached; then
    echo "t9 disconnect: A runs without its forwarder to Zitadel; the forwarder is started again" >&2
    (forward_idp) >>"$log" 2>&1 || echo "A's forwarder to Zitadel could not be started again; recreate the fixture" >&2
  fi
}

# t9_disconnect: A stopped for 60 s and started again while the participant follows T9's apply,
# so that the participant's event stream ends and must be resumed (journeys §5.7). The clients do
# not follow an operation yet (ginsys/bronzeward#354 and #359), so this step proves the server half
# with its own reader: a stream opened before the stop and resumed with Last-Event-ID after the
# start follows the apply to its end, and its event IDs equal those of a full replay, none lost
# and none repeated. If the apply does not survive A's restart, the step fails.
t9_disconnect() {
  local dir=$part/t9-disconnect rc last state
  t9_op=$(sql "SELECT id FROM operation WHERE kind = 'apply-config' AND machine = '$(worker)' ORDER BY seq DESC LIMIT 1")
  [ -n "$t9_op" ] || die "no apply-config operation on the worker; run the t9 setup first"
  state=$(sql "SELECT state FROM operation WHERE id = '$t9_op'")
  case $state in
    completed | rejected | failed | cancelled) die "the apply ended ($state) before the disconnect; run t9 disconnect right after the t9 setup" ;;
  esac
  rm -rf -- "$dir"
  mkdir -p -- "$dir"
  trap t9_clean EXIT
  trap 'exit 130' INT TERM
  t9_open "$dir/before"
  "$bin/inject" kill A >>"$log" 2>&1 || die "cannot stop A; its output is in $log"
  rc=0
  wait "$t9_reader" || rc=$?
  t9_reader=''
  # Only a stream that the stop cut is resumed, and curl names a cut connection by 18 (the transfer
  # closed with data outstanding) or 56 (a receive failure). Any other status fails: 0 met the
  # apply's end first, 28 curl's limit, and a signal or another error ended the reader on its own.
  case $rc in
    18 | 56) ;;
    0) die "the apply ended before the stop; run t9 disconnect right after the t9 setup" ;;
    *) die "the stream on A ended with curl status $rc, not by the stop's cut connection" ;;
  esac
  echo "A is stopped for 60 s: the participant's event stream has ended"
  sleep 60
  restart_a >>"$log" 2>&1 || die "cannot start A again; its output is in $log"
  echo "A is started again: the participant's client can resume"
  last=$(t9_ids "$dir/before" | tail -n 1)
  t9_read "the resumed stream" "$dir/after" 300 "$last"
  state=$(sql "SELECT state FROM operation WHERE id = '$t9_op'")
  [ "$state" = completed ] || die "the apply did not complete after A's restart: $state (a product finding; keep $dir)"
  t9_read "the full replay" "$dir/full" 60
  [ "$(t9_ids "$dir/before" "$dir/after")" = "$(t9_ids "$dir/full")" ] ||
    die "the resumed stream's events differ from the full replay: an event was lost or repeated (see $dir)"
  trap - EXIT INT TERM
  read_ok "the stream resumed with Last-Event-ID after A's restart: $(t9_ids "$dir/full" | wc -l) events, none lost or repeated, the apply completed" true
}
t9() {
  if [ "${1:-}" = disconnect ]; then
    task=t9 log=$part/setup-t9.log
    t9_disconnect
    return
  fi
  setup t9
  # Last, on Zitadel: the apply starts once the links are joined, so no restart of A meets it.
  prepare links linkjoin
  # The restore left no apply-config operation, so the first one on the worker is this apply. The
  # controller dispatches the approved plan within a few of its 5 s heartbeats after the join.
  local w op=''
  w=$(worker)
  for _ in $(seq 30); do
    op=$(sql "SELECT state FROM operation WHERE kind = 'apply-config' AND machine = '$w' ORDER BY seq DESC LIMIT 1")
    [ -z "$op" ] || break
    sleep 1
  done
  case $op in
    '') die "no apply-config operation on the worker 30 s after the join: the apply did not start" ;;
    completed | rejected | failed | cancelled) die "the apply ended ($op) before the participant could follow it (ginsys/bronzeward#512)" ;;
  esac
  echo "read ok: the apply started on the worker ($op)"
  echo "names: none; the apply completes within 4 minutes"
}
