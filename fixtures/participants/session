#!/usr/bin/env bash
# The participant environment of the usability sessions (#367, facilitator script README.md):
# the fixture, with instance A trusting Zitadel's login page instead of the fixture issuer, the web
# interface for A, and one command per task that brings the fixture to the task's precondition.
#
#   session start         fixtures/bin/up, dev-idp up --participants, A trusts Zitadel, the web host
#   session passwords     a new password for every seeded human, shown once on this terminal;
#                         --exec <command> gives them to that command's environment instead;
#                         --only <human> sets that one human's alone
#   session shell         the participant's shell: its own client configuration, no history file
#   session t1 ... t11    the task's precondition, the names to read out, then the reads that
#                         confirm it; in the session order T1, T3 to T9, T2, T10, T11
#   session t5 collide    h-all's competing save into the participant's open draft (collide.mjs)
#   session t9 disconnect A stopped for 60 s and started again; a stream resumed with
#                         Last-Event-ID follows the apply to completion, no event lost or repeated
#   session scan [path]   no session password in any retained file or log, with a planted control
#   session stop          the web host and dev-idp; fixtures/bin/down removes the fixture
#
# Supported order: run session stop before fixtures/bin/down or fixtures/dev-idp down, and run one
# participant session per Docker daemon. The session uses the host's one default dev-idp, so no
# other checkout may start or stop the default dev-idp on that daemon while a session starts or
# runs. stop and a failed start's rollback remove the forwarder and dev-idp by name, so outside that
# order they can remove another checkout's containers of the same names.
#
# Everything is synthetic. A session password starts with BWSYNTH-pw-, which is what scan looks
# for; it is never written to a file by this script.
set -euo pipefail
here=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
# shellcheck source-path=SCRIPTDIR source=../lib.sh
. "$here/../lib.sh"
bin=$FIXTURES/bin
# The participant environment runs on the default dev-idp instance, whose issuer and login page
# ports it uses; a named one (scripts/dev/instance.sh) would leave this script on another provider.
[ -z "${BW_DEV_INSTANCE:-}" ] || die "the participant environment uses the default dev-idp instance, because the participant clients' redirect URIs are seeded for one origin; unset BW_DEV_INSTANCE"
repo=$(dirname -- "$FIXTURES")
# The default instance's names, issuer port and state directory. The login page is on the port after
# the issuer's (fixtures/dev-idp).
# shellcheck source-path=SCRIPTDIR source=../../scripts/dev/instance.sh
. "$repo/scripts/dev/instance.sh" || exit 1
idp=$repo/$BW_DEV_IDP_DIR
login=http://localhost:$((BW_DEV_IDP_PORT + 1))/ui/v2/login
# The participant's own state: its client configuration and the web host. Gitignored (.dev/).
part=$repo/.dev/participants
web=http://localhost:58443
marker=BWSYNTH-pw-
# Not bw-dev-idp-forward: that is BW_DEV_INSTANCE=forward's Zitadel.
fwd=bw-dev-forward

idp_var() { sed -n "s/^$1=//p" "$idp/idp.env"; }

# The processes that start spawns, by the pid that start captures at each spawn. A failed start
# ends them from this list, because stop finds a process only by a record that start may have
# failed to write. Bash reaps an exited child by itself, so its pid can then be another process's.
spawned=()
kill_spawned() {
  local p
  for p in "${spawned[@]}"; do
    webhost_runs "$p" || continue
    kill "$p" 2>/dev/null || continue
    for _ in $(seq 10); do
      webhost_runs "$p" || break
      sleep 1
    done
    if webhost_runs "$p"; then kill -KILL "$p" 2>/dev/null || true; fi
    wait "$p" 2>/dev/null || true
  done
}

# webhost_runs <pid>: the process runs, and it is this checkout's web host. It is a child of this
# shell (a failed start's web host, also before it runs its command), or it runs the command that
# start runs. After the web host exits, another process can get its pid, and that process is
# neither. The reads are builtins, so nothing forks between this check and a signal after it.
webhost_runs() {
  local s arg0
  { IFS= read -r s <"/proc/$1/stat"; } 2>/dev/null || return 1
  s=${s##*) }
  [ "${s%% *}" != Z ] || return 1
  s=${s#* }
  [ "${s%% *}" != "$$" ] || return 0
  { IFS= read -r -d '' arg0 <"/proc/$1/cmdline"; } 2>/dev/null && [ "$arg0" = "$part/webhost" ]
}

# A's configuration, and bin/up's copy of it, which stop puts back.
cfg=$STATE/server/a/config.yaml

# trust_zitadel: A's configuration names Zitadel as its issuer, by the issuer URL the browser and
# the CLI use, and the project as its audience. The rest is bin/up's. The clients accept plain http
# to localhost only (client contracts §6 item 1), so A reaches that URL through forward_idp.
trust_zitadel() {
  local issuer project line
  issuer=$(idp_var BW_TEST_IDP_ISSUER)
  project=$(idp_var BW_TEST_IDP_PROJECT)
  # A second start begins again from bin/up's configuration. The backup gets its name only when it
  # is complete, because stop puts any backup it finds over A's configuration.
  if [ -f "$cfg.fixture" ]; then
    cp -- "$cfg.fixture" "$cfg"
  else
    { cp -- "$cfg" "$cfg.fixture.partial" && mv --no-target-directory -- "$cfg.fixture.partial" "$cfg.fixture"; } || {
      rm -f -- "$cfg.fixture.partial"
      die "cannot back up A's configuration to $cfg.fixture; A's configuration is unchanged"
    }
  fi
  while IFS= read -r line; do
    case $line in
    '    issuer: http://issuer:5556') printf '    issuer: %s\n' "$issuer" ;;
    '    plainHTTPHosts: [issuer]') printf '    plainHTTPHosts: []\n' ;;
    '    audience: bronzeward') printf '    audience: "%s"\n' "$project" ;;
    *) printf '%s\n' "$line" ;;
    esac
  done <"$cfg" >"$cfg.partial"
  if ! grep --quiet --fixed-strings -- "    issuer: $issuer" "$cfg.partial" ||
    ! grep --quiet --fixed-strings -- "    audience: \"$project\"" "$cfg.partial"; then
    die "A's configuration has no fixture issuer lines to replace ($cfg)"
  fi
  mv --no-target-directory -- "$cfg.partial" "$cfg"
}

# set_issuer zitadel|fixture: A's configuration names one issuer, for a task setup. Zitadel, as
# trust_zitadel sets it, is where the participant signs in. The fixture issuer is the one the
# scenarios mint their tokens for, so each task setup runs on it and hands over on Zitadel. A trusts
# one issuer at a time and reads it at its start (restart_a). Only the three issuer lines change:
# the scenarios write other lines of A's configuration (deniedSubjects, driftInterval, the keys,
# S7's ingestion block), which a copy of bin/up's configuration would lose.
set_issuer() {
  local line i
  # Read through the from and to namerefs below.
  # shellcheck disable=SC2034
  local fixture=('    issuer: http://issuer:5556' '    plainHTTPHosts: [issuer]' '    audience: bronzeward') \
    zitadel=("    issuer: $(idp_var BW_TEST_IDP_ISSUER)" '    plainHTTPHosts: []' "    audience: \"$(idp_var BW_TEST_IDP_PROJECT)\"")
  if [ "$1" = zitadel ]; then local -n from=fixture to=zitadel; else local -n from=zitadel to=fixture; fi
  while IFS= read -r line; do
    for i in 0 1 2; do
      if [ "$line" = "${from[$i]}" ]; then
        line=${to[$i]}
        break
      fi
    done
    printf '%s\n' "$line"
  done <"$cfg" >"$cfg.partial"
  for i in 0 1 2; do
    grep --quiet --line-regexp --fixed-strings -- "${to[$i]}" "$cfg.partial" || {
      rm -f -- "$cfg.partial"
      die "A's configuration has no issuer line to set to $1 ($cfg): ${to[$i]# *}"
    }
  done
  mv --no-target-directory -- "$cfg.partial" "$cfg"
}

running() { [ "$(docker inspect --type container --format '{{.State.Running}}' "$1" 2>/dev/null)" = true ]; }

# restart_a: A started again on its configuration, and on Zitadel the forwarder in its new network
# namespace. inject start puts back any recorded link split.
restart_a() {
  # Each step returns its failure: stage runs this in a `||` list, where errexit is off.
  if running "$BW_A"; then "$bin/inject" kill A >/dev/null || return; fi
  "$bin/inject" start A >/dev/null || return
  if grep --quiet --line-regexp --fixed-strings -- '    plainHTTPHosts: []' "$cfg"; then forward_idp; fi
}

# forward_idp: a forwarder in A's network namespace, listening on its 127.0.0.1 at the issuer's port
# and passing each connection to Zitadel on the dev-idp network, so that A reaches the issuer URL
# that the browser and the CLI use. Never published on the host. A start makes a new namespace, so
# this runs after every start of A. Node is in the login page's pinned image.
forward_idp() {
  docker rm -f "$fwd" >/dev/null 2>&1 || true
  docker run -d --name "$fwd" --network "container:$BW_A" --user "$(id -u):$(id -g)" \
    -e "BW_PORT=$BW_DEV_IDP_PORT" -e "BW_IDP=$BW_DEV_IDP_CONTAINER" --entrypoint node \
    "$ZITADEL_LOGIN_IMAGE" -e 'const net = require("net"), p = Number(process.env.BW_PORT);
net.createServer((c) => { const z = net.connect(8080, process.env.BW_IDP); c.pipe(z).pipe(c);
  c.on("error", () => z.destroy()); z.on("error", () => c.destroy()); }).listen(p, "127.0.0.1");' \
    >/dev/null || die "cannot start the issuer forwarder in $BW_A's network namespace"
  for _ in $(seq 20); do
    if docker exec "$fwd" node -e "$discovery_get" 2>/dev/null; then return 0; fi
    sleep 1
  done
  die "A's namespace does not reach Zitadel's discovery document through the forwarder (docker logs $fwd)"
}
# discovery_get: node code that exits 0 if Zitadel's discovery document answers 200 on 127.0.0.1 at
# the port in BW_PORT, the forwarder's. Without an answer within 5 s it exits 1, so that a forwarder
# that accepts and never answers cannot hold a cleanup.
discovery_get='const p = Number(process.env.BW_PORT);
  setTimeout(() => process.exit(1), 5000);
  require("http").get({ host: "127.0.0.1", port: p,
  path: "/.well-known/openid-configuration", headers: { Host: "localhost:" + p } },
  (r) => process.exit(r.statusCode === 200 ? 0 : 1)).on("error", () => process.exit(1))'
# idp_reached: A's network namespace, as it is now, reaches Zitadel through a forwarder. A forwarder
# started before A's last start is in A's old namespace and still answers from there, so this asks
# from a new container in A's current namespace.
idp_reached() {
  docker run --rm --network "container:$BW_A" --user "$(id -u):$(id -g)" -e "BW_PORT=$BW_DEV_IDP_PORT" \
    --entrypoint node "$ZITADEL_LOGIN_IMAGE" -e "$discovery_get" >/dev/null 2>&1
}

start() {
  need docker curl jq go npm
  # start takes no provider down. The provider state can be stale, from another Docker daemon,
  # and dev-idp down removes containers by name, so it would remove another checkout's provider.
  if [ -d "$idp" ]; then
    die "this checkout has a dev-idp provider ($idp); if it is this checkout's, run fixtures/dev-idp down, then session start again"
  fi
  # An earlier session's state names its web host and its daemon; removing it would lose them.
  if [ -e "$part" ]; then
    die "a participant session exists in this checkout ($part); run session stop first"
  fi
  # The participant state marks the session as this checkout's, for stop, and records the Docker
  # daemon that this start acts on (lib.sh pins the context for this process) before any start step.
  local daemon
  daemon=$(docker info --format '{{.ID}}') && [ -n "$daemon" ] || die "the Docker daemon does not answer; nothing was started"
  # Until the rollback trap below, a failure removes the participant state: start refused an
  # existing one, so it is this start's, and stop refuses it without a complete daemon record.
  trap 'rm -rf -- "$part"' EXIT
  mkdir -p -- "$part/bin" "$part/home"
  chmod 700 "$part"
  printf '%s\n' "$daemon" >"$part/daemon"
  "$bin/up"
  # The provider state did not exist, so the provider that dev-idp up makes from here is this
  # session's. dev-idp up refuses another checkout's containers before it writes its state.
  : >"$part/idp-started"
  # From here, a failure undoes the start: stop removes what it made and puts back A's configuration.
  trap 'echo "session start failed; undoing it with session stop" >&2; kill_spawned; stop' EXIT
  # The web client's origin is the web host's, not the browser tests' page.
  BW_DEV_IDP_WEB_ORIGIN=$web "$FIXTURES/dev-idp" up --participants >/dev/null
  trust_zitadel
  docker network connect "$BW_DEV_IDP_NET" "$BW_A" || die "cannot connect $BW_A to the dev-idp network"
  go build -o "$part/bin/bronzewardctl" "$repo/cmd/bronzewardctl"
  go build -o "$part/webhost" "$FIXTURES/webhost"
  (cd "$repo" && mise run web) >"$part/web-build.log" 2>&1 || die "the web build failed ($part/web-build.log)"
  local project
  project=$(idp_var BW_TEST_IDP_PROJECT)
  # Zitadel puts the project in aud only when this scope asks for it (client contracts §5 item 4).
  jq -n --arg i "$(idp_var BW_TEST_IDP_ISSUER)" --arg a "$project" --arg c "$(idp_var BW_TEST_IDP_CLI_CLIENT)" \
    --arg w "$(idp_var BW_TEST_IDP_WEB_CLIENT)" \
    '{issuer: $i, audience: $a, cliClientId: $c, webClientId: $w, scopes: ("urn:zitadel:iam:org:project:id:" + $a + ":aud")}' \
    >"$part/client.json"
  # Another listener on the port would answer the readiness read for a web host that failed to bind.
  if curl --disable -s --noproxy '*' -o /dev/null --max-time 2 "$web/"; then
    die "something already answers on $web; stop it, then run session start again"
  fi
  nohup "$part/webhost" -listen 127.0.0.1:58443 -dist "$repo/web/dist" -headers "$repo/web/headers.json" \
    -client-config "$part/client.json" -issuer "$(idp_var BW_TEST_IDP_ISSUER)" \
    -api "http://127.0.0.1:$SERVER_A_PORT" >"$part/webhost.log" 2>&1 &
  spawned+=("$!")
  local pid=$!
  echo "$pid" >"$part/webhost.pid"
  curl --disable -sf --noproxy '*' -o "$part/served.json" --max-time 2 --retry 10 --retry-connrefused --retry-delay 1 \
    "$web/bronzeward-client.json" || die "the web host did not answer on $web ($part/webhost.log)"
  # The answer is this web host's: it still runs, and it serves this start's client configuration.
  kill -0 "$pid" 2>/dev/null || die "the web host (pid $pid) exited ($part/webhost.log)"
  cmp -s -- "$part/client.json" "$part/served.json" || die "$web serves another client configuration than $part/client.json"
  rm -f -- "$part/served.json"
  trap - EXIT
  echo "participant environment up: web $web, login page $login" >&2
  echo "next: fixtures/participants/session passwords, then the first task's setup" >&2
}

# passwords [--exec <command>...]: a new password for every seeded human, through Zitadel's user
# API. It goes to Zitadel on standard input and to this terminal, and nowhere else. With --exec
# (the agent's rehearsal), nothing is printed: the command runs with each password in its
# environment only, as BW_PW_<NAME> (h-author: BW_PW_H_AUTHOR).
passwords() {
  local exec='' only=''
  if [ "${1:-}" = --only ]; then
    only=${2:?passwords --only needs a human}
    shift 2
  fi
  if [ "${1:-}" = --exec ]; then
    shift
    [ $# -gt 0 ] || die "passwords --exec needs a command"
    exec=1
  else
    [ -t 1 ] || die "passwords shows each password once, on a terminal; standard output is not one"
  fi
  local issuer pair name uid pw letters digits env=() set=0
  issuer=$(idp_var BW_TEST_IDP_ISSUER)
  for pair in $(idp_var BW_TEST_IDP_USERS | tr ',' ' '); do
    name=${pair%%=*} uid=${pair#*=}
    [ -z "$only" ] || [ "$name" = "$only" ] || continue
    # From a bounded read: `tr </dev/urandom | head` ends in SIGPIPE, which pipefail turns into a
    # silent exit.
    letters=$(LC_ALL=C tr -dc 'a-z0-9' < <(head -c 1024 /dev/urandom))
    digits=$(LC_ALL=C tr -dc '0-9' < <(head -c 1024 /dev/urandom))
    [ "${#letters}" -ge 8 ] && [ "${#digits}" -ge 4 ] || die "could not make a password for $name"
    pw=$marker${letters:0:8}-${digits:0:4}
    # --disable first: a facilitator's curlrc could name a trace file, which would get the body.
    # The password reaches jq and the token reaches curl on a pipe, from the shell's builtin
    # printf, never in a child's environment or command line.
    printf '%s' "$pw" | jq -Rc '{newPassword: {password: ., changeRequired: false}}' |
      curl --disable -sSf --noproxy '*' -o /dev/null -X POST "$issuer/v2/users/$uid/password" \
        -H @<(printf 'Authorization: Bearer %s\n' "$(<"$idp/seed.pat")") -H 'Content-Type: application/json' -d @- ||
      die "could not set the password of $name"
    set=$((set + 1))
    if [ -n "$exec" ]; then
      name=${name^^}
      env+=("BW_PW_${name//-/_}=$pw")
    else
      printf '%-12s %s\n' "$name" "$pw"
    fi
  done
  pw=''
  [ -z "$only" ] || [ "$set" -eq 1 ] || die "passwords --only: no seeded human $only"
  # Exported in a subshell, not passed to env(1), so that no password is ever an argument.
  if [ -n "$exec" ]; then (
    for pw in "${env[@]}"; do export "${pw?}"; done
    exec "$@"
  ); fi
}

# The participant client's environment, for env: its own configuration and state, and no desktop
# session bus, so that no sign-in reaches the desktop's credential store (Secret Service). The lab
# context keeps its sign-in in a token file under the participant home (t1), which scan reads and
# stop removes; an inherited BRONZEWARD_TOKEN_FILE would move that file elsewhere. An inherited
# BRONZEWARD_CONTEXT would name a context that the participant configuration does not have.
client_env=(-u DBUS_SESSION_BUS_ADDRESS -u BRONZEWARD_TOKEN_FILE -u BRONZEWARD_CONTEXT
  XDG_CONFIG_HOME="$part/home/config" XDG_STATE_HOME="$part/home/state" PATH="$part/bin:$PATH")

# in_part <command>...: a command as the participant's client sees it.
in_part() {
  env "${client_env[@]}" "$@"
}

shell() {
  [ -x "$part/bin/bronzewardctl" ] || die "no participant environment; run fixtures/participants/session start"
  exec env "${client_env[@]}" HISTFILE=/dev/null PS1='participant$ ' bash --norc --noprofile -i
}

# read_ok <what> <command>...: one read the setup names; the setup fails on the first that fails.
read_ok() {
  local what=$1
  shift
  if "$@" >/dev/null 2>&1; then echo "read ok: $what"; else die "read failed: $what (recreate the fixture)"; fi
}

t1() {
  "$bin/bw" migrate >/dev/null
  "$bin/inject" start A >/dev/null
  forward_idp
  rm -rf -- "${part:?}/home"
  mkdir -p -- "$part/home"
  in_part bronzewardctl context add lab --from "$web" --oidc-token-file "$part/home/lab-token" >/dev/null
  echo "names: none"
  read_ok "A answers" curl -sf --noproxy '*' -o /dev/null --max-time 5 "http://127.0.0.1:$SERVER_A_PORT/livez"
  read_ok "the web host names Zitadel as the issuer" \
    sh -c "curl -sf --noproxy '*' --max-time 5 '$web/bronzeward-client.json' | jq -e --arg i '$(idp_var BW_TEST_IDP_ISSUER)' '.issuer == \$i'"
  read_ok "the client has the context lab" sh -c "env XDG_CONFIG_HOME='$part/home/config' '$part/bin/bronzewardctl' context list | grep -q lab"
  # Only the client's own "not signed in" answer for the lab token file passes, not any failure.
  # shellcheck disable=SC2016 # $out and $1 are the inner shell's
  read_ok "the client is not signed in" in_part sh -c 'out=$(bronzewardctl --no-input whoami 2>&1) && exit 1
    case $out in *"not signed in: nothing is stored in the token file $1;"*) ;; *) exit 1 ;; esac' sh "$part/home/lab-token"
}

# The task setups T2-T11, in the session order of README.md: T1, T3 to T9, T2, T10, T11. Each runs
# the acceptance scenarios' steps up to the task's precondition, on the fixture issuer, then hands A
# back on Zitadel. A database restore cannot undo a change on a node, so a setup restores only to a
# point no node has moved from since: p-base (seeded, nothing registered), p-s2 (S2's publication,
# nothing applied) and p-labels (p-s2 and the published label bw-team). Each scenario's output goes
# to the task's log in $part.

# sql <statement>: a read of the fixture's database, through the containers need_state verified
# (the dispatch below runs it for every setup).
sql() { pg psql -U bronzeward -d bronzeward -Atc "$1"; }
worker() { sql "SELECT id FROM machine WHERE talos_endpoint::text = '$TALOS_WORKER_IP:50000'"; }

# stage <command>...: one setup step, its output in the task's log; the setup stops on a failure.
stage() {
  printf '== %s\n' "$*" >>"$log"
  "$@" >>"$log" 2>&1 || {
    grep -- $'^FAIL\t' "$log" >&2 || true
    die "setup $task: $(basename -- "$1") ${*:2} failed; its output is in $log"
  }
}
snap() {
  stage "$bin/inject" db-snapshot "p-$1"
  stage "$bin/inject" bao-snapshot "p-$1"
}
# restore <point>: the database and OpenBao back to that point, with every running instance
# paused meanwhile, as S5 step 7 does. If the restore fails, handback unpauses them.
restore() {
  local i c up=()
  for i in A B C; do
    c=BW_$i
    if running "${!c}"; then up+=("$i"); fi
  done
  for i in ${up[@]+"${up[@]}"}; do stage "$bin/inject" pause "$i"; done
  stage "$bin/inject" db-restore "p-$1"
  stage "$bin/inject" bao-restore "p-$1"
  for i in ${up[@]+"${up[@]}"}; do stage "$bin/inject" unpause "$i"; done
}
scenario() { stage "$FIXTURES/scenarios/$1" "${@:2}"; }
prepare() { stage "$here/prepare" "$@"; }

# setup <task>: the task's own setup function, between A switched to the fixture issuer and A back
# on Zitadel; the seconds it took, for the README's timings. A setup that fails or is interrupted
# still hands A back on Zitadel, so that the task before can go on and the setup can run again.
# Every paused instance is unpaused, whoever paused it: the scenarios' own restores (s2 pass, s3
# pass) pause A, B and C too. The switch and the restart run in a subshell, because set_issuer and
# forward_idp end the shell on a failure, and the message must still be printed.
handback() {
  local i c p
  echo "setup $task failed: A goes back on Zitadel" >&2
  for i in A B C; do
    c=BW_$i
    if ! p=$(docker inspect --type container --format '{{.State.Paused}}' "${!c}" 2>/dev/null); then
      echo "$i could not be inspected, so it may still be paused; recreate the fixture" >&2
      continue
    fi
    [ "$p" = true ] || continue
    "$bin/inject" unpause "$i" >>"$log" 2>&1 || echo "$i could not be unpaused; recreate the fixture" >&2
  done
  (set_issuer zitadel && restart_a) >>"$log" 2>&1 || echo "A could not be handed back on Zitadel; recreate the fixture" >&2
}
setup() {
  local t0=$SECONDS
  task=$1 log=$part/setup-$1.log
  : >"$log"
  trap handback EXIT
  set_issuer fixture
  stage restart_a
  "setup_$1"
  # The trap stays until A runs on Zitadel again: a failure of this switch is handed back too.
  set_issuer zitadel
  stage restart_a
  trap - EXIT
  echo "setup $task: $((SECONDS - t0)) s"
}

# setup_t3: a p-base that exists is restored, never taken again, and a new one is taken only while
# nothing is registered. A rerun after a partial s1 register, or after a restore that stopped
# halfway, goes back to the first p-base, so that t4 never restores a registered cluster.
setup_t3() {
  [ -s "$STATE/automation-token" ] || stage "$bin/seed"
  if [ -s "$STATE/backups/pg-p-base.dump" ] && [ -s "$STATE/backups/bao-p-base.snap" ]; then
    restore base
  elif [ "$(sql 'SELECT (SELECT count(*) FROM cluster) + (SELECT count(*) FROM machine)')" = 0 ]; then
    snap base
  else
    die "setup t3: a cluster or a machine is registered, and there is no p-base snapshot to go back to; recreate the fixture"
  fi
  scenario s1 register
}
setup_t4() {
  restore base
  scenario s1 pass
  scenario s3 handover
  scenario s2 pass
  snap s2
  prepare labels
  snap labels
}
setup_t5() { restore labels; }
setup_t6() {
  restore labels
