# What this scan made: its planted controls, the copied logs and its error file. scan_clean removes
# them, on any exit too, so that no control stays behind in retained state.
scan_made=()
scan_clean() {
  local f
  for f in ${scan_made[@]+"${scan_made[@]}"}; do rm -rf -- "$f"; done
  scan_made=()
}

# scan [path]...: the retained files of this checkout's fixture, dev-idp and participant state,
# the logs of their containers and any path named, for a session password. Run it before stop.
# Each of the four places gets a planted control that must be found, so that a place the scan does
# not read fails it. A container list, a log or a file that cannot be read fails it too.
scan() {
  local pattern="${marker}[a-z0-9]{8}-[0-9]{4}" control=.bw-scan-control
  local logs=$part/scan-logs errs names selected hits c d rc=0 missing='' planted recorded reached
  local roots=("$STATE" "$idp" "$part" "$logs")
  for d in "$STATE" "$idp" "$part"; do [ -d "$d" ] || die "no $d to scan; run scan before session stop"; done
  # The logs are read by container name, so on another Docker daemon they would be other containers'.
  [ -f "$part/daemon" ] && IFS= read -r recorded <"$part/daemon" && [ -n "$recorded" ] ||
    die "$part has no record of the Docker daemon its session start used, so scan cannot tell which logs are the session's"
  reached=$(docker info --format '{{.ID}}') || die "the Docker daemon does not answer"
  [ "$recorded" = "$reached" ] ||
    die "the participant session was started on the Docker daemon $recorded, and this shell reaches $reached (DOCKER_HOST or the Docker context changed); point the shell back at that daemon and run scan again"
  # The controls this scan plants, one per line, by the exact path that grep prints for each.
  planted=$(for d in "${roots[@]}"; do printf '%s/%s\n' "$d" "$control"; done)
  trap scan_clean EXIT
  trap 'exit 130' INT TERM
  # Outside the places scanned: grep refuses to read the file its own output goes to.
  errs=$(mktemp)
  scan_made+=("$errs")
  for d in "$@"; do [ -r "$d" ] || die "cannot read $d"; done
  names=$(docker ps -a --format '{{.Names}}') || die "cannot list containers (docker ps)"
  for c in "$BW_A" "$BW_DEV_IDP_CONTAINER"; do
    grep -qxF -- "$c" <<<"$names" || die "no container $c to read the log of; run scan before session stop"
  done
  # Every scan removes its log copies, so a scan-logs here is not this scan's: removing it would
  # remove whatever it holds, a session password included.
  [ ! -e "$logs" ] && [ ! -L "$logs" ] ||
    die "$logs exists, and this scan did not make it; read it, remove it, and run scan again"
  scan_made+=("$logs")
  mkdir -p -- "$logs"
  # grep's status 1 is "none of them", which A's check above rules out; any other failure stops.
  selected=$(grep -E "^($FIXTURE_NAME-.*|$BW_DEV_IDP_CONTAINER|$BW_DEV_IDP_PG_CONTAINER|$BW_DEV_IDP_GROUPS_CONTAINER|bw-dev-login|$fwd)\$" <<<"$names") ||
    die "cannot select the containers to read the logs of"
  for c in $selected; do
    docker logs "$c" >"$logs/$c.log" 2>&1 || die "cannot read the log of $c"
  done
  for c in "$BW_A" "$BW_DEV_IDP_CONTAINER"; do
    [ -f "$logs/$c.log" ] || die "the log of $c was not read"
  done
  # A file already at a control's path is not this scan's: planting would overwrite it and the
  # cleanup would delete it, with whatever it holds. Checked for all four before any is planted.
  for d in "${roots[@]}"; do
    [ ! -e "$d/$control" ] && [ ! -L "$d/$control" ] ||
      die "$d/$control exists, and this scan did not plant it; read it, remove it, and run scan again"
  done
  for d in "${roots[@]}"; do
    scan_made+=("$d/$control")
    printf 'planted %splanted0-0000\n' "$marker" >"$d/$control"
  done
  # -R follows every symbolic link below the roots: -r skips a linked file or directory silently,
  # and its target would read as clean. A link that cannot be followed fails the scan (rc 2).
  hits=$(grep -RlE --binary-files=text --devices=skip -- "$pattern" "${roots[@]}" "$@" 2>"$errs") || rc=$?
  for d in "${roots[@]}"; do grep -qxF -- "$d/$control" <<<"$hits" || missing+=" $d"; done
  [ "$rc" -le 1 ] || cat -- "$errs" >&2
  scan_clean
  trap - EXIT INT TERM
  [ "$rc" -le 1 ] || die "the scan could not read everything (above), so it proves nothing"
  [ -z "$missing" ] || die "the planted control was not found in:$missing; the scan did not read it"
  # Only this scan's own controls are dropped; another file of the same name is a hit. Status 1 is
  # "no hit but the controls"; any other failure would read as a clean scan.
  hits=$(grep -vxF -- "$planted" <<<"$hits") || [ $? = 1 ] || die "cannot filter the scan's hits, so it proves nothing"
  if [ -n "$hits" ]; then
    while IFS= read -r d; do echo "session password pattern in $d"; done <<<"$hits"
    die "a session password pattern is in a retained file or log (above)"
  fi
  echo "scan: no session password in a retained file or log; the planted control was found in each of ${#roots[@]} places"
}

# stop: the web host, the forwarder and dev-idp gone, A off the dev-idp network and back on bin/up's
# configuration (started again if it runs), each checked before the participant state is removed.
stop() {
  local pid nets names owner running=''
  trap - EXIT
  # The forwarder, A and the default dev-idp have fixed names, so they can be another checkout's
  # session. stop acts only on a session this checkout started, on the daemon bin/up used, while
  # this checkout holds the fixture claim (an empty claim: no fixture runs, and A with it).
  if [ ! -d "$part" ] && [ ! -f "$cfg.fixture" ]; then
    echo "no participant session in this checkout; nothing to stop" >&2
    return 0
  fi
  # Every teardown below acts by name: the forwarder, A and the provider. On another daemon than
  # the one this session's start used, the names can be another checkout's. The record survives
  # fixtures/bin/down, which removes bin/up's record and makes daemon_own pass.
  if [ -d "$part" ]; then
    local recorded reached
    [ -f "$part/daemon" ] && IFS= read -r recorded <"$part/daemon" && [ -n "$recorded" ] ||
      die "$part has no record of the Docker daemon its session start used, so stop cannot tell which session the containers are; nothing was changed. Stop the session's containers by hand, then remove $part"
    reached=$(docker info --format '{{.ID}}') || die "the Docker daemon does not answer; nothing was changed"
    [ "$recorded" = "$reached" ] ||
      die "the participant session was started on the Docker daemon $recorded, and this shell reaches $reached (DOCKER_HOST or the Docker context changed); nothing was changed. Point the shell back at that daemon and run session stop again"
  fi
  # On another Docker daemon than bin/up's, A would read as gone, and stop would drop the backup.
  daemon_own
  owner=$(claim_owner) || die "could not ask Docker who holds the fixture claim"
  [ -z "$owner" ] || [ "$owner" = "$FIXTURES" ] ||
    die "the fixture belongs to the checkout at $owner; stop the participant session there"
  # After the web host exits, another process can get its pid; only the web host is signalled.
  if [ -f "$part/webhost.pid" ]; then
    pid=$(cat "$part/webhost.pid")
    if webhost_runs "$pid"; then
      kill "$pid" 2>/dev/null || true
      for _ in $(seq 10); do webhost_runs "$pid" || break; sleep 1; done
      if webhost_runs "$pid"; then die "the web host (pid $pid) still runs after 10 s; kill it, then run session stop again"; fi
    fi
  fi
  docker rm -f "$fwd" >/dev/null 2>&1 || true
  # A container list that fails is not "no forwarder" or "no A": stop would then leave the forwarder,
  # or skip A's network and restart.
  names=$(docker ps -a --format '{{.Names}}') || die "cannot list containers (docker ps)"
  if grep -qxF -- "$fwd" <<<"$names"; then die "the forwarder $fwd is still there (docker rm -f $fwd)"; fi
  if grep -qxF -- "$BW_A" <<<"$names"; then
    # dev-idp down removes its network, which refuses while A is attached to it.
    docker network disconnect "$BW_DEV_IDP_NET" "$BW_A" >/dev/null 2>&1 || true
    nets=$(docker inspect --type container --format '{{range $n, $_ := .NetworkSettings.Networks}}{{$n}} {{end}}' "$BW_A") ||
      die "cannot inspect $BW_A"
    case " $nets" in *" $BW_DEV_IDP_NET "*) die "$BW_A is still on the network $BW_DEV_IDP_NET" ;; esac
    running=$(docker inspect --type container --format '{{.State.Running}}' "$BW_A") || die "cannot inspect $BW_A"
  fi
  # The backup stays until A runs on it again, so that a failure here leaves it for the next stop.
  # $cfg.restart marks a restart begun: a stop that stopped A and could not start it again leaves
  # A stopped, and the next stop starts it. A that no longer exists (bin/down) has none to finish.
  if [ -f "$cfg.fixture" ]; then
    cp -- "$cfg.fixture" "$cfg"
    if [ "$running" = true ]; then : >"$cfg.restart"; fi
    if [ -f "$cfg.restart" ] && grep -qxF -- "$BW_A" <<<"$names"; then
      if [ "$running" = true ]; then
        "$bin/inject" kill A >/dev/null || die "cannot stop $BW_A to restart it on bin/up's configuration; run session stop again"
      fi
      "$bin/inject" start A >/dev/null || die "cannot start $BW_A on bin/up's configuration; run session stop again"
    fi
    rm -f -- "$cfg.restart" "$cfg.fixture"
  fi
  # Every temporary file of a write beside A's configuration, by pattern, with or without a backup:
  # a failed start can leave one at any step.
  rm -f -- "$cfg".partial "$cfg".*.partial
  # Only the provider this session's start made is taken down. Another provider state can be
  # stale, from another Docker daemon, where dev-idp down would remove another checkout's provider.
  if [ -f "$part/idp-started" ] && [ -d "$idp" ]; then "$FIXTURES/dev-idp" down; fi
  rm -rf -- "$part"
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
start | shell | t1 | stop) "$cmd" ;;
passwords | scan) "$cmd" "$@" ;;
t2 | t3 | t4 | t5 | t6 | t7 | t8 | t9 | t10 | t11)
  need_state
  "$cmd" "$@"
  ;;
*) die "usage: fixtures/participants/session start | passwords [--only <human>] [--exec <command>...] | shell | t1 | t2 | t3 | t4 | t5 [collide] | t6 | t7 | t8 | t9 [disconnect] | t10 | t11 | scan [path]... | stop (run stop before fixtures/bin/down or fixtures/dev-idp down; one participant session per Docker daemon; the session uses the host's one default dev-idp, so no other checkout may start or stop the default dev-idp on that daemon while a session starts or runs)" ;;
esac
