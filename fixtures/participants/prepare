#!/usr/bin/env bash
# The usability task setups' own steps (fixtures/participants/session), on the acceptance
# scenarios' helpers and identities. Each runs while A trusts the fixture issuer, except t9-hold,
# t9-release and t11-check, which use only the database, docker and the fixture's injections. Each
# check writes PASS or FAIL to participants.tsv in its evidence directory and to stdout; exit 1 on
# any FAIL.
#
#   prepare labels          h-author's role fragment participants-labels, one node label
#                           (bw-team: blue), listed in the workers profile, published by h-publisher
#   prepare t6-draft        h-author's saved, unpublished draft for T6: bw-team changed to green and
#                           an empty label bw-note, the empty-looking field of T7
#   prepare t7-publish      that draft published by h-publisher, unless it is published already; the
#                           worker's review shows S2's bw-s2 redacted and bw-note empty
#   prepare links linksplit|linkjoin   A's, B's and C's links to the worker
#   prepare t9-hold         T9's apply held on C, as S4 holds one: C alone joined to the worker, so
#                           C alone commits the approved plan, and C stalls before its attempt
#   prepare t9-release      the hold ended: C's stall removed, A's, B's and C's links joined; safe to
#                           repeat; with no hold recorded by t9-hold, it changes nothing
#   prepare applied         the apply T9 followed completed: Applied is Desired, from an operation
#   prepare t10-revert      the facilitator's close of a drift that T10 left open, as S5 step 6
#                           reverts one: h-publisher's plan, h-approver's approval and unfreeze
#   prepare drift-closed    T10's drift closed; a scope still frozen is unfrozen by h-approver
#   prepare t11-check       A started in the current epoch after its entry, with its ingestion
#                           configuration; the control plane's scope still pre-restore
#                           unaccounted; no apply-config operation since S7's stop
set -euo pipefail
here=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
bin=$here/../bin
# shellcheck source-path=SCRIPTDIR source=../lib.sh
. "$here/../lib.sh"

step=${1:-}
case $step in
  labels | t6-draft | t7-publish | links | t9-hold | t9-release | applied | t10-revert | drift-closed | t11-check) ;;
  *) die "usage: fixtures/participants/prepare labels|t6-draft|t7-publish|links linksplit|linkjoin|t9-hold|t9-release|applied|t10-revert|drift-closed|t11-check" ;;
esac
need docker curl jq timeout id sleep date
need_state
umask 077
image_id=$(cat -- "$STATE/up-image") || die "no server image is recorded in $STATE; run fixtures/bin/up"
image_own "$image_id" || die "the recorded server image is not this run's; run fixtures/bin/down, then up"
EV=$STATE/evidence/participants-$step-$(date -u +%Y%m%dT%H%M%SZ)
mkdir -p -- "$EV" "$EV/http"
scenario=participants
# shellcheck source-path=SCRIPTDIR source=../scenarios/common.sh
. "$here/../scenarios/common.sh"
# S4's held-operation checks (stalls_at, committed_held), for T9's hold.
# shellcheck source-path=SCRIPTDIR source=../scenarios/dispatch.sh
. "$here/../scenarios/dispatch.sh"
run_key=$(date -u +%s%N)
ref="participants $step"

cluster=$(sql "SELECT id FROM cluster WHERE name = 'bw-fixture'") || die "cannot read the cluster"
machine_w=$(sql "SELECT id FROM machine WHERE cluster = '$cluster' AND talos_endpoint::text = '$TALOS_WORKER_IP:50000'") ||
  die "cannot read the worker's machine"
machine_cp=$(sql "SELECT id FROM machine WHERE cluster = '$cluster' AND talos_endpoint::text = '$TALOS_CONTROLPLANE_IP:50000'") ||
  die "cannot read the control plane's machine"

# labels_put <who> <name> <document>: the role fragment participants-labels in the draft, under its
# ETag: 200, the ETag replaced; its revision in frag_rev.
labels_put() {
  fresh "$1"
  answers 200 - PUT "/api/v1/drafts/$draft/fragments/participants-labels" "$tok" \
    "$(jq -nc --arg d "$3" '{layer: "role", document: $d, marks: []}')" "$(key "fragment-$2")" "$etag" || return 1
  etag=$(etag_of_last)
  frag_rev=$(jq -er '.entry.revision' "$EV/last.body")
}
# profile_with <who> <name>: the workers profile, under the draft's ETag, listing its head's
# fragment revisions with frag_rev in place of any earlier participants-labels revision.
profile_with() {
  local body
  fresh "$1"
  body=$(sql "SELECT coalesce(jsonb_agg(f.fragment_revision ORDER BY f.position), '[]'::jsonb)
    FROM profile p JOIN profile_revision_fragment f ON f.revision = p.head_revision_id
    JOIN fragment_revision r ON r.id = f.fragment_revision
    WHERE p.cluster = '$cluster' AND p.name = 'workers' AND r.name <> 'participants-labels'") || return 1
  body=$(jq -nc --argjson l "$body" --arg f "$frag_rev" '{fragments: ($l + [$f])}') || return 1
  answers 200 - PUT "/api/v1/drafts/$draft/profiles/workers" "$tok" "$body" "$(key "profile-$2")" "$etag" || return 1
  etag=$(etag_of_last)
}
# t6_open: the one open draft titled "participants t6", its id in draft and its ETag in etag.
t6_open() {
  draft=$(sql "SELECT id FROM draft WHERE title = 'participants t6' AND state = 'open'") || return 1
  [ -z "$draft" ] && return 0
  fresh h-author
  answers 200 - GET "/api/v1/drafts/$draft" "$tok" && etag=$(etag_of_last) && [ -n "$etag" ]
}
# a_started_after_entry: A's container started after the current epoch's entry, so the epoch A read
# at its start (cmd/bronzeward/main.go) is that epoch, which still is current.
a_started_after_entry() {
  local started entered
  started=$(docker inspect --type container --format '{{.State.StartedAt}}' "$BW_A") || return 1
  entered=$(sql "SELECT extract(epoch FROM r.entered_at) FROM recovery_epoch r JOIN installation_state i ON i.epoch = r.epoch
    WHERE i.recovery_mode") || return 1
  [ -n "$entered" ] && [ "$(date -u -d "$started" +%s)" -gt "${entered%.*}" ]
}
# t7_review: the review of the worker's Desired, as T7's participant reads it: S2's label bw-s2
# with its value redacted, and T6's label bw-note with an empty value, each on a line of the
# rendered configuration.
t7_review() {
  local rel
  rel=$(sql "SELECT desired FROM machine_state WHERE machine = '$machine_w'") && [ -n "$rel" ] || return 1
  fresh h-author
  answers 200 - GET "/api/v1/releases/$rel/machines/$machine_w/review" "$tok" || return 1
  jq -e --arg q "'" '[.configuration | split("\n")[] | sub("^ +"; "")] as $ls
    | ($ls | any(test("^bw-s2: [\"\($q)]?<redacted:[^>]+>[\"\($q)]?$")))
      and ($ls | any(IN("bw-note: \"\"", "bw-note: \($q)\($q)")))' "$EV/last.body" >/dev/null
}
# applied_desired: the worker's Applied is its Desired, and an operation applied it.
applied_desired() {
  same "$(sql "SELECT (applied_release = desired)::text || ' ' || applied_source FROM machine_state WHERE machine = '$machine_w'")" \
    'true operation'
}

case $step in
  labels)
    check "$ref" 'h-author opens a draft: 201' draft_by h-author labels
    check "$ref" 'h-author puts the role fragment participants-labels, bw-team: blue: 200' \
      labels_put h-author labels $'apiVersion: v1alpha1\nkind: KubeNodeConfig\nlabels:\n  bw-team: blue\n'
    check "$ref" 'h-author lists it in the workers profile: 200' profile_with h-author labels
    check "$ref" "h-publisher publishes it: 202, one release, the worker's Desired" publish_by h-publisher labels
    ;;
  t6-draft)
    check "$ref" 'h-author opens the draft "participants t6": 201' draft_by h-author t6
    check "$ref" 'h-author changes bw-team to green and adds the empty label bw-note: 200' \
      labels_put h-author t6 $'apiVersion: v1alpha1\nkind: KubeNodeConfig\nlabels:\n  bw-team: green\n  bw-note: ""\n'
    check "$ref" 'h-author lists the new revision in the workers profile: 200' profile_with h-author t6
    ;;
  t7-publish)
    t6_open || die "cannot read T6's draft"
    if [ -n "$draft" ]; then
      check "$ref" "h-publisher publishes T6's draft: 202, one release, the worker's Desired" publish_by h-publisher t7
    else
      check "$ref" "T6's draft is published already" \
        same "$(sql "SELECT count(*) FROM draft WHERE title = 'participants t6' AND state = 'published'")" 1
    fi
    check "$ref" "the worker's review shows bw-s2 redacted and bw-note empty" t7_review
    ;;
  links)
    case ${2:-} in linksplit | linkjoin) ;; *) die "usage: prepare links linksplit|linkjoin" ;; esac
    check "$ref" "inject $2 A, B and C to the worker" worker_links "$2"
    ;;
  t9-hold)
    # A no-reboot apply ends in about 50 ms on the fixture, before any read can find it running
    # (ginsys/bronzeward#512). So T9's apply is held as S4 holds one: C's control file names the
    # stall first, and then C alone is joined to the worker, so that C alone can take the evidence
    # observation and commit. C stalls after the commitment, before its attempt.
    plan=$(sql "SELECT p.id FROM plan p JOIN plan_state s ON s.plan = p.id
      WHERE p.machine = '$machine_w' AND p.kind = 'apply-config' AND s.state = 'approved'") ||
      die "cannot read the worker's approved plan"
    one_line "$plan" || die "not one approved apply-config plan on the worker; run the t9 setup"
    [ "$(sql "SELECT count(*) FROM operation WHERE kind = 'apply-config' AND machine = '$machine_w'")" = 0 ] ||
      die "an apply-config operation exists on the worker already; run the t9 setup again"
    # With A's or B's link open, that instance could commit the plan and apply it at once.
    counted 3 '^[ABC] worker$' "$STATE/linksplits" || die "not every link to the worker is cut; run the t9 setup again"
    n=$(stalls_at dispatch-committed)
    # The mark comes first: from here on, a release has a hold, or part of one, to end.
    : >"$STATE/participants-t9-hold" || die "cannot record T9's hold in $STATE"
    interrupt dispatch-committed stall || die "cannot write C's control file"
    result PASS "$ref" 'C told to stall after the commitment'
    check "$ref" 'inject linkjoin C worker, with A and B still cut' "$bin/inject" linkjoin C worker
    check "$ref" 'the plan committed, its operation committed with no attempt; C stalls there' \
      within 120 committed_held "$plan" "$n"
    ;;
  t9-release)
    # The hold ends: a stalled C goes on, and every instance reaches the worker again, so whichever
    # owns the apply now can complete it. A takes the apply over when it starts again. With no
    # hold recorded, nothing changes: T8's setup cut the links on purpose, and joining them would
    # let T8's approved plan go to the worker. The mark goes only after a full release.
    if [ ! -e "$STATE/participants-t9-hold" ]; then
      result PASS "$ref" 'no T9 hold is recorded: nothing to release'
    else
      interrupt - || die "cannot remove C's control file"
      result PASS "$ref" "C's control file removed"
      check "$ref" 'inject linkjoin A, B and C to the worker' worker_links linkjoin
      if [ "$failed" -eq 0 ]; then rm -f -- "$STATE/participants-t9-hold"; fi
    fi
    ;;
  applied)
    check "$ref" "the worker's Applied is its Desired, from an operation, within four minutes" within 240 applied_desired
    ;;
  t10-revert)
    # Not a participant step: neither client can plan, approve or unfreeze yet. A session whose
    # participant left T10's drift open needs it closed before T11's setup. A plan of the worker's
    # Desired binds the open record, so h-approver's approval is of an unseen overwrite. A scope
    # that the participant froze is unfrozen after the approval, as in S5 step 6.
    drift_open=$(sql "SELECT opened FROM drift_record WHERE machine = '$machine_w' AND closed IS NULL")
    if [ -z "$drift_open" ]; then
      say "no drift record is open on the worker; nothing to revert"
    else
      check "$ref" "a plan of the worker's Desired as h-publisher, a revert: 201" plan_by h-publisher t10-revert
      [ -n "$plan_id" ] || die "no revert plan; nothing after it can run"
      check "$ref" "the plan binds the record opened at revision $drift_open" \
        same "$(sql "SELECT drift_record FROM plan WHERE id = '$plan_id'")" "$drift_open"
      check "$ref" "approved as h-approver: 201" approve_by h-approver "$plan_id" t10-revert
      if [ "$(sql "SELECT frozen FROM machine WHERE id = '$machine_w'")" = t ]; then
        fresh h-approver
        check "$ref" "the worker's scope, frozen in T10, unfrozen by h-approver: 201" \
          answers 201 - POST "/api/v1/machines/$machine_w/unfreezes" "$tok" '{"reason": "T10 revert"}' "$(key unfreeze)"
      fi
      reverted() { [ "$(sql "SELECT resolution FROM drift_record WHERE machine = '$machine_w' AND opened = $drift_open")" = reverted ]; }
      check "$ref" "within 5 minutes the revert completes and closes the record reverted" within 300 reverted
    fi
    ;;
  drift-closed)
    # A drift record is named by its machine and the revision that opened it, and a machine has at
    # most one open (drift_record_open). A failure names the one T10 left open (README).
    drift_open=$(sql "SELECT opened FROM drift_record WHERE machine = '$machine_w' AND closed IS NULL")
    check "$ref" "T10's drift is closed: no open drift record on the worker${drift_open:+ (open: the record opened at revision $drift_open)}" \
      same "$drift_open" ''
    if [ "$failed" -eq 0 ] && [ "$(sql "SELECT frozen FROM machine WHERE id = '$machine_w'")" = t ]; then
      fresh h-approver
      check "$ref" "the worker's scope, still frozen after T10, unfrozen by h-approver: 201" \
        answers 201 - POST "/api/v1/machines/$machine_w/unfreezes" "$tok" '{"reason": "T11 setup"}' "$(key unfreeze)"
    fi
    ;;
  t11-check)
    check "$ref" "A's configuration has its ingestion block, so A owns claims and decides as the controller" \
      grep --quiet --extended-regexp '^ingestion:' "$STATE/server/a/config.yaml"
    check "$ref" "A started after the current epoch's entry, so A's owner epoch is the current one" a_started_after_entry
    check "$ref" "the control plane's scope: pre-restore unaccounted, with no accounting or release in this epoch" \
      same "$(sql "SELECT m.scope_state || ' ' || (SELECT count(*) FROM scope_accounting a WHERE a.machine = m.id AND a.epoch = i.epoch)
        || ' ' || (SELECT count(*) FROM scope_release r WHERE r.machine = m.id AND r.epoch = i.epoch)
        FROM machine m, installation_state i WHERE m.id = '$machine_cp'")" 'pre-restore-unaccounted 0 0'
    stopped=$(sed -n 's/^stopped\t//p' "$STATE/participants-t11" 2>/dev/null) && [ -n "$stopped" ] ||
      die "no S7 t11 stop is recorded in $STATE; run fixtures/scenarios/s7 t11 first"
    check "$ref" "no apply-config operation was created since S7's stop" \
      same "$(sql "SELECT count(*) FROM operation WHERE kind = 'apply-config' AND created_at > '$stopped'")" 0
    ;;
esac
say "prepare $step: $failed failed; evidence in $EV"
[ "$failed" -eq 0 ]
