# Version manifest for the investigation fixtures. Every experiment report cites this file's
# commit. Values are frozen on purpose: change one only in a commit that says why, because a bump
# invalidates evidence recorded against the old value. Plain KEY=value, sourced by fixtures/lib.sh
# and read by docker compose.

# Talos (design baseline v1.14.5). The CLI is downloaded and checked against upstream's
# sha256sum.txt; the node image is pinned by index digest.
TALOS_VERSION=v1.14.5
TALOSCTL_URL=https://github.com/siderolabs/talos/releases/download/v1.14.5/talosctl-linux-amd64
TALOSCTL_SHA256=ff432b68986709e6b69c563a08a2ced4232d5196b0dccd6d2e783e9d714d7d7d
TALOS_IMAGE=ghcr.io/siderolabs/talos:v1.14.5@sha256:2bd72b810f540a75d5b1c8c3739ada000fff9beec18c941790c34b9592f1a8ff
KUBERNETES_VERSION=1.36.2

# OpenBao (design baseline v2.6.1).
OPENBAO_IMAGE=ghcr.io/openbao/openbao:2.6.1@sha256:5b2486ab0fb90bbc788cc345b0a08616dfb375873ee8be5df3a2fd4d378a67e0
# The HTTP client bin/inject runs inside the OpenBao container's network namespace (the image
# itself carries none that can send a DELETE), so that a request reaches the container verified
# under the name and not whatever holds the published port by then.
CURL_IMAGE=docker.io/curlimages/curl:8.22.0@sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777

# PostgreSQL. The tag floats; the digest does not. bin/evidence records the exact server version.
POSTGRES_IMAGE=docker.io/library/postgres:17-alpine@sha256:f02121de6f74d30d8a94cd1d9584125e2178d7e6c377d8130112d4e52d867995

# The test identity provider (fixtures/dev-idp), pinned by index digest. A test fixture only: it
# selects no identity provider for deployments.
ZITADEL_IMAGE=ghcr.io/zitadel/zitadel:v4.19.5@sha256:a586456a208e0db4c633db0ba43c427c24b37846138b8b13ff16ad8e003a18d3
# Its login page (login v2), at the same release, for the participant sessions (#367): a person
# signs in through it, where the tests sign in through the session API.
ZITADEL_LOGIN_IMAGE=ghcr.io/zitadel/zitadel-login:v4.19.5@sha256:2f8e57672fcd4f9a285d99355fae9f85fd7495768c090c07c3bbc2d84fc06617

# Local provider candidates (E5). sops is checked against upstream's checksums file, age against
# the digest GitHub records for the release asset.
SOPS_VERSION=v3.13.3
SOPS_URL=https://github.com/getsops/sops/releases/download/v3.13.3/sops-v3.13.3.linux.amd64
SOPS_SHA256=e5bec3346a873ae91d871550f3e698c1aad962aff462a080e40f25fde17fef6b
AGE_VERSION=v1.3.2
AGE_URL=https://github.com/FiloSottile/age/releases/download/v1.3.2/age-v1.3.2-linux-amd64.tar.gz
AGE_SHA256=cbe24006683f8eb669266162894b9a522a1af52f2665fbc63a4bb032ed26ac10
# The two binaries inside that archive, as extracted: what the commands run and check before use.
AGE_BINARY_SHA256=eb7dd1b518f0a307c99cd97782623c5321da049154b04acd2d98d21aa7bc9b2c
AGE_KEYGEN_SHA256=0a0009db842259d6717f7eeb30acb6b90d2a2eb924c6acd0a0db0ca1f1537899

# Topology. The subnet must not overlap the Kubernetes pod (10.244.0.0/16) or service
# (10.96.0.0/12) ranges: Talos drops overlapping addresses from its API certificate and the
# cluster never bootstraps.
FIXTURE_NAME=bw-fixture
TALOS_SUBNET=10.55.0.0/24
TALOS_CONTROLPLANE_IP=10.55.0.2
TALOS_WORKER_IP=10.55.0.3
# Instances A, B and C on the cluster's network, fixed: an instance started while a Talos node is
# detached would otherwise take the node's address, and the node could not rejoin on it.
BW_A_TALOS_IP=10.55.0.11
BW_B_TALOS_IP=10.55.0.12
BW_C_TALOS_IP=10.55.0.13
# B's recovery start (acceptance plan S7): B's configuration and port, its own address.
BW_B_RECOVERY_TALOS_IP=10.55.0.14
# Every published host port stays below Linux's ephemeral range (32768-60999 by default): a
# scenario restarts these services, and while one is stopped any outbound connection or Go
# test listener on the host may take its port, so the restart fails "address already in use".
POSTGRES_PORT=25432
OPENBAO_PORT=28200
# The server instances under test, A and B (plain http), published on 127.0.0.1 only, like
# POSTGRES_PORT. C is the fixture-only build with the interruption seam (internal/seam).
SERVER_A_PORT=28080
SERVER_B_PORT=28081
SERVER_C_PORT=28082
