#!/usr/bin/env bash
# Acceptance plan S1, adoption of the existing cluster, against the fixture. `run`: the
# preconditions, steps 1 to 5 and the pass criteria. Each check writes PASS, FAIL or SKIP, its
# acceptance-plan reference and what it checked to s1.tsv in the evidence directory and to stdout;
# the directory is then scanned by bin/evidence. Exit 1 on any FAIL.
# Usage: scenarios/s1 run   (on a fresh fixtures/bin/up, with mise run dev-db and mise run dev-bao
# up for the Go tests)
set -euo pipefail
here=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
bin=$here/../bin
# shellcheck source-path=SCRIPTDIR source=../lib.sh
. "$here/../lib.sh"

s1_mode=${1:-}
case $s1_mode in run) ;; *) die "usage: scenarios/s1 run" ;; esac
need docker curl jq timeout id sleep git date sha256sum base64 head tr
need_state
# No fixture lock of its own: bw, seed, inject and evidence each take the one they need.
umask 077
image_id=$(cat -- "$STATE/up-image") || die "no server image is recorded in $STATE; run fixtures/bin/up"
image_own "$image_id" || die "the recorded server image is not this run's; run fixtures/bin/down, then up"
EV=$STATE/evidence/s1-$s1_mode-$(date -u +%Y%m%dT%H%M%SZ)
mkdir -p -- "$EV" "$EV/http"
scenario=s1
# shellcheck source-path=SCRIPTDIR source=common.sh
. "$here/common.sh"

# The worker's file secret bin/up planted, by the path its patch gave it (machine.files[0]).
WORKER_MARK='doc[0]/machine/files/0/content'
# The Talos API methods that change a node. A read-only ingestion calls none of them.
MUTATIONS='MachineService/(ApplyConfiguration|Reboot|Reset|Shutdown|Upgrade|Rollback|Bootstrap|EtcdLeaveCluster|EtcdRemoveMember|EtcdForfeitLeadership)|LifecycleService/'
run_key=$(date -u +%s%N)

# node_talos <node ip> <talosctl args...>: talosctl against one node, through that node.
node_talos() { talosctl_timed 20 -e "$1" -n "$1" "${@:2}"; }
# key <name>: this run's Idempotency-Key for one request.
key() { printf 's1-%s-%s' "$run_key" "$1"; }
# etag_of_last: the ETag header of the last response.
etag_of_last() { sed -n 's/^[Ee][Tt][Aa][Gg]: *//p' "$EV/last.headers" | tr -d '\r'; }
# sql <statement>: one psql answer, unaligned, as Bronzeward's owner role.
sql() { pg psql -U bronzeward -d bronzeward -Atc "$1"; }
# digest_of <bundle file> <node ip>: the first field of that node's line.
digest_of() { awk -v n="$2" '$2 == n {print $1}' "$1"; }
# mutations <node ip>: how many Talos mutation requests that node's apid log records.
mutations() {
  local log
  log=$(node_talos "$1" logs apid) || return 1
  grep --count --extended-regexp -- "$MUTATIONS" <<<"$log" || true
}

# Step 1's records. Globals: a command substitution would lose them.
cluster='' machine_cp='' machine_w=''
# record <reference> <what> <path> <body> <key name>: a 201 for h-author's POST, its id in
# $recorded.
recorded=''
record() {
  local ref=$1 what=$2 path=$3 body=$4
  recorded=
  check "$ref" "$what" answers 201 - POST "$path" "$author" "$body" "$(key "${path##*/}-$5")"
  recorded=$(jq -er '.id' "$EV/last.body" 2>/dev/null) || recorded=
  [ -n "$recorded" ] || die "s1: $what: no id in the response; nothing after it can run"
}

# Step 3's draft and its current ETag; the claims of the imports that succeeded.
draft='' etag='' ingested=()
# ingest <machine id> <marks JSON array> [key suffix]: POST /ingestions with If-Match the draft's
# ETag, then the claim to its end, the operation's state and the draft's new ETag. A machine's
# second import takes a suffix: its Idempotency-Key is its own.
ingest() {
  local m=$1 marks=$2 body ing op state n
  body=$(jq -nc --arg m "$m" --arg d "$draft" --argjson marks "$marks" \
    '{kind: "import", source: "machine", staging: "transient", machine: $m, draft: $d, marks: $marks}')
  answers 202 - POST /api/v1/ingestions "$author" "$body" "$(key "ingestion-$m${3:+-$3}")" "$etag" || return 1
  if ! ing=$(jq -er '.ingestion' "$EV/last.body") || ! op=$(jq -er '.operation' "$EV/last.body"); then
    say "s1: POST /ingestions: no ingestion or operation in the 202"
    return 1
  fi
  # The claim ends released or abandoned; the lease is 15 s, so a minute is generous.
  state=
  for ((n = 0; n < 60; n++)); do
    answers 200 - GET "/api/v1/ingestions/$ing" "$author" || return 1
    state=$(jq -er '.state' "$EV/last.body") || state=
    case $state in released | abandoned) break ;; esac
    sleep 1
  done
  [ "$state" = released ] || {
    say "s1: ingestion of $m: claim $state, want released"
    return 1
  }
  ingested+=("$ing")
  answers_with '.state == "succeeded"' 200 - GET "/api/v1/operations/$op" "$author" || return 1
  answers 200 - GET "/api/v1/drafts/$draft" "$author" || return 1
  local next
  next=$(etag_of_last)
  [ -n "$next" ] && [ "$next" != "$etag" ] || {
    say "s1: the draft's ETag did not move across the ingestion of $m"
    return 1
  }
  etag=$next
}

# has_references <machine id> [marked]: the machine's import base document holds !bwref
# references, one row each, and, with marked, the file content as one. The document is matched in
# the database, never printed.
has_references() {
  local m=$1 refs
  refs=$(sql "SELECT count(*) FROM import_base_reference r JOIN import_base_revision b ON b.id = r.revision WHERE b.machine = '$m'") || return 1
  [ "$refs" -ge 1 ] || {
    say "s1: $m: no reference rows"
    return 1
  }
  [ "$(sql "SELECT count(*) FROM import_base_revision WHERE machine = '$m' AND position('!bwref' IN document) > 0")" = 1 ] || {
    say "s1: $m: the import base document holds no !bwref"
    return 1
  }
  [ "${2:-}" != marked ] ||
    [ "$(sql "SELECT count(*) FROM import_base_revision WHERE machine = '$m' AND document ~ '\\ycontent: !bwref '")" = 1 ] || {
    say "s1: $m: the file content is not a reference"
    return 1
  }
}

# generations_listed: every generation a reference row names is listed under its claim's path by
# the metadata identity, at version 1 (create-only), and those paths list nothing else.
generations_listed() {
  local rows path dir value listing names want got
  rows=$(sql "SELECT generation FROM import_base_reference ORDER BY generation") || return 1
  [ -n "$rows" ] || return 1
  want=$(printf '%s\n' "$rows" | sort -u)
  got=
  for dir in $(printf '%s\n' "$rows" | sed 's|/[^/]*$||' | sort -u); do
    listing=$(BAO_TOKEN=$BW_BAO_METADATA_TOKEN bao kv list -format=json -mount=secret "$dir") || {
      say "s1: the metadata identity cannot list $dir"
      return 1
    }
    names=$(jq -er '.[]' <<<"$listing") || return 1
    for value in $names; do got+="$dir/$value"$'\n'; done
  done
  got=$(printf '%s' "$got" | sed '/^$/d' | sort -u)
  [ "$got" = "$want" ] || {
    say "s1: the generation paths listed are not the referenced ones"
    return 1
  }
  for path in $rows; do
    value=$(BAO_TOKEN=$BW_BAO_METADATA_TOKEN bao kv metadata get -format=json -mount=secret "$path" | jq -er '.data.current_version') || return 1
    [ "$value" = 1 ] || {
      say "s1: $path is at version $value, not a create-only generation"
      return 1
    }
  done
}

# baseline_is_pre_state <machine id> <node ip> <pre-state digest file>: the OpenBao administrator
# decrypts the machine's baseline ciphertext outside Bronzeward; its configuration digest
# (execution-recovery §1: trailing newlines made one) is the one recorded and the pre-state's.
# The plaintext stays in the pipe.
baseline_is_pre_state() {
  local row ct recorded_digest got pre
  row=$(sql "SELECT encode(baseline_ciphertext, 'escape') || ' ' || encode(configuration_digest, 'hex') FROM import_base_revision WHERE machine = '$1'") || return 1
  ct=${row%% *} recorded_digest=${row##* }
  got=$(printf '%s\n' "$(bao write -field=plaintext transit/decrypt/bw-baseline ciphertext="$ct" | base64 -d)" |
    sha256sum | cut -d' ' -f1) || return 1
  pre=$(digest_of "$3" "$2")
  [ "$got" = "$recorded_digest" ] && [ "$got" = "$pre" ] || {
    say "s1: $1: decrypted baseline $got, recorded $recorded_digest, pre-state $pre"
    return 1
  }
}

# executor_refused <machine id>: the executor identity's decryption of the baseline is refused.
executor_token=''
executor_refused() {
  local ct out rc=0
  ct=$(sql "SELECT encode(baseline_ciphertext, 'escape') FROM import_base_revision WHERE machine = '$1'") || return 1
  out=$(BAO_TOKEN=$executor_token bao write -field=plaintext transit/decrypt/bw-baseline ciphertext="$ct" 2>&1) || rc=$?
  if [ "$rc" -eq 0 ] || ! grep --quiet --ignore-case --fixed-strings 'permission denied' <<<"$out"; then
    say "s1: the executor's baseline decryption was not refused for permission (exit $rc)"
    return 1
  fi
}

# gen_claims: the claims the metadata identity lists under gen/<cluster>/, one per line, sorted;
# nothing when the path holds none yet (bao's JSON answer is then {} with exit 2).
gen_claims() {
  local out rc=0
  out=$(BAO_TOKEN=$BW_BAO_METADATA_TOKEN bao kv list -format=json -mount=secret "gen/$cluster" 2>&1) || rc=$?
  case $rc in
    0) jq -er '.[]' <<<"$out" | sed 's|/$||' | sort ;;
    2) [ "$out" = '{}' ] ;;
    *) return 1 ;;
  esac
}
# claims_added <listing before the imports>: there was none; now there are exactly the imports'.
claims_added() {
  [ -z "$1" ] && [ "$(gen_claims)" = "$(printf '%s\n' "${ingested[@]}" | sort)" ]
}

# refused_input <name>: a refused input. Each holds the canary, a scan pattern, so a problem or a
# log that quoted it would fail the scan.
refused_input() {
  case $1 in
    parse) printf 'machine:\n  token: %s\n  certSANs: [\n' "$BW_CANARY" ;;
    guard) printf 'machine:\n  token: %s\n  nodeLabels:\n    copy: %s\n' "$BW_CANARY" "$BW_CANARY" ;;
  esac
}
# import_refused <name> <body> <operation filter> <cause or -> [fault]: POST /ingestions under
# the draft's current ETag with that body, which its run refuses: 202; the claim ends abandoned
# with no payload; the operation satisfies the filter, its terminal event names the cause (unless
# -), and its problem holds no scan pattern; nothing read is kept (no new import base revision);
# the draft's ETag and the claims under gen/<cluster>/ are unchanged. With a fault, it is put in
# place after the first listing and taken away before the second: OpenBao answers both. A fault
# that cannot be taken away leaves every later check meaningless.
import_refused() {
  local name=$1 fault_name=${5:-} before rc=0
  if ! before=$(gen_claims); then
    say "s1: refusal $name: the metadata identity cannot list gen/$cluster"
    return 1
  fi
  if [ -n "$fault_name" ] && ! fault "$fault_name" on; then
    say "s1: refusal $name: the fault was not put in place"
    fault "$fault_name" off || die "s1: refusal $name: the fault could not be taken away"
    return 1
  fi
  refusal_observed "$@" || rc=$?
  [ -z "$fault_name" ] || fault "$fault_name" off || die "s1: refusal $name: the fault could not be taken away"
  [ "$rc" -eq 0 ] || return "$rc"
  [ "$(gen_claims)" = "$before" ] || {
    say "s1: refusal $name: the claims under gen/$cluster/ changed"
    return 1
  }
}
# refusal_observed <name> <body> <operation filter> <cause or ->: import_refused's checks that
# read only the API and the database.
refusal_observed() {
  local name=$1 body=$2 filter=$3 cause=$4 revisions ing op state n
  revisions=$(sql 'SELECT count(*) FROM import_base_revision') || return 1
  answers 202 - POST /api/v1/ingestions "$author" "$body" "$(key "refusal-$name")" "$etag" || return 1
  if ! ing=$(jq -er '.ingestion' "$EV/last.body") || ! op=$(jq -er '.operation' "$EV/last.body"); then
    say "s1: refusal $name: no ingestion or operation in the 202"
    return 1
  fi
  state=
  for ((n = 0; n < 60; n++)); do
    answers 200 - GET "/api/v1/ingestions/$ing" "$author" || return 1
    state=$(jq -er '.state' "$EV/last.body") || state=
    case $state in released | abandoned) break ;; esac
    sleep 1
  done
  [ "$state" = abandoned ] || {
    say "s1: refusal $name: claim $state, want abandoned"
    return 1
  }
  [ "$(sql "SELECT count(*) FROM staging_claim WHERE id = '$ing' AND state = 'abandoned' AND payload IS NULL")" = 1 ] || {
    say "s1: refusal $name: the claim row is not abandoned without a payload"
    return 1
  }
  answers_with "$filter" 200 - GET "/api/v1/operations/$op" "$author" || return 1
  if grep --quiet --fixed-strings --file="$STATE/scan-patterns.txt" -- "$EV/last.body"; then
    say "s1: refusal $name: the operation's problem holds a fixture secret"
    return 1
  fi
  [ "$cause" = - ] ||
    [ "$(sql "SELECT entry->>'cause' FROM operation_event WHERE operation = '$op' AND entry->>'type' = 'failed'")" = "$cause" ] || {
    say "s1: refusal $name: the terminal event does not name the cause $cause"
    return 1
  }
  [ "$(sql 'SELECT count(*) FROM import_base_revision')" = "$revisions" ] || {
    say "s1: refusal $name: an import base revision was kept"
    return 1
  }
  answers 200 - GET "/api/v1/drafts/$draft" "$author" || return 1
  [ "$(etag_of_last)" = "$etag" ] || {
    say "s1: refusal $name: the draft's ETag moved"
    return 1
  }
}
# machine_body <machine id>: a source machine import of it, transient, nothing marked.
machine_body() {
  jq -nc --arg m "$1" --arg d "$draft" '{kind: "import", source: "machine", staging: "transient", machine: $m, draft: $d, marks: []}'
}
# refused <name> <machine id> <marks JSON array> <rule> <paths JSON or -> [document]: an import,
# source machine, or source document with refused_input <name>, that compilation refuses (C §13):
# import_refused, the operation failed 422 validation-failed naming the rule (and the paths).
refused() {
  local name=$1 m=$2 marks=$3 rule=$4 paths=$5 doc='' source=machine body filter
  if [ "${6:-}" = document ]; then
    doc=$(refused_input "$name") source=document
  fi
  # The document over stdin: on jq's command line it would be readable by any local user.
  body=$(printf '%s' "$doc" | jq -Rsc --arg m "$m" --arg d "$draft" --arg s "$source" --argjson marks "$marks" \
    '. as $doc | {kind: "import", source: $s, staging: "transient", machine: $m, draft: $d, marks: $marks}
     + if $doc == "" then {} else {document: $doc} end')
  filter=".state == \"failed\" and .error.status == 422 and .error.type == \"urn:bronzeward:problem:validation-failed\" and .error.rule == \"$rule\""
  [ "$paths" = - ] || filter+=" and .error.paths == $paths"
  import_refused "$name" "$body" "$filter" -
}

# The cluster's Talos cluster ID as its nodes report it, and one no node has.
talos_cid='' wrong_cid=''
# fault <name> on|off: the fault an access case puts in place, then takes away. A value written to
# the access path holds the canary, so a problem or a log that quoted it fails the scan; it goes
# over stdin.
fault() {
  local access=access/talos/$cluster
  case $1-$2 in
    absent-on) bao kv metadata delete -mount=secret "$access" >/dev/null ;;
    garbage-on) printf 'not a talosconfig %s\n' "$BW_CANARY" | bao_stdin kv put -mount=secret "$access" talosconfig=- >/dev/null ;;
    malformed-on) printf '%s\n' "$BW_CANARY" | bao_stdin kv put -mount=secret "$access" other=- >/dev/null ;;
    absent-off | garbage-off | malformed-off) put_access "$cluster" ;;
    silent-on) "$bin/inject" linksplit A worker >/dev/null ;;
    silent-off) "$bin/inject" linkjoin A worker >/dev/null ;;
    cluster-id-on) sql "UPDATE cluster SET talos_cluster_id = '$wrong_cid' WHERE id = '$cluster'" >/dev/null ;;
    cluster-id-off) sql "UPDATE cluster SET talos_cluster_id = '$talos_cid' WHERE id = '$cluster'" >/dev/null ;;
    node-id-on | node-id-off) ;;
    *) return 1 ;;
  esac
}
# access_case <name> <machine id> <status> <problem code> <cause>: under the fault <name>, a
# source machine import of the machine refused by its node read (PA §3.3) with that status, code
# and cause (import_refused).
access_case() {
  import_refused "access-$1" "$(machine_body "$2")" \
    ".state == \"failed\" and .error.status == $3 and .error.type == \"urn:bronzeward:problem:$4\"" "$5" "$1"
}
# sealed_refused: with OpenBao sealed, POST /ingestions is refused at the request, since its keyed
# fingerprint is OpenBao's to compute: 503 dependency-unavailable and no claim committed; once
# unsealed, the draft's ETag and the claims under gen/<cluster>/ are unchanged. The run's own
# provider-unavailable cause is the Go test's (TestMachineAccessUnavailable): no fixture fault
# seals OpenBao between the request and the run's read.
sealed_refused() {
  local before claims rc=0
  before=$(gen_claims) || return 1
  claims=$(sql 'SELECT count(*) FROM staging_claim') || return 1
  if ! "$bin/inject" seal openbao >/dev/null; then
    "$bin/inject" unseal openbao >/dev/null || die "s1: OpenBao could not be unsealed"
    say "s1: OpenBao could not be sealed"
    return 1
  fi
  answers 503 dependency-unavailable POST /api/v1/ingestions "$author" "$(machine_body "$machine_w")" \
    "$(key refusal-sealed)" "$etag" || rc=1
  "$bin/inject" unseal openbao >/dev/null || die "s1: OpenBao could not be unsealed"
  [ "$rc" -eq 0 ] || return 1
  [ "$(sql 'SELECT count(*) FROM staging_claim')" = "$claims" ] || {
    say "s1: a claim was committed while OpenBao was sealed"
    return 1
  }
  answers 200 - GET "/api/v1/drafts/$draft" "$author" || return 1
  [ "$(etag_of_last)" = "$etag" ] && [ "$(gen_claims)" = "$before" ] || {
    say "s1: the draft's ETag or the claims under gen/$cluster/ changed while OpenBao was sealed"
    return 1
  }
}
# scan_clean <name>: the bundle evidence_to <name> captured holds no fixture secret but its control.
scan_clean() { grep --quiet --fixed-strings -- 'positive control found; 0 other file(s) contain' "$EV/$1-evidence.log"; }
# refusal_bundle <name>: the evidence bundle after one refusal, and its scan clean.
refusal_bundle() {
  evidence_to "refusal-$1" || die "no bundle for the $1 refusal: bin/evidence failed"
  check 'S1 refusal' "after the $1 refusal, its bundle and the run directory: no fixture secret but the scan's control" \
    scan_clean "refusal-$1"
}

# Predicates for check: their arguments land in commands.tsv, so they take IDs and counts only.
same() { [ "$1" = "$2" ]; }
differ() { [ "$1" != "$2" ]; }
# counted <n> <ERE> <file>: exactly n lines of the file match.
counted() { [ "$(grep --count --extended-regexp -- "$2" "$3")" = "$1" ]; }
# put_access <cluster id>: the operator's write of bin/up's talosconfig, over stdin.
put_access() { bao_stdin kv put -mount=secret "access/talos/$1" talosconfig=- <"$TALOSCONFIG" >/dev/null; }
# access_read <cluster id>: the executor identity reads the cluster's Talos access.
access_read() { BAO_TOKEN=$executor_token bao kv get -format=json -mount=secret "access/talos/$1" >/dev/null 2>&1; }

# same_file <a> <b>: two capture files are byte-identical and name both nodes.
same_file() { cmp --quiet -- "$1" "$2" && [ "$(grep --count --extended-regexp '^[0-9a-f]+ ' "$1")" = 2 ]; }

# evidence_to <name>: a bundle captured and scanned now, its path in $bundle and in $EV/<name>.
bundle=''
evidence_to() {
  bundle=$("$bin/evidence" "$EV" 2>"$EV/$1-evidence.log") || {
    say "s1: bin/evidence ($1) failed: $(tail -n 1 "$EV/$1-evidence.log")"
    return 1
  }
  printf '%s\n' "$bundle" >"$EV/$1-bundle"
}

# The rows no request reaches (a heartbeat is internal to an instance, a crash inside T1 needs a
# seam inside the process; ruling 1), proven by the Go tests that already prove them. Anchored:
# TestHeartbeat alone, not TestHeartbeatLossStopsRunner.
go_tests='TestOwnerFenceMatrix|TestHeartbeat|TestHeartbeatExtendsFromTheLockTime|TestCrashInsideT1LeavesDraft|TestTakeoverRacesT1|TestTakeoverNothingToDecrypt|TestTakeoverDecryptFailureLeavesResumed|TestMachineAccessUnavailable'
# go_rows_ran: those tests, in the clone, against go-db's PostgreSQL and OpenBao (mise run dev-db
# and dev-bao by default), as go-db runs them: a missing service fails, it does not skip. The DSN
# and token reach the tests through the environment, never the command line, so neither is in a
# retained file. Passes when go test exited 0 with no test skipped.
go_rows_ran() {
  (
    export BW_TEST_PG_DSN="${BW_TEST_PG_DSN:-postgres://bronzeward@127.0.0.1:55433/bronzeward?sslmode=disable}"
    export BW_TEST_BAO_ADDR="${BW_TEST_BAO_ADDR:-http://127.0.0.1:58201}"
    export BW_TEST_BAO_TOKEN="${BW_TEST_BAO_TOKEN:-bw-dev-root-token}"
    logged go-rows env BW_REQUIRE_PG=1 BW_REQUIRE_BAO=1 mise exec -- go test -count=1 -v -run "^($go_tests)\$" \
      ./internal/staging ./internal/api
  ) && ! grep --quiet -- '--- SKIP' "$EV/go-rows.log"
}
# go_row <test>: the test's own top-level PASS line is in go-rows.log.
go_row() { grep --quiet -- "^--- PASS: $1 (" "$EV/go-rows.log"; }

# The takeover rows (C §3.4) on instance C, the interruption build: its run stops where C's
# control file says (internal/seam), and B and A take the claim over.
# interrupt <step> kill|stall, or interrupt -: C's control file, written whole under another name
# and moved into place, so that C never reads half of it; - removes it.
interrupt() {
  local control=$STATE/server/c/interrupt tmp
  if [ "$1" = - ]; then
    rm -f -- "$control"
    return
  fi
  tmp=$(mktemp -- "$STATE/server/c/interrupt.XXXXXX") || return 1
  if ! printf '%s %s\n' "$1" "$2" >"$tmp" || ! mv -f -- "$tmp" "$control"; then
    rm -f -- "$tmp"
    return 1
  fi
}
# c_log: instance C's log, by the container ID need_state verified.
c_log() { docker logs "${verified_container_ids[$BW_C]}" 2>&1; }
# c_says <ERE>: a line of C's log matches.
c_says() { c_log | grep --quiet --extended-regexp -- "$1"; }
# c_exited: C is not running, and its log says the seam killed it at baseline.
c_exited() {
  [ "$(docker inspect --format '{{.State.Running}}' "${verified_container_ids[$BW_C]}")" = false ] &&
    c_says '^fixture interrupt: kill at baseline$'
}
# within <seconds> <command...>: the command succeeds within that many seconds, asked each second.
within() {
  local n
  for ((n = 1; n < $1; n++)); do
    "${@:2}" && return 0
    sleep 1
  done
  "${@:2}"
}

# The encrypted import C runs: its claim and operation.
tk_ing='' tk_op=''
# c_import <key name>: an encrypted import of the worker, its file content marked, POSTed to C
# under the draft's current ETag: 202, its claim and operation in tk_ing and tk_op.
c_import() {
  local body rc=0
  tk_ing='' tk_op=''
  body=$(jq -nc --arg m "$machine_w" --arg d "$draft" --arg p "$WORKER_MARK" \
    '{kind: "import", source: "machine", staging: "encrypted", machine: $m, draft: $d, marks: [$p]}')
  call_port=$SERVER_C_PORT
  answers 202 - POST /api/v1/ingestions "$author" "$body" "$(key "ingestion-$1")" "$etag" || rc=1
  call_port=$SERVER_A_PORT
  [ "$rc" -eq 0 ] || return 1
  tk_ing=$(jq -er '.ingestion' "$EV/last.body") && tk_op=$(jq -er '.operation' "$EV/last.body")
}
# takeover <A|B> <status> <problem code or -> <key name>: an author's takeover of tk_ing on that
# instance gets that status (and problem).
takeover() {
  local rc=0
  [ "$1" = A ] || call_port=$SERVER_B_PORT
  answers "$2" "$3" POST "/api/v1/ingestions/$tk_ing/takeovers" "$author" '{}' "$(key "takeover-$4")" || rc=1
  call_port=$SERVER_A_PORT
  return "$rc"
}
# claim_is <state> <owner generation> payload|none: tk_ing's stored row.
claim_is() {
  [ "$(sql "SELECT state || ' ' || owner_gen || ' ' || CASE WHEN payload IS NULL THEN 'none' ELSE 'payload' END
    FROM staging_claim WHERE id = '$tk_ing'")" = "$1 $2 $3" ]
}
# events_are <list>: tk_op's event types in order, space-separated.
events_are() {
  [ "$(sql "SELECT string_agg(entry->>'type', ' ' ORDER BY number) FROM operation_event WHERE operation = '$tk_op'")" = "$1" ]
}
# lapsed: tk_ing's lease has lapsed by the database's clock.
lapsed() { [ "$(sql "SELECT lease_until <= clock_timestamp() FROM staging_claim WHERE id = '$tk_ing'")" = t ]; }
# past <epoch seconds>: the database's clock is past it.
past() { [ "$(sql "SELECT clock_timestamp() > to_timestamp($1)")" = t ]; }
# lease_epoch: tk_ing's lease end, in epoch seconds.
lease_epoch() { sql "SELECT extract(epoch FROM lease_until) FROM staging_claim WHERE id = '$tk_ing'"; }
# The operation's events up to the staged one, on an import of a machine: its start, the Talos
# access version read, the envelope stored.
staged_events='started talos-access staged'
# stalled_staged: C's run stopped after storing the envelope, its claim held at generation 1.
stalled_staged() { c_says '^fixture interrupt: stall at staged$' && claim_is held 1 payload && events_are "$staged_events"; }
# live_at_first: the claim live, still held at generation 1 with its envelope.
live_at_first() { ! lapsed && claim_is held 1 payload; }
# resumed_under_b: B's resume failed: its taken-over and resume-failed events, the claim resumed at
# generation 2 with its envelope kept.
resumed_under_b() { events_are "$staged_events taken-over resume-failed" && claim_is resumed 2 payload; }
# committed_by_a: A's resume committed: its taken-over and succeeded events, the claim released at
# generation 3 without a payload.
committed_by_a() { events_are "$staged_events taken-over resume-failed taken-over succeeded" && claim_is released 3 none; }
# op_is <state> [problem code]: tk_op's state (and its problem's type), read as an author.
op_is() {
  local filter=".state == \"$1\""
  [ -z "${2:-}" ] || filter+=" and .error.type == \"urn:bronzeward:problem:$2\""
  answers_with "$filter" 200 - GET "/api/v1/operations/$tk_op" "$author"
}
# failed_cause_is <cause>: tk_op's failed event names that cause.
failed_cause_is() {
  [ "$(sql "SELECT entry->>'cause' FROM operation_event WHERE operation = '$tk_op' AND entry->>'type' = 'failed'")" = "$1" ]
}
# draft_etag_is <etag>: the draft's current ETag.
draft_etag_is() { answers 200 - GET "/api/v1/drafts/$draft" "$author" && [ "$(etag_of_last)" = "$1" ]; }
# revisions_are <n>: how many import base revisions exist.
revisions_are() { [ "$(sql 'SELECT count(*) FROM import_base_revision')" = "$1" ]; }
# nothing_after_a <revisions>: since A's commit, nothing written: the claim, the events, the import
# base revisions and the draft's ETag all as A left them.
nothing_after_a() { committed_by_a && revisions_are "$1" && draft_etag_is "$etag"; }
# killed_before_staging: C exited at its baseline, the claim held at generation 1 without an
# envelope, no staged event.
killed_before_staging() { c_exited && claim_is held 1 none && events_are 'started talos-access'; }
# abandoned_nothing: the takeover abandoned the claim at generation 2 without a payload, and failed
# the operation ingestion-abandoned with the cause nothing-to-decrypt and no taken-over event.
abandoned_nothing() {
  claim_is abandoned 2 none && events_are 'started talos-access failed' && op_is failed ingestion-abandoned &&
    failed_cause_is nothing-to-decrypt
}

# takeover_rows: C stalls an encrypted import after staging it; its heartbeat keeps the lease, so
# B's takeover is refused; C frozen, the lease lapses, and with OpenBao sealed B's takeover is
# accepted but its decryption fails, the claim resumed under B; A's takeover is refused while B's
# lease is live, then, unsealed and B's lease lapsed, accepted, and A's draft transaction commits.
# C, released and thawed, writes nothing.
takeover_rows() {
  local lease0 revisions
  check 'S1 takeover, C §3.4' 'C told to stall its next run after the staged event' interrupt staged stall
  check 'S1 takeover, C §3.4' 'encrypted import of the worker on C: 202' c_import takeover
  [ -n "$tk_op" ] ||
    die "s1: the encrypted import on C was not accepted; nothing after it can run"
  check 'S1 takeover, C §3.4' "C's run stalls after the staged event: the claim held at generation 1 with its envelope" \
    within 60 stalled_staged
  lease0=$(lease_epoch) || die "s1: cannot read the claim's lease"
  check 'S1 lease extension, C §3.3' "the claim's first lease end passes while C's run stalls" within 30 past "$lease0"
  check 'S1 lease extension, C §3.3' "C's heartbeat extended the lease: the claim still live, held at generation 1" live_at_first
  check 'S1 takeover, C §3.4' "B's takeover while C's lease is live: 409 conflict" takeover B 409 conflict live
  check 'S1 takeover, C §3.4' 'inject pause C (its heartbeat frozen with its run)' "$bin/inject" pause C
  check 'S1 takeover, C §3.4' "C's lease lapses" within 40 lapsed
  if ! "$bin/inject" seal openbao >/dev/null; then
    "$bin/inject" unseal openbao >/dev/null || die "s1: OpenBao could not be unsealed"
    die "s1: OpenBao could not be sealed"
  fi
  check 'S1 takeover, C §3.4' "B's takeover with OpenBao sealed: 202 (a takeover reads no key)" takeover B 202 - sealed
  check 'S1 takeover, C §3.4' "B's decryption fails: resume-failed event, the claim resumed under B at generation 2, its envelope kept" \
    within 20 resumed_under_b
  check 'S1 takeover, C §3.4' "A's takeover while B's lease is live: 409 conflict" takeover A 409 conflict b-live
  "$bin/inject" unseal openbao >/dev/null || die "s1: OpenBao could not be unsealed"
  check 'S1 takeover, C §3.4' "B's lease lapses (its run stopped)" within 40 lapsed
  revisions=$(sql 'SELECT count(*) FROM import_base_revision') || die "s1: cannot count import base revisions"
  check 'S1 takeover, C §3.4' "A's takeover once B's lease lapsed: 202" takeover A 202 - after-b
  check 'S1 takeover, C §3.4' "A resumes and commits: taken-over and succeeded events, the claim released at generation 3" \
    within 60 committed_by_a
  check 'S1 takeover, C §3.4' "A's draft transaction: the operation succeeded" op_is succeeded
  check 'S1 takeover, C §3.4' "A's draft transaction: one new import base revision" revisions_are "$((revisions + 1))"
  answers 200 - GET "/api/v1/drafts/$draft" "$author" || die "s1: cannot read the draft"
  check 'S1 takeover, C §3.4' "A's draft transaction moved the draft's ETag" differ "$(etag_of_last)" "$etag"
  etag=$(etag_of_last)
  check 'S1 takeover, C §3.4' "C's stall released" interrupt -
  check 'S1 takeover, C §3.4' 'inject unpause C' "$bin/inject" unpause C
  check 'S1 takeover, C §3.4' "C, the old owner, is fenced: its log has its heartbeat or its draft transaction refused" \
    within 30 c_says "ingestion $tk_ing: (heartbeat refused|the draft transaction: )"
  check 'S1 takeover, C §3.4' "C wrote nothing: the claim, the events, the import base revisions and the draft's ETag as A left them" \
    nothing_after_a "$((revisions + 1))"
}

# nothing_to_decrypt_row: C exits after its baseline, before any envelope is stored; once the
# lease lapses, A's takeover abandons the claim, its operation failed ingestion-abandoned with the
# cause nothing-to-decrypt, and the draft is unchanged. C is started again after.
nothing_to_decrypt_row() {
  check 'S1 takeover, C §3.4' 'C told to exit at once at its next baseline' interrupt baseline kill
  check 'S1 takeover, C §3.4' 'encrypted import of the worker on C: 202' c_import nothing
  [ -n "$tk_op" ] ||
    die "s1: the encrypted import on C was not accepted; nothing after it can run"
  check 'S1 takeover, C §3.4' 'C exits at its baseline: the claim held at generation 1 without an envelope, no staged event' \
    within 60 killed_before_staging
  check 'S1 takeover, C §3.4' "C's lease lapses" within 40 lapsed
  check 'S1 takeover, C §3.4' "A's takeover with nothing to decrypt: 202 at the operation" takeover A 202 - nothing
  check 'S1 takeover, C §3.4' 'the claim abandoned at generation 2 without a payload, the operation failed ingestion-abandoned, cause nothing-to-decrypt' \
    abandoned_nothing
  check 'S1 takeover, C §3.4' "the draft's ETag unchanged" draft_etag_is "$etag"
  check 'S1 takeover, C §3.4' "C's control file removed" interrupt -
  check 'S1 takeover, C §3.4' 'inject start C' "$bin/inject" start C
}

run() {
  # Preconditions: S0's migrate and seed, both instances up, then the pre-state.
  check 'S1 precondition' 'bw migrate' "$bin/bw" migrate
  check 'S1 precondition' 'inject start A' "$bin/inject" start A
  check 'S1 precondition' 'inject start B' "$bin/inject" start B
  interrupt - || die "cannot remove C's control file"
  check 'S1 precondition' 'inject start C (the interruption build, no interruption named)' "$bin/inject" start C
  check 'S1 precondition' 'A answers /livez' answers 204 - GET /livez ''
  "$bin/seed" >/dev/null || die "bin/seed failed"
  redact_automation_token "$(cat -- "$STATE/automation-token")"
  author=$(mint h-author) || die "cannot mint an author token"
  keep_secret "$author"
  evidence_to pre || die "no pre-state: bin/evidence failed"
  cp -- "$bundle/talos-config-sha256.txt" "$EV/pre-talos-config-sha256.txt"
  cp -- "$bundle/talos-config-version.txt" "$EV/pre-talos-config-version.txt"
  check 'S1 precondition' 'pre-state: both nodes have a configuration digest' \
    counted 2 '^[0-9a-f]{64} ' "$EV/pre-talos-config-sha256.txt"
  check 'S1 precondition' 'pre-state: both nodes have a machine-configuration resource version' \
    counted 2 '^[0-9]+ ' "$EV/pre-talos-config-version.txt"
  local cp_mut w_mut
  cp_mut=$(mutations "$TALOS_CONTROLPLANE_IP") || die "cannot read the control plane's apid log"
  w_mut=$(mutations "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"

  # Step 1: the cluster by its Talos cluster ID, each machine by its node ID and endpoint.
  local cid cid_w nid_cp nid_w
  cid=$(node_talos "$TALOS_CONTROLPLANE_IP" get info -o json | jq -er '.spec.clusterId') ||
    die "cannot read the control plane's cluster ID"
  cid_w=$(node_talos "$TALOS_WORKER_IP" get info -o json | jq -er '.spec.clusterId') ||
    die "cannot read the worker's cluster ID"
  nid_cp=$(node_talos "$TALOS_CONTROLPLANE_IP" get identity -o json | jq -er '.spec.nodeId') ||
    die "cannot read the control plane's node ID"
  nid_w=$(node_talos "$TALOS_WORKER_IP" get identity -o json | jq -er '.spec.nodeId') ||
    die "cannot read the worker's node ID"
  talos_cid=$cid
  wrong_cid=$(head -c 32 /dev/urandom | base64 | tr '+/' '-_') || die "cannot make a cluster ID"
  check 'S1 step 1' 'both nodes report one cluster ID' same "$cid" "$cid_w"
  check 'S1 step 1' 'the nodes report two node IDs' differ "$nid_cp" "$nid_w"
  record 'S1 step 1' 'POST /clusters as h-author with the Talos cluster ID: 201' /api/v1/clusters \
    "$(jq -nc --arg c "$cid" --arg e "https://$TALOS_CONTROLPLANE_IP:6443" --arg v "${TALOS_VERSION%.*}" \
      '{name: "bw-fixture", endpoint: $e, contract: $v, talosClusterId: $c}')" cluster
  cluster=$recorded
  record 'S1 step 1' 'POST /machines (control plane) by Talos node ID and endpoint: 201' /api/v1/machines \
    "$(jq -nc --arg c "$cluster" --arg n "$nid_cp" --arg e "$TALOS_CONTROLPLANE_IP:50000" \
      '{cluster: $c, talosNodeId: $n, talosEndpoint: $e}')" controlplane
  machine_cp=$recorded
  record 'S1 step 1' 'POST /machines (worker) by Talos node ID and endpoint: 201' /api/v1/machines \
    "$(jq -nc --arg c "$cluster" --arg n "$nid_w" --arg e "$TALOS_WORKER_IP:50000" \
      '{cluster: $c, talosNodeId: $n, talosEndpoint: $e}')" worker
  machine_w=$recorded

  # Step 2: the operator writes bin/up's os:admin talosconfig to the cluster's access path.
  check 'S1 step 2' 'bao kv put -mount=secret access/talos/<cluster> as the administrator, talosconfig over stdin' \
    put_access "$cluster"

  # Steps 3 and 4: the import draft, then each node in turn under its current ETag.
  check 'S1 step 3' 'POST /drafts as h-author: 201 with an ETag' \
    answers 201 - POST /api/v1/drafts "$author" "$(jq -nc --arg c "$cluster" '{cluster: $c, title: "S1 import"}')" "$(key draft)"
  draft=$(jq -er '.id' "$EV/last.body" 2>/dev/null) || die "s1: the draft has no id; nothing after it can run"
  etag=$(etag_of_last)
  [ -n "$etag" ] || die "s1: the draft has no ETag; nothing after it can run"
  local claims_before
  claims_before=$(gen_claims) || die "s1: the metadata identity cannot list gen/$cluster"
  check 'S1 steps 3-4' 'control plane ingested (source machine, transient): claim released, operation succeeded, ETag moved' \
    ingest "$machine_cp" '[]'
  check 'S1 steps 3-4' 'worker ingested with its file content marked: claim released, operation succeeded, ETag moved' \
    ingest "$machine_w" "$(jq -nc --arg p "$WORKER_MARK" '[$p]')"

  # Pass criteria the database and OpenBao answer.
  check 'S1 pass' 'control plane: !bwref references where the schema list identified values' has_references "$machine_cp"
  check 'S1 pass' 'worker: !bwref references, the marked file content among them' has_references "$machine_w" marked
  check 'S1 pass' 'each reference a create-only generation, listed under its claim by the metadata identity, nothing else there' \
    generations_listed
  check 'S1 pass' 'control plane: the baseline, decrypted by the administrator, has the recorded configuration digest, the pre-state' \
    baseline_is_pre_state "$machine_cp" "$TALOS_CONTROLPLANE_IP" "$EV/pre-talos-config-sha256.txt"
  check 'S1 pass' 'worker: the baseline, decrypted by the administrator, has the recorded configuration digest, the pre-state' \
    baseline_is_pre_state "$machine_w" "$TALOS_WORKER_IP" "$EV/pre-talos-config-sha256.txt"
  executor_token=$(bao token create -policy=bw-executor -no-default-policy -ttl=10m -format=json | jq -er '.auth.client_token') ||
    die "cannot create an executor token"
  keep_secret "$executor_token"
  check 'S1 pass' "the executor identity's decryption of the worker's baseline: refused" executor_refused "$machine_w"
  check 'S1 pass' "control: the same executor token reads the cluster's Talos access" access_read "$cluster"

  # The refusal set (C §13): each refused before any provider write, one bundle each. The control
  # for "no claim under gen/": the two imports above listed theirs.
  check 'S1 refusal' 'control: before the imports gen/<cluster>/ listed no claim, after them exactly their two' \
    claims_added "$claims_before"
  withheld+=("$BW_CANARY")
  check 'S1 refusal' 'worker, source machine, a mark addressing no node: abandoned, 422 mark-unaddressed naming the mark, no secret in the problem, ETag and gen/ unchanged' \
    refused unaddressed "$machine_w" '["doc[0]/machine/files/9/content"]' mark-unaddressed '["doc[0]/machine/files/9/content"]'
  refusal_bundle unaddressed
  check 'S1 refusal' 'source document, unparseable: abandoned, 422 parse, no secret in the problem, ETag and gen/ unchanged' \
    refused parse "$machine_w" '[]' parse - document
  refusal_bundle parse
  check 'S1 refusal' 'source document, the extracted token also an unmarked label: abandoned, 422 guard-value naming the label, no secret in the problem, ETag and gen/ unchanged' \
    refused guard "$machine_w" '[]' guard-value '["doc[0]/machine/nodeLabels/copy"]' document
  refusal_bundle guard
  local robot
  robot=$(cat -- "$STATE/automation-token") || die "no automation token in $STATE"
  check 'S1 refusal, PA §10.3' 'automation (the seed token) on POST /ingestions: 403 forbidden, humanOnly' \
    answers_with '.humanOnly == true' 403 forbidden POST /api/v1/ingestions "$robot" "$(machine_body "$machine_cp")" \
    "$(key automation)" "$etag"

  # Talos access refusals (PA §3.3, §16): each fixture-producible cause, one import each, its fault
  # put in place before and taken away after.
  check 'S1 access' 'the access secret absent (metadata deleted): abandoned, 503 talos-access-unavailable, cause absent, nothing kept' \
    access_case absent "$machine_w" 503 talos-access-unavailable absent
  check 'S1 access' 'the access secret not a talosconfig: abandoned, 503 talos-access-unavailable, cause talosconfig, nothing kept' \
    access_case garbage "$machine_w" 503 talos-access-unavailable talosconfig
  check 'S1 access' 'the access secret not exactly a talosconfig field: abandoned, 503 talos-access-unavailable, cause malformed, nothing kept' \
    access_case malformed "$machine_w" 503 talos-access-unavailable malformed
  check 'S1 access' 'OpenBao sealed: refused at the request, 503 dependency-unavailable, no claim, ETag and gen/ unchanged' \
    sealed_refused
  check 'S1 access' "the worker's endpoint silent to A (link split): abandoned, 503 talos-access-unavailable, cause node-unreachable, nothing kept" \
    access_case silent "$machine_w" 503 talos-access-unavailable node-unreachable
  record 'S1 access' 'POST /machines with a node ID no node has, at the control plane endpoint: 201' /api/v1/machines \
    "$(jq -nc --arg c "$cluster" --arg n "s1-no-such-node-$run_key" --arg e "$TALOS_CONTROLPLANE_IP:50000" \
      '{cluster: $c, talosNodeId: $n, talosEndpoint: $e}')" stranger
  check 'S1 access' 'a machine recorded with another node ID: abandoned, 409 machine-identity-mismatch, cause node-id, nothing kept' \
    access_case node-id "$recorded" 409 machine-identity-mismatch node-id
  check 'S1 access' 'the cluster recorded with another Talos cluster ID: abandoned, 409 machine-identity-mismatch, cause cluster-id, nothing kept' \
    access_case cluster-id "$machine_w" 409 machine-identity-mismatch cluster-id
  check 'S1 access' "control: with every fault taken away, the worker's import is not refused" \
    ingest "$machine_w" "$(jq -nc --arg p "$WORKER_MARK" '[$p]')" again

  # Takeover and interruption on instance C (C §3.3, §3.4).
  takeover_rows
  nothing_to_decrypt_row

  # The rows the Go tests prove (ruling 1), in a clone of the image commit, so that the results
  # are the server's own commit's; removed again once they have run.
  if clone_made go-rows-clone; then
    check 'S1 precondition' "GOFLAGS, GOEXPERIMENT and GOWORK are unset and the Go version is the image's, so the tests run on the server's build (clone HEAD $clone_head)" go_env_clean
    check 'S1 Go tests' 'the tests below ran against PostgreSQL and OpenBao and passed, none skipped (go-rows.log)' go_rows_ran
    check 'S1 lease extension, C §3.3' "a heartbeat from another ingestion principal, one of an older generation, and the owner's own after its lease lapsed: each refused, the claim unchanged (TestOwnerFenceMatrix)" \
      go_row TestOwnerFenceMatrix
    check 'S1 lease extension, C §3.3' "control: the owner's heartbeat while live extends the lease, never past the absolute expiry (TestHeartbeat)" \
      go_row TestHeartbeat
    check 'S1 lease extension, C §3.3' "control: the extension counts from when the heartbeat took the claim's lock (TestHeartbeatExtendsFromTheLockTime)" \
      go_row TestHeartbeatExtendsFromTheLockTime
    check 'S1 interruption' 'a crash inside the draft transaction: the draft and its ETag unchanged, nothing it wrote committed, the claim unreleased (TestCrashInsideT1LeavesDraft)' \
      go_row TestCrashInsideT1LeavesDraft
    check 'S1 takeover, C §3.4' "the old owner's draft transaction refused after a takeover, nothing of the draft written (TestTakeoverRacesT1)" \
      go_row TestTakeoverRacesT1
    check 'S1 takeover, C §3.4' 'a takeover with nothing to decrypt abandons the claim, its operation failed ingestion-abandoned (TestTakeoverNothingToDecrypt)' \
      go_row TestTakeoverNothingToDecrypt
    check 'S1 takeover, C §3.4' "a decryption failure leaves the claim resumed under the taker, then taken over once its lease lapses (TestTakeoverDecryptFailureLeavesResumed)" \
      go_row TestTakeoverDecryptFailureLeavesResumed
    check 'S1 access, PA §16' 'the provider unavailable to the access read: 503 talos-access-unavailable, cause provider-unavailable, the claim abandoned (TestMachineAccessUnavailable)' \
      go_row TestMachineAccessUnavailable
  else
    result FAIL 'S1 Go tests' 'no clone of the image commit (go-rows-clone.log): the Go tests did not run'
  fi
  rm -rf -- "$clone_dir"

  # Step 5: the post-state, compared with the pre-state.
  evidence_to post || die "no post-state: bin/evidence failed"
  cp -- "$bundle/talos-config-sha256.txt" "$EV/post-talos-config-sha256.txt"
  cp -- "$bundle/talos-config-version.txt" "$EV/post-talos-config-version.txt"
  check 'S1 pass' "neither node's configuration digest changed" \
    same_file "$EV/pre-talos-config-sha256.txt" "$EV/post-talos-config-sha256.txt"
  check 'S1 pass' "neither node's machine-configuration resource version changed" \
    same_file "$EV/pre-talos-config-version.txt" "$EV/post-talos-config-version.txt"
  local cp_after w_after w_ctl
  cp_after=$(mutations "$TALOS_CONTROLPLANE_IP") || die "cannot read the control plane's apid log"
  w_after=$(mutations "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
  # The positive control, after the post-state: a dry-run apply on the worker is a mutation
  # method; the same query must count it, or the log does not record methods and the check proves
  # nothing.
  node_talos "$TALOS_WORKER_IP" apply-config --dry-run \
    --file <(node_talos "$TALOS_WORKER_IP" get machineconfig v1alpha1 -o jsonpath='{.spec}') >/dev/null 2>&1 ||
    die "the dry-run apply control did not run"
  w_ctl=$(mutations "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
  if [ "$w_ctl" -gt "$w_after" ]; then
    check 'S1 pass' "no Talos mutation request in the control plane's apid log across the run (control: the dry-run apply is counted)" \
      same "$cp_mut" "$cp_after"
    check 'S1 pass' "no Talos mutation request in the worker's apid log across the run (control: the dry-run apply is counted)" \
      same "$w_mut" "$w_after"
  else
    result SKIP 'S1 pass' 'no Talos mutation in the apid logs: not shown, the dry-run apply control is not in the log either'
  fi
}

"$s1_mode"
rm -f -- "$EV/last.body" "$EV/last.headers"
# The final bundle: the evidence directory and the run directory scanned, as S0's step 5 does.
ev_log=$(mktemp)
if final=$("$bin/evidence" "$EV" 2>"$ev_log"); then
  cat -- "$ev_log" >&2
  if grep --quiet --fixed-strings -- 'positive control found; 0 other file(s) contain' "$ev_log"; then
    result PASS 'S1 step 5' 'bin/evidence scanned the bundle and the run directory; no file but its control holds a fixture secret, the marked value included'
  else
    result FAIL 'S1 step 5' "the leak scan reports fixture secrets: $final/leak-scan.txt"
  fi
  if [ -e "$final/unavailable.txt" ]; then
    result FAIL 'S1 step 5' "the bundle is incomplete: $final/unavailable.txt names what was not captured"
  else
    result PASS 'S1 step 5' 'the bundle is complete: bin/evidence captured every source'
  fi
  # The tokens this run minted and created, searched in the bundle and the run directory, with a
  # control holding the last of them that must be the one file listed (as s0 does).
  local_ctl=$STATE/s1-token-control
  trap 'rm -f -- "$local_ctl"' EXIT
  printf 'x %s x\n' "${secrets[-1]:-}" >"$local_ctl"
  hits=$(grep --recursive --files-with-matches --fixed-strings --file=<(printf '%s\n' "${secrets[@]}") -- \
    "$EV" "$final" "$local_ctl") || hits=
  rm -f -- "$local_ctl"
  trap - EXIT
  if [ "${#secrets[@]}" -gt 0 ] && [ "$hits" = "$local_ctl" ]; then
    result PASS 'S1 step 5' "none of the ${#secrets[@]} tokens this run minted or created is in the bundle or the run directory (control found)"
  else
    printf 's1: files holding a token of this run: %s\n' "${hits:-none, not even the control}" >&2
    result FAIL 'S1 step 5' "the tokens this run minted or created: ${#secrets[@]} searched, the listing is not the control alone"
  fi
else
  cat -- "$ev_log" >&2
  result FAIL 'S1 step 5' 'bin/evidence failed'
fi
rm -f -- "$ev_log"
say "s1 $s1_mode: $failed failed; evidence in $EV, bundle ${final:-none}"
[ "$failed" -eq 0 ]
