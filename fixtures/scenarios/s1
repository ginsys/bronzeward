#!/usr/bin/env bash
# Acceptance plan S1, adoption of the existing cluster, against the fixture. `run`: the
# preconditions, steps 1 to 5, the pass criteria, the refusal set, the Talos access refusals, and
# takeover, lease and interruption on instance C, and the orphan report over the interrupted
# claims, the operator review (review.sh). `review`: the preconditions, steps 1 to 3 and the
# operator review rows alone, with their orphan report and dump, for developing those rows.
# `pass`, the integrated run's: `run` without the Go rows and the negative controls (the refusal
# set through the orphan rows). `node-id`: the Talos access refusal for another node ID, on its own
# up. `register`: the preconditions and steps 1 and 2 alone, the cluster and its machines recorded
# and its first key supplied, for a participant's import (fixtures/participants).
# `first-keys`: after step 1's records, the three first keys of ginsys/bronzeward#898 supplied
# to the control plane's endpoint, the refusals, and the scan; on an up of its own.
# `onboard`: bronzewardctl cluster onboard against the fixture's Talos and server, with no OpenBao
# address, token or bao on its PATH (ginsys/bronzeward#900), with --no-import; on an up of its own. Each check
# writes PASS, FAIL or SKIP, its acceptance-plan reference and what it checked to s1.tsv in the
# evidence directory and to stdout; the directory is then scanned by bin/evidence. Exit 1 on any
# FAIL.
# Usage: scenarios/s1 run|pass|review|node-id|register|first-keys|onboard   (on a fresh fixtures/bin/up, with mise run
# dev-db and mise run dev-bao up for run's Go tests)
set -euo pipefail
here=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
bin=$here/../bin
# shellcheck source-path=SCRIPTDIR source=../lib.sh
. "$here/../lib.sh"

s1_mode=${1:-}
pass_only=''
case $s1_mode in run | review | node-id | register | first-keys | onboard) ;; pass) pass_only=1 ;; *) die "usage: scenarios/s1 run|pass|review|node-id|register|first-keys|onboard" ;; esac
need docker curl jq timeout id sleep git date sha256sum base64 head tr
need_state
# No fixture lock of its own: bw, seed, inject and evidence each take the one they need.
umask 077
image_id=$(cat -- "$STATE/up-image") || die "no server image is recorded in $STATE; run fixtures/bin/up"
image_own "$image_id" || die "the recorded server image is not this run's; run fixtures/bin/down, then up"
EV=$STATE/evidence/s1-$s1_mode-$(date -u +%Y%m%dT%H%M%SZ)
mkdir -p -- "$EV" "$EV/http"
scenario=s1
# shellcheck source-path=SCRIPTDIR source=common.sh
. "$here/common.sh"

# The worker's file secret bin/up planted, by the path its patch gave it (machine.files[0]).
WORKER_MARK='doc[0]/machine/files/0/content'
# The mutation matcher is common.sh's (MUTATIONS: the methods a read-only ingestion never sends).
mutation_ref='S1 pass'
run_key=$(date -u +%s%N)
# shellcheck source-path=SCRIPTDIR source=review.sh
. "$here/review.sh"

# Step 1's records. Globals: a command substitution would lose them.
cluster='' machine_cp='' machine_w=''
# record <reference> <what> <path> <body> <key name>: a 201 for h-author's POST, its id in
# $recorded.
recorded=''
record() {
  local ref=$1 what=$2 path=$3 body=$4
  recorded=
  check "$ref" "$what" answers 201 - POST "$path" "$author" "$body" "$(key "${path##*/}-$5")"
  recorded=$(jq -er '.id' "$EV/last.body" 2>/dev/null) || recorded=
  [ -n "$recorded" ] || die "s1: $what: no id in the response; nothing after it can run"
}

# has_references <machine id> [marked]: the machine's import base document holds !bwref
# references, one row each, and, with marked, the file content as one. The document is matched in
# the database, never printed.
has_references() {
  local m=$1 refs
  refs=$(sql "SELECT count(*) FROM import_base_reference r JOIN import_base_revision b ON b.id = r.revision WHERE b.machine = '$m'") || return 1
  [ "$refs" -ge 1 ] || {
    say "s1: $m: no reference rows"
    return 1
  }
  [ "$(sql "SELECT count(*) FROM import_base_revision WHERE machine = '$m' AND position('!bwref' IN document) > 0")" = 1 ] || {
    say "s1: $m: the import base document holds no !bwref"
    return 1
  }
  [ "${2:-}" != marked ] ||
    [ "$(sql "SELECT count(*) FROM import_base_revision WHERE machine = '$m' AND document ~ '\\ycontent: !bwref '")" = 1 ] || {
    say "s1: $m: the file content is not a reference"
    return 1
  }
}

# generations_listed: every generation a reference row names is listed under its claim's path by
# the metadata identity, at version 1 (create-only), and those paths list nothing else.
generations_listed() {
  local rows path dir value listing names want got
  rows=$(sql "SELECT generation FROM import_base_reference ORDER BY generation") || return 1
  [ -n "$rows" ] || return 1
  want=$(printf '%s\n' "$rows" | sort -u)
  got=
  for dir in $(printf '%s\n' "$rows" | sed 's|/[^/]*$||' | sort -u); do
    listing=$(BAO_TOKEN=$BW_BAO_METADATA_TOKEN bao kv list -format=json -mount=secret "$dir") || {
      say "s1: the metadata identity cannot list $dir"
      return 1
    }
    names=$(jq -er '.[]' <<<"$listing") || return 1
    for value in $names; do got+="$dir/$value"$'\n'; done
  done
  got=$(printf '%s' "$got" | sed '/^$/d' | sort -u)
  [ "$got" = "$want" ] || {
    say "s1: the generation paths listed are not the referenced ones"
    return 1
  }
  for path in $rows; do
    value=$(BAO_TOKEN=$BW_BAO_METADATA_TOKEN bao kv metadata get -format=json -mount=secret "$path" | jq -er '.data.current_version') || return 1
    [ "$value" = 1 ] || {
      say "s1: $path is at version $value, not a create-only generation"
      return 1
    }
  done
}

# baseline_is_pre_state <machine id> <node ip> <pre-state digest file>: the OpenBao administrator
# decrypts the machine's baseline ciphertext outside Bronzeward; its configuration digest
# (execution-recovery §1: trailing newlines made one) is the one recorded and the pre-state's.
# The plaintext stays in the pipe.
baseline_is_pre_state() {
  local row ct recorded_digest got pre
  row=$(sql "SELECT encode(baseline_ciphertext, 'escape') || ' ' || encode(configuration_digest, 'hex') FROM import_base_revision WHERE machine = '$1'") || return 1
  ct=${row%% *} recorded_digest=${row##* }
  got=$(printf '%s\n' "$(bao write -field=plaintext transit/decrypt/bw-baseline ciphertext="$ct" | base64 -d)" |
    sha256sum | cut -d' ' -f1) || return 1
  pre=$(digest_of "$3" "$2")
  [ "$got" = "$recorded_digest" ] && [ "$got" = "$pre" ] || {
    say "s1: $1: decrypted baseline $got, recorded $recorded_digest, pre-state $pre"
    return 1
  }
}

# executor_refused <machine id>: the executor identity's decryption of the baseline is refused.
executor_token=''
executor_refused() {
  local ct out rc=0
  ct=$(sql "SELECT encode(baseline_ciphertext, 'escape') FROM import_base_revision WHERE machine = '$1'") || return 1
  out=$(BAO_TOKEN=$executor_token bao write -field=plaintext transit/decrypt/bw-baseline ciphertext="$ct" 2>&1) || rc=$?
  if [ "$rc" -eq 0 ] || ! grep --quiet --ignore-case --fixed-strings 'permission denied' <<<"$out"; then
    say "s1: the executor's baseline decryption was not refused for permission (exit $rc)"
    return 1
  fi
}

# gen_claims: the claims the metadata identity lists under gen/<cluster>/, one per line, sorted;
# nothing when the path holds none yet (bao's JSON answer is then {} with exit 2).
gen_claims() {
  local out rc=0
  out=$(BAO_TOKEN=$BW_BAO_METADATA_TOKEN bao kv list -format=json -mount=secret "gen/$cluster" 2>&1) || rc=$?
  case $rc in
    0) jq -er '.[]' <<<"$out" | sed 's|/$||' | sort ;;
    2) [ "$out" = '{}' ] ;;
    *) return 1 ;;
  esac
}
# claims_added <listing before the imports>: there was none; now there are exactly the imports'.
claims_added() {
  [ -z "$1" ] && [ "$(gen_claims)" = "$(printf '%s\n' "${ingested[@]}" | sort)" ]
}

# refused_input <name>: a refused input. Each holds the canary, a scan pattern, so a problem or a
# log that quoted it would fail the scan.
refused_input() {
  case $1 in
    parse) printf 'machine:\n  token: %s\n  certSANs: [\n' "$BW_CANARY" ;;
    guard) printf 'machine:\n  token: %s\n---\napiVersion: v1alpha1\nkind: KubeNodeConfig\nlabels:\n  copy: %s\n' "$BW_CANARY" "$BW_CANARY" ;;
  esac
}
# import_refused <name> <body> <operation filter> <cause or -> [fault]: POST /ingestions under
# the draft's current ETag with that body, which its run refuses: 202; the claim ends abandoned
# with no payload; the operation satisfies the filter, its terminal event names the cause (unless
# -), and its problem holds no scan pattern; nothing read is kept (no new import base revision);
# the draft's ETag and the claims under gen/<cluster>/ are unchanged. With a fault, it is put in
# place after the first listing and taken away before the second: OpenBao answers both. A fault
# that cannot be taken away leaves every later check meaningless.
import_refused() {
  local name=$1 fault_name=${5:-} before rc=0
  if ! before=$(gen_claims); then
    say "s1: refusal $name: the metadata identity cannot list gen/$cluster"
    return 1
  fi
  if [ -n "$fault_name" ] && ! fault "$fault_name" on; then
    say "s1: refusal $name: the fault was not put in place"
    fault "$fault_name" off || die "s1: refusal $name: the fault could not be taken away"
    return 1
  fi
  refusal_observed "$@" || rc=$?
  [ -z "$fault_name" ] || fault "$fault_name" off || die "s1: refusal $name: the fault could not be taken away"
  [ "$rc" -eq 0 ] || return "$rc"
  [ "$(gen_claims)" = "$before" ] || {
    say "s1: refusal $name: the claims under gen/$cluster/ changed"
    return 1
  }
}
# refusal_observed <name> <body> <operation filter> <cause or ->: import_refused's checks that
# read only the API and the database.
refusal_observed() {
  local name=$1 body=$2 filter=$3 cause=$4 revisions ing op state n
  revisions=$(sql 'SELECT count(*) FROM import_base_revision') || return 1
  answers 202 - POST /api/v1/ingestions "$author" "$body" "$(key "refusal-$name")" "$etag" || return 1
  if ! ing=$(jq -er '.ingestion' "$EV/last.body") || ! op=$(jq -er '.operation' "$EV/last.body"); then
    say "s1: refusal $name: no ingestion or operation in the 202"
    return 1
  fi
  state=
  for ((n = 0; n < 60; n++)); do
    answers 200 - GET "/api/v1/ingestions/$ing" "$author" || return 1
    state=$(jq -er '.state' "$EV/last.body") || state=
    case $state in released | abandoned) break ;; esac
    sleep 1
  done
  [ "$state" = abandoned ] || {
    say "s1: refusal $name: claim $state, want abandoned"
    return 1
  }
  [ "$(sql "SELECT count(*) FROM staging_claim WHERE id = '$ing' AND state = 'abandoned' AND payload IS NULL")" = 1 ] || {
    say "s1: refusal $name: the claim row is not abandoned without a payload"
    return 1
  }
  answers_with "$filter" 200 - GET "/api/v1/operations/$op" "$author" || return 1
  # 1 is the only clean answer: 0 found a secret, and 2 read no pattern file or no body.
  local leak=0
  grep --quiet --fixed-strings --file="$STATE/scan-patterns.txt" -- "$EV/last.body" || leak=$?
  case $leak in
    1) ;;
    0) say "s1: refusal $name: the operation's problem holds a fixture secret"; return 1 ;;
    *) say "s1: refusal $name: the operation's problem could not be scanned (grep exit $leak)"; return 1 ;;
  esac
  [ "$cause" = - ] ||
    [ "$(sql "SELECT entry->>'cause' FROM operation_event WHERE operation = '$op' AND entry->>'type' = 'failed'")" = "$cause" ] || {
    say "s1: refusal $name: the terminal event does not name the cause $cause"
    return 1
  }
  [ "$(sql 'SELECT count(*) FROM import_base_revision')" = "$revisions" ] || {
    say "s1: refusal $name: an import base revision was kept"
    return 1
  }
  answers 200 - GET "/api/v1/drafts/$draft" "$author" || return 1
  [ "$(etag_of_last)" = "$etag" ] || {
    say "s1: refusal $name: the draft's ETag moved"
    return 1
  }
}
# machine_body <machine id>: a source machine import of it, transient, nothing marked.
machine_body() {
  jq -nc --arg m "$1" --arg d "$draft" '{kind: "import", source: "machine", staging: "transient", machine: $m, draft: $d, marks: []}'
}
# refused <name> <machine id> <marks JSON array> <rule> <paths JSON or -> [document]: an import,
# source machine, or source document with refused_input <name>, that compilation refuses (C §13):
# import_refused, the operation failed 422 validation-failed naming the rule (and the paths).
refused() {
  local name=$1 m=$2 marks=$3 rule=$4 paths=$5 doc='' source=machine body filter
  if [ "${6:-}" = document ]; then
    doc=$(refused_input "$name") source=document
  fi
  # The document over stdin: on jq's command line it would be readable by any local user.
  body=$(printf '%s' "$doc" | jq -Rsc --arg m "$m" --arg d "$draft" --arg s "$source" --argjson marks "$marks" \
    '. as $doc | {kind: "import", source: $s, staging: "transient", machine: $m, draft: $d, marks: $marks}
     + if $doc == "" then {} else {document: $doc} end')
  filter=".state == \"failed\" and .error.status == 422 and .error.type == \"urn:bronzeward:problem:validation-failed\" and .error.rule == \"$rule\""
  [ "$paths" = - ] || filter+=" and .error.paths == $paths"
  import_refused "$name" "$body" "$filter" -
}

# The cluster's Talos cluster ID as its nodes report it, and one no node has.
talos_cid='' wrong_cid=''
# cluster_id_set <Talos cluster ID>: the cluster's recorded Talos cluster ID rewritten. The schema
# refuses that UPDATE (trigger identity on cluster), and no registration reaches the state either:
# node IDs are unique and compared before the cluster ID, so a second cluster cannot record the
# worker. The fault therefore lifts the trigger for its one statement, in one transaction, as a
# record written wrong by hand or restored from elsewhere would be.
cluster_id_set() {
  sql "ALTER TABLE cluster DISABLE TRIGGER identity;
    UPDATE cluster SET talos_cluster_id = '$1' WHERE id = '$cluster';
    ALTER TABLE cluster ENABLE TRIGGER identity" >/dev/null
}
# fault <name> on|off: the fault an access case puts in place, then takes away. A machine import
# signs from the CA key version the cluster's latest first-key act names: absent deletes that key's
# metadata, and changed then writes other bytes at the same path, so the version number is again 1
# with another created_time. The value written holds the canary, so a problem or a log that quoted
# it fails the scan; it goes over stdin. Taking either away supplies the first key again, a new act
# that names the restored version.
fault() {
  local ca=access/talos-ca/$cluster
  case $1-$2 in
    absent-on) bao kv metadata delete -mount=secret "$ca" >/dev/null ;;
    changed-on)
      bao kv metadata delete -mount=secret "$ca" >/dev/null &&
        printf '{"ca":"%s","key":"%s"}' "$BW_CANARY" "$BW_CANARY" | bao_stdin kv put -mount=secret "$ca" - >/dev/null
      ;;
    absent-off | changed-off)
      bao kv metadata delete -mount=secret "$ca" >/dev/null 2>&1 || true
      fk_post talosconfig "$TALOSCONFIG" "$first_keys_endpoint" "restore-$RANDOM$RANDOM" 200 -
      ;;
    silent-on) "$bin/inject" linksplit A worker >/dev/null ;;
    silent-off) "$bin/inject" linkjoin A worker >/dev/null ;;
    cluster-id-on | cluster-id-off) cluster_id_set "$([ "$2" = on ] && printf '%s' "$wrong_cid" || printf '%s' "$talos_cid")" ;;
    node-id-on | node-id-off) ;;
    *) return 1 ;;
  esac
}
# access_case <name> <machine id> <status> <problem code> <cause>: under the fault <name>, a
# source machine import of the machine refused by its node read (PA §3.3) with that status, code
# and cause (import_refused).
access_case() {
  import_refused "access-$1" "$(machine_body "$2")" \
    ".state == \"failed\" and .error.status == $3 and .error.type == \"urn:bronzeward:problem:$4\"" "$5" "$1"
}
# sealed_refused: with OpenBao sealed, POST /ingestions is refused at the request, since its keyed
# fingerprint is OpenBao's to compute: 503 dependency-unavailable and no claim committed; once
# unsealed, the draft's ETag and the claims under gen/<cluster>/ are unchanged. The run's own
# provider-unavailable cause is the Go test's (TestMachineAccessUnavailable): no fixture fault
# seals OpenBao between the request and the run's read.
sealed_refused() {
  local before claims rc=0
  before=$(gen_claims) || return 1
  claims=$(sql 'SELECT count(*) FROM staging_claim') || return 1
  if ! "$bin/inject" seal openbao >/dev/null; then
    "$bin/inject" unseal openbao >/dev/null || die "s1: OpenBao could not be unsealed"
    say "s1: OpenBao could not be sealed"
    return 1
  fi
  answers 503 dependency-unavailable POST /api/v1/ingestions "$author" "$(machine_body "$machine_w")" \
    "$(key refusal-sealed)" "$etag" || rc=1
  "$bin/inject" unseal openbao >/dev/null || die "s1: OpenBao could not be unsealed"
  [ "$rc" -eq 0 ] || return 1
  [ "$(sql 'SELECT count(*) FROM staging_claim')" = "$claims" ] || {
    say "s1: a claim was committed while OpenBao was sealed"
    return 1
  }
  answers 200 - GET "/api/v1/drafts/$draft" "$author" || return 1
  [ "$(etag_of_last)" = "$etag" ] && [ "$(gen_claims)" = "$before" ] || {
    say "s1: the draft's ETag or the claims under gen/$cluster/ changed while OpenBao was sealed"
    return 1
  }
}
# ca_read_refused <cluster id>: the executor identity's read of the cluster's stored CA key is refused,
# and the administrator's read of it (the control) answers.
ca_read_refused() {
  bao kv get -format=json -mount=secret "access/talos-ca/$1" >/dev/null 2>&1 || return 1
  ! BAO_TOKEN=$executor_token bao kv get -format=json -mount=secret "access/talos-ca/$1" >/dev/null 2>&1
}

# same_file <a> <b>: two capture files are byte-identical and name both nodes.
same_file() { cmp --quiet -- "$1" "$2" && [ "$(grep --count --extended-regexp '^[0-9a-f]+ ' "$1")" = 2 ]; }

# The rows no request reaches (a heartbeat is internal to an instance, a crash inside T1 needs a
# seam inside the process; ruling 1), proven by the Go tests that already prove them, and every
# test the acceptance plan's §7.1 names for ginsys/bronzeward#22 (its *check* items), so that
# S1's evidence holds their results. Anchored: TestHeartbeat alone, not TestHeartbeatLossStopsRunner.
go_tests='TestOwnerFenceMatrix|TestHeartbeat|TestHeartbeatExtendsFromTheLockTime|TestCrashInsideT1LeavesDraft'
go_tests+='|TestTakeOver|TestTakeOverRefusals|TestTakeOverRechecksEligibility|TestTakeOverConcurrentTakers'
go_tests+='|TestTakeoverResumesToT1|TestTakeoverRefusals|TestTakeoverNothingToDecrypt|TestTakeoverDecryptFailureLeavesResumed'
go_tests+='|TestTakeoverDigestMismatchAbandons|TestTakeoverRacesT1|TestTakeoverConcurrentTakers|TestTakeoverNoEcho'
go_tests+='|TestMachineIdentityMismatch|TestMachineIngestionIdentityControls|TestMachineAccessUnavailable|TestMachineIngestion'
go_tests+='|TestMachineAccessEventFencedByTheClaim|TestMachineAccessErrorTextControl|TestLiveRoleProbe'
go_tests+='|TestSMBIOSUUIDIsOneMachine|TestSMBIOSUUIDControl|TestIdentityKeyConcurrent|TestInventoryIdentityKeys|TestInventoryRefusals'
# go_rows_ran: those tests, in the clone, against go-db's PostgreSQL and OpenBao (mise run dev-db
# and dev-bao by default), as go-db runs them: a missing service fails, it does not skip; the live
# role probe against the fixture's control plane with bin/up's talosconfig. The DSN, token and path reach
# the tests through the environment, never the command line, so none is in a retained file.
# Passes when go test exited 0 with no test skipped.
go_rows_ran() {
  (
    export BW_TEST_PG_DSN="${BW_TEST_PG_DSN:-postgres://bronzeward@127.0.0.1:11432/bronzeward?sslmode=disable}"
    export BW_TEST_BAO_ADDR="${BW_TEST_BAO_ADDR:-http://127.0.0.1:11200}"
    export BW_TEST_BAO_TOKEN="${BW_TEST_BAO_TOKEN:-bw-dev-root-token}"
    # The control plane: Talos generates client configurations, which the role probe needs, only there.
    export BW_TEST_TALOSCONFIG=$TALOSCONFIG BW_TEST_TALOS_ENDPOINT=$TALOS_CONTROLPLANE_IP
    logged go-rows env BW_REQUIRE_PG=1 BW_REQUIRE_BAO=1 mise exec -- go test -count=1 -v -run "^($go_tests)\$" \
      ./internal/staging ./internal/api ./internal/talos
  ) && ! grep --quiet -- '--- SKIP' "$EV/go-rows.log"
}
# go_row <test>: the test's own top-level PASS line is in go-rows.log.
go_row() { grep --quiet -- "^--- PASS: $1 (" "$EV/go-rows.log"; }

# The takeover rows (C §3.4) on instance C, the interruption build: its run stops where C's
# control file says (internal/seam), and B and A take the claim over.
# The import C runs: its claim (tk_ing, common.sh) and operation.
tk_op=''
# c_import <key name> transient|encrypted: an import of the worker, its file content marked, POSTed
# to C under the draft's current ETag: 202, its claim and operation in tk_ing and tk_op.
c_import() {
  local body rc=0
  tk_ing='' tk_op=''
  body=$(jq -nc --arg m "$machine_w" --arg d "$draft" --arg p "$WORKER_MARK" --arg s "$2" \
    '{kind: "import", source: "machine", staging: $s, machine: $m, draft: $d, marks: [$p]}')
  call_port=$SERVER_C_PORT
  answers 202 - POST /api/v1/ingestions "$author" "$body" "$(key "ingestion-$1")" "$etag" || rc=1
  call_port=$SERVER_A_PORT
  # C writes its 202 before it starts the run, but the answer is sent only once the handler returns,
  # so a kill at the claim point can end C between its COMMIT and the send. The same request to A
  # then gets the committed answer, replayed under its Idempotency-Key, never a second import.
  if [ "$rc" -ne 0 ] && [ "$last_status" = 000 ]; then
    rc=0
    answers 202 - POST /api/v1/ingestions "$author" "$body" "$(key "ingestion-$1")" "$etag" || rc=1
    [ "$rc" -ne 0 ] || grep --quiet --ignore-case '^Idempotent-Replayed: true' "$EV/last.headers" || {
      say "s1: the import $1 C did not answer was not a replay on A"
      rc=1
    }
  fi
  [ "$rc" -eq 0 ] || return 1
  tk_ing=$(jq -er '.ingestion' "$EV/last.body") && tk_op=$(jq -er '.operation' "$EV/last.body")
}
# takeover <A|B> <status> <problem code or -> <key name>: an author's takeover of tk_ing on that
# instance gets that status (and problem).
takeover() {
  local rc=0
  [ "$1" = A ] || call_port=$SERVER_B_PORT
  answers "$2" "$3" POST "/api/v1/ingestions/$tk_ing/takeovers" "$author" '{}' "$(key "takeover-$4")" || rc=1
  call_port=$SERVER_A_PORT
  return "$rc"
}
# events_are <list>: tk_op's event types in order, space-separated.
events_are() {
  [ "$(sql "SELECT string_agg(entry->>'type', ' ' ORDER BY number) FROM operation_event WHERE operation = '$tk_op'")" = "$1" ]
}
# refused_live <A|B> <key name>: with the lease read as live just before, that instance's takeover
# answers 409 for the live lease, not for one of the other conflicts a takeover can meet.
refused_live() {
  local rc=0
  ! lapsed || { say "s1: the lease had already lapsed before $1's takeover"; return 1; }
  [ "$1" = A ] || call_port=$SERVER_B_PORT
  answers_with '.detail == "the claim'"'"'s lease has not lapsed"' 409 conflict \
    POST "/api/v1/ingestions/$tk_ing/takeovers" "$author" '{}' "$(key "takeover-$2")" || rc=1
  call_port=$SERVER_A_PORT
  return "$rc"
}
# past <epoch seconds>: the database's clock is past it.
past() { [ "$(sql "SELECT clock_timestamp() > to_timestamp($1)")" = t ]; }
# lease_epoch: tk_ing's lease end, in epoch seconds.
lease_epoch() { sql "SELECT extract(epoch FROM lease_until) FROM staging_claim WHERE id = '$tk_ing'"; }
# The operation's events up to the staged one, on an import of a machine: its start, the Talos
# access version read, the envelope stored.
staged_events='started talos-access staged'
# stalled_staged: C's run stopped after storing the envelope, its claim held at generation 1.
stalled_staged() { c_says '^fixture interrupt: stall at staged$' && claim_is held 1 payload && events_are "$staged_events"; }
# live_at_first: the claim live, still held at generation 1 with its envelope.
live_at_first() { ! lapsed && claim_is held 1 payload; }
# resumed_under_b: B's resume failed: its taken-over and resume-failed events, the claim resumed at
# generation 2 with its envelope kept.
resumed_under_b() { events_are "$staged_events taken-over resume-failed" && claim_is resumed 2 payload; }
# committed_by_a: A's resume committed: its taken-over and succeeded events, the claim released at
# generation 3 without a payload.
committed_by_a() { events_are "$staged_events taken-over resume-failed taken-over succeeded" && claim_is released 3 none; }
# op_is <state> [problem code]: tk_op's state (and its problem's type), read as an author.
op_is() {
  local filter=".state == \"$1\""
  [ -z "${2:-}" ] || filter+=" and .error.type == \"urn:bronzeward:problem:$2\""
  answers_with "$filter" 200 - GET "/api/v1/operations/$tk_op" "$author"
}
# failed_cause_is <cause>: tk_op's failed event names that cause.
failed_cause_is() {
  [ "$(sql "SELECT entry->>'cause' FROM operation_event WHERE operation = '$tk_op' AND entry->>'type' = 'failed'")" = "$1" ]
}
# revisions_are <n>: how many import base revisions exist.
revisions_are() { [ "$(sql 'SELECT count(*) FROM import_base_revision')" = "$1" ]; }
# nothing_after_a <revisions>: since A's commit, nothing written: the claim, the events, the import
# base revisions and the draft's ETag all as A left them.
nothing_after_a() { committed_by_a && revisions_are "$1" && draft_etag_is "$etag"; }

# The kill points: compilation §2.3's steps 0 to 8, as internal/seam names them.
kill_points='claim read parse identify substitute guard generation construct baseline'
# pre_events <step>: the operation's events when C exits at the step: its start, and from the read
# on the Talos access version read.
pre_events() { if [ "$1" = claim ]; then printf started; else printf 'started talos-access'; fi; }
# killed_at <step> <kills before>: C exited at the step, the claim held at generation 1 without an
# envelope, the operation's events those before the step.
killed_at() { c_killed_at "$1" "$(($2 + 1))" && claim_is held 1 none && events_are "$(pre_events "$1")"; }
# op_failed_abandoned: tk_op failed ingestion-abandoned, read in the database: a poll, so no
# transcript per try.
op_failed_abandoned() {
  [ "$(sql "SELECT state || ' ' || (error->>'type') FROM operation WHERE id = '$tk_op'")" = 'failed urn:bronzeward:problem:ingestion-abandoned' ]
}
# swept <step>: the sweep wrote the transient claim abandoned at generation 1 without a payload,
# and failed its operation ingestion-abandoned with one terminal event.
swept() { claim_is abandoned 1 none && events_are "$(pre_events "$1") failed" && op_is failed ingestion-abandoned; }
# abandoned_nothing <step>: the takeover abandoned the claim at generation 2 without a payload and
# failed the operation ingestion-abandoned with the cause nothing-to-decrypt, no taken-over event.
abandoned_nothing() {
  claim_is abandoned 2 none && events_are "$(pre_events "$1") failed" && op_is failed ingestion-abandoned &&
    failed_cause_is nothing-to-decrypt
}
# How many generations an import of the worker with its file content marked makes: its last
# committed revision's reference rows.
gen_count=''
# generations_made <step>: how many generations an import killed at the step created: none before
# step 6, all of the import's once it is done (the generation seam follows the last create).
generations_made() {
  case $1 in
    generation | construct | baseline) printf '%s\n' "$gen_count" ;;
    *) printf '0\n' ;;
  esac
}
# generations_kept <step>: every generation created before the kill is still listed under the
# claim, none deleted.
generations_kept() {
  local want got
  want=$(generations_made "$1")
  got=$(claim_generations) || return 1
  [ "$got" = "$want" ] || {
    say "s1: killed at $1: $got generation(s) listed under the claim, want $want"
    return 1
  }
}

# takeover_rows: C stalls an encrypted import after staging it; its heartbeat keeps the lease, so
# B's takeover is refused; C frozen, the lease lapses, and with OpenBao partitioned B's takeover is
# accepted but its decryption fails, the claim resumed under B; A's takeover is refused while B's
# lease is live, then, OpenBao joined again and B's lease lapsed, accepted, and A's draft
# transaction commits.
# C, released and thawed, writes nothing.
takeover_rows() {
  local lease0 revisions
  fresh_author
  check 'S1 takeover, C §3.4' 'C told to stall its next run after the staged event' interrupt staged stall
  check 'S1 takeover, C §3.4' 'encrypted import of the worker on C: 202' c_import takeover encrypted
  [ -n "$tk_op" ] ||
    die "s1: the encrypted import on C was not accepted; nothing after it can run"
  check 'S1 takeover, C §3.4' "C's run stalls after the staged event: the claim held at generation 1 with its envelope" \
    within 60 stalled_staged
  lease0=$(lease_epoch) || die "s1: cannot read the claim's lease"
  check 'S1 lease extension, C §3.3' "the claim's first lease end passes while C's run stalls" within 30 past "$lease0"
  check 'S1 lease extension, C §3.3' "C's heartbeat extended the lease: the claim still live, held at generation 1" live_at_first
  check 'S1 takeover, C §3.4' "B's takeover while C's lease is live (read first): 409 conflict, the lease not lapsed" refused_live B live
  # C's heartbeat keeps its lease live through the capture, its staged envelope in the bundle.
  outcome_bundle 'S1 takeover, C §3.4' takeover-refused-b
  check 'S1 takeover, C §3.4' 'inject pause C (its heartbeat frozen with its run)' "$bin/inject" pause C
  check 'S1 takeover, C §3.4' "C's lease lapses" within 40 lapsed
  if ! "$bin/inject" netsplit openbao >/dev/null; then
    "$bin/inject" netjoin openbao >/dev/null || die "s1: OpenBao could not be put back on its network"
    die "s1: OpenBao could not be partitioned"
  fi
  check 'S1 takeover, C §3.4' "B's takeover with OpenBao partitioned: 202 (a takeover reads no key)" takeover B 202 - partitioned
  # B's decryption fails at once when B dials afresh, or at the provider's 30-second request bound
  # on a connection it already held; B's heartbeat keeps its lease meanwhile.
  check 'S1 takeover, C §3.4' "B's decryption fails: resume-failed event, the claim resumed under B at generation 2, its envelope kept" \
    within 45 resumed_under_b
  check 'S1 takeover, C §3.4' "A's takeover while B's lease is live (read first): 409 conflict, the lease not lapsed" refused_live A b-live
  "$bin/inject" netjoin openbao >/dev/null || die "s1: OpenBao could not be put back on its network"
  # One bundle for B's failed decryption and A's refusal: A's takeover must land inside B's
  # 15-second lease, which a capture between them would outlast.
  outcome_bundle 'S1 takeover, C §3.4' takeover-resume-failed-refused-a
  check 'S1 takeover, C §3.4' "B's lease lapses (its run stopped)" within 40 lapsed
  revisions=$(sql 'SELECT count(*) FROM import_base_revision') || die "s1: cannot count import base revisions"
  check 'S1 takeover, C §3.4' "A's takeover once B's lease lapsed: 202" takeover A 202 - after-b
  check 'S1 takeover, C §3.4' "A resumes and commits: taken-over and succeeded events, the claim released at generation 3" \
    within 60 committed_by_a
  check 'S1 takeover, C §3.4' "A's draft transaction: the operation succeeded" op_is succeeded
  check 'S1 takeover, C §3.4' "A's draft transaction: one new import base revision" revisions_are "$((revisions + 1))"
  answers 200 - GET "/api/v1/drafts/$draft" "$author" || die "s1: cannot read the draft"
  check 'S1 takeover, C §3.4' "A's draft transaction moved the draft's ETag" differ "$(etag_of_last)" "$etag"
  etag=$(etag_of_last)
  check 'S1 takeover, C §3.4' "C's stall released" interrupt -
  check 'S1 takeover, C §3.4' 'inject unpause C' "$bin/inject" unpause C
  check 'S1 takeover, C §3.4' "C, the old owner, is fenced: its log has its heartbeat or its draft transaction refused" \
    within 30 c_says "ingestion $tk_ing: (heartbeat refused|the draft transaction: )"
  check 'S1 takeover, C §3.4' "C wrote nothing: the claim, the events, the import base revisions and the draft's ETag as A left them" \
    nothing_after_a "$((revisions + 1))"
}

# interrupt_case <step> transient|encrypted: C exits at once at the step, before any envelope is
# stored. Transient: once the lease lapses the sweep abandons the claim (C §3.5). Encrypted: the
# claim outlives its lease until its expiry, and A's takeover abandons it with nothing to decrypt
# (C §3.4). Either way the operation fails ingestion-abandoned, every generation created before the
# kill is still listed, and the draft is unchanged. The bundle is captured while C is still stopped,
# so its writable layer is what the kill left, before a startup could clean it; C is started again
# after.
interrupt_case() {
  local step=$1 staging_mode=$2 kills row_ref='S1 interruption, C §3.5'
  [ "$staging_mode" = transient ] || row_ref='S1 interruption, C §3.4'
  fresh_author
  kills=$(kills_at "$step")
  check "$row_ref" "C told to exit at once at $step" interrupt "$step" kill
  check "$row_ref" "$staging_mode import of the worker on C: 202" c_import "kill-$step-$staging_mode" "$staging_mode"
  [ -n "$tk_op" ] || die "s1: the $staging_mode import on C was not accepted; nothing after it can run"
  check "$row_ref" "C exits at $step ($staging_mode): the claim held at generation 1 without an envelope, only the events before $step" \
    within 60 killed_at "$step" "$kills"
  check "$row_ref" "C's control file removed" interrupt -
  if [ "$staging_mode" = transient ]; then
    check "$row_ref" "killed at $step, transient: the sweep abandons the claim once its lease lapses, not before" \
      swept_after_lapse 45
    check "$row_ref" "killed at $step, transient: the sweep fails the operation ingestion-abandoned" \
      within 45 op_failed_abandoned
    check "$row_ref" "killed at $step, transient: the claim abandoned at generation 1 without a payload, one failed event" swept "$step"
  else
    check "$row_ref" "killed at $step, encrypted: the lease lapses" within 40 lapsed
    check "$row_ref" "killed at $step, encrypted: A's takeover: 202 at the operation" takeover A 202 - "kill-$step"
    check "$row_ref" "killed at $step, encrypted: the claim abandoned at generation 2 without a payload, the operation failed ingestion-abandoned, cause nothing-to-decrypt" \
      abandoned_nothing "$step"
  fi
  check "$row_ref" "killed at $step ($staging_mode): every generation created before the kill still listed under the claim, none deleted" \
    generations_kept "$step"
  interrupted+=("$tk_ing $(generations_made "$step")")
  check "$row_ref" "killed at $step ($staging_mode): the draft's ETag unchanged" draft_etag_is "$etag"
  outcome_bundle "$row_ref" "interrupt-$step-$staging_mode"
  check "$row_ref" 'inject start C' "$bin/inject" start C
}
# interruption_matrix: every kill point in both staging modes, one bundle per point and mode.
interruption_matrix() {
  local step
  gen_count=$(sql "SELECT count(*) FROM import_base_reference WHERE revision =
    (SELECT id FROM import_base_revision WHERE machine = '$machine_w' ORDER BY created_at DESC LIMIT 1)") ||
    die "s1: cannot count the worker's references"
  check 'S1 interruption' "control: an import of the worker makes $gen_count generations, so a kill after step 6 has some to keep" \
    differ "$gen_count" 0
  for step in $kill_points; do
    interrupt_case "$step" transient
    interrupt_case "$step" encrypted
  done
}

# The interrupted claims, each "<claim> <generations it made>", for the orphan report.
interrupted=()
# orphans_listed: the report lists each interrupted claim's generations as orphans of that claim
# recorded abandoned, as many as the import made.
orphans_listed() {
  local entry claim want got tab=$'\t'
  for entry in "${interrupted[@]}"; do
    read -r claim want <<<"$entry"
    got=$(grep --count --extended-regexp -- \
      "^orphan${tab}gen/$cluster/$claim/[^${tab}]+${tab}claim=$claim${tab}state=abandoned${tab}" "$EV/orphan-report.txt") || got=0
    [ "$got" = "$want" ] || {
      say "s1: the orphan report lists $got generation(s) of $claim, want $want"
      return 1
    }
  done
}
# orphans_kept: after the report, the metadata identity still lists every interrupted claim's
# generations: the report deleted none.
orphans_kept() {
  local entry claim want got
  for entry in "${interrupted[@]}"; do
    read -r claim want <<<"$entry"
    got=$(claim_generations "$claim") || return 1
    [ "$got" = "$want" ] || {
      say "s1: after the orphan report, $got generation(s) listed under $claim, want $want"
      return 1
    }
  done
}
# orphan_report: bw orphans on the cluster, under the orphan-report identity (persistence-api §6.4),
# its output kept in the evidence.
orphan_report() { "$bin/bw" orphans -cluster "$cluster" >"$EV/orphan-report.txt"; }
# orphan_rows: the acceptance plan's S1 interruption rows for the orphan report, after every kill.
orphan_rows() {
  local entry total=0 want
  for entry in "${interrupted[@]}"; do
    want=${entry#* }
    total=$((total + want))
  done
  check 'S1 interruption, orphans' "control: the interruptions left $total generation(s) of abandoned claims to report" \
    differ "$total" 0
  check 'S1 interruption, orphans' 'bw orphans on the cluster, under the orphan-report identity, exits 0 (orphan-report.txt)' \
    orphan_report
  check 'S1 interruption, orphans' "each of the ${#interrupted[@]} interrupted claims' generations listed as orphans of that abandoned claim" \
    orphans_listed
  check 'S1 interruption, orphans' "every interrupted claim's generations still listed after the report, none deleted" orphans_kept
}
# The database dump taken after every success, refusal and interruption, for the final bundle to
# expand and scan (PA §16: no request body in the backups). bin/evidence scans only the backups
# that exist, and nothing else in S1 takes one.
backup_name=s1-$run_key

# preconditions: S0's migrate and seed, the three instances up. After s0 run on the same up, as in
# the integrated run, bin/seed has run already and is not run again (it refuses a second run).
preconditions() {
  check 'S1 precondition' 'bw migrate' "$bin/bw" migrate
  check 'S1 precondition' 'inject start A' "$bin/inject" start A
  check 'S1 precondition' 'inject start B' "$bin/inject" start B
  interrupt - || die "cannot remove C's control file"
  check 'S1 precondition' 'inject start C (the interruption build, no interruption named)' "$bin/inject" start C
  check 'S1 precondition' 'A answers /livez' answers 204 - GET /livez ''
  [ -s "$STATE/automation-token" ] || "$bin/seed" >/dev/null || die "bin/seed failed"
  redact_automation_token "$(cat -- "$STATE/automation-token")"
}

# cluster_draft: steps 1 to 3: the cluster by its Talos cluster ID, each machine by its node ID
# and endpoint, the first key, and the import draft with its ETag.
cluster_draft() {
  cluster_register
  first_key_step

  # Step 3: the import draft.
  check 'S1 step 3' 'POST /drafts as h-author: 201 with an ETag' \
    answers 201 - POST /api/v1/drafts "$author" "$(jq -nc --arg c "$cluster" '{cluster: $c, title: "S1 import"}')" "$(key draft)"
  draft=$(jq -er '.id' "$EV/last.body" 2>/dev/null) || die "s1: the draft has no id; nothing after it can run"
  etag=$(etag_of_last)
  [ -n "$etag" ] || die "s1: the draft has no ETag; nothing after it can run"
}

# cluster_register: step 1: the cluster and its machines.
cluster_register() {
  local cid cid_w nid_cp nid_w
  # Step 1: the cluster by its Talos cluster ID, each machine by its node ID and endpoint.
  cid=$(node_talos "$TALOS_CONTROLPLANE_IP" get info -o json | jq -er '.spec.clusterId') ||
    die "cannot read the control plane's cluster ID"
  cid_w=$(node_talos "$TALOS_WORKER_IP" get info -o json | jq -er '.spec.clusterId') ||
    die "cannot read the worker's cluster ID"
  nid_cp=$(node_talos "$TALOS_CONTROLPLANE_IP" get identity -o json | jq -er '.spec.nodeId') ||
    die "cannot read the control plane's node ID"
  nid_w=$(node_talos "$TALOS_WORKER_IP" get identity -o json | jq -er '.spec.nodeId') ||
    die "cannot read the worker's node ID"
  # The server records the standard spelling; a node of Talos before v1.14 prints the URL-safe one.
  talos_cid=$(printf '%s' "$cid" | tr -- '-_' '+/') || die "cannot spell the cluster ID"
  wrong_cid=$(head -c 32 /dev/urandom | base64 -w 0) || die "cannot make a cluster ID"
  check 'S1 step 1' 'both nodes report one cluster ID' same "$cid" "$cid_w"
  check 'S1 step 1' 'the nodes report two node IDs' differ "$nid_cp" "$nid_w"
  record 'S1 step 1' 'POST /clusters as h-author with the Talos cluster ID: 201' /api/v1/clusters \
    "$(jq -nc --arg c "$cid" --arg e "https://$TALOS_CONTROLPLANE_IP:6443" --arg v "${TALOS_VERSION%.*}" \
      '{name: "bw-fixture", endpoint: $e, contract: $v, talosClusterId: $c}')" cluster
  cluster=$recorded
  record 'S1 step 1' 'POST /machines (control plane) by Talos node ID and endpoint: 201' /api/v1/machines \
    "$(jq -nc --arg c "$cluster" --arg n "$nid_cp" --arg e "$TALOS_CONTROLPLANE_IP:50000" \
      '{cluster: $c, talosNodeId: $n, platform: "container", talosEndpoint: $e}')" controlplane
  machine_cp=$recorded
  record 'S1 step 1' 'POST /machines (worker) by Talos node ID and endpoint: 201' /api/v1/machines \
    "$(jq -nc --arg c "$cluster" --arg n "$nid_w" --arg e "$TALOS_WORKER_IP:50000" \
      '{cluster: $c, talosNodeId: $n, platform: "container", talosEndpoint: $e}')" worker
  machine_w=$recorded

  fresh_author
}

# first_key_step: step 2 (ginsys/bronzeward#899): a machine import signs its own certificate from the
# CA key its cluster's latest first-key act names, so the os:admin talosconfig's CA key is supplied
# through the first-keys route, tried at the control plane.
first_key_step() {
  first_keys_endpoint=$TALOS_CONTROLPLANE_IP:50000
  check 'S1 step 2' 'POST /clusters/<cluster>/first-keys with the os:admin talosconfig: 200, version 1, one act' \
    fk_supply talosconfig "$TALOSCONFIG" step2 false 1
}

# register: the preconditions and steps 1 and 2 alone, the state from which a participant imports
# the worker (usability task T3, fixtures/participants).
register() {
  preconditions
  fresh_author
  cluster_register
  first_key_step
}

# review: the operator review rows alone (review.sh), on the records steps 1 to 3 make.
review() {
  preconditions
  fresh_author
  cluster_draft
  expiry_start
  review_rows
  expiry_rows
  orphan_rows
  check 'S1 backups, PA §16' 'inject db-snapshot: a dump of the bronzeward database after the review rows' \
    "$bin/inject" db-snapshot "$backup_name"
}

# pre_state: the pre-state bundle, both nodes' configuration digests and resource versions, and both
# nodes' apid logs in cp_log and w_log.
pre_state() {
  evidence_to pre || die "no pre-state: bin/evidence failed"
  cp -- "$bundle/talos-config-sha256.txt" "$EV/pre-talos-config-sha256.txt"
  cp -- "$bundle/talos-config-version.txt" "$EV/pre-talos-config-version.txt"
  check 'S1 precondition' 'pre-state: both nodes have a configuration digest' \
    counted 2 '^[0-9a-f]{64} ' "$EV/pre-talos-config-sha256.txt"
  check 'S1 precondition' 'pre-state: both nodes have a machine-configuration resource version' \
    counted 2 '^[0-9]+ ' "$EV/pre-talos-config-version.txt"
  cp_log=$(apid_log "$TALOS_CONTROLPLANE_IP") || die "cannot read the control plane's apid log"
  w_log=$(apid_log "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
}
# post_state: the post-state bundle compared with pre_state's, and no mutation in either apid log
# since it.
post_state() {
  local cp_after w_after
  evidence_to post || die "no post-state: bin/evidence failed"
  cp -- "$bundle/talos-config-sha256.txt" "$EV/post-talos-config-sha256.txt"
  cp -- "$bundle/talos-config-version.txt" "$EV/post-talos-config-version.txt"
  check 'S1 pass' "neither node's configuration digest changed" \
    same_file "$EV/pre-talos-config-sha256.txt" "$EV/post-talos-config-sha256.txt"
  check 'S1 pass' "neither node's machine-configuration resource version changed" \
    same_file "$EV/pre-talos-config-version.txt" "$EV/post-talos-config-version.txt"
  cp_after=$(apid_log "$TALOS_CONTROLPLANE_IP") || die "cannot read the control plane's apid log"
  w_after=$(apid_log "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
  # The positive control, after the post-state and on each node for its own row: a dry-run apply
  # is a mutation method, and the same query must find it on that node, or its log does not
  # record methods and the row proves nothing.
  no_mutation "the control plane" "$TALOS_CONTROLPLANE_IP" "$cp_log" "$cp_after"
  no_mutation 'the worker' "$TALOS_WORKER_IP" "$w_log" "$w_after"
}

# node-id: the one Talos access refusal that leaves a record behind, a machine with a node ID no
# node has, at the control plane's endpoint. It runs on an up of its own: a negative control leaves
# no state a later scenario relies on (acceptance plan §2), and that machine's scope, which no
# restoration observation can ever make ready, would hold S7's recovery mode open (ER §7.6).
node-id() {
  preconditions
  fresh_author
  pre_state
  cluster_draft
  record 'S1 access' 'POST /machines with a node ID no node has, at the control plane endpoint: 201' /api/v1/machines \
    "$(jq -nc --arg c "$cluster" --arg n "s1-no-such-node-$run_key" --arg e "$TALOS_CONTROLPLANE_IP:50000" \
      '{cluster: $c, talosNodeId: $n, platform: "container", talosEndpoint: $e}')" stranger
  check 'S1 access' 'a machine recorded with another node ID: abandoned, 409 machine-identity-mismatch, cause node-id, nothing kept' \
    access_case node-id "$recorded" 409 machine-identity-mismatch node-id
  outcome_bundle 'S1 access' access-node-id
  post_state
}

# first-keys: ginsys/bronzeward#898 against the fixture's own control plane, on an up of its own: the
# three first keys (the control plane's configuration, the cluster's secrets bundle, the os:admin
# talosconfig) supplied in turn, each tried at the control plane's endpoint before the CA key is
# stored, the stored key and the act read back, then the refusals, each leaving the stored version
# and the acts as they were, and the scan. The documents hold the cluster's CA key: the request
# bodies are withheld from every transcript and the files live in a directory of the state, never
# the evidence.
first_keys_endpoint=''
fk_version() { bao kv metadata get -format=json -mount=secret "access/talos-ca/$cluster" | jq -er '.data.current_version'; }
fk_absent() { ! bao kv metadata get -mount=secret "access/talos-ca/$cluster" >/dev/null 2>&1; }
fk_acts() { sql "SELECT count(*) FROM first_key_act WHERE cluster = '$cluster'"; }
# fk_post <kind> <file> <endpoint> <name> <status> <problem code or ->: the file's text as the document.
fk_post() {
  local kind=$1 file=$2 endpoint=$3 name=$4 doc body
  doc=$(jq -Rs . <"$file") || return 1
  withheld+=("${doc:1:${#doc}-2}")
  body=$(jq -nc --arg k "$kind" --rawfile d "$file" --arg e "$endpoint" '{kind: $k, document: $d, endpoint: $e}') || return 1
  answers "$5" "$6" POST "/api/v1/clusters/$cluster/first-keys" "$author" "$body" "$(key "first-key-$name")"
}
# fk_supply <kind> <file> <name> <replaced> <version>: a 200 that stores that version, with one act each.
fk_supply() {
  fk_post "$1" "$2" "$first_keys_endpoint" "$3" 200 - || return 1
  jq -e --arg c "$cluster" --arg k "$1" --argjson r "$4" --argjson v "$5" \
    '.cluster == $c and .kind == $k and .replaced == $r and .caKeyVersion.version == $v' "$EV/last.body" >/dev/null || {
    say "s1: first key $3: the answer is not the expected one"
    return 1
  }
  [ "$(fk_version)" = "$5" ] && [ "$(fk_acts)" = "$5" ]
}
# fk_refused <kind> <file> <endpoint> <name> <status> <problem code> <rule or ->: refused, with nothing
# written: the stored version and the acts are as they were.
fk_refused() {
  local v a
  v=$(fk_version) && a=$(fk_acts) || return 1
  fk_post "$1" "$2" "$3" "$4" "$5" "$6" || return 1
  [ "$7" = - ] || jq -e --arg r "$7" '.rule == $r' "$EV/last.body" >/dev/null || {
    say "s1: first key $4: the refusal does not name the rule $7"
    return 1
  }
  [ "$(fk_version)" = "$v" ] && [ "$(fk_acts)" = "$a" ]
}
# fk_ca_value <crt|key>: the fixture's os CA certificate or key, as the secrets bundle holds it.
fk_ca_value() { awk -v f="$1:" '/^ *os:$/ {o = 1; next} o && $1 == f {print $2; exit}' "$STATE/talos-secrets.yaml" | base64 -d; }
# fk_stored_is_fixtures: the key at the path is the fixture's os CA key (compared by digest, whitespace
# aside; nothing printed) and every act records the fixture CA certificate's fingerprint.
fk_stored_is_fixtures() {
  local want_crt got_crt want_key got_key acts=${1:-3}
  want_crt=$(fk_ca_value crt | openssl x509 -outform DER | sha256sum | cut -d' ' -f1) || return 1
  got_crt=$(bao kv get -field=ca -mount=secret "access/talos-ca/$cluster" | openssl x509 -outform DER | sha256sum | cut -d' ' -f1) || return 1
  want_key=$(fk_ca_value key | tr -d '[:space:]' | sha256sum | cut -d' ' -f1) || return 1
  got_key=$(bao kv get -field=key -mount=secret "access/talos-ca/$cluster" | tr -d '[:space:]' | sha256sum | cut -d' ' -f1) || return 1
  [ "$want_crt" = "$got_crt" ] && [ "$want_key" = "$got_key" ] &&
    [ "$(sql "SELECT count(*) FROM first_key_act WHERE cluster = '$cluster' AND ca_fingerprint = '$want_crt'")" = "$acts" ]
}
first-keys() {
  local tmp
  preconditions
  fresh_author
  cluster_register
  first_keys_endpoint=$TALOS_CONTROLPLANE_IP:50000
  tmp=$(mktemp -d -- "$STATE/first-keys.XXXXXX") || die "no directory for the first-key documents"
  node_talos "$TALOS_WORKER_IP" get machineconfig v1alpha1 -o jsonpath='{.spec}' >"$tmp/worker.yaml" || die "cannot read the worker's configuration"
  talosctl gen secrets --output-file "$tmp/other-secrets.yaml" || die "cannot generate an unrelated secrets bundle"
  talosctl_timed 30 -e "$TALOS_CONTROLPLANE_IP" -n "$TALOS_CONTROLPLANE_IP" config new "$tmp/reader.talosconfig" --roles os:reader --crt-ttl 1h ||
    die "cannot generate an os:reader talosconfig"
  printf 'not a first key %s\n' "$run_key" >"$tmp/garbage"
  check 'S1 first keys' 'no CA key is stored before the first supply: the path has no version' fk_absent
  check 'S1 first keys' "the control plane's machine configuration, tried at its endpoint: 200, replaced false, version 1, one act" \
    fk_supply machine-config "$STATE/controlplane.yaml" machine-config false 1
  check 'S1 first keys' "the cluster's secrets bundle: 200, replaced true, version 2, two acts" \
    fk_supply secrets-bundle "$STATE/talos-secrets.yaml" secrets-bundle true 2
  check 'S1 first keys' "the os:admin talosconfig, whose CA key is read through the control plane: 200, replaced true, version 3, three acts" \
    fk_supply talosconfig "$TALOSCONFIG" talosconfig true 3
  check 'S1 first keys' "the stored key is the fixture's os CA key, and each act records its certificate's fingerprint" fk_stored_is_fixtures
  check 'S1 first keys' 'a worker configuration holds no key: 422 first-key-no-ca-key, nothing written' \
    fk_refused machine-config "$tmp/worker.yaml" "$first_keys_endpoint" worker-config 422 validation-failed first-key-no-ca-key
  check 'S1 first keys' 'a document that is no machine configuration: 422 first-key-unusable, nothing written' \
    fk_refused machine-config "$tmp/garbage" "$first_keys_endpoint" garbage 422 validation-failed first-key-unusable
  check 'S1 first keys' 'an os:reader talosconfig: 422 first-key-role-insufficient, nothing written' \
    fk_refused talosconfig "$tmp/reader.talosconfig" "$first_keys_endpoint" reader 422 validation-failed first-key-role-insufficient
  check 'S1 first keys' 'the os:admin talosconfig at the worker, which holds no CA key: 422 first-key-endpoint-no-control-plane, nothing written' \
    fk_refused talosconfig "$TALOSCONFIG" "$TALOS_WORKER_IP:50000" worker-endpoint 422 validation-failed first-key-endpoint-no-control-plane
  check 'S1 first keys' "an unrelated cluster's secrets bundle as a replacement: the node refuses its certificate, 503 talos-access-unavailable, the stored key and its version unchanged" \
    fk_refused secrets-bundle "$tmp/other-secrets.yaml" "$first_keys_endpoint" unrelated 503 talos-access-unavailable -
  check 'S1 first keys' "the stored key is still the fixture's after the refusals" fk_stored_is_fixtures
  rm -rf -- "$tmp"
  check 'S1 backups, PA §16' 'inject db-snapshot: a dump of the bronzeward database after the first keys' \
    "$bin/inject" db-snapshot "$backup_name"
  outcome_bundle 'S1 first keys' first-keys
}

# onboard: ginsys/bronzeward#900 against the fixture's own Talos and server, on an up of its own:
# bronzewardctl cluster onboard sends the first key to the server like any other request. The client
# runs with an empty environment (no OpenBao address or token, and no PATH, so no bao) as h-author.
# The first key is the talosconfig, whose CA key is read through the control plane. The checks: the
# records, the stored key, a rerun that replaces it, a run that skips it, the client's own environment
# and arguments, and the key's value in no evidence file.
ob_env=''
# ob_run <name> <args>...: bronzewardctl --context h-author <args> with env -i, its output and exit
# status kept as cli-<name>.txt, the status the function's. The environment it ran with is ob_env.
ob_run() {
  local name=$1 tok rc=0
  shift
  tok=$(mint h-author) || return 1
  keep_secret "$tok"
  printf '{"accessToken":"%s"}' "$tok" >"$cli_dir/h-author.json"
  ob_env=$(printf '%s\n' "XDG_CONFIG_HOME=$cli_dir/config" "XDG_STATE_HOME=$cli_dir/state" "XDG_CACHE_HOME=$cli_dir/cache" \
    'DBUS_SESSION_BUS_ADDRESS=disabled:' "PATH=$cli_dir/nopath") || return 1
  printf '%s\n' "$ob_env" >"$EV/onboard-client-env.txt"
  env -i "XDG_CONFIG_HOME=$cli_dir/config" "XDG_STATE_HOME=$cli_dir/state" "XDG_CACHE_HOME=$cli_dir/cache" \
    'DBUS_SESSION_BUS_ADDRESS=disabled:' "PATH=$cli_dir/nopath" "$ctl_bin" --context h-author "$@" >"$EV/cli-$name.txt" 2>&1 || rc=$?
  printf '[bronzewardctl --context h-author %s, exit %d]\n' "$*" "$rc" >>"$EV/cli-$name.txt"
  return "$rc"
}
# bao_traces <file>: how many lines name an OpenBao address, token or flag.
bao_traces() { grep --count --extended-regexp -- 'BAO_|VAULT_|--bao-' "$1" || true; }
# ob_no_bao <control file>: the client's environment and every kept run's arguments and output name
# nothing of OpenBao, and the same count reads one line in the control file (which does).
ob_no_bao() {
  local f n=0
  for f in "$EV/onboard-client-env.txt" "$EV"/cli-onboard-*.txt; do
    [ -e "$f" ] || return 1
    n=$((n + $(bao_traces "$f")))
  done
  [ "$n" = 0 ] && [ "$(bao_traces "$1")" = 1 ]
}
# ob_canary_absent: the talosconfig's key, read from the file and never passed as an argument, is in
# no file of the evidence directory.
ob_canary_absent() {
  local canary
  canary=$(awk '$1 == "key:" {print $2; exit}' "$TALOSCONFIG") && [ -n "$canary" ] || return 1
  ! grep --recursive --quiet --fixed-strings --file=<(printf '%s\n' "$canary") -- "$EV"
}
ob_args() {
  printf '%s\n' cluster onboard --talosconfig "$TALOSCONFIG" --name bw-fixture --endpoint "$TALOS_CONTROLPLANE_IP:50000" \
    --kubernetes-endpoint "https://$TALOS_CONTROLPLANE_IP:6443" --no-import
}
onboard() {
  local ctl_file args
  preconditions
  cli_prepare 'S1 onboard' h-author
  mkdir -p -- "$cli_dir/nopath"
  mapfile -t args < <(ob_args)
  check 'S1 onboard' 'cluster onboard: the talosconfig is the first key; no OpenBao address, token or bao anywhere: exit 0' ob_run onboard-first "${args[@]}"
  cluster=$(sql "SELECT id FROM cluster WHERE name = 'bw-fixture'") || die "s1: onboard recorded no cluster"
  check 'S1 onboard' 'the cluster is recorded once, with both machines' same "$(sql "SELECT count(*) FROM cluster WHERE name = 'bw-fixture'") $(sql "SELECT count(*) FROM machine WHERE cluster = '$cluster'")" '1 2'
  check 'S1 onboard' 'the output says the first key was stored' cli_kept onboard-first '^First key: stored'
  check 'S1 onboard' 'the stored CA key is version 1 and one act records it' same "$(fk_version) $(fk_acts)" '1 1'
  check 'S1 onboard' "the stored key is the fixture's os CA key, and the act records its certificate's fingerprint" fk_stored_is_fixtures 1
  check 'S1 onboard' 'a rerun replaces the key: exit 0, "First key: replaced", version 2, two acts' \
    ob_run onboard-rerun "${args[@]}"
  check 'S1 onboard' 'the rerun reports the first key replaced' cli_kept onboard-rerun '^First key: replaced'
  check 'S1 onboard' 'after the rerun the stored key is version 2 with two acts' same "$(fk_version) $(fk_acts)" '2 2'
  check 'S1 onboard' 'a run with --skip-first-key sends none: exit 0' ob_run onboard-skip "${args[@]}" --skip-first-key
  check 'S1 onboard' 'the skipping run reports the first key skipped' cli_kept onboard-skip '^First key: skipped'
  check 'S1 onboard' 'the skipping run leaves the version and the acts as they were' same "$(fk_version) $(fk_acts)" '2 2'
  ctl_file=$(mktemp -- "$STATE/onboard-control.XXXXXX") || die "no control file"
  printf 'BAO_ADDR=http://127.0.0.1:8200\n' >"$ctl_file"
  check 'S1 onboard' "the client's environment, arguments and output name no OpenBao address, token or flag (the control file reads one)" ob_no_bao "$ctl_file"
  rm -f -- "$ctl_file"
  check 'S1 onboard' "the talosconfig's key is in no file of the evidence directory" ob_canary_absent
  check 'S1 backups, PA §16' 'inject db-snapshot: a dump of the bronzeward database after onboarding' \
    "$bin/inject" db-snapshot "$backup_name"
  outcome_bundle 'S1 onboard' onboard
}

run() {
  # Preconditions, then the pre-state.
  preconditions

  # The rows the Go tests prove (ruling 1), in a clone of the image commit, so that the results
  # are the server's own commit's; removed again once they have run. They run before the apid
  # logs are read below: the role probe's GenerateClientConfiguration on the control plane is the
  # scenario's own mutation request, not the system's, and stays out of step 5's interval.
  if ! controls_run 'S1 Go tests' 'the Go rows (lease, takeover, interruption, access and inventory refusals)'; then
    :
  elif clone_made go-rows-clone; then
    check 'S1 precondition' "GOFLAGS, GOEXPERIMENT and GOWORK are unset and the Go version is the image's, so the tests run on the server's build (clone HEAD $clone_head)" go_env_clean
    check 'S1 Go tests' 'the tests below ran against PostgreSQL and OpenBao and passed, none skipped (go-rows.log)' go_rows_ran
    check 'S1 lease extension, C §3.3' "a heartbeat from another ingestion principal, one of an older generation, and the owner's own after its lease lapsed: each refused, the claim unchanged (TestOwnerFenceMatrix)" \
      go_row TestOwnerFenceMatrix
    check 'S1 lease extension, C §3.3' "control: the owner's heartbeat while live extends the lease, never past the absolute expiry (TestHeartbeat)" \
      go_row TestHeartbeat
    check 'S1 lease extension, C §3.3' "control: the extension counts from when the heartbeat took the claim's lock (TestHeartbeatExtendsFromTheLockTime)" \
      go_row TestHeartbeatExtendsFromTheLockTime
    check 'S1 interruption' 'a crash inside the draft transaction: the draft and its ETag unchanged, nothing it wrote committed, the claim unreleased (TestCrashInsideT1LeavesDraft)' \
      go_row TestCrashInsideT1LeavesDraft
    check 'S1 takeover, C §3.4' "the old owner's draft transaction refused after a takeover, nothing of the draft written (TestTakeoverRacesT1)" \
      go_row TestTakeoverRacesT1
    check 'S1 takeover, C §3.4' 'a takeover with nothing to decrypt abandons the claim, its operation failed ingestion-abandoned (TestTakeoverNothingToDecrypt)' \
      go_row TestTakeoverNothingToDecrypt
    check 'S1 takeover, C §3.4' "a decryption failure leaves the claim resumed under the taker, then taken over once its lease lapses (TestTakeoverDecryptFailureLeavesResumed)" \
      go_row TestTakeoverDecryptFailureLeavesResumed
    check 'S1 access, PA §16' 'the provider unavailable to the access read: 503 talos-access-unavailable, cause provider-unavailable, the claim abandoned (TestMachineAccessUnavailable)' \
      go_row TestMachineAccessUnavailable
    # The acceptance plan's §7.1 *check* items for ginsys/bronzeward#22, one row per test it names.
    local t
    for t in TestTakeOver TestTakeOverRefusals TestTakeOverRechecksEligibility TestTakeOverConcurrentTakers \
      TestTakeoverResumesToT1 TestTakeoverRefusals TestTakeoverDigestMismatchAbandons TestTakeoverConcurrentTakers \
      TestTakeoverNoEcho; do
      check 'S1 takeover, C §15 check' "$t passed" go_row "$t"
    done
    for t in TestMachineIdentityMismatch TestMachineIngestionIdentityControls TestMachineIngestion \
      TestMachineAccessEventFencedByTheClaim TestMachineAccessErrorTextControl; do
      check 'S1 access, PA §16 check' "$t passed" go_row "$t"
    done
    # PA §16's inventory item: one SMBIOS UUID, Talos node ID or Talos cluster ID under two keys,
    # one refused; a body with both identity keys, or neither, refused.
    for t in TestSMBIOSUUIDIsOneMachine TestSMBIOSUUIDControl TestIdentityKeyConcurrent \
      TestInventoryIdentityKeys TestInventoryRefusals; do
      check 'S1 inventory, PA §16 check' "$t passed" go_row "$t"
    done
    check 'S1 access, PA §16 check' "TestLiveRoleProbe passed against the fixture's control plane: os:reader and os:operator refused MachineConfig with PermissionDenied, os:admin reads" \
      go_row TestLiveRoleProbe
  else
    result FAIL 'S1 Go tests' 'no clone of the image commit (go-rows-clone.log): the Go tests did not run'
  fi
  rm -rf -- "$clone_dir"

  check 'S1 precondition' "the mutation matcher counts an apid line of each mutating Talos API method once and of each read method not at all ($(grep -c . <<<"$MUTATIONS") mutating, talos-api-methods.tsv)" \
    methods_counted
  check 'S1 precondition' 'the mutation matcher gives no count, not 0, when grep fails extracting the methods or counting them' \
    matcher_fails_closed
  fresh_author
  pre_state

  cluster_draft
  # Step 4: each node in turn under the draft's current ETag.
  local claims_before
  claims_before=$(gen_claims) || die "s1: the metadata identity cannot list gen/$cluster"
  check 'S1 steps 3-4' 'control plane ingested (source machine, transient): claim released, operation succeeded, ETag moved' \
    ingest "$machine_cp" '[]'
  outcome_bundle 'S1 steps 3-4' success-controlplane
  check 'S1 steps 3-4' 'worker ingested with its file content marked: claim released, operation succeeded, ETag moved' \
    ingest "$machine_w" "$(jq -nc --arg p "$WORKER_MARK" '[$p]')"
  outcome_bundle 'S1 steps 3-4' success-worker

  # Pass criteria the database and OpenBao answer.
  check 'S1 pass' 'control plane: !bwref references where the schema list identified values' has_references "$machine_cp"
  check 'S1 pass' 'worker: !bwref references, the marked file content among them' has_references "$machine_w" marked
  check 'S1 pass' 'each reference a create-only generation, listed under its claim by the metadata identity, nothing else there' \
    generations_listed
  check 'S1 pass' 'control plane: the baseline, decrypted by the administrator, has the recorded configuration digest, the pre-state' \
    baseline_is_pre_state "$machine_cp" "$TALOS_CONTROLPLANE_IP" "$EV/pre-talos-config-sha256.txt"
  check 'S1 pass' 'worker: the baseline, decrypted by the administrator, has the recorded configuration digest, the pre-state' \
    baseline_is_pre_state "$machine_w" "$TALOS_WORKER_IP" "$EV/pre-talos-config-sha256.txt"
  executor_token=$(bao token create -policy=bw-executor -no-default-policy -ttl=10m -format=json | jq -er '.auth.client_token') ||
    die "cannot create an executor token"
  keep_secret "$executor_token"
  check 'S1 pass' "the executor identity's decryption of the worker's baseline: refused" executor_refused "$machine_w"
  check 'S1 pass' "the executor identity's read of the cluster's stored CA key: refused (the administrator's read of it answers)" ca_read_refused "$cluster"

  if controls_run 'S1 negative controls' 'the refusal set, the Talos access refusals, takeover, the interruption matrix, the review, expiry and orphan rows'; then
    controls "$claims_before"
  fi
  check 'S1 backups, PA §16' 'inject db-snapshot: a dump of the bronzeward database after the imports and whatever controls ran' \
    "$bin/inject" db-snapshot "$backup_name"

  # Step 5: the post-state, compared with the pre-state.
  post_state
}
pass() { run; }

# controls: the refusal set, the access refusals, takeover, the interruption matrix and the review,
# expiry and orphan rows, after the imports.
controls() {
  local claims_before=$1
  fresh_author
  # The refusal set (C §13): each refused before any provider write, one bundle each. The control
  # for "no claim under gen/": the two imports above listed theirs.
  check 'S1 refusal' 'control: before the imports gen/<cluster>/ listed no claim, after them exactly their two' \
    claims_added "$claims_before"
  withheld+=("$BW_CANARY")
  check 'S1 refusal' 'worker, source machine, a mark addressing no node: abandoned, 422 mark-unaddressed naming the mark, no secret in the problem, ETag and gen/ unchanged' \
    refused unaddressed "$machine_w" '["doc[0]/machine/files/9/content"]' mark-unaddressed '["doc[0]/machine/files/9/content"]'
  outcome_bundle 'S1 refusal' refusal-unaddressed
  check 'S1 refusal' 'source document, unparseable: abandoned, 422 parse, no secret in the problem, ETag and gen/ unchanged' \
    refused parse "$machine_w" '[]' parse - document
  outcome_bundle 'S1 refusal' refusal-parse
  check 'S1 refusal' 'source document, the extracted token also an unmarked label: abandoned, 422 guard-value naming the label, no secret in the problem, ETag and gen/ unchanged' \
    refused guard "$machine_w" '[]' guard-value '["doc[1]/labels/copy"]' document
  outcome_bundle 'S1 refusal' refusal-guard
  local robot
  robot=$(cat -- "$STATE/automation-token") || die "no automation token in $STATE"
  check 'S1 refusal, PA §10.3' 'automation (the seed token) on POST /ingestions: 403 forbidden, humanOnly' \
    answers_with '.humanOnly == true' 403 forbidden POST /api/v1/ingestions "$robot" "$(machine_body "$machine_cp")" \
    "$(key automation)" "$etag"
  outcome_bundle 'S1 refusal, PA §10.3' refusal-automation

  fresh_author
  # Talos access refusals (PA §3.3, §16): each fixture-producible cause, one import each, its fault
  # put in place before and taken away after.
  check 'S1 access' 'the CA key the first-key act names, its metadata deleted: abandoned, 503 talos-access-unavailable, cause version-gone, nothing kept' \
    access_case absent "$machine_w" 503 talos-access-unavailable version-gone
  outcome_bundle 'S1 access' access-absent
  check 'S1 access' 'the CA key written again at the same path, version 1 with another created_time: abandoned, 503 talos-access-unavailable, cause version-changed, nothing kept' \
    access_case changed "$machine_w" 503 talos-access-unavailable version-changed
  outcome_bundle 'S1 access' access-changed
  check 'S1 access' 'OpenBao sealed: refused at the request, 503 dependency-unavailable, no claim, ETag and gen/ unchanged' \
    sealed_refused
  outcome_bundle 'S1 access' access-sealed
  check 'S1 access' "the worker's endpoint silent to A (link split): abandoned, 503 talos-access-unavailable, cause node-unreachable, nothing kept" \
    access_case silent "$machine_w" 503 talos-access-unavailable node-unreachable
  outcome_bundle 'S1 access' access-silent
  # Another node ID is node-id's, on an up of its own.
  check 'S1 access' 'the cluster recorded with another Talos cluster ID: abandoned, 409 machine-identity-mismatch, cause cluster-id, nothing kept' \
    access_case cluster-id "$machine_w" 409 machine-identity-mismatch cluster-id
  outcome_bundle 'S1 access' access-cluster-id
  check 'S1 access' "control: with every fault taken away, the worker's import is not refused" \
    ingest "$machine_w" "$(jq -nc --arg p "$WORKER_MARK" '[$p]')" again
  outcome_bundle 'S1 access' success-worker-again

  # Takeover and interruption on instance C (C §3.3 to §3.5), then the operator review (C §3.6);
  # the expiry claim pauses first, so that its absolute expiry passes while the others run.
  expiry_start
  takeover_rows
  outcome_bundle 'S1 takeover, C §3.4' success-takeover
  interruption_matrix
  review_rows
  expiry_rows
  orphan_rows
}

"$s1_mode"
rm -f -- "$EV/last.body" "$EV/last.headers"
# The final bundle: the evidence directory and the run directory scanned, as S0's step 5 does.
ev_log=$(mktemp)
if final=$("$bin/evidence" "$EV" 2>"$ev_log"); then
  cat -- "$ev_log" >&2
  if grep --quiet --fixed-strings -- 'positive control found; 0 other file(s) contain' "$ev_log"; then
    result PASS 'S1 step 5' 'bin/evidence scanned the bundle and the run directory; no file but its control holds a fixture secret, the marked value included'
  else
    result FAIL 'S1 step 5' "the leak scan reports fixture secrets: $final/leak-scan.txt"
  fi
  if [ -e "$final/unavailable.txt" ]; then
    result FAIL 'S1 step 5' "the bundle is incomplete: $final/unavailable.txt names what was not captured"
  else
    result PASS 'S1 step 5' 'the bundle is complete: bin/evidence captured every source'
  fi
  # The scan above covers the dump only if the bundle holds it expanded, with the database's rows
  # in it: an interrupted claim's own row, the line keyed by its id inside the staging_claim COPY
  # block (other tables carry the id too, so a bare match would not show the claim row is there).
  # node-id and register take no dump. The pass mode interrupts nothing: the worker's machine row
  # instead.
  dump_table=staging_claim dump_id=${interrupted[0]:-} dump_row='an interrupted claim'
  [ "$s1_mode" != pass ] || dump_table=machine dump_id=$machine_w dump_row="the worker's machine"
  [ "$s1_mode" != first-keys ] && [ "$s1_mode" != onboard ] || { dump_table=first_key_act dump_row="a first key's act"; dump_id=$(sql "SELECT act FROM first_key_act ORDER BY act LIMIT 1") || dump_id=; }
  if [ "$s1_mode" = node-id ] || [ "$s1_mode" = register ]; then
    :
  elif [ -n "${dump_id%% *}" ] &&
    awk -v id="${dump_id%% *}" -v table="$dump_table" '
      index($0, "COPY public." table " ") == 1 { block = 1; next }
      block && /^\\\.$/ { block = 0 }
      block && index($0, id "\t") == 1 { found = 1 }
      END { exit !found }' "$final/backups/pg-$backup_name.dump.sql"; then
    result PASS 'S1 step 5, PA §16' "the scanned bundle holds the database dump expanded, $dump_row among its rows (control)"
  else
    result FAIL 'S1 step 5, PA §16' 'the scanned bundle does not hold the database dump expanded with the run'"'"'s rows: the backup went unscanned'
  fi
  # The tokens this run minted and created, searched in the run directory, the final bundle and
  # every bundle the run captured before it (the pre- and post-state, each refusal's and
  # interruption's: siblings of the run directory, so only their recorded paths reach them), with a
  # control holding the last of them that must be the one file listed (as s0 does).
  local_ctl=$STATE/s1-token-control
  trap 'rm -f -- "$local_ctl"' EXIT
  # An empty array has no [-1], with or without a default: the FAIL below must stay reachable.
  if [ "${#secrets[@]}" -gt 0 ]; then printf 'x %s x\n' "${secrets[-1]}" >"$local_ctl"; else : >"$local_ctl"; fi
  earlier=()
  for f in "$EV"/*-bundle; do
    [ -e "$f" ] || continue
    earlier+=("$(cat -- "$f")")
  done
  hits=$(grep --recursive --files-with-matches --fixed-strings --file=<(printf '%s\n' "${secrets[@]}") -- \
    "$EV" "$final" "${earlier[@]}" "$local_ctl") || hits=
  rm -f -- "$local_ctl"
  trap - EXIT
  if [ "${#secrets[@]}" -gt 0 ] && [ "$hits" = "$local_ctl" ]; then
    result PASS 'S1 step 5' "none of the ${#secrets[@]} tokens this run minted or created is in any bundle of the run or the run directory (control found)"
  else
    printf 's1: files holding a token of this run: %s\n' "${hits:-none, not even the control}" >&2
    result FAIL 'S1 step 5' "the tokens this run minted or created: ${#secrets[@]} searched, the listing is not the control alone"
  fi
else
  cat -- "$ev_log" >&2
  result FAIL 'S1 step 5' 'bin/evidence failed'
fi
rm -f -- "$ev_log"
say "s1 $s1_mode: $failed failed; evidence in $EV, bundle ${final:-none}"
[ "$failed" -eq 0 ]
