#!/usr/bin/env bash
# Acceptance plan S4, the safe apply, against the fixture. `run`: on the state S3's approval part
# leaves (step 3's plan approved, A's, B's and C's links to the worker cut), the links are joined
# again and the controller dispatches the plan: the use-time check and an evidence observation, the
# commitment, one attempt sending apply-config (no-reboot) over the worker's own route, the
# acceptance, a completion observation, and the operation completed with Applied the release. The
# timeline orders each of them, the worker's digest becomes the artifact's and its resource version
# moves, the control plane is untouched, and Desired, Applied and Observed agree only at the end.
# `controls`: S4's negative controls on the same starting state, with nothing sent. A plan body
# naming a route is refused at creation. Step 3's plan is cancelled and a plan with a 10 s age bound
# approved in its place; A and B are paused and C alone is joined to the worker, told to stall once
# its evidence is recorded. With OpenBao sealed, then stopped, C's use-time check fails and is
# recorded, and nothing commits; started again, the check passes and the evidence is recorded. Once
# that evidence is older than the plan binds, C is told to stall after the commitment instead: the
# stale evidence is no evidence (nothing refused), and the commitment rests on a later observation.
# Its operation then holds the worker's scope, with no attempt: with A and B running, a second
# approved plan waits, and a publication changing the worker's assignment fails 409 scope-busy. The
# database is dumped, then both s3-step3 snapshots are restored with C's link cut again: the state
# `run` starts from.
# `restores`: the commitment-level controls, each from a restore of S3's step-4 snapshots with the S2
# release planned on C alone, A and B paused and C told to stall before anything could be sent. The
# worker's assignment changed after planning, and a later release published before the approval:
# comparison 2 refuses the commitment. The plan cancelled, or the approver's identity revoked, once
# the operation is committed with no attempt: the attempt is refused, the operation goes unresolved,
# then cancelled. The identity revoked after the evidence and before the commitment: comparison 1
# refuses it. OpenBao paused while C checks the plan, h-approver's next approval under a token
# without the approver group 403, then OpenBao unpaused: the plan commits and its attempt is
# admitted. The run ends restored to the s3-step3 snapshots, as controls does.
# Each check writes PASS, FAIL or SKIP, its acceptance-plan reference and what it checked to s4.tsv
# in the evidence directory and to stdout. Exit 1 on any FAIL.
# Usage: scenarios/s4 controls|restores|run   (after scenarios/s1 run, s3 handover, s2 run and s3 run
# on the same up; controls and restores, when run, before run)
set -euo pipefail
here=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
bin=$here/../bin
# shellcheck source-path=SCRIPTDIR source=../lib.sh
. "$here/../lib.sh"

s4_mode=${1:-}
case $s4_mode in controls | restores | run) ;; *) die "usage: scenarios/s4 controls|restores|run" ;; esac
need docker curl jq timeout id sleep date awk wc
need_state
# No fixture lock of its own: inject and evidence each take the one they need.
umask 077
image_id=$(cat -- "$STATE/up-image") || die "no server image is recorded in $STATE; run fixtures/bin/up"
image_own "$image_id" || die "the recorded server image is not this run's; run fixtures/bin/down, then up"
EV=$STATE/evidence/s4-$s4_mode-$(date -u +%Y%m%dT%H%M%SZ)
mkdir -p -- "$EV" "$EV/http"
scenario=s4
# shellcheck source-path=SCRIPTDIR source=common.sh
. "$here/common.sh"
run_key=$(date -u +%s%N)
mutation_ref='S4 pass'
[ "$s4_mode" = run ] || mutation_ref='S4 negative controls'

cluster='' machine_cp='' machine_w='' plan='' rel='' was='' baseline='' op=''
viewer='' viewer_at=0
fresh_viewer() {
  [ -z "$viewer" ] || [ $((SECONDS - viewer_at)) -ge 180 ] || return 0
  viewer=$(mint h-viewer) || die "cannot mint a viewer token"
  keep_secret "$viewer"
  viewer_at=$SECONDS
}
machine_at() {
  sql "SELECT id FROM machine WHERE cluster = '$cluster' AND talos_endpoint::text = '$1:50000'
    AND talos_node_id NOT LIKE 's1-no-such-node-%'"
}
one_line() { [ -n "$1" ] && [ "$(wc -l <<<"$1")" = 1 ]; }
# worker_cut: .state/linksplits records A's, B's and C's links to the worker cut.
worker_cut() { counted 3 '^[ABC] worker$' "$STATE/linksplits"; }
worker_joined() { [ ! -f "$STATE/linksplits" ] || counted 0 '^[ABC] worker$' "$STATE/linksplits"; }
# served <jq filter>: h-viewer reads the worker and the body satisfies the filter.
served() {
  fresh_viewer
  answers_with "$1" 200 - GET "/api/v1/machines/$machine_w" "$viewer"
}
# rev <SQL predicate on machine_event e>: the revision of the one worker entry it selects.
rev() { sql "SELECT e.revision FROM machine_event e WHERE e.machine = '$machine_w' AND $1"; }

preconditions() {
  local ref='S4 precondition'
  cluster=$(sql "SELECT id FROM cluster WHERE name = 'bw-fixture'") || die "s4: cannot read the cluster"
  machine_cp=$(machine_at "$TALOS_CONTROLPLANE_IP") || die "s4: cannot read the control plane's machine"
  one_line "$machine_cp" || die "s4: not one machine at the control plane's endpoint: run scenarios/s1 run first"
  machine_w=$(machine_at "$TALOS_WORKER_IP") || die "s4: cannot read the worker's machine"
  one_line "$machine_w" || die "s4: not one machine at the worker's endpoint: run scenarios/s1 run first"
  plan=$(sql "SELECT id FROM plan WHERE kind = 'apply-config'") || die "s4: cannot read the plans"
  one_line "$plan" || die "s4: not one apply-config plan: run scenarios/s3 run first"
  rel=$(sql "SELECT release FROM plan WHERE id = '$plan'")
  was=$(sql "SELECT applied_release FROM machine_state WHERE machine = '$machine_w'")
  baseline=$(sql "SELECT baseline_revision FROM machine_state WHERE machine = '$machine_w'")
  check "$ref" "S3's step 3 plan: the worker's, approved, no operation, no-reboot, unexpired for ten minutes more" \
    same "$(sql "SELECT p.machine || ' ' || s.state || ' ' || coalesce(s.operation, 'none') || ' ' || p.mode
      || ' ' || (p.expires_at > now() + interval '10 minutes') FROM plan p JOIN plan_state s ON s.plan = p.id
      WHERE p.id = '$plan'")" "$machine_w approved none no-reboot true"
  check "$ref" "its release is the worker's Desired and not its Applied" \
    same "$(sql "SELECT (desired = '$rel') || ' ' || (applied_release <> '$rel') FROM machine_state WHERE machine = '$machine_w'")" 'true true'
  check "$ref" 'no apply-config operation exists' same "$(sql "SELECT count(*) FROM operation WHERE kind = 'apply-config'")" 0
  check "$ref" "A's, B's and C's links to the worker are cut (S3 step 4)" worker_cut
  check "$ref" 'A answers /livez' answers 204 - GET /livez ''
  check "$ref" "the mutation matcher counts an apid line of each mutating Talos API method once and of each read method not at all" \
    methods_counted
  check "$ref" "Desired, Applied and Observed served as three values: Desired the plan's release, Applied and Observed not" \
    served ".desired == \"$rel\" and .applied.release == \"$was\" and .applied.source == \"adoption\"
      and (.observed.release // \"none\") != \"$rel\""
}

cp_log='' w_log=''
pre_state() {
  local ref='S4 precondition'
  evidence_to pre || die "no pre-state: bin/evidence failed"
  cp -- "$bundle/talos-config-sha256.txt" "$EV/pre-talos-config-sha256.txt"
  cp -- "$bundle/talos-config-version.txt" "$EV/pre-talos-config-version.txt"
  check "$ref" 'the pre-state bundle: complete, no fixture secret but the scan control' scan_clean pre
  check "$ref" 'pre-state: both nodes have a configuration digest and a resource version' \
    same "$(grep -c -E '^[0-9a-f]{64} ' "$EV/pre-talos-config-sha256.txt") $(grep -c -E '^[0-9]+ ' "$EV/pre-talos-config-version.txt")" '2 2'
  cp_log=$(apid_log "$TALOS_CONTROLPLANE_IP") || die "cannot read the control plane's apid log"
  w_log=$(apid_log "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
}

# completed: the plan committed to an apply-config operation that completed; its id in op.
completed() {
  op=$(sql "SELECT o.id FROM plan_state s JOIN operation o ON o.id = s.operation
    WHERE s.plan = '$plan' AND s.state = 'committed' AND o.kind = 'apply-config' AND o.state = 'completed'")
  [ -n "$op" ]
}
# A, B and C each run the controller's loop, so the checks and observations of the plan may come from
# several of them: each ordering is read among the committing controller's own entries.
# use_time_passed: that controller's last use-time check of the plan before its commitment passed,
# the access and the artifact each passed.
use_time_passed() {
  [ "$(sql "SELECT u.entry->>'result' || ' ' || (u.entry->'dependencies'->'access'->>'result')
      || ' ' || (u.entry->'dependencies'->'artifact'->>'result')
      FROM machine_event u, machine_event c
      WHERE u.machine = '$machine_w' AND c.machine = u.machine AND c.kind = 'commitment' AND c.entry->>'plan' = '$plan'
        AND u.kind = 'use-time-check' AND u.entry->>'plan' = '$plan' AND u.revision < c.revision
        AND u.entry->>'controller' = c.entry->>'controller'
      ORDER BY u.revision DESC LIMIT 1")" = 'passed passed passed' ]
}
# evidence_committed: the commitment names the operation and an evidence observation of the plan by
# the same controller, read with the access (not unread), begun after that controller's last
# use-time check of the plan and before the commitment.
evidence_committed() {
  [ "$(sql "SELECT count(*) FROM machine_event c
      JOIN observation o ON o.id = c.entry->>'observation' AND o.machine = c.machine
      JOIN observation_start s ON s.machine = o.machine AND s.revision = o.basis
      WHERE c.machine = '$machine_w' AND c.kind = 'commitment' AND c.entry->>'plan' = '$plan' AND c.entry->>'operation' = '$op'
        AND s.purpose = 'evidence' AND s.plan = '$plan' AND s.controller = c.entry->>'controller'
        AND o.revision < c.revision AND o.configuration_digest IS NOT NULL
        AND s.revision > (SELECT max(u.revision) FROM machine_event u WHERE u.machine = c.machine AND u.kind = 'use-time-check'
          AND u.entry->>'plan' = '$plan' AND u.entry->>'controller' = c.entry->>'controller' AND u.revision < c.revision)")" = 1 ]
}
# one_attempt: one attempt, number 1, after the commitment, on the plan's route, resting on the
# commitment's observation; its response accepted, recorded after it.
one_attempt() {
  local c
  c=$(rev "e.kind = 'commitment' AND e.entry->>'operation' = '$op'") && [ -n "$c" ] || return 1
  [ "$(sql "SELECT count(*) || ' ' || bool_and(a.number = 1 AND a.revision > $c AND a.route::text = p.route::text
      AND a.observation = (SELECT entry->>'observation' FROM machine_event WHERE machine = '$machine_w' AND revision = $c)
      AND r.class = 'accepted' AND r.revision > a.revision)
      FROM attempt a JOIN plan p ON p.id = a.plan LEFT JOIN attempt_response r ON r.attempt = a.id
      WHERE a.operation = '$op'")" = '1 true' ]
}
# states_in_order: the operation's entries, by revision: the commitment, the attempt (which moves
# it from committed to sending), the response, sending to verifying, verifying to completed, and
# the Applied change.
states_in_order() {
  [ "$(sql "SELECT string_agg(CASE WHEN kind = 'operation-state' THEN (entry->>'from') || '>' || (entry->>'to') ELSE kind END,
      ',' ORDER BY revision) FROM machine_event
    WHERE machine = '$machine_w' AND kind IN ('commitment', 'attempt', 'response', 'operation-state', 'applied-change')
      AND entry->>'operation' = '$op'")" = 'commitment,attempt,response,sending>verifying,verifying>completed,applied-change' ]
}
# completion_after_response: a completion observation of the operation, begun after the response,
# reading the release's configuration digest, and the operation's result naming it.
completion_after_response() {
  [ "$(sql "SELECT count(*) FROM observation o JOIN observation_start s ON s.machine = o.machine AND s.revision = o.basis
      JOIN plan p ON p.id = s.plan JOIN release_machine rm ON rm.release = p.release AND rm.machine = p.machine
      WHERE s.machine = '$machine_w' AND s.operation = '$op' AND s.purpose = 'completion'
        AND o.configuration_digest = rm.configuration_digest
        AND s.revision > (SELECT r.revision FROM attempt a JOIN attempt_response r ON r.attempt = a.id WHERE a.operation = '$op')
        AND o.id = (SELECT result->>'observation' FROM operation WHERE id = '$op')")" = 1 ]
}
# applied_moved: Applied is the release from source operation, its digest the artifact's, the
# baseline revision one more, and one Applied change entry names the plan and the operation.
applied_moved() {
  [ "$(sql "SELECT s.applied_release || ' ' || s.applied_source || ' ' || s.baseline_revision || ' ' || (s.applied_digest = rm.configuration_digest)
      FROM machine_state s JOIN release_machine rm ON rm.release = s.applied_release AND rm.machine = s.machine
      WHERE s.machine = '$machine_w'")" = "$rel operation $((baseline + 1)) true" ] &&
    [ "$(sql "SELECT count(*) FROM machine_event WHERE machine = '$machine_w' AND kind = 'applied-change'
      AND entry->>'plan' = '$plan' AND entry->>'operation' = '$op' AND entry->>'source' = 'operation'
      AND entry->>'from' = '$was' AND entry->>'to' = '$rel'")" = 1 ]
}
# scope_released: no committed, sending, verifying or unresolved apply-config operation holds the
# worker's scope or the cluster's rollout slot.
scope_released() {
  [ "$(sql "SELECT count(*) FROM operation WHERE kind = 'apply-config' AND state IN ('committed', 'sending', 'verifying', 'unresolved')
    AND (machine = '$machine_w' OR cluster = '$cluster')")" = 0 ]
}
# node_applied: in the latest bundle the worker's digest is the artifact's and its resource version
# moved; the control plane's digest and resource version are the pre-state's.
node_applied() {
  local want
  want=$(sql "SELECT encode(configuration_digest, 'hex') FROM release_machine WHERE release = '$rel' AND machine = '$machine_w'")
  [ -n "$want" ] &&
    [ "$(digest_of "$bundle/talos-config-sha256.txt" "$TALOS_WORKER_IP")" = "$want" ] &&
    [ "$(digest_of "$EV/pre-talos-config-sha256.txt" "$TALOS_WORKER_IP")" != "$want" ] &&
    differ "$(digest_of "$bundle/talos-config-version.txt" "$TALOS_WORKER_IP")" "$(digest_of "$EV/pre-talos-config-version.txt" "$TALOS_WORKER_IP")"
}
# unchanged_node <ip>: in the latest bundle the node's digest and resource version are the pre-state's.
unchanged_node() {
  local ip=$1
  [ -n "$(digest_of "$EV/pre-talos-config-sha256.txt" "$ip")" ] &&
    [ "$(digest_of "$bundle/talos-config-sha256.txt" "$ip")" = "$(digest_of "$EV/pre-talos-config-sha256.txt" "$ip")" ] &&
    [ "$(digest_of "$bundle/talos-config-version.txt" "$ip")" = "$(digest_of "$EV/pre-talos-config-version.txt" "$ip")" ]
}
# one_apply <log before> <log now>: exactly one mutating request past the log before, and it is
# ApplyConfiguration.
one_apply() {
  local methods
  [[ "$2" == "$1"* ]] || return 1
  [ "$(run_mutations "$1" "$2")" = 1 ] || return 1
  # Read whole first: grep --quiet stops at its match, and under pipefail a writer still writing
  # into the pipe would fail the check.
  methods=$(log_methods <<<"${2:${#1}}") || return 1
  grep --quiet --fixed-strings --line-regexp -- machine.MachineService/ApplyConfiguration <<<"$methods"
}
# keep <name> <path>: h-viewer's read of the path, kept in the evidence directory.
keep() {
  fresh_viewer
  answers 200 - GET "$2" "$viewer" && cp -- "$EV/last.body" "$EV/$1.json"
}

safe_apply() {
  local ref='S4 step 1' w_after cp_after
  pre_state
  check "$ref" "inject linkjoin A, B and C to the worker: the controller may dispatch S3's step 3 plan" worker_links linkjoin
  check "$ref" 'no link to the worker is recorded cut' worker_joined
  check "$ref" "the plan's operation completed within four minutes" within 240 completed
  [ -n "$op" ] || die "s4: the plan's operation did not complete; nothing after it can run"
  check "$ref" "the use-time check before the commitment passed, its access and artifact each passed" use_time_passed
  ref='S4 step 2'
  check "$ref" "the commitment names the operation and an evidence observation of the plan, read after the use-time check and before the commitment" \
    evidence_committed
  ref='S4 step 3'
  check "$ref" "one attempt, number 1, after the commitment, on the plan's route, on the commitment's observation, its response accepted after it" \
    one_attempt
  w_after=$(apid_log "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
  cp_after=$(apid_log "$TALOS_CONTROLPLANE_IP") || die "cannot read the control plane's apid log"
  check "$ref" "the worker's apid log records exactly one mutating request past the pre-state, ApplyConfiguration" \
    one_apply "$w_log" "$w_after"
  ref='S4 step 4'
  check "$ref" 'on the timeline, in order: the commitment, the attempt (committed to sending), the response, sending to verifying, verifying to completed, the Applied change' states_in_order
  check "$ref" "a completion observation begun after the response read the release's digest, and the result names it" \
    completion_after_response
  ref='S4 step 5'
  check "$ref" "Applied the release from source operation, its digest the artifact's, the baseline revision one more, one Applied change entry" \
    applied_moved
  ref='S4 pass'
  evidence_to post || die "no post-state: bin/evidence failed"
  check "$ref" 'the post-state bundle: complete, no fixture secret but the scan control' scan_clean post
  check "$ref" "the worker's digest is the artifact's and its resource version moved" node_applied
  check "$ref" "the control plane's digest and resource version are the pre-state's" unchanged_node "$TALOS_CONTROLPLANE_IP"
  no_mutation 'the control plane' "$TALOS_CONTROLPLANE_IP" "$cp_log" "$cp_after"
  check "$ref" 'Desired, Applied and Observed served as one value, the release, after completion' \
    served ".desired == \"$rel\" and .applied.release == \"$rel\" and .applied.source == \"operation\" and .observed.release == \"$rel\""
  check "$ref" "scope and rollout slot released: no live apply-config operation for the worker or the cluster" scope_released
  ref='S4 retained evidence'
  check "$ref" 'the operation, its attempt and response, as served' keep operation "/api/v1/operations/$op"
  check "$ref" "the worker's timeline, as served" keep timeline "/api/v1/machines/$machine_w/timeline?limit=500"
  check "$ref" "the worker's observation records, as served" keep observations "/api/v1/machines/$machine_w/observations?limit=500"
}

# The controls (mode controls). act0 and approval0: the last act and step 3's approval at the start,
# which the restore puts back; held: the operation the age plan commits, which holds the scope.
act0=0 approval0='' ops0=0 held='' pub_op='' age=10
worker_rev() { sql "SELECT coalesce(max(revision), 0) FROM machine_event WHERE machine = '$machine_w'"; }
# route_refused: a plan body naming the control plane's endpoint as the worker's route: 400
# invalid-request, no plan created. A plan binds its machine's own endpoint; the body has no route.
route_refused() {
  local before body
  before=$(sql "SELECT count(*) FROM plan") || return 1
  body=$(plan_body "$(jq -nc --arg r "$TALOS_CONTROLPLANE_IP:50000" '{route: $r}')") || return 1
  fresh h-publisher
  answers 400 invalid-request POST /api/v1/plans "$tok" "$body" "$(key plan-route)" || return 1
  [ "$(sql "SELECT count(*) FROM plan")" = "$before" ]
}
# cancel_step3: step 3's plan cancelled by its creator, h-publisher.
cancel_step3() {
  fresh h-publisher
  answers 200 - POST "/api/v1/plans/$plan/cancellations" "$tok" '{"reason": "S4 negative controls"}' "$(key cancel-step3)" &&
    plan_state_is "$plan" cancelled
}
# check_failed <plan> <instant>: a use-time check of the plan begun after the instant failed with its
# access provider-unavailable, none passed, and no apply-config operation exists since the start.
# By its start, not its revision: a check begun before OpenBao changed state may be recorded after.
check_failed() {
  local got
  got=$(sql "SELECT count(*) FILTER (WHERE entry->>'result' = 'failed'
      AND entry->'dependencies'->'access'->>'cause' = 'provider-unavailable')
      || ' ' || count(*) FILTER (WHERE entry->>'result' = 'passed')
    FROM machine_event WHERE machine = '$machine_w' AND kind = 'use-time-check' AND entry->>'plan' = '$1'
      AND (entry->>'started')::timestamptz > '$2'::timestamptz") || return 1
  [[ $got =~ ^[1-9][0-9]*\ 0$ ]] && nothing_since "$ops0"
}
# nothing_since <operation seq>: no apply-config operation exists since that sequence number.
nothing_since() { [ "$(sql "SELECT count(*) FROM operation WHERE seq > $1 AND kind = 'apply-config'")" = 0 ]; }
# stalls_at <step>: how many times C's log says the seam stalled it at the step.
stalls_at() { c_log | grep --count --line-regexp --fixed-strings -- "fixture interrupt: stall at $1" || true; }
# evidence_stalled <plan> <revision> <stalls before>: past the revision a use-time check of the plan
# passed and its evidence is recorded, C stalled there once more, and nothing committed.
evidence_stalled() {
  [ "$(sql "SELECT count(*) FROM machine_event WHERE machine = '$machine_w' AND kind = 'use-time-check'
    AND entry->>'plan' = '$1' AND entry->>'result' = 'passed' AND revision > $2")" -ge 1 ] &&
    obs_started "$1" && [ "$(stalls_at dispatch-evidence)" -gt "$3" ] && nothing_since "$ops0"
}
# idle <plan> <approval>: the plan approved by the approval, no operation and no refusal entry.
idle() { plan_is_stored "$1" approved "$2" && [ "$(refusals "$1")" = 0 ]; }
# committed_held <plan> <stalls before>: the plan committed to an apply-config operation that is
# still committed with no attempt, its id in held, and C stalled after the commitment once more.
committed_held() {
  held=$(sql "SELECT o.id FROM plan_state s JOIN operation o ON o.id = s.operation WHERE s.plan = '$1'
    AND s.state = 'committed' AND o.kind = 'apply-config'") || return 1
  [ -n "$held" ] && still_held && [ "$(stalls_at dispatch-committed)" -gt "$2" ]
}
# still_held: held is committed, with no attempt.
still_held() {
  [ "$(sql "SELECT o.state || ' ' || count(a.id) FROM operation o LEFT JOIN attempt a ON a.operation = o.id
    WHERE o.id = '$held' GROUP BY o.state")" = 'committed 0' ]
}
# older_logged <plan>: C's log says the plan's evidence was older than it allows, retried after a lease.
older_logged() { c_says "commitment of plan $1: evidence [a-z0-9_]+ is older than the plan allows: .*retried after"; }
# committed_on_later <plan> <stalled observation> <instant>: the commitment names another
# observation than the stalled one, whose start entry is after the instant.
committed_on_later() {
  [ "$(sql "SELECT (c.entry->>'observation') <> '$2' AND e.at > '$3'::timestamptz FROM machine_event c
    JOIN observation o ON o.id = c.entry->>'observation' AND o.machine = c.machine
    JOIN machine_event e ON e.machine = o.machine AND e.revision = o.basis
    WHERE c.machine = '$machine_w' AND c.kind = 'commitment' AND c.entry->>'plan' = '$1'")" = t ]
}
# waits <plan> <approval>: the plan approved by the approval with no operation, and no use-time
# check, commitment or refusal entry names it: the controller never takes it up.
waits() {
  plan_is_stored "$1" approved "$2" &&
    [ "$(sql "SELECT count(*) FROM machine_event WHERE machine = '$machine_w' AND entry->>'plan' = '$1'
      AND kind IN ('use-time-check', 'commitment', 'refusal')")" = 0 ]
}
# reassign <name>: the worker's assignment in the draft changed to the handover's cluster fragment
# alone, under the draft's ETag: 200.
reassign() {
  fresh h-author
  answers 200 - PUT "/api/v1/drafts/$draft/assignments/$machine_w" "$tok" \
    '{"profiles": [], "fragments": {"cluster": ["s3-handover"]}}' "$(key "assignment-$1")" "$etag" || return 1
  etag=$(etag_of_last)
  [ -n "$etag" ]
}
# publish_busy: the draft published as h-publisher under its ETag: 202, its operation in pub_op.
publish_busy() {
  fresh h-publisher
  answers 202 - POST "/api/v1/drafts/$draft/publications" "$tok" '{}' "$(key publication-busy)" "$etag" || return 1
  pub_op=$(jq -er '.id' "$EV/last.body")
}
# busy_refused: the publication failed with the problem scope-busy naming the worker as the scope
# and held as the operation, with no release; the worker's Desired is still the plan's release.
busy_refused() {
  [ "$(sql "SELECT state || ' ' || (error->>'type') || ' ' || (error->>'status') || ' ' || (error->>'scope')
      || ' ' || (error->>'operation') FROM operation WHERE id = '$pub_op'")" = \
    "failed urn:bronzeward:problem:scope-busy 409 $machine_w $held" ] &&
    [ "$(sql "SELECT count(*) FROM release WHERE operation = '$pub_op'")" = 0 ] &&
    [ "$(sql "SELECT desired FROM machine_state WHERE machine = '$machine_w'")" = "$rel" ]
}
# db_reads: the instance answers a database read again after a restore swapped the database under
# it: the worker, which every snapshot holds.
db_reads() {
  fresh h-viewer
  [ "$(call GET "/api/v1/machines/$machine_w" "$tok")" = 200 ]
}
# restored: the database is the snapshot's: no act after the controls began, step 3's plan the only
# apply-config plan, approved by its approval, unexpired for ten minutes more, and no apply-config
# operation.
restored() {
  [ "$(sql "SELECT coalesce(max(seq), 0) FROM act")" = "$act0" ] &&
    [ "$(sql "SELECT count(*) FROM plan WHERE kind = 'apply-config'")" = 1 ] &&
    [ "$(sql "SELECT expires_at > now() + interval '10 minutes' FROM plan WHERE id = '$plan'")" = t ] &&
    plan_is_stored "$plan" approved "$approval0" && nothing_since 0
}

controls() {
  local ref='S4 negative controls' pa second sa rev since n stalled released_at w_after cp_after
  approval0=$(sql "SELECT approval FROM plan_state WHERE plan = '$plan'") || die "s4: cannot read step 3's approval"
  act0=$(sql "SELECT coalesce(max(seq), 0) FROM act") || die "s4: cannot read the acts"
  ops0=$(sql "SELECT coalesce(max(seq), 0) FROM operation") || die "s4: cannot read the operations"
  # The restore keeps the plan's absolute expiry: run needs ten minutes of it after the controls,
  # whose waits can take fifteen.
  [ "$(sql "SELECT expires_at > now() + interval '25 minutes' FROM plan WHERE id = '$plan'")" = t ] ||
    die "s4: step 3's plan expires within 25 minutes; run scenarios/s3 run again on a fresh up"
  pre_state
  check "$ref" "a plan body naming the control plane's endpoint as the worker's route: 400 invalid-request, no plan created (ER §10.9: a plan binds its machine's own endpoint)" \
    route_refused
  # Step 3's plan is set aside, with every link still cut: the restore at the end puts it back.
  check "$ref" "step 3's plan cancelled by its creator, h-publisher" cancel_step3

  # C alone dispatches, told to stall once its evidence is recorded, so nothing is ever sent. C is
  # restarted first, its link still cut: a dispatch of step 3's plan begun before the cancellation
  # would otherwise reach the stall and hold C's loop. The stall is a prerequisite: without it the
  # join below would let C send.
  check "$ref" 'inject pause A and B' both pause
  check "$ref" 'inject kill C' "$bin/inject" kill C
  check "$ref" 'inject start C, its link to the worker still cut' "$bin/inject" start C
  call_port=$SERVER_C_PORT
  check "$ref" 'C answers /livez again' within 30 answers 204 - GET /livez ''
  interrupt dispatch-evidence stall || die "s4: C's stall not installed; nothing after it can run"
  result PASS "$ref" 'C told to stall once the evidence is recorded'
  check "$ref" 'inject linkjoin C worker: C alone may dispatch' "$bin/inject" linkjoin C worker
  check "$ref" 'inject seal openbao' "$bin/inject" seal openbao
  since=$(sql "SELECT clock_timestamp()") || die "s4: cannot read the database clock"
  check "$ref" "an apply-config plan of the worker's Desired as h-publisher on C, its evidence at most $age s old: 201" \
    plan_by h-publisher age "{\"maxObservationAgeSeconds\": $age}"
  pa=$plan_id
  [ -n "$pa" ] || die "s4: no age plan; nothing after it can run"
  check "$ref" 'approved as h-approver on C: 201' approve_by h-approver "$pa" age
  check "$ref" "OpenBao sealed: C's use-time check of the plan fails, recorded with its access provider-unavailable; none passes, no operation" \
    within 90 check_failed "$pa" "$since"
  sleep 16
  check "$ref" 'three heartbeats on, still sealed: no passed check, no operation' check_failed "$pa" "$since"
  check "$ref" 'inject kill openbao' "$bin/inject" kill openbao
  since=$(sql "SELECT clock_timestamp()") || die "s4: cannot read the database clock"
  check "$ref" "OpenBao stopped: a use-time check begun after the stop fails, recorded with its access provider-unavailable; none passes, no operation" \
    within 90 check_failed "$pa" "$since"
  # Read before the start: C may pass its check and stall before the start returns.
  n=$(stalls_at dispatch-evidence)
  rev=$(worker_rev) || die "s4: cannot read the worker's timeline"
  check "$ref" 'inject start openbao: started and unsealed' "$bin/inject" start openbao
  check "$ref" 'OpenBao started: the use-time check passes and the evidence is recorded; C stalls there, nothing committed' \
    within 120 evidence_stalled "$pa" "$rev" "$n"

  # The age control (ruling: stale evidence is no evidence, nothing refused; ER choice §10.28).
  stalled=$(first_observation "$pa")
  [ -n "$stalled" ] || die "s4: no stalled observation; nothing after it can run"
  check "$ref" "the stalled evidence is older than the plan binds ($age s)" within 60 observation_stale "$pa" "$((age + 3))"
  check "$ref" 'while stalled: the plan approved, no operation, no refusal entry' idle "$pa" "$approval_id"
  released_at=$(sql "SELECT clock_timestamp()") || die "s4: cannot read the database clock"
  n=$(stalls_at dispatch-committed)
  interrupt dispatch-committed stall || die "s4: C's second stall not installed; nothing after it can run"
  result PASS "$ref" 'C told to stall after the commitment instead'
  check "$ref" 'the plan committed, its operation committed with no attempt; C stalls there' within 120 committed_held "$pa" "$n"
  check "$ref" "C's log records the stalled evidence as older than the plan allows, retried after a lease" older_logged "$pa"
  check "$ref" 'the commitment names another observation than the stalled one, begun after its release' \
    committed_on_later "$pa" "$stalled" "$released_at"
  check "$ref" 'no refusal entry names the plan' same "$(refusals "$pa")" 0

  # The held scope, with A and B running again (their links stay cut).
  check "$ref" 'inject unpause A and B' both unpause
  call_port=$SERVER_A_PORT
  check "$ref" 'A answers /livez' within 30 answers 204 - GET /livez ''
  check "$ref" 'a second apply-config plan for the worker as h-publisher while the first holds the scope: 201' plan_by h-publisher second
  second=$plan_id
  [ -n "$second" ] || die "s4: no second plan; nothing after it can run"
  check "$ref" 'approved as h-approver: 201' approve_by h-approver "$second" second
  sa=$approval_id
  sleep 16
  check "$ref" 'three heartbeats on, the second plan waits: approved, no operation, no use-time check, commitment or refusal entry names it (comparison 4 refusing it is the Go check TestCommitmentRefusals)' \
    waits "$second" "$sa"
  check "$ref" 'the first operation still holds the scope: committed, no attempt' still_held
  check "$ref" 'h-author opens a draft: 201' draft_by h-author busy
  check "$ref" "h-author changes the worker's assignment in it: 200" reassign busy
  check "$ref" 'h-publisher publishes it: 202' publish_busy
  check "$ref" "the publication fails 409 scope-busy naming the worker and the holding operation, no release, the worker's Desired unchanged" \
    within 120 busy_refused
  check "$ref" 'the first operation still holds the scope: committed, no attempt' still_held
  result SKIP "$ref" 'a frozen scope refused: the freeze route is ginsys/bronzeward#27'"'"'s; the Go check TestCommitmentRefusals "frozen" covers it until then'
  result SKIP "$ref" "without the unique index both commit (DS row 011), node validation's InvalidArgument (DS row 022), the ownership check outside the attempt's UPDATE (DB row 018): the DS re-run's"

  outcome_bundle "$ref" controls
  check "$ref" "the worker's digest and resource version are the pre-state's" unchanged_node "$TALOS_WORKER_IP"
  check "$ref" "the control plane's digest and resource version are the pre-state's" unchanged_node "$TALOS_CONTROLPLANE_IP"
  w_after=$(apid_log "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
  cp_after=$(apid_log "$TALOS_CONTROLPLANE_IP") || die "cannot read the control plane's apid log"
  no_mutation 'the worker' "$TALOS_WORKER_IP" "$w_log" "$w_after"
  no_mutation 'the control plane' "$TALOS_CONTROLPLANE_IP" "$cp_log" "$cp_after"
  check 'S4 backups' 'inject db-snapshot: a dump of the bronzeward database after the controls' "$bin/inject" db-snapshot "$backup_name"

  # Back to what run starts from. C's stall is released only once the database under it is the
  # snapshot's and its link is cut again: its attempt then finds no operation and nothing is sent.
  ref='S4 controls handoff'
  check "$ref" 'inject linksplit C worker' "$bin/inject" linksplit C worker
  check "$ref" 'inject pause A, B and C' servers pause
  check "$ref" 'inject db-restore s3-step3' "$bin/inject" db-restore s3-step3
  check "$ref" 'inject bao-restore s3-step3' "$bin/inject" bao-restore s3-step3
  check "$ref" "C's control file removed" interrupt -
  check "$ref" 'inject unpause A, B and C' servers unpause
  check "$ref" 'A reads the restored database' within 60 db_reads
  check "$ref" "restored: no act after the controls began, step 3's plan the only apply-config plan, approved by its approval and unexpired for ten minutes more, no apply-config operation" \
    restored
  check "$ref" "A's, B's and C's links to the worker are cut" worker_cut
}

# The restores (mode restores). act4: the last act the first restore of S3's step-4 snapshots holds.
act4=''
# restored_step4: the database is S3's step-4 snapshot's: no apply-config plan or operation, the
# worker's Desired the S2 release, and, after the first restore, the act sequence it held.
restored_step4() {
  [ -n "$act4" ] || act4=$(sql "SELECT coalesce(max(seq), 0) FROM act") || return 1
  [ "$(sql "SELECT coalesce(max(seq), 0) FROM act")" = "$act4" ] &&
    [ "$(sql "SELECT count(*) FROM plan WHERE kind = 'apply-config'")" = 0 ] && nothing_since 0 &&
    [ "$(sql "SELECT desired FROM machine_state WHERE machine = '$machine_w'")" = "$rel" ]
}
# from_step4 <case> <stall step>: C, its link cut and A and B paused, killed; S3's step-4 snapshots
# restored; C told to stall at the step and started; then an apply-config plan of the S2 release as
# h-publisher on C, its id in plan_id. The stall is a prerequisite: nothing after it may send. The
# snapshots hold no apply-config plan, so C has nothing to dispatch before its split is back.
from_step4() {
  local ref="S4 negative controls, $1"
  check "$ref" 'inject linksplit C worker' "$bin/inject" linksplit C worker
  check "$ref" 'inject kill C' "$bin/inject" kill C
  check "$ref" 'inject db-restore s3-step4' "$bin/inject" db-restore s3-step4
  check "$ref" 'inject bao-restore s3-step4' "$bin/inject" bao-restore s3-step4
  interrupt "$2" stall || die "s4: C's stall not installed; nothing after it can run"
  result PASS "$ref" "C told to stall at $2"
  check "$ref" 'inject start C, its link to the worker cut' "$bin/inject" start C
  check "$ref" 'C answers /livez again' within 30 answers 204 - GET /livez ''
  check "$ref" 'C reads the restored database' within 60 db_reads
  check "$ref" "restored to S3's step-4 snapshots: no apply-config plan or operation, the worker's Desired the S2 release, the first restore's last act" \
    restored_step4
  ops0=$(sql "SELECT coalesce(max(seq), 0) FROM operation") || die "s4: cannot read the operations"
  check "$ref" "an apply-config plan of the S2 release as h-publisher on C: 201" plan_by h-publisher "$1"
  [ -n "$plan_id" ] || die "s4: no plan for $1; nothing after it can run"
}
# commit_refused <plan> <comparison> <cause>: one refusal entry names the plan, a commitment's (it
# names no operation), by the comparison with the cause; the plan has no operation.
commit_refused() {
  [ "$(sql "SELECT count(*) || ' ' || string_agg((entry->>'comparison') || ':' || (entry->>'cause'), ',')
    || ' ' || bool_and(NOT entry ? 'operation') FROM machine_event
    WHERE machine = '$machine_w' AND kind = 'refusal' AND entry->>'plan' = '$1'")" = "1 $2:$3 true" ] &&
    [ "$(sql "SELECT count(*) FROM operation WHERE plan = '$1'")" = 0 ]
}
# settled_cancelled <cause>: held is cancelled with no attempt; its entries, in timeline order, are
# the attempt's refusal by comparison 1 with the cause, then committed to unresolved and unresolved
# to cancelled, each with it.
settled_cancelled() {
  [ "$(sql "SELECT o.state || ' ' || count(a.id) FROM operation o LEFT JOIN attempt a ON a.operation = o.id
    WHERE o.id = '$held' GROUP BY o.state")" = 'cancelled 0' ] &&
    [ "$(sql "SELECT string_agg(CASE kind WHEN 'refusal' THEN 'refusal ' || (entry->>'comparison')
        ELSE (entry->>'from') || '>' || (entry->>'to') || ' ' || (entry->>'comparison') END || ': ' || (entry->>'cause'), ', '
        ORDER BY revision)
      FROM machine_event WHERE machine = '$machine_w' AND entry->>'operation' = '$held' AND kind IN ('refusal', 'operation-state')")" = \
      "refusal 1: $1, committed>unresolved 1: $1, unresolved>cancelled 1: $1" ]
}
# revoke_approver <name>: h-recovery revokes h-approver's identity: 201.
revoke_approver() {
  fresh h-recovery
  answers 201 - POST /api/v1/identity-revocations "$tok" \
    '{"iss":"http://issuer:5556","sub":"h-approver","reason":"S4 negative controls"}' "$(key "revoke-$1")"
}
# cancel_plan <plan> <name>: h-publisher, its creator, cancels the plan: 200.
cancel_plan() {
  fresh h-publisher
  answers 200 - POST "/api/v1/plans/$1/cancellations" "$tok" '{"reason": "S4 negative controls"}' "$(key "cancel-$2")"
}
# approve_without_role <plan>: h-approver, removed from bw-approvers at the issuer, approves under a
# fresh token without it: 403 forbidden, and the plan is still proposed.
approve_without_role() {
  local t
  t=$(mint_without h-approver bw-approvers) || return 1
  keep_secret "$t"
  answers 403 forbidden POST "/api/v1/plans/$1/approvals" "$t" '{}' "$(key approval-without-role)" &&
    plan_state_is "$1" proposed
}
# attempt_admitted <plan> <stalls before>: the plan committed, its operation sending with one
# attempt and no response, its id in held; C stalled once more after the attempt, so nothing is sent.
attempt_admitted() {
  held=$(sql "SELECT operation FROM plan_state WHERE plan = '$1' AND state = 'committed'") && [ -n "$held" ] &&
    [ "$(sql "SELECT o.state || ' ' || count(a.id) || ' ' || count(r.attempt) FROM operation o
      LEFT JOIN attempt a ON a.operation = o.id LEFT JOIN attempt_response r ON r.attempt = a.id
      WHERE o.id = '$held' GROUP BY o.state")" = 'sending 1 0' ] &&
    [ "$(stalls_at dispatch-attempted)" -gt "$2" ]
}
# untaken <plan>: no operation since ops0, and no commitment entry names the plan.
untaken() {
  nothing_since "$ops0" && [ "$(sql "SELECT count(*) FROM machine_event WHERE machine = '$machine_w'
    AND kind = 'commitment' AND entry->>'plan' = '$1'")" = 0 ]
}

restores() {
  local ref='S4 negative controls' p n rev w_after cp_after
  approval0=$(sql "SELECT approval FROM plan_state WHERE plan = '$plan'") || die "s4: cannot read step 3's approval"
  act0=$(sql "SELECT coalesce(max(seq), 0) FROM act") || die "s4: cannot read the acts"
  [ "$(sql "SELECT expires_at > now() + interval '25 minutes' FROM plan WHERE id = '$plan'")" = t ] ||
    die "s4: step 3's plan expires within 25 minutes; run scenarios/s3 run again on a fresh up"
  pre_state
  # C alone dispatches from here on; each case kills it, so a stall left by the last one ends there.
  check "$ref" 'inject pause A and B' both pause
  call_port=$SERVER_C_PORT

  # The assignment changed after planning and the approval: comparison 2.
  from_step4 assignment dispatch-attempted
  p=$plan_id
  check "$ref, assignment" 'approved as h-approver: 201' approve_by h-approver "$p" assignment
  check "$ref, assignment" 'h-author opens a draft: 201' draft_by h-author assignment
  check "$ref, assignment" "h-author changes the worker's assignment in it: 200" reassign assignment
  check "$ref, assignment" 'h-publisher publishes it: 202, one release, the worker'"'"'s Desired' publish_by h-publisher assignment
  check "$ref, assignment" 'inject linkjoin C worker' "$bin/inject" linkjoin C worker
  check "$ref, assignment" "the commitment refused by comparison 2, the machine's assignment revision changed; no operation" \
    within 90 commit_refused "$p" 2 "the machine's assignment revision changed"

  # A later release, then the approval, which does not compare Desired: comparison 2. Its control is
  # run's commitment of step 3's plan with no publication between (ER choice §10.24).
  from_step4 desired dispatch-attempted
  p=$plan_id
  check "$ref, desired" 'h-author opens a draft: 201' draft_by h-author desired
  check "$ref, desired" 'h-author drafts an unrelated change, a fragment: 200' fragment_by h-author desired desired
  check "$ref, desired" 'h-publisher publishes it as a later release: 202, one release, the worker'"'"'s Desired' publish_by h-publisher desired
  check "$ref, desired" 'then approved as h-approver: 201' approve_by h-approver "$p" desired
  check "$ref, desired" 'inject linkjoin C worker' "$bin/inject" linkjoin C worker
  check "$ref, desired" "the commitment refused by comparison 2, the machine's Desired release changed; no operation" \
    within 90 commit_refused "$p" 2 "the machine's Desired release changed"

  # Cancelled after the commitment, with no attempt: unresolved, then cancelled (ER §9.2).
  from_step4 cancelled dispatch-committed
  p=$plan_id
  check "$ref, cancelled" 'approved as h-approver: 201' approve_by h-approver "$p" cancelled
  n=$(stalls_at dispatch-committed)
  check "$ref, cancelled" 'inject linkjoin C worker' "$bin/inject" linkjoin C worker
  check "$ref, cancelled" 'the plan committed, its operation committed with no attempt; C stalls there' within 120 committed_held "$p" "$n"
  check "$ref, cancelled" 'h-publisher cancels the committed plan: 200' cancel_plan "$p" cancelled
  interrupt dispatch-attempted stall || die "s4: C's stall not moved; nothing after it can run"
  result PASS "$ref, cancelled" 'C released, told to stall after an attempt instead'
  check "$ref, cancelled" 'the attempt refused by comparison 1, the plan is cancelled; the operation committed to unresolved, then cancelled, on the timeline; no attempt' \
    within 90 settled_cancelled 'the plan is cancelled'

  result SKIP "$ref" 'a revocation started while a commitment holds the approval waits for it, and the control without the lock does not (DS row 003): the Go check TestCommitmentRevocationsWait and the DS re-run'

  # The approver's identity revoked before the commitment: comparison 1. Revoked before the
  # controller reads the plan, it is no candidate at all, so the revocation comes once the evidence is.
  # The link is joined before the approval, the stall holding the commitment: the seam is reached
  # after an observation that could not read the node too, and the evidence must be a real read.
  from_step4 identity-before dispatch-evidence
  p=$plan_id
  n=$(stalls_at dispatch-evidence)
  rev=$(worker_rev) || die "s4: cannot read the worker's timeline"
  check "$ref, identity before" 'inject linkjoin C worker' "$bin/inject" linkjoin C worker
  check "$ref, identity before" 'approved as h-approver: 201' approve_by h-approver "$p" identity-before
  check "$ref, identity before" 'the use-time check passes and the evidence is recorded; C stalls there, nothing committed' \
    within 120 evidence_stalled "$p" "$rev" "$n"
  check "$ref, identity before" "h-recovery revokes h-approver's identity: 201" revoke_approver identity-before
  interrupt dispatch-attempted stall || die "s4: C's stall not moved; nothing after it can run"
  result PASS "$ref, identity before" 'C released, told to stall after an attempt instead'
  check "$ref, identity before" "the commitment refused by comparison 1, the approver's identity is revoked; no operation" \
    within 90 commit_refused "$p" 1 "the approver's identity is revoked"

  # Revoked after the commitment, with no attempt: unresolved, its scope held, then cancelled (ER §3.3).
  from_step4 identity-after dispatch-committed
  p=$plan_id
  check "$ref, identity after" 'approved as h-approver: 201' approve_by h-approver "$p" identity-after
  n=$(stalls_at dispatch-committed)
  check "$ref, identity after" 'inject linkjoin C worker' "$bin/inject" linkjoin C worker
  check "$ref, identity after" 'the plan committed, its operation committed with no attempt; C stalls there' within 120 committed_held "$p" "$n"
  check "$ref, identity after" "h-recovery revokes h-approver's identity: 201" revoke_approver identity-after
  interrupt dispatch-attempted stall || die "s4: C's stall not moved; nothing after it can run"
  result PASS "$ref, identity after" 'C released, told to stall after an attempt instead'
  check "$ref, identity after" "the attempt refused by comparison 1, the approver's identity is revoked; the operation committed to unresolved, then cancelled, on the timeline; no attempt" \
    within 90 settled_cancelled "the approver's identity is revoked"

  # OpenBao paused holds the commitment; a role removed at the issuer afterwards does not stop it
  # (PA choice §17.23). S3's approval revocation before commitment, which refuses, is the contrast.
  from_step4 openbao dispatch-attempted
  p=$plan_id
  check "$ref, openbao" 'a second plan as h-publisher: 201' plan_by h-publisher openbao-second
  check "$ref, openbao" 'inject linkjoin C worker' "$bin/inject" linkjoin C worker
  check "$ref, openbao" 'inject pause openbao' "$bin/inject" pause openbao
  check "$ref, openbao" 'the first plan approved as h-approver: 201' approve_by h-approver "$p" openbao
  sleep 16
  check "$ref, openbao" 'three heartbeats on: no operation, no commitment entry names the plan' untaken "$p"
  check "$ref, openbao" "h-approver, removed from bw-approvers at the issuer, approves the second plan under a fresh token: 403 forbidden, still proposed" \
    approve_without_role "$plan_id"
  check "$ref, openbao" 'still no operation, no commitment entry names the plan' untaken "$p"
  n=$(stalls_at dispatch-attempted)
  check "$ref, openbao" 'inject unpause openbao' "$bin/inject" unpause openbao
  check "$ref, openbao" 'the plan commits and its attempt is admitted, no response; C stalls before sending' \
    within 120 attempt_admitted "$p" "$n"

  ref='S4 negative controls'
  outcome_bundle "$ref" restores
  check "$ref" "the worker's digest and resource version are the pre-state's" unchanged_node "$TALOS_WORKER_IP"
  check "$ref" "the control plane's digest and resource version are the pre-state's" unchanged_node "$TALOS_CONTROLPLANE_IP"
  w_after=$(apid_log "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
  cp_after=$(apid_log "$TALOS_CONTROLPLANE_IP") || die "cannot read the control plane's apid log"
  no_mutation 'the worker' "$TALOS_WORKER_IP" "$w_log" "$w_after"
  no_mutation 'the control plane' "$TALOS_CONTROLPLANE_IP" "$cp_log" "$cp_after"
  check 'S4 backups' 'inject db-snapshot: a dump of the bronzeward database after the restores' "$bin/inject" db-snapshot "$backup_name"

  # Back to what run starts from. C, stalled after its attempt, is killed with its link cut: the
  # attempt is never sent. A start puts the split back only once the instance answers, so C starts
  # on S3's step-4 snapshots, with no approved plan, and is paused while step 3's are restored under
  # it, its split kept: started on step 3's, C could dispatch its plan before the split is back.
  ref='S4 restores handoff'
  check "$ref" 'inject linksplit C worker' "$bin/inject" linksplit C worker
  check "$ref" 'inject kill C' "$bin/inject" kill C
  check "$ref" 'inject db-restore s3-step4' "$bin/inject" db-restore s3-step4
  check "$ref" 'inject bao-restore s3-step4' "$bin/inject" bao-restore s3-step4
  check "$ref" "C's control file removed" interrupt -
  check "$ref" 'inject start C, its link to the worker cut' "$bin/inject" start C
  check "$ref" 'C answers /livez again' within 30 answers 204 - GET /livez ''
  check "$ref" 'inject pause C' "$bin/inject" pause C
  check "$ref" 'inject db-restore s3-step3' "$bin/inject" db-restore s3-step3
  check "$ref" 'inject bao-restore s3-step3' "$bin/inject" bao-restore s3-step3
  check "$ref" 'inject unpause A, B and C' servers unpause
  call_port=$SERVER_A_PORT
  check "$ref" 'A reads the restored database' within 60 db_reads
  check "$ref" "restored: no act after the restores began, step 3's plan the only apply-config plan, approved by its approval and unexpired for ten minutes more, no apply-config operation" \
    restored
  check "$ref" "A's, B's and C's links to the worker are cut" worker_cut
}

backup_name=s4-$run_key
run() {
  preconditions
  withheld+=("$BW_CANARY")
  case $s4_mode in
    controls) controls ;;
    restores) restores ;;
    run)
      safe_apply
      check 'S4 backups' 'inject db-snapshot: a dump of the bronzeward database after the apply' "$bin/inject" db-snapshot "$backup_name"
      ;;
  esac
}

run
rm -f -- "$EV/last.body" "$EV/last.headers"
# The final bundle: the evidence directory and the run directory scanned, as S1's step 5 does.
ev_log=$(mktemp)
if final=$("$bin/evidence" "$EV" 2>"$ev_log"); then
  cat -- "$ev_log" >&2
  if grep --quiet --fixed-strings -- 'positive control found; 0 other file(s) contain' "$ev_log"; then
    result PASS 'S4 evidence' 'bin/evidence scanned the bundle and the run directory; no file but its control holds a fixture secret'
  else
    result FAIL 'S4 evidence' "the leak scan reports fixture secrets: $final/leak-scan.txt"
  fi
  if [ -e "$final/unavailable.txt" ]; then
    result FAIL 'S4 evidence' "the bundle is incomplete: $final/unavailable.txt names what was not captured"
  else
    result PASS 'S4 evidence' 'the bundle is complete: bin/evidence captured every source'
  fi
  # The scan above covers the dump only if the bundle holds it expanded: the attempt's (run's) or
  # the held operation's (controls' or restores') own row inside its COPY block, whose first column
  # is the ID. That row is in the dump only: the restore after it removed it from the database.
  if [ "$s4_mode" = run ]; then
    dump_table=attempt dump_row='the attempt'
    dump_id=$(sql "SELECT id FROM attempt WHERE operation = '${op:-none}'") || dump_id=
  else
    dump_table=operation dump_row='the held operation' dump_id=$held
  fi
  if [ -n "$dump_id" ] &&
    awk -v id="$dump_id" -v table="$dump_table" '
      index($0, "COPY public." table " ") == 1 { block = 1; next }
      block && /^\\\.$/ { block = 0 }
      block && index($0, id "\t") == 1 { found = 1 }
      END { exit !found }' "$final/backups/pg-$backup_name.dump.sql"; then
    result PASS 'S4 backups' "the scanned bundle holds the database dump expanded, $dump_row among its rows (control)"
  else
    result FAIL 'S4 backups' 'the scanned bundle does not hold the database dump expanded with the run'"'"'s rows: the backup went unscanned'
  fi
  # The tokens this run minted, searched in the run directory, the final bundle and every bundle the
  # run captured before it, with a control holding the last of them that must be the one file
  # listed (as s1, s2 and s3 do).
  local_ctl=$STATE/s4-token-control
  trap 'rm -f -- "$local_ctl"' EXIT
  if [ "${#secrets[@]}" -gt 0 ]; then printf 'x %s x\n' "${secrets[-1]}" >"$local_ctl"; else : >"$local_ctl"; fi
  earlier=()
  for f in "$EV"/*-bundle; do
    [ -e "$f" ] || continue
    earlier+=("$(cat -- "$f")")
  done
  hits=$(grep --recursive --files-with-matches --fixed-strings --file=<(printf '%s\n' "${secrets[@]}") -- \
    "$EV" "$final" "${earlier[@]}" "$local_ctl") || hits=
  rm -f -- "$local_ctl"
  trap - EXIT
  if [ "${#secrets[@]}" -gt 0 ] && [ "$hits" = "$local_ctl" ]; then
    result PASS 'S4 evidence' "none of the ${#secrets[@]} tokens this run minted is in any bundle of the run or the run directory (control found)"
  else
    printf 's4: files holding a token of this run: %s\n' "${hits:-none, not even the control}" >&2
    result FAIL 'S4 evidence' "the tokens this run minted: ${#secrets[@]} searched, the listing is not the control alone"
  fi
else
  cat -- "$ev_log" >&2
  result FAIL 'S4 evidence' 'bin/evidence failed'
fi
rm -f -- "$ev_log"
say "s4 $s4_mode: $failed failed; evidence in $EV, bundle ${final:-none}"
[ "$failed" -eq 0 ]
