#!/usr/bin/env bash
# Acceptance plan S2, publication, against the fixture: its negative controls, the draft-update
# ingestion matrix and the publication matrix (compilation §15). A fragment update of a new draft
# that succeeds, two that are refused, and one killed on instance C after each of compilation
# §2.3's steps 0 to 7; then a publication on C that succeeds, one the compilation refuses, and one
# killed at each of the publication's interruption points, each of a new draft into which the
# worker is imported. After each, the claim or the operation, and the draft, as the contract leaves
# them, and one evidence bundle scanned for every fixture secret: the logs, the database's data
# directory and write-ahead log, the backups, and the instances' writable layers. Each check writes PASS, FAIL or SKIP, its acceptance-plan reference and what it
# checked to s2.tsv in the evidence directory and to stdout; the directory is then scanned by
# bin/evidence. Exit 1 on any FAIL.
# Usage: scenarios/s2 run   (after scenarios/s1 run on the same fixtures/bin/up: S2's precondition)
set -euo pipefail
here=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
bin=$here/../bin
# shellcheck source-path=SCRIPTDIR source=../lib.sh
. "$here/../lib.sh"

s2_mode=${1:-}
case $s2_mode in run) ;; *) die "usage: scenarios/s2 run" ;; esac
need docker curl jq timeout id sleep date awk
need_state
# No fixture lock of its own: inject and evidence each take the one they need.
umask 077
image_id=$(cat -- "$STATE/up-image") || die "no server image is recorded in $STATE; run fixtures/bin/up"
image_own "$image_id" || die "the recorded server image is not this run's; run fixtures/bin/down, then up"
EV=$STATE/evidence/s2-$s2_mode-$(date -u +%Y%m%dT%H%M%SZ)
mkdir -p -- "$EV" "$EV/http"
scenario=s2
# shellcheck source-path=SCRIPTDIR source=common.sh
. "$here/common.sh"
run_key=$(date -u +%s%N)

cluster=''
# The marked label every update carries: one generation when its ingestion gets that far.
LABEL_MARK='doc[0]/machine/nodeLabels/tier'
# update_input <name>: a fragment document. Each holds the canary, a scan pattern, so a problem, a
# log or a row that quoted it would fail the scan.
update_input() {
  case $1 in
    marked) printf 'machine:\n  nodeLabels:\n    tier: %s\n' "$BW_CANARY" ;;
    parse) printf 'machine:\n  nodeLabels:\n    tier: %s\n  certSANs: [\n' "$BW_CANARY" ;;
    guard) printf 'machine:\n  nodeLabels:\n    tier: %s\n    copy: %s\n' "$BW_CANARY" "$BW_CANARY" ;;
    # The machine token, a reference of the worker's import base (a schema-listed secret): a
    # publication's compilation refuses the fragment that overrides it (C §6 step 7).
    override) printf 'machine:\n  token: %s\n' "$BW_CANARY" ;;
  esac
}
# fragment_body <input name> <marks JSON array>: a fragment PUT body (persistence-api §9.3) of the
# cluster layer, the document over stdin: on jq's command line it would be readable by any local
# user.
fragment_body() {
  update_input "$1" | jq -Rsc --argjson marks "$2" '{layer: "cluster", document: ., marks: $marks}'
}
# put_fragment <status> <problem code or -> <fragment name> <input name> <marks JSON array>: the
# fragment PUT to A under the draft's current ETag gets that status; its claim in tk_ing.
put_fragment() {
  local body
  tk_ing=''
  body=$(fragment_body "$4" "$5") || return 1
  answers "$1" "$2" PUT "/api/v1/drafts/$draft/fragments/$3" "$author" "$body" "$(key "fragment-$3")" "$etag" || return 1
  tk_ing=$(jq -er '.ingestion' "$EV/last.body") || {
    say "s2: the answer for $3 names no ingestion"
    return 1
  }
}
# generations_are <n>: that many generations listed under tk_ing's path.
generations_are() {
  local got
  got=$(claim_generations) || return 1
  [ "$got" = "$1" ] || {
    say "s2: $got generation(s) listed under the claim, want $1"
    return 1
  }
}
# no_record <key name>: no idempotency record under the request's key: nothing answered was kept.
no_record() { [ "$(sql "SELECT count(*) FROM idempotency_record WHERE key = '$(key "$1")'")" = 0 ]; }

# updated <fragment name>: a marked update succeeds: 200 with a new ETag, the claim released at
# generation 1 without a payload, its one generation listed.
updated() {
  put_fragment 200 - "$1" marked "$(jq -nc --arg p "$LABEL_MARK" '[$p]')" || return 1
  differ "$(etag_of_last)" "$etag" || {
    say "s2: the update of $1 did not move the draft's ETag"
    return 1
  }
  etag=$(etag_of_last)
  claim_is released 1 none && generations_are 1
}
# refused <fragment name> <input name> <marks JSON array> <rule> <paths JSON or ->: the update is
# refused 422 validation-failed naming the rule (and the paths), the claim abandoned at generation
# 1 without a payload, no generation listed, the draft's ETag unchanged.
refused() {
  local filter=".rule == \"$4\""
  [ "$5" = - ] || filter+=" and .paths == $5"
  put_fragment 422 validation-failed "$1" "$2" "$3" || return 1
  jq -e "$filter" "$EV/last.body" >/dev/null || {
    say "s2: the refusal of $1 does not name the rule $4 (and the paths $5)"
    return 1
  }
  claim_is abandoned 1 none && generations_are 0 && draft_etag_is "$etag"
}

# The kill points: compilation §2.3's steps 0 to 7, as internal/seam names them for a draft update
# (step 8, the baseline, is for imports and drift adoptions only).
kill_points='claim read parse identify substitute guard generation construct'
# generations_made <step>: how many generations an update killed at the step created: none before
# step 6, the update's one once it is done (the generation seam follows the last create).
generations_made() {
  case $1 in
    generation | construct) printf '1\n' ;;
    *) printf '0\n' ;;
  esac
}
# killed_at <step> <kills before>: C exited at the step, the claim held at generation 1 without a
# payload (a draft update's claim is transient).
killed_at() { c_killed_at "$1" "$(($2 + 1))" && claim_is held 1 none; }
# c_update <step>: the marked update of fragment kill-<step>, sent to C, which exits at the step
# before it answers: nothing answers (000). Its claim, found by the request's key, in tk_ing.
c_update() {
  local body got name=kill-$1
  tk_ing=''
  body=$(fragment_body marked "$(jq -nc --arg p "$LABEL_MARK" '[$p]')") || return 1
  call_port=$SERVER_C_PORT
  got=$(call PUT "/api/v1/drafts/$draft/fragments/$name" "$author" "$body" "$(key "fragment-$name")" "$etag")
  call_port=$SERVER_A_PORT
  transcript "$got" PUT "/api/v1/drafts/$draft/fragments/$name" "$author" "$body" "$(key "fragment-$name")" "$etag"
  [ "$got" = 000 ] || {
    say "s2: C answered the update killed at $1: $got"
    return 1
  }
  tk_ing=$(sql "SELECT id FROM staging_claim WHERE idempotency_key = '$(key "fragment-$name")'")
  [ -n "$tk_ing" ]
}
# The interrupted claims, one of them looked for in the dump at the end.
interrupted=()
# kill_case <step>: C exits at once at the step. Once the lease lapses the sweep abandons the claim
# (C §3.5); every generation created before the kill is still listed; the draft and its ETag are
# unchanged and no record was kept. The bundle is captured while C is still stopped, so its
# writable layer is what the kill left, before a startup could clean it; C is started again after.
kill_case() {
  local step=$1 kills row_ref='S2 negative controls, C §15'
  fresh_author
  kills=$(kills_at "$step")
  check "$row_ref" "C told to exit at once at $step" interrupt "$step" kill
  check "$row_ref" "marked update of the draft on C: no answer, C exits at $step" c_update "$step"
  [ -n "$tk_ing" ] || die "s2: no claim for the update killed at $step; nothing after it can run"
  check "$row_ref" "C exited at $step: the claim held at generation 1 without a payload" within 60 killed_at "$step" "$kills"
  check "$row_ref" "C's control file removed" interrupt -
  check "$row_ref" "killed at $step: the sweep abandons the claim at generation 1 without a payload once its lease lapses, not before" \
    swept_after_lapse 45
  check "$row_ref" "killed at $step: every generation created before the kill still listed under the claim, none deleted" \
    generations_are "$(generations_made "$step")"
  interrupted+=("$tk_ing")
  check "$row_ref" "killed at $step: the draft's ETag unchanged" draft_etag_is "$etag"
  check "$row_ref" "killed at $step: no idempotency record kept for the request" no_record "fragment-kill-$step"
  outcome_bundle "$row_ref" "interrupt-$step"
  check "$row_ref" 'inject start C' "$bin/inject" start C
  check "$row_ref" 'C answers /livez again' within 30 c_live
}
# c_live: instance C answers /livez.
c_live() {
  local got
  call_port=$SERVER_C_PORT
  got=$(call GET /livez '')
  call_port=$SERVER_A_PORT
  [ "$got" = 204 ]
}

# The publications (compilation §15): each publishes a new draft of its own, into which the worker
# is imported with its file content marked, so that the release covers it. Each is sent to C with A
# and B paused, so that C's publish worker is the one that claims it.
WORKER_MARK='doc[0]/machine/files/0/content'
# The worker's machine, as S1 recorded it at the worker's Talos endpoint.
machine_w=''
# h-publisher's token, minted again as the author's is.
publisher='' publisher_at=0
fresh_publisher() {
  [ -z "$publisher" ] || [ $((SECONDS - publisher_at)) -ge 180 ] || return 0
  publisher=$(mint h-publisher) || die "cannot mint a publisher token"
  keep_secret "$publisher"
  publisher_at=$SECONDS
}
# pub_draft <name>: a new draft with the worker imported into it, its id in draft and its ETag in
# etag; pub_ready 1 once both are.
pub_ready=0
pub_draft() {
  pub_ready=0
  answers 201 - POST /api/v1/drafts "$author" \
    "$(jq -nc --arg c "$cluster" --arg t "S2 publication $1" '{cluster: $c, title: $t}')" "$(key "draft-pub-$1")" || return 1
  draft=$(jq -er '.id' "$EV/last.body") || return 1
  etag=$(etag_of_last)
  [ -n "$etag" ] || return 1
  ingest "$machine_w" "$(jq -nc --arg p "$WORKER_MARK" '[$p]')" "pub-$1" || return 1
  pub_ready=1
}
# both pause|unpause: that inject action on A and on B.
both() { "$bin/inject" "$1" A && "$bin/inject" "$1" B; }
servers() { both "$1" && "$bin/inject" "$1" C; }
# publish_on_c <name> <statuses ERE>: the publication of the draft, sent to C as h-publisher under
# the draft's ETag, gets one of the statuses (000 when C exits before it answers). Its operation,
# found by the draft, in pub_op: one publish operation of the draft, and the one a 202 names.
pub_op=''
publish_on_c() {
  local got path=/api/v1/drafts/$draft/publications
  pub_op=''
  call_port=$SERVER_C_PORT
  got=$(call POST "$path" "$publisher" '{}' "$(key "publication-$1")" "$etag")
  call_port=$SERVER_A_PORT
  transcript "$got" POST "$path" "$publisher" '{}' "$(key "publication-$1")" "$etag"
  [[ $got =~ ^($2)$ ]] || {
    say "s2: the publication $1 on C: $got, want $2"
    return 1
  }
  [ "$(sql "SELECT count(*) FROM operation WHERE kind = 'publish' AND draft = '$draft'")" = 1 ] || {
    say "s2: the draft of the publication $1 has not one publish operation"
    return 1
  }
  pub_op=$(sql "SELECT id FROM operation WHERE kind = 'publish' AND draft = '$draft'")
  [ "$got" != 202 ] || [ "$(jq -r '.id' "$EV/last.body")" = "$pub_op" ]
}
# pub_is <state> <owner generation> <event types>: pub_op's stored state, owner generation and its
# events' types in order, comma-separated.
pub_is() {
  [ "$(sql "SELECT o.state || ' ' || o.owner_gen || ' ' || (SELECT string_agg(e.entry->>'type', ',' ORDER BY e.number)
    FROM operation_event e WHERE e.operation = o.id) FROM operation o WHERE o.id = '$pub_op'")" = "$1 $2 $3" ]
}
# pub_is_unreleased <state> <generation> <event types, comma-separated>: pub_is and unreleased.
pub_is_unreleased() { pub_is "$@" && unreleased; }
# pub_lease_held: pub_op still running, its lease deadline (the stopped run's) in pub_lease.
pub_lease_held() {
  pub_lease=$(sql "SELECT lease_until FROM operation WHERE id = '$pub_op' AND state = 'running'")
  [ -n "$pub_lease" ]
}
# claimed_after_lease: pub_op's second claim (event 3) committed no earlier than pub_lease, so no
# worker took the job while the stopped run's lease was live. A commit time that was not tracked
# compares as NULL and fails.
claimed_after_lease() {
  [ "$(sql "SELECT pg_xact_commit_timestamp(xmin) >= '$pub_lease'::timestamptz FROM operation_event
    WHERE operation = '$pub_op' AND number = 3 AND entry->>'type' = 'claimed'")" = t ]
}
# released_once: one release names pub_op, and the draft is published as that release.
released_once() {
  [ "$(sql "SELECT count(*) FROM release WHERE operation = '$pub_op'")" = 1 ] &&
    [ "$(sql "SELECT d.state FROM draft d JOIN release r ON r.id = d.release AND r.operation = '$pub_op'
      WHERE d.id = '$draft'")" = published ]
}
# unreleased: no release names pub_op, and the draft is still open.
unreleased() {
  [ "$(sql "SELECT count(*) FROM release WHERE operation = '$pub_op'")" = 0 ] &&
    [ "$(sql "SELECT state FROM draft WHERE id = '$draft'")" = open ]
}
# pub_override: the override fragment put into the draft and selected by the worker's assignment,
# at the cluster layer (a fragment reaches a machine only through its assignment); the draft's new
# ETag in etag.
pub_override() {
  put_fragment 200 - override override '[]' || return 1
  etag=$(etag_of_last)
  [ -n "$etag" ] || return 1
  answers 200 - PUT "/api/v1/drafts/$draft/assignments/$machine_w" "$author" \
    '{"profiles": [], "fragments": {"cluster": ["override"]}}' "$(key assignment-override)" "$etag" || return 1
  etag=$(etag_of_last)
  [ -n "$etag" ]
}
# pub_case_start <name>: tokens fresh, the case's draft ready, or the run ends: nothing after it
# can run.
pub_case_start() {
  fresh_author
  fresh_publisher
  check 'S2 negative controls, C §15' "publication $1: a new draft with the worker imported, its file content marked" pub_draft "$1"
  [ "$pub_ready" = 1 ] || die "s2: no draft for the publication $1; nothing after it can run"
}
# The interruption points of a publication, as internal/seam names them: after the claim, the
# snapshot read, the pins read, every machine compiled, the artifacts encrypted, and every
# statement of the publication commit made before its COMMIT.
pub_points='publish-claim publish-snapshot publish-pins publish-compile publish-encrypt publish-commit'
# pub_kill_case <point>: C exits at once at the point while it runs the publication. Until the
# lease lapses the operation stays running at owner generation 1 with nothing published; the bundle
# is captured while C is still stopped and A and B still paused, so its writable layer is what the
# kill left, plaintexts held in memory included, and no takeover can commit during the capture
# (the state is read again after it); then A and B resume, C is started again, and once the lease
# lapses the job is claimed at generation 2 and succeeds, with one release.
pub_kill_case() {
  local p=$1 kills row_ref='S2 negative controls, C §15'
  pub_case_start "kill-$p"
  kills=$(kills_at "$p")
  check "$row_ref" "C told to exit at once at $p" interrupt "$p" kill
  check "$row_ref" 'inject pause A and B' both pause
  check "$row_ref" "publication on C: 202, or no answer when C exits first" publish_on_c "kill-$p" '202|000'
  [ -n "$pub_op" ] || die "s2: no operation for the publication killed at $p; nothing after it can run"
  check "$row_ref" "C exited at $p" within 60 c_killed_at "$p" "$((kills + 1))"
  check "$row_ref" "C's control file removed" interrupt -
  check "$row_ref" "killed at $p: the operation running at generation 1 after its claim, no other event" pub_is running 1 queued,claimed
  check "$row_ref" "killed at $p: no release names the operation, the draft still open" unreleased
  check "$row_ref" "killed at $p: the stopped run's lease deadline read" pub_lease_held
  outcome_bundle "$row_ref" "publication-$p"
  check "$row_ref" "killed at $p: after the capture, still running at generation 1 and unreleased" \
    pub_is_unreleased running 1 queued,claimed
  check "$row_ref" 'inject unpause A and B' both unpause
  check "$row_ref" 'inject start C' "$bin/inject" start C
  check "$row_ref" 'C answers /livez again' within 30 c_live
  check "$row_ref" "killed at $p: once the lease lapses, claimed again at generation 2 and succeeded" \
    within 90 pub_is succeeded 2 queued,claimed,claimed,succeeded
  check "$row_ref" "killed at $p: the second claim committed only after the stopped run's lease lapsed" claimed_after_lease
  check "$row_ref" "killed at $p: one release names the operation, the draft published as it" released_once
}

# The negative controls no fixture request reaches (a race at a lock, an injected change, a
# provider classification, a lost reply after COMMIT), proven by the Go tests that prove them, so
# that S2's evidence holds their results. Anchored, as in S1.
go_tests='TestFragmentPutPreconditions|TestDraftUpdatePreconditions'
go_tests+='|TestPublishCommitChangedHeadMoved|TestPublishCommitUnchangedHeadMoved|TestPublishCommitUnchangedHeadMovedConcurrently'
go_tests+='|TestCompileRefusesAnExactCopy|TestRefusalSweep|TestFidelityFailsOnAnInjectedChange'
go_tests+='|TestClassify|TestReadPinnedRefuses|TestPublishCommitStatusRecordedAfter'
go_tests+='|TestReplay|TestPublicationRequest|TestKeyReusedForAnotherRequest|TestProfileUpdate'
go_tests+='|TestPublishCommitRetry|TestPublishCommitExistingRelease'
go_tests+='|TestPublishClaim|TestPublishRunLapsed|TestPublishCommitFenced|TestReleaseImmutableTables'
# go-db's PostgreSQL, the caller's BW_TEST_PG_DSN when set.
go_db_dsn=${BW_TEST_PG_DSN:-postgres://bronzeward@127.0.0.1:55433/bronzeward?sslmode=disable}
# go_rows_ran: those tests, in the clone, against go-db's PostgreSQL (mise run dev-db by default),
# as go-db runs them: a missing database fails, it does not skip. None of them reads OpenBao: the
# provider is a stand-in in each. The DSN reaches the tests through the environment (isolated_run's
# descriptor), never a command line. Passes when go test exited 0 with no test skipped.
go_rows_ran() {
  (
    # shellcheck disable=SC2030 # each run exports the DSN in its own subshell
    export BW_TEST_PG_DSN="$go_db_dsn"
    logged go-rows env BW_REQUIRE_PG=1 mise exec -- go test -count=1 -v -run "^($go_tests)\$" \
      ./internal/api ./internal/classify ./internal/compile ./internal/ingest ./internal/migrate
  ) && ! grep --quiet -- '--- SKIP' "$EV/go-rows.log"
}
# go_row <test>: the test's own top-level PASS line is in go-rows.log.
go_row() { grep --quiet -- "^--- PASS: $1 (" "$EV/go-rows.log"; }
# bao_rows_ran: TestLiveProviderStates (dependency monitor §10.1 items 2 and 3), in the clone,
# against this fixture's OpenBao and go-db's PostgreSQL: each provider object state classified
# through the monitor's metadata client, under test-unique copies of the fixture's committed
# policies (baotest), on objects and keys of its own. The address and the root token reach the
# test through the environment (isolated_run's descriptor), never a command line. Passes when go
# test exited 0 with no test skipped: BW_REQUIRE_BAO=1 turns a missing OpenBao into a failure.
bao_rows_ran() {
  (
    # shellcheck disable=SC2031 # each run exports the DSN in its own subshell
    export BW_TEST_PG_DSN="$go_db_dsn"
    export BW_TEST_BAO_ADDR="http://127.0.0.1:$OPENBAO_PORT" BW_TEST_BAO_TOKEN="$BW_BAO_ROOT_TOKEN"
    logged go-bao-rows env BW_REQUIRE_PG=1 BW_REQUIRE_BAO=1 mise exec -- go test -count=1 -v \
      -run '^TestLiveProviderStates$' ./internal/monitor
  ) && ! grep --quiet -- '--- SKIP' "$EV/go-bao-rows.log"
}
# bao_row <subtest>: TestLiveProviderStates/<subtest>'s own PASS line is in go-bao-rows.log, the
# name as go test prints it (spaces as underscores), compared as text.
bao_row() {
  awk -v p="    --- PASS: TestLiveProviderStates/$1 (" 'index($0, p) == 1 { found = 1 } END { exit !found }' \
    "$EV/go-bao-rows.log"
}
# go_rows: the rows, in a clone of the image commit, removed again once they have run.
go_rows() {
  local ref='S2 negative controls'
  if clone_made go-rows-clone; then
    check 'S2 precondition' "GOFLAGS, GOEXPERIMENT and GOWORK are unset and the Go version is the image's, so the tests run on the server's build (clone HEAD $clone_head)" go_env_clean
    check 'S2 Go tests' 'the tests below ran against PostgreSQL and passed, none skipped (go-rows.log)' go_rows_ran
    check "$ref" 'a second author on a replaced ETag: 412, nothing written, for a fragment (TestFragmentPutPreconditions)' go_row TestFragmentPutPreconditions
    check "$ref" 'the same for a profile: 428 without If-Match, 412 on a replaced ETag, nothing written (TestDraftUpdatePreconditions)' go_row TestDraftUpdatePreconditions
    check "$ref" 'a head the draft changes moved since its base: 409 stale-input naming it (TestPublishCommitChangedHeadMoved)' go_row TestPublishCommitChangedHeadMoved
    check "$ref" 'a head the release uses unchanged moved since the snapshot: 409 stale-input (TestPublishCommitUnchangedHeadMoved)' go_row TestPublishCommitUnchangedHeadMoved
    check "$ref" "FOR SHARE (DB row 011): the commit waits on another publication's move of an unchanged head, then finds it, 409 (TestPublishCommitUnchangedHeadMovedConcurrently; without the lock it does not wait and commits)" \
      go_row TestPublishCommitUnchangedHeadMovedConcurrently
    check "$ref" 'the compiler refuses a literal copy of a resolved value of six bytes or more, its stored or placed form, by path only (TestCompileRefusesAnExactCopy)' \
      go_row TestCompileRefusesAnExactCopy
    check "$ref" "ingestion refuses the reserved text !bwref, every refusal rule naming its rule and quoting no value (TestRefusalSweep)" go_row TestRefusalSweep
    check "$ref" 'the fidelity check fails on an injected change (TestFidelityFailsOnAnInjectedChange)' go_row TestFidelityFailsOnAnInjectedChange
    check "$ref" 'a KV version soft-deleted classified blocked, destroyed lost, the provider unreachable unknown (TestClassify)' go_row TestClassify
    check "$ref" 'a pinned version not retained refuses the publication 422 naming it; one the provider cannot reach, 503 (TestReadPinnedRefuses)' \
      go_row TestReadPinnedRefuses
    check "$ref" 'a status recorded other than retained after the publication began refuses its commit (TestPublishCommitStatusRecordedAfter)' go_row TestPublishCommitStatusRecordedAfter
    check "$ref" 'a repeated request under one key replays the first answer (TestReplay)' go_row TestReplay
    check "$ref" 'a repeated publication request under one key replays its 202 (TestPublicationRequest)' go_row TestPublicationRequest
    check "$ref" 'the key reused for another body: 422 idempotency-key-reused (TestKeyReusedForAnotherRequest)' go_row TestKeyReusedForAnotherRequest
    check "$ref" 'the same on a profile update (TestProfileUpdate)' go_row TestProfileUpdate
    check "$ref" "a worker's reply lost after COMMIT: the retry meets its own release and writes nothing (TestPublishCommitRetry)" go_row TestPublishCommitRetry
    check "$ref" 'a second operation of the published draft revision ends with the existing release, not a second (TestPublishCommitExistingRelease)' go_row TestPublishCommitExistingRelease
    check "$ref" 'a running publish job whose lease lapsed is claimed at the next generation; a live lease is not (TestPublishClaim)' go_row TestPublishClaim
    check "$ref" 'a run whose lease lapsed writes nothing: no release, no failure (TestPublishRunLapsed)' go_row TestPublishRunLapsed
    check "$ref" 'a worker whose ownership was superseded writes nothing on commit (TestPublishCommitFenced)' go_row TestPublishCommitFenced
    check 'S2 pass' 'every release table refuses UPDATE and DELETE (TestReleaseImmutableTables)' go_row TestReleaseImmutableTables
    check 'S2 Go tests' "TestLiveProviderStates ran against this fixture's OpenBao and PostgreSQL and passed, none skipped (go-bao-rows.log)" \
      bao_rows_ran
    ref='S2 negative controls (DM §10.1 items 2 and 3)'
    check "$ref" 'a KV version, first retained, soft-deleted: blocked; undeleted: retained; destroyed: lost; alerts blocked then lost, no other' \
      bao_row 'KV_soft-deleted,_undeleted,_destroyed'
    check "$ref" 'a KV version pruned past max_versions: lost, one lost alert' bao_row KV_pruned_past_max_versions
    check "$ref" "a retained version's KV metadata deleted: unknown (absent), regression on that pass and not on the next" \
      bao_row KV_metadata_deleted_after_retained
    check "$ref" 'the same 404 on a dependency never retained: no alert until 15 minutes unknown, then persistent (control)' \
      bao_row KV_metadata_deleted_without_the_seed
    check "$ref" 'a Transit version below the decryption floor: unknown naming it; the floor lowered: retained; trimmed: unknown naming it; one regression each' \
      bao_row 'Transit_below_the_decryption_floor,_lowered,_then_trimmed'
    check "$ref" 'a Transit key deleted: unknown (absent), regression on that pass and not on the next' bao_row Transit_key_deleted
  else
    result FAIL 'S2 Go tests' 'no clone of the image commit (go-rows-clone.log): the Go tests did not run'
  fi
  rm -rf -- "$clone_dir"
}

# The machinery gate (compilation §10.1, the S2 precondition): SR's and SP's matrices re-run with
# composition through the compiler's own path, by experiments/c10-machinery-gate/run/all against
# this fixture. Its output holds the bases' synthetic secrets, so it goes to a directory outside the
# checkout (mktemp -d, under TMPDIR; run/all refuses one inside), only its result tables and
# run/all's own output are kept, in c10/ and c10-gate.log, each once it scans clean against the
# run's leak-refusal patterns (the final bundle's scan knows only the fixture's), and the directory
# is removed. It runs with the Go settings and version the image was built with, and on this
# checkout, not a clone, since it reads this fixture's state, so the checkout is held to the image
# commit with no path differing and none git is told to skip (checkout_differs, as S0's
# same_checkout), before the gate and after it; run.txt's own git status count does not see
# skipped paths. Each of the seven tables must be there and not empty, as run/collect-evidence
# requires. An interruption removes the directory too; a removal that fails fails the row and
# names the directory. c10_ran runs in a subshell, so the traps that remove it on an interruption
# are its own and replace none of the scenario's.
c10_clean() {
  [ -n "$c10_tmp" ] || return 0
  rm -rf -- "$c10_tmp"
  if [ -e "$c10_tmp" ]; then
    printf 'output directory not removed, holds synthetic fixture secrets: %s\n' "$c10_tmp" >>"$EV/c10-gate.log"
    return 1
  fi
  c10_tmp=''
}
c10_ran() (
  local f rc=0 gate=0
  c10_image_checkout || {
    printf 'not run: the checkout is not the image commit with no path differing\n' >"$EV/c10-gate.log"
    return 1
  }
  c10_go_env || {
    printf "not run: GOFLAGS, GOEXPERIMENT or GOWORK is set, or the Go version is not the image's\n" >"$EV/c10-gate.log"
    return 1
  }
  c10_tmp=$(mktemp -d) || return 1
  trap 'c10_clean' EXIT
  trap 'c10_clean; exit 130' INT TERM
  C10_OUT=$c10_tmp/out "$FIXTURES/../experiments/c10-machinery-gate/run/all" >"$c10_tmp/stdout.log" 2>&1 || gate=$?
  ran c10-gate "$gate" experiments/c10-machinery-gate/run/all
  [ "$gate" -eq 0 ] || rc=1
  # Nothing is kept that does not scan clean against the run's own leak-refusal patterns, as
  # run/collect-evidence's (the gate's synthetic base secrets, every SP value form, BWSYNTH): the
  # fixture's final scan knows none of them. The go test log is not kept.
  : >"$EV/c10-gate.log"
  if c10_patterns "$c10_tmp/out"; then
    c10_keep "$c10_tmp/out" "$c10_tmp/stdout.log" "$EV/c10-gate.log" ||
      { printf 'run/all output withheld: it holds a leak-refusal pattern, or could not be scanned\n' >"$EV/c10-gate.log"; rc=1; }
    mkdir -p -- "$EV/c10"
    for f in run.txt summary.txt controls.tsv matrix.tsv sp-summary.txt sp-controls.tsv sp-matrix.tsv; do
      [ -s "$c10_tmp/out/$f" ] || { printf '%s missing or empty\n' "$f" >>"$EV/c10-gate.log"; rc=1; continue; }
      c10_keep "$c10_tmp/out" "$c10_tmp/out/$f" "$EV/c10/$f" ||
        { printf '%s withheld: it holds a leak-refusal pattern, or could not be scanned\n' "$f" >>"$EV/c10-gate.log"; rc=1; }
    done
  else
    printf 'run/all output withheld: the run recorded no leak-refusal patterns to scan it against\n' >"$EV/c10-gate.log"
    rc=1
  fi
  printf 'exit %d\n' "$gate" >>"$EV/c10-gate.log"
  c10_clean || rc=1
  [ "$rc" -eq 0 ]
)
# c10_patterns <out>: the run recorded its leak-refusal patterns in <out>, as many as
# run/collect-evidence requires.
c10_patterns() {
  [ -f "$1/patterns.txt" ] && [ "$(wc -l <"$1/patterns.txt")" -ge 10 ] &&
    [ -f "$1/sp-patterns.txt" ] && [ "$(wc -l <"$1/sp-patterns.txt")" -ge 28 ]
}
# c10_keep <out> <file> <copy>: the file copied only when none of <out>'s patterns, nor BWSYNTH,
# is in it; a match or a failed scan copies nothing.
c10_keep() {
  local rc=0
  grep -qF -e BWSYNTH -f "$1/patterns.txt" -f "$1/sp-patterns.txt" -- "$2" || rc=$?
  [ "$rc" -eq 1 ] && cp -- "$2" "$3"
}
# c10_go_env: the Go settings the gate compiles with, read in this checkout as run/all's go reads
# them: GOFLAGS, GOEXPERIMENT and GOWORK unset, and the version the image was built with (a
# GOTOOLCHAIN switch shows as another version), as go_env_clean holds the Go rows' clone.
c10_go_env() {
  local out v
  out=$(go -C "$FIXTURES/.." env GOFLAGS GOEXPERIMENT GOWORK GOVERSION) || return 1
  mapfile -t v <<<"$out"
  [ "${#v[@]}" -eq 4 ] && [ -z "${v[0]}${v[1]}${v[2]}" ] && [ -n "${v[3]}" ] &&
    [ "${v[3]}" = "$(sed -n 's/^go //p' "$STATE/up-build")" ]
}
# c10_image_checkout: this checkout is the commit up-build records for the image, no path
# differing, and every tracked file's bytes HEAD's.
c10_image_checkout() {
  local n raw
  n=$(checkout_differs) || return 1
  raw=$(c10_raw_differs) || return 1
  [ "$(fixtures_git rev-parse HEAD)" = "$(sed -n 's/^commit //p' "$STATE/up-build")" ] && [ "$n" -eq 0 ] && [ "$raw" -eq 0 ]
}
# c10_raw_differs: how many of HEAD's regular files have other bytes on disk, hashed with no
# filter: a clean filter (or another content attribute) has git status compare its output, so a
# modified file whose filtered copy is the commit's is clean to git status and to checkout_differs.
# Symbolic links and submodules are left to checkout_differs (core.symlinks=true shows a type
# change). A path git cannot hash, or one holding a newline, fails the count.
c10_raw_differs() {
  local top tree rec meta path mode oid paths=() want=() got=() i n=0
  top=$(fixtures_git rev-parse --show-toplevel) || return 1
  tree=$(mktemp) || return 1
  fixtures_git ls-tree -r -z --full-tree HEAD >"$tree" || { rm -f -- "$tree"; return 1; }
  while IFS= read -r -d '' rec; do
    meta=${rec%%$'\t'*} path=${rec#*$'\t'}
    read -r mode _ oid <<<"$meta"
    case $mode in 100644 | 100755) ;; *) continue ;; esac
    case $path in *$'\n'*) paths=() && break ;; esac
    paths+=("$top/$path") want+=("$oid")
  done <"$tree"
  rm -f -- "$tree"
  [ "${#paths[@]}" -gt 0 ] && [ "${#paths[@]}" -eq "${#want[@]}" ] || return 1
  mapfile -t got < <(printf '%s\n' "${paths[@]}" | fixtures_git hash-object --no-filters --stdin-paths)
  [ "${#got[@]}" -eq "${#want[@]}" ] || return 1
  for i in "${!want[@]}"; do [ "${got[$i]}" = "${want[$i]}" ] || n=$((n + 1)); done
  printf '%d\n' "$n"
}
# c10_at_image: the gate's run.txt names the image commit with no input uncommitted, and the
# checkout is still that commit with no path differing.
c10_at_image() {
  local commit
  commit=$(sed -n 's/^commit //p' "$STATE/up-build") && [ -n "$commit" ] || return 1
  awk -F'\t' -v c="$commit" '$1 == "commit" { m = ($2 == c) } $1 == "uncommitted-inputs" { u = $2 }
    END { exit !(m && u == "0") }' "$EV/c10/run.txt" && c10_image_checkout
}
# c10_matrix <summary>: the matrix has rows, and none is unexpected.
c10_matrix() {
  awk -F'\t' '$1 == "rows" { r = $2 } $1 == "unexpected" { u = $2 } END { exit !(r > 0 && u == "0") }' "$EV/c10/$1"
}
# c10_controls <controls>: every control on both bases held (pass, or an identical round trip).
c10_controls() {
  awk -F'\t' '{ n++; b[$2] = 1 } $4 != "pass" && $4 != "identical" { bad = 1 }
    END { exit !(n > 0 && !bad && ("fixture" in b) && ("generated" in b)) }' "$EV/c10/$1"
}
c10_rows() {
  local ref='S2 precondition, C §10.1'
  check "$ref" 'the machinery gate, run/all against this fixture, exited 0 (c10-gate.log)' c10_ran
  check "$ref" 'it ran at the image commit with no uncommitted input (c10/run.txt), the checkout that commit with no path differing or skipped, every tracked file unfiltered the same bytes' c10_at_image
  check "$ref" "SR's matrix through the compiler's path: every case on both bases as expected (c10/summary.txt)" c10_matrix summary.txt
  check "$ref" "SR's controls: the compiler's round trip and validation of each base (c10/controls.tsv)" c10_controls controls.tsv
  check "$ref" "SP's matrix through the compiler's path: every case as expected, no value or base secret in any cell (c10/sp-summary.txt)" \
    c10_matrix sp-summary.txt
  check "$ref" "SP's controls: paired-diff moves and rotations, the oracle finds a planted value (c10/sp-controls.tsv)" c10_controls sp-controls.tsv
}

# S2 steps 1 to 7 (acceptance plan S2), after the matrices, on an Applied state seeded here:
# the scenario's precondition is S3's handover (ginsys/bronzeward#25), which has not landed, so the
# worker's Applied is set by SQL to the release last published for it, as an adoption would record
# it (owner decision, 2026-10-03). The step-1 draft imports nothing: its import base is that
# Applied release's.
S2_LABEL=bw-s2
applied='' ref_name='' ref_version='' frv='' prv='' arv='' s2_release='' robot='' robot_id=''
# seed_applied: the worker's Applied set to its Desired release, source adoption and baseline
# revision 1, with the baseline's digest as an adoption records it (execution and recovery §6.3,
# choice §10.15): the configuration digest of the release's import base revision, computed when
# the worker's configuration was read from the node, not the recompiled artifact's, which a
# re-encoding renderer may change. The release id in applied.
seed_applied() {
  applied=$(sql "SELECT desired FROM machine_state WHERE machine = '$machine_w'") || return 1
  [ -n "$applied" ] || return 1
  sql "UPDATE machine_state SET applied_release = desired, applied_source = 'adoption', baseline_revision = 1,
    applied_digest = (SELECT b.configuration_digest FROM release_machine rm
      JOIN import_base_revision b ON b.id = rm.import_base_revision AND b.machine = rm.machine
      WHERE rm.release = '$applied' AND rm.machine = '$machine_w')
    WHERE machine = '$machine_w'" >/dev/null || return 1
  [ "$(sql "SELECT count(*) FROM machine_state s JOIN release_machine rm ON rm.release = s.applied_release AND rm.machine = s.machine
    JOIN import_base_revision b ON b.id = rm.import_base_revision AND b.machine = rm.machine
    WHERE s.machine = '$machine_w' AND s.applied_release = '$applied' AND s.applied_digest = b.configuration_digest")" = 1 ]
}
# applied_is_node: the digest seeded as Applied's is the worker's machine configuration as the
# pre-state capture read it from the node (bin/evidence: SHA-256 with trailing newlines made one,
# as the configuration digest), so the seed describes the node S2 starts from.
applied_is_node() {
  local seeded pre
  seeded=$(sql "SELECT encode(applied_digest, 'hex') FROM machine_state WHERE machine = '$machine_w'") || return 1
  pre=$(awk -v n="$TALOS_WORKER_IP" '$2 == n { print $1 }' "$EV/pre-talos-config-sha256.txt")
  [ -n "$seeded" ] && [ "$seeded" = "$pre" ] || {
    say "s2: seeded Applied digest ${seeded:-none}, the worker's pre-state ${pre:-none}"
    return 1
  }
}
# applied_reference: the reference the Applied release's review records at the worker's marked file
# content (WORKER_MARK, extracted when the worker was imported), its name and version in ref_name
# and ref_version.
applied_reference() {
  answers 200 - GET "/api/v1/releases/$applied/machines/$machine_w/review" "$1" || return 1
  ref_name=$(jq -er --arg p "$WORKER_MARK" '[.provenance[] | select(.source.path == $p)] | if length == 1 then .[0].reference else error("not one") end' "$EV/last.body") &&
    ref_version=$(jq -er --arg p "$WORKER_MARK" '.provenance[] | select(.source.path == $p) | .version' "$EV/last.body")
}
# label_body: the worker fragment of step 1: one node label whose value is a !bwref to that
# reference, declared at its kind and version; no value of its own, so no mark.
label_body() {
  printf 'machine:\n  nodeLabels:\n    %s: !bwref %s\n' "$S2_LABEL" "$ref_name" |
    jq -Rsc --arg n "$ref_name" --argjson v "$ref_version" \
      '{layer: "role", document: ., marks: [], declarations: {references: {($n): {kind: "string", version: $v}}}}'
}
# s2_draft <token> <key name>: POST /drafts; the id in draft, the ETag in etag.
s2_draft() {
  answers 201 - POST /api/v1/drafts "$1" "$(jq -nc --arg c "$cluster" --arg t "S2 $2" '{cluster: $c, title: $t}')" "$(key "$2")" || return 1
  draft=$(jq -er '.id' "$EV/last.body") || return 1
  etag=$(etag_of_last)
  [ -n "$etag" ]
}
# s2_put <token> <key name> <path under the draft> <body>: a 200 under the draft's ETag that moves
# it; the entry's revision in s2_rev, the new ETag in etag.
s2_rev=''
s2_put() {
  answers 200 - PUT "/api/v1/drafts/$draft$3" "$1" "$4" "$(key "$2")" "$etag" || return 1
  s2_rev=$(jq -er '.entry.revision' "$EV/last.body") || return 1
  differ "$(etag_of_last)" "$etag" || return 1
  etag=$(etag_of_last)
}
# s2_edit <token> <key prefix>: steps 1 and 2 as that identity: the draft, the worker fragment, the
# profile listing its revision, the worker's assignment selecting the profile; the revisions in
# frv, prv, arv.
s2_edit() {
  s2_draft "$1" "$2-draft" &&
    s2_put "$1" "$2-fragment" /fragments/s2-labels "$(label_body)" && frv=$s2_rev &&
    s2_put "$1" "$2-profile" /profiles/workers "$(jq -nc --arg f "$frv" '{fragments: [$f]}')" && prv=$s2_rev &&
    s2_put "$1" "$2-assignment" "/assignments/$machine_w" '{"profiles": ["workers"], "fragments": {}}' && arv=$s2_rev
}
# stale_put <path> <body> <key name> <count query>: a second author's PUT under the ETag the first
# author's PUT replaced: 412, the revisions the query counts not added to, the draft's ETag
# unchanged. The second author is the automation identity, which holds author.
stale_put() {
  local before old=$s2_prior_etag
  before=$(stale_counts "$4") || return 1
  answers 412 precondition-failed PUT "/api/v1/drafts/$draft$1" "$robot" "$2" "$(key "stale-$3")" "$old" || return 1
  [ "$(stale_counts "$4")" = "$before" ] && draft_etag_is "$etag"
}
# stale_counts <count query>: what a refused update must not add to: the query's revisions, acts,
# idempotency records (a refusal is not replayed) and staging claims.
stale_counts() {
  sql "SELECT ($1), (SELECT count(*) FROM act), (SELECT count(*) FROM idempotency_record),
    (SELECT count(*) FROM staging_claim)"
}
s2_prior_etag=''
# s2_publish <token> <key name>: the draft published on A: 202, the operation (pub_op) succeeded
# with one release, its id in s2_release.
s2_publish() {
  answers 202 - POST "/api/v1/drafts/$draft/publications" "$1" '{}' "$(key "$2")" "$etag" || return 1
  pub_op=$(jq -er '.id' "$EV/last.body") || return 1
  within 60 pub_is succeeded 1 queued,claimed,succeeded || return 1
  released_once || return 1
  s2_release=$(sql "SELECT id FROM release WHERE operation = '$pub_op'")
  [ -n "$s2_release" ]
}
# desired_is_release: the worker's Desired is s2_release; its Applied is still the seeded release.
desired_is_release() {
  [ "$(sql "SELECT desired || ' ' || applied_release FROM machine_state WHERE machine = '$machine_w'")" = "$s2_release $applied" ]
}
# only_publish_since <operation seq>: no operation but publish created after that sequence number
# (no plan exists before ginsys/bronzeward#25: an apply-config or adopt operation is how one would
# show).
only_publish_since() { [ "$(sql "SELECT count(*) FROM operation WHERE seq > $1 AND kind <> 'publish'")" = 0 ]; }
# review_redacted: step 4's review of the worker: the label present with its value redacted as the
# reference at its declared version, the provenance of that reference and version naming the
# fragment revision at exactly doc[N]/machine/nodeLabels/<label>. The label's line is then looked
# for in document N of the configuration and compared whole (a quoted scalar either way), its
# parent line by indentation nodeLabels: and that one's machine:, so the marker under another key,
# in another document, under another label ending in the name, or at another version, does not
# match.
review_redacted() {
  answers 200 - GET "/api/v1/releases/$s2_release/machines/$machine_w/review" "$author" || return 1
  jq -e --arg l "$S2_LABEL" --arg n "$ref_name" --argjson v "$ref_version" --arg f "$frv" '
    def ind: capture("^(?<s> *)").s | length;
    def trim: sub("^ +"; "");
    def parent($ls; $i): ($ls[$i] | ind) as $k
      | [range($i - 1; -1; -1) | select(($ls[.] | test("^ *$") | not) and ($ls[.] | ind) < $k)] | first;
    "<redacted:\($n)@\($v)>" as $m
    | [.provenance[] | select(.reference == $n and .version == $v and .source.revision == $f
        and .output == "doc[\(.output | capture("^doc\\[(?<d>[0-9]+)\\]").d)]/machine/nodeLabels/\($l)")] as $p
    | if ($p | length) != 1 then false else
        ($p[0].output | capture("^doc\\[(?<d>[0-9]+)\\]").d | tonumber) as $d
        | (.configuration | split("\n---\n") | .[$d] // "" | split("\n")) as $ls
        | [range(0; $ls | length) as $i
           | select($ls[$i] | trim | IN("\($l): \($m)", "\($l): '"'"'\($m)'"'"'", "\($l): \"\($m)\""))
           | parent($ls; $i) as $a | select($a != null and ($ls[$a] | trim) == "nodeLabels:")
           | parent($ls; $a) as $b | select($b != null and $ls[$b] == "machine:")]
        | length == 1
      end' "$EV/last.body" >/dev/null
}
# machinery_pin: the machinery module's version (go.mod) and its go.sum checksum at the commit
# up-build records for the image, tab-separated.
machinery_pin() {
  local commit v
  commit=$(sed -n 's/^commit //p' "$STATE/up-build") && [ -n "$commit" ] || return 1
  v=$(fixtures_git show "$commit:go.mod" | awk '$1 == "github.com/siderolabs/talos/pkg/machinery" { print $2 }') &&
    [ -n "$v" ] || return 1
  fixtures_git show "$commit:go.sum" |
    awk -v v="$v" '$1 == "github.com/siderolabs/talos/pkg/machinery" && $2 == v { printf "%s\t%s\n", v, $3 }'
}
# release_sources: step 5's release names step 2's fragment, profile and assignment revisions, and
# its renderer record is exactly the pinned one: the fixture Talos version's contract minor, the
# image's machinery version and go.sum checksum, and the fixture's Kubernetes version.
release_sources() {
  local contract=${TALOS_VERSION%.*} mv ms
  IFS=$'\t' read -r mv ms < <(machinery_pin) && [ -n "$ms" ] || return 1
  answers 200 - GET "/api/v1/releases/$s2_release" "$author" || return 1
  jq -e --arg f "$frv" --arg p "$prv" --arg a "$arv" --arg c "$contract" --arg mv "$mv" --arg ms "$ms" \
    --arg k "v$KUBERNETES_VERSION" '
    ([.sources[] | select(.kind == "fragment" and .revision == $f)] | length == 1)
    and ([.sources[] | select(.kind == "profile" and .revision == $p)] | length == 1)
    and ([.sources[] | select(.kind == "assignment" and .revision == $a)] | length == 1)
    and .renderer == {contract: $c, machineryVersion: $mv, machineryChecksum: $ms, kubernetesVersion: $k}' \
    "$EV/last.body" >/dev/null
}
# release_stored: the worker's artifact is Transit ciphertext with its digests; its dependency
# records name exact versions, the label's reference among them from the fragment revision with
# its effective record (the same object, version and creation, for the release and the worker),
# and still from the release's import base revision at the worker's marked file content
# (WORKER_MARK), the occurrence the reference was taken from; an encryption dependency on the
# artifact key; every one classified retained.
release_stored() {
  [ "$(sql "SELECT count(*) FROM release_machine WHERE release = '$s2_release' AND machine = '$machine_w'
    AND ciphertext LIKE 'vault:v%' AND length(configuration_digest) = 32 AND length(ciphertext_digest) = 32")" = 1 ] &&
    [ "$(sql "SELECT count(*) FROM dependency WHERE release = '$s2_release' AND machine = '$machine_w' AND kind = 'reproduction'
      AND reference = '$ref_name' AND source_revision = '$frv' AND version = $ref_version")" = 1 ] &&
    [ "$(sql "SELECT count(*) FROM dependency d JOIN release_machine rm ON rm.release = d.release AND rm.machine = d.machine
      WHERE d.release = '$s2_release' AND d.machine = '$machine_w' AND d.kind = 'reproduction' AND d.reference = '$ref_name'
      AND d.version = $ref_version AND d.source_revision = rm.import_base_revision AND d.path = '$WORKER_MARK'")" = 1 ] &&
    [ "$(sql "SELECT count(*) FROM dependency e JOIN dependency r ON r.release = e.release AND r.machine = e.machine
      AND r.reference = e.reference AND r.provider = e.provider AND r.object = e.object AND r.version = e.version
      AND r.created = e.created
      WHERE e.release = '$s2_release' AND e.machine = '$machine_w' AND e.kind = 'effective' AND r.kind = 'reproduction'
      AND e.reference = '$ref_name' AND e.version = $ref_version AND r.source_revision = '$frv'")" = 1 ] &&
    [ "$(sql "SELECT count(*) FROM dependency WHERE release = '$s2_release' AND kind = 'encryption'")" -ge 1 ] &&
    [ "$(sql "SELECT count(*) FROM dependency d JOIN dependency_status s USING (provider, object, version, created)
      WHERE d.release = '$s2_release' AND s.class <> 'retained'")" = 0 ]
}
# artifact_digests: the worker's stored digests are those of its stored bytes: the ciphertext
# digest is SHA-256 of the stored ciphertext text, and the configuration digest is the artifact's,
# as the OpenBao administrator decrypts it outside Bronzeward with the artifact key the row names
# (execution-recovery §1: trailing newlines made one, as s1's baseline check). The plaintext stays
# in the pipe.
artifact_digests() {
  local row ct cfg ok key got
  row=$(sql "SELECT ciphertext || ' ' || encode(configuration_digest, 'hex') || ' ' ||
    (ciphertext_digest = sha256(convert_to(ciphertext, 'UTF8')))::text || ' ' || key_name
    FROM release_machine WHERE release = '$s2_release' AND machine = '$machine_w'") || return 1
  read -r ct cfg ok key <<<"$row"
  [ "$ok" = true ] && [ "$key" = bw-artifact ] && [ -n "$cfg" ] || {
    say "s2: the stored ciphertext digest matches its ciphertext: ${ok:-no row}; key ${key:-none}"
    return 1
  }
  got=$(printf '%s\n' "$(bao write -field=plaintext "transit/decrypt/$key" ciphertext="$ct" | base64 -d)" |
    sha256sum | cut -d' ' -f1) || return 1
  [ "$got" = "$cfg" ] || { say "s2: decrypted artifact digest $got, stored configuration digest $cfg"; return 1; }
}
# immutable <table> <column>: an UPDATE and a DELETE of the release's rows in the table are refused
# and leave them as they were.
immutable() {
  local before
  before=$(sql "SELECT md5(string_agg(t::text, ',' ORDER BY t::text)) FROM $1 t WHERE release = '$s2_release'") || return 1
  [ -n "$before" ] || return 1
  if sql "UPDATE $1 SET $2 = $2 WHERE release = '$s2_release'" >/dev/null 2>&1; then return 1; fi
  if sql "DELETE FROM $1 WHERE release = '$s2_release'" >/dev/null 2>&1; then return 1; fi
  [ "$(sql "SELECT md5(string_agg(t::text, ',' ORDER BY t::text)) FROM $1 t WHERE release = '$s2_release'")" = "$before" ]
}
# release_immutable: the same for the release row itself, keyed by id.
release_immutable() {
  local before
  before=$(sql "SELECT md5(r::text) FROM release r WHERE id = '$s2_release'") || return 1
  if sql "UPDATE release SET draft_revision = draft_revision WHERE id = '$s2_release'" >/dev/null 2>&1; then return 1; fi
  if sql "DELETE FROM release WHERE id = '$s2_release'" >/dev/null 2>&1; then return 1; fi
  [ "$(sql "SELECT md5(r::text) FROM release r WHERE id = '$s2_release'")" = "$before" ]
}
# The last act recorded when the snapshots were taken.
act_seq=''
# robot_acts: the automation identity's acts since the snapshots: author acts of steps 1 and 2,
# then one publisher act, the publication (persistence-api §10.3, §10.5).
robot_acts() {
  [ "$(sql "SELECT string_agg(role || ' ' || action, ',' ORDER BY seq) FROM act WHERE principal = '$robot_id' AND seq > $act_seq")" = \
    'author draft.create,author draft.fragment.update,author draft.profile.update,author draft.assignment.update,publisher draft.publish' ]
}
# restored: the database is the snapshot's: no act after it, step 3's release absent, the worker's
# Desired and Applied the seeded release.
restored() {
  [ "$(sql "SELECT coalesce(max(seq), 0) FROM act")" = "$act_seq" ] &&
    [ "$(sql "SELECT count(*) FROM release WHERE id = '$s2_release'")" = 0 ] &&
    [ "$(sql "SELECT desired || ' ' || applied_release FROM machine_state WHERE machine = '$machine_w'")" = "$applied $applied" ]
}
# db_reads: A answers a database read again (after a restore swapped the database under it): the
# seeded Applied release, which the snapshot holds. The token is minted again if old: a restore
# can outlast its life.
db_reads() {
  fresh_author
  [ "$(call GET "/api/v1/releases/$applied" "$author")" = 200 ]
}
# same_versions: both nodes' machine-configuration resource versions read before and after, and
# equal.
same_versions() {
  cmp --quiet -- "$EV/pre-talos-config-version.txt" "$EV/post-talos-config-version.txt" &&
    counted 2 '^[0-9]+ ' "$EV/post-talos-config-version.txt"
}

# Step 6 and its negative controls: the dependency monitors of A, B and C, each passing every 60
# seconds (dependency monitor §6.1), classify every recorded dependency against the fixture's
# OpenBao; then the label reference's KV version is soft-deleted, destroyed, and OpenBao partitioned,
# sealed and paused in turn. Each state is read once every dependency has been observed since it
# was set (observed_from after the injection), with the alerts recorded since just before it, as
# DM §6.2 sets them and no other. Step 7's bao-restore puts the version back.
dep_p='' dep_obj='' dep_ver='' s6_t0='' s6_a0=''
# s6_pinned: the one dependency status s2_release's reproduction records of the label reference
# name (the fragment's and the import base's are one KV version); its id, object and version in
# dep_p, dep_obj and dep_ver.
s6_pinned() {
  local rows
  rows=$(sql "SELECT DISTINCT s.id || ' ' || s.object || ' ' || s.version FROM dependency d
    JOIN dependency_status s USING (provider, object, version, created)
    WHERE d.release = '$s2_release' AND d.kind = 'reproduction' AND d.reference = '$ref_name' AND d.provider = 'kv'")
  [ -n "$rows" ] && [ "$(wc -l <<<"$rows")" = 1 ] || return 1
  read -r dep_p dep_obj dep_ver <<<"$rows"
  [ "$dep_ver" = "$ref_version" ]
}
# s6_inject <inject args...>: the last alert's sequence in s6_a0, then the injection, then the
# database's time in s6_t0: the phase's alerts follow s6_a0, its observations postdate s6_t0.
s6_inject() {
  s6_a0=$(sql "SELECT coalesce(max(seq), 0) FROM dependency_alert") && [ -n "$s6_a0" ] &&
    "$bin/inject" "$@" &&
    s6_t0=$(sql "SELECT statement_timestamp()") && [ -n "$s6_t0" ]
}
# s6_classes <class> <reason> <others' class> <others' reason>: every dependency status observed
# since s6_t0, dep_p's of that class and reason, each other one's of the others' (- for none), and
# at least one other.
s6_classes() {
  [ "$(sql "SELECT count(*) FILTER (WHERE observed_from <= '$s6_t0' OR NOT CASE WHEN id = '$dep_p'
      THEN class = '$1' AND coalesce(reason, '-') = '$2' ELSE class = '$3' AND coalesce(reason, '-') = '$4' END)
      || ' ' || (count(*) FILTER (WHERE id <> '$dep_p') > 0) FROM dependency_status")" = '0 true' ]
}
# s6_alerts: the alerts recorded since s6_a0 as kind:dependency:reason, in recording order.
s6_alerts() {
  sql "SELECT coalesce(string_agg(kind || ':' || coalesce(dependency, '-') || ':' || coalesce(reason, '-'), ',' ORDER BY seq), '')
    FROM dependency_alert WHERE seq > $s6_a0"
}
# s6_alerted <alerts...>: s6_alerts is one of the lists given, each alert naming s2_release; says
# what it got otherwise.
s6_alerted() {
  local got want
  got=$(s6_alerts) || return 1
  [ "$(sql "SELECT count(*) FROM dependency_alert WHERE seq > $s6_a0 AND NOT '$s2_release' = ANY (releases)")" = 0 ] || {
    say "s2: an alert since $s6_a0 does not name $s2_release"
    return 1
  }
  for want in "$@"; do [ "$got" != "$want" ] || return 0; done
  say "s2: alerts since $s6_a0: '$got', want one of: $*"
  return 1
}
# s6_regressions <reason>: one regression of that reason for each dependency but dep_p, and no other
# alert: dep_p, lost, raises none on becoming unknown (§6.2).
s6_regressions() {
  local want
  want=$(sql "SELECT coalesce(string_agg('regression:' || id || ':$1', ',' ORDER BY id), '') FROM dependency_status
    WHERE id <> '$dep_p'") || return 1
  [ "$(sql "SELECT coalesce(string_agg(kind || ':' || coalesce(dependency, '-') || ':' || coalesce(reason, '-'), ','
    ORDER BY dependency), '') FROM dependency_alert WHERE seq > $s6_a0")" = "$want" ] || {
    say "s2: alerts since $s6_a0: '$(s6_alerts)', want $want"
    return 1
  }
}
# s6_served <jq filter>: GET /dependencies as h-author, one page, satisfies the filter.
s6_served() {
  fresh_author
  answers_with "(.next == null) and ($1)" 200 - GET '/api/v1/dependencies?limit=500' "$author"
}
# s6_pinned_served <class> <reason> <alert kind>: GET /dependencies/{dep_p} serves that class and
# reason, not stale, and its alerts route ends with an alert of that kind and reason naming
# s2_release.
s6_pinned_served() {
  fresh_author
  answers_with ".class == \"$1\" and .reason == \"$2\" and .stale == false and .object == \"$dep_obj\" and .version == $dep_ver" \
    200 - GET "/api/v1/dependencies/$dep_p" "$author" &&
    answers_with "(.items | last | .kind == \"$3\" and .reason == \"$2\" and (.releases | index(\"$s2_release\") != null))" \
      200 - GET "/api/v1/dependencies/$dep_p/alerts?limit=500" "$author"
}
# s6_refused <key name> <status> <problem code> <jq filter on the dependency>: a new draft, changing
# nothing, published as h-publisher: 202, then the operation failed with that problem, naming a
# dependency the filter accepts, and nothing released.
s6_refused() {
  fresh_author
  fresh_publisher
  s2_draft "$author" "$1-draft" || return 1
  answers 202 - POST "/api/v1/drafts/$draft/publications" "$publisher" '{}' "$(key "$1")" "$etag" || return 1
  pub_op=$(jq -er '.id' "$EV/last.body") || return 1
  within 150 pub_is failed 1 queued,claimed,failed || return 1
  unreleased || return 1
  answers_with ".state == \"failed\" and .error.status == $2 and .error.type == \"urn:bronzeward:problem:$3\" and (.error.dependency | $4)" \
    200 - GET "/api/v1/operations/$pub_op" "$author"
}
# s6_outage <split> <join> <reason> <key name>: OpenBao made unreachable by inject <split> openbao,
# then reachable again by <join> openbao, with the checks of each.
s6_outage() {
  local ref='S2 negative controls (step 6)'
  check "$ref" "inject $1 openbao" s6_inject "$1" openbao
  check "$ref" "$1: every dependency observed since unknown ($3)" within 300 s6_classes unknown "$3" unknown "$3"
  check "$ref" "$1: one regression for each dependency but the lost one, naming the release, and no other alert" s6_regressions "$3"
  check "$ref" "$1: GET /dependencies serves every one unknown" s6_served '[.items[] | select(.class != "unknown")] == []'
  check "$ref" "$1: a publication pinning the version refused 503 dependency-unavailable, nothing released" \
    s6_refused "$4" 503 dependency-unavailable '.provider == "kv" or .provider == "transit"'
  check "$ref" "inject $2 openbao" s6_inject "$2" openbao
  check "$ref" "$2: the version lost again, every other dependency retained" within 300 s6_classes lost destroyed retained -
  check "$ref" "$2: one lost alert for the version on its new entry into lost, and no other" s6_alerted "lost:$dep_p:destroyed"
}

s2_steps() {
  local ref seq snap=s2-step1-$run_key
  robot=$(cat -- "$STATE/automation-token") || die "no automation token in $STATE"
  redact_automation_token "$robot"
  robot_id=$(sed -n 's/^identity \(idn_[a-z2-7]*\):.*/\1/p' "$STATE/automation-identity")
  [ -n "$robot_id" ] || die "s2: no automation identity in $STATE"
  fresh_author
  fresh_publisher
  ref='S2 precondition (seeded, Q2)'
  check "$ref" "seed: the worker's Applied set by SQL to its Desired release, source adoption, the configuration digest of its import base as read from the node (an adoption's record)" seed_applied
  [ -n "$applied" ] || die "s2: no Applied seeded; nothing after it can run"
  check "$ref" "the Applied release's review names one reference at the worker's marked file content" applied_reference "$author"
  [ -n "$ref_name" ] || die "s2: no reference to carry; nothing after it can run"
  evidence_to pre || die "no pre-state: bin/evidence failed"
  check "$ref" 'the pre-state bundle: complete, no fixture secret but the scan control' scan_clean pre
  cp -- "$bundle/talos-config-version.txt" "$EV/pre-talos-config-version.txt"
  cp -- "$bundle/talos-config-sha256.txt" "$EV/pre-talos-config-sha256.txt"
  check "$ref" "pre-state: the worker has a machine-configuration resource version" \
    counted 1 "^[0-9]+ $TALOS_WORKER_IP\$" "$EV/pre-talos-config-version.txt"
  check "$ref" "the seeded Applied digest is the worker's configuration as the pre-state read it from the node" applied_is_node
  seq=$(sql "SELECT coalesce(max(seq), 0) FROM operation") || die "s2: cannot read the operations"
  act_seq=$(sql "SELECT coalesce(max(seq), 0) FROM act") || die "s2: cannot read the acts"
  check 'S2 step 7' 'inject db-snapshot s2-step1' "$bin/inject" db-snapshot "$snap"
  check 'S2 step 7' 'inject bao-snapshot s2-step1' "$bin/inject" bao-snapshot "$snap"
  # The capture and the snapshots can outlast a token's life: each token is minted again before
  # its next use (fresh_* re-mint one three minutes old).
  fresh_author

  # Steps 1 and 2, each mutation under the draft's current ETag; a second author on a replaced ETag
  # gets 412 for the fragment, the profile and the assignment.
  check 'S2 step 1' 'POST /drafts as h-author: 201 with an ETag' s2_draft "$author" step1-draft
  s2_prior_etag=$etag
  check 'S2 step 1' "PUT a worker fragment, one node label a !bwref to the worker's extracted file content: 200, ETag moved" \
    s2_put "$author" step1-fragment /fragments/s2-labels "$(label_body)"
  frv=$s2_rev
  check 'S2 negative controls' 'a second author on the replaced ETag, of the fragment: 412, nothing written, ETag unchanged' \
    stale_put /fragments/s2-labels "$(label_body)" fragment "SELECT count(*) FROM fragment_revision WHERE name = 's2-labels'"
  s2_prior_etag=$etag
  check 'S2 step 2' 'PUT a worker profile listing the fragment revision: 200, ETag moved' \
    s2_put "$author" step1-profile /profiles/workers "$(jq -nc --arg f "$frv" '{fragments: [$f]}')"
  prv=$s2_rev
  check 'S2 negative controls' 'a second author on the replaced ETag, of the profile: 412, nothing written, ETag unchanged' \
    stale_put /profiles/workers "$(jq -nc --arg f "$frv" '{fragments: [$f]}')" profile "SELECT count(*) FROM profile_revision WHERE name = 'workers'"
  s2_prior_etag=$etag
  check 'S2 step 2' "PUT the worker's assignment selecting the profile: 200, ETag moved" \
    s2_put "$author" step1-assignment "/assignments/$machine_w" '{"profiles": ["workers"], "fragments": {}}'
  arv=$s2_rev
  check 'S2 negative controls' 'a second author on the replaced ETag, of the assignment: 412, nothing written, ETag unchanged' \
    stale_put "/assignments/$machine_w" '{"profiles": ["workers"], "fragments": {}}' assignment \
    "SELECT count(*) FROM assignment_revision WHERE machine = '$machine_w'"
  [ -n "$frv" ] && [ -n "$prv" ] && [ -n "$arv" ] || die "s2: steps 1 and 2 left no revisions; nothing after them can run"

  # Step 3, on A, the workers of A, B and C all running.
  fresh_publisher
  check 'S2 step 3' 'POST /publications as h-publisher: 202; the publish operation succeeded with one release, the draft published' \
    s2_publish "$publisher" step3-publication
  [ -n "$s2_release" ] || die "s2: step 3 published no release; nothing after it can run"
  check 'S2 pass' "the release is the worker's Desired; Applied still the seeded release" desired_is_release
  check 'S2 pass' 'no plan and no operation but publish since the seed' only_publish_since "$seq"

  # Step 4.
  fresh_author
  check 'S2 step 4' "GET the worker's review: the label present, its value redacted as the reference, provenance naming the fragment revision" \
    review_redacted

  # Step 5.
  check 'S2 step 5' "GET the release: step 2's fragment, profile and assignment revisions, the renderer at the node's contract minor" release_sources
  check 'S2 step 5' 'stored: Transit ciphertext and digests; exact-version dependency records, the label reference from the fragment revision and, kept, from the import base at its mark; all retained' \
    release_stored
  check 'S2 step 5' "stored digests: the ciphertext's is its stored text's, the configuration's is the decrypted artifact's" artifact_digests
  check 'S2 pass' 'the release row refuses UPDATE and DELETE' release_immutable
  check 'S2 pass' "the release's machine rows refuse UPDATE and DELETE" immutable release_machine mode
  check 'S2 pass' "the release's source rows refuse UPDATE and DELETE" immutable release_source head_revision
  check 'S2 pass' "the release's dependency records refuse UPDATE and DELETE" immutable dependency kind
  check 'S2 pass' 'no plan and no operation but publish since the seed (after step 5)' only_publish_since "$seq"
  evidence_to post || die "no post-state: bin/evidence failed"
  cp -- "$bundle/talos-config-version.txt" "$EV/post-talos-config-version.txt"
  check 'S2 pass' "the worker's machine-configuration resource version unchanged by publication" same_versions
  check 'S2 step 5' 'the post-state bundle: no fixture secret but the scan control' scan_clean post

  # Step 6, then its negative controls on the label reference's KV version.
  check 'S2 step 6' "the label reference's KV version: one dependency status for the release's reproduction records" s6_pinned
  [ -n "$dep_p" ] || die "s2: no dependency status for the label reference; step 6 cannot run"
  s6_t0=$(sql "SELECT published_at FROM release WHERE id = '$s2_release'") || die "s2: cannot read the release"
  check 'S2 step 6' 'the monitors classify every dependency retained, each observed since the release' \
    within 180 s6_classes retained - retained -
  check 'S2 step 6' 'GET /dependencies serves every one retained, none stale' \
    s6_served '[.items[] | select(.class != "retained" or .stale)] == [] and .lastPass != null'
  ref='S2 negative controls (step 6)'
  check "$ref" 'inject bao-soft-delete of the version' s6_inject bao-soft-delete "$dep_obj" "$dep_ver"
  check "$ref" 'soft-deleted: the version blocked (soft-deleted), every other dependency retained' \
    within 180 s6_classes blocked soft-deleted retained -
  # A pass in the deletion's own second cannot order it (§3, deletion-time-undecidable): unknown,
  # which raises its regression, before the next pass's blocked.
  check "$ref" 'soft-deleted: one blocked alert for the version, naming the release, after at most a regression of an undecidable deletion time; no other' \
    s6_alerted "blocked:$dep_p:soft-deleted" "regression:$dep_p:deletion-time-undecidable,blocked:$dep_p:soft-deleted"
  check "$ref" 'soft-deleted: GET /dependencies/{id} serves it blocked; its alerts route the blocked alert' \
    s6_pinned_served blocked soft-deleted blocked
  check "$ref" 'soft-deleted: a publication pinning the version refused 422, naming it blocked, nothing released' \
    s6_refused step6-blocked 422 validation-failed \
    ".provider == \"kv\" and .object == \"$dep_obj\" and .version == $dep_ver and .reference == \"$ref_name\" and .class == \"blocked\""
  check "$ref" 'inject bao-destroy of the version' s6_inject bao-destroy "$dep_obj" "$dep_ver"
  check "$ref" 'destroyed: the version lost (destroyed), every other dependency retained' \
    within 180 s6_classes lost destroyed retained -
  check "$ref" 'destroyed: one lost alert for the version, naming the release, and no other' s6_alerted "lost:$dep_p:destroyed"
  check "$ref" 'destroyed: GET /dependencies/{id} serves it lost; its alerts route the lost alert' \
    s6_pinned_served lost destroyed lost
  check "$ref" 'destroyed: a publication pinning the version refused 422, naming it lost, nothing released' \
    s6_refused step6-lost 422 validation-failed \
    ".provider == \"kv\" and .object == \"$dep_obj\" and .version == $dep_ver and .reference == \"$ref_name\" and .class == \"lost\""
  # Partitioned, sealed, paused: no connection, a 503, no answer within the request timeout.
  s6_outage netsplit netjoin unreachable step6-netsplit
  s6_outage seal unseal unavailable step6-seal
  s6_outage pause unpause unreachable step6-pause

  # Step 7: from the snapshots taken before step 1, the automation identity repeats steps 1 to 3.
  # The servers are paused across the database swap and keep running: db-restore ends their
  # sessions and renames in one transaction, and a pool reconnecting in between makes the rename
  # fail. Unpaused, they reconnect to the restored database.
  check 'S2 step 7' 'inject pause A, B and C' servers pause
  check 'S2 step 7' 'inject db-restore s2-step1' "$bin/inject" db-restore "$snap"
  check 'S2 step 7' 'inject unpause A, B and C' servers unpause
  check 'S2 step 7' 'inject bao-restore s2-step1' "$bin/inject" bao-restore "$snap"
  check 'S2 step 7' 'A reads the restored database' within 60 db_reads
  check 'S2 step 7' "restored: no act after the snapshot, step 3's release gone, the worker's Desired and Applied the seeded release" \
    restored
  check 'S2 step 7' 'the automation identity repeats steps 1 and 2 as itself' s2_edit "$robot" step7
  check 'S2 step 7' 'the automation identity publishes: one release, the draft published' s2_publish "$robot" step7-publication
  check 'S2 step 7' "the automation identity's acts: steps 1 and 2 under author, the publication under publisher" robot_acts
  check 'S2 step 7' 'no plan and no operation but publish since the seed' only_publish_since "$seq"
  outcome_bundle 'S2 step 7' step7
}

# The database dump taken after every success, refusal and interruption, for the final bundle to
# expand and scan (C §15: backups).
backup_name=s2-$run_key

run() {
  # Preconditions: S1's run on this fixture, its cluster recorded, every instance answering.
  cluster=$(sql "SELECT id FROM cluster WHERE name = 'bw-fixture'") || die "s2: cannot read the cluster"
  [ -n "$cluster" ] || die "s2: no cluster bw-fixture: run scenarios/s1 run first"
  interrupt - || die "cannot remove C's control file"
  check 'S2 precondition' 'A answers /livez' answers 204 - GET /livez ''
  check 'S2 precondition' 'C (the interruption build, no interruption named) answers /livez' c_live
  # The machinery gate first (acceptance plan S2's precondition): no release is made and no
  # evidence captured on a compiler it has not accepted.
  local gate_failed=$failed
  c10_rows
  [ "$failed" -eq "$gate_failed" ] || die "s2: the machinery gate did not pass; S2 does not run on a compiler it has not accepted"
  withheld+=("$BW_CANARY")
  fresh_author
  check 'S2 step 1' 'POST /drafts as h-author: 201 with an ETag' \
    answers 201 - POST /api/v1/drafts "$author" "$(jq -nc --arg c "$cluster" '{cluster: $c, title: "S2 draft updates"}')" "$(key draft)"
  draft=$(jq -er '.id' "$EV/last.body" 2>/dev/null) || die "s2: the draft has no id; nothing after it can run"
  etag=$(etag_of_last)
  [ -n "$etag" ] || die "s2: the draft has no ETag; nothing after it can run"

  # Success and refusal (C §13), one bundle each.
  check 'S2 negative controls, C §15' 'a marked update: 200, ETag moved, the claim released, its one generation listed' updated marked
  outcome_bundle 'S2 negative controls, C §15' success
  check 'S2 negative controls, C §15' 'an unparseable update: 422 parse, the claim abandoned, no generation, ETag unchanged' \
    refused parse parse '[]' parse -
  outcome_bundle 'S2 negative controls, C §15' refusal-parse
  check 'S2 negative controls, C §15' 'the marked value also an unmarked label: 422 guard-value naming the label, the claim abandoned, no generation, ETag unchanged' \
    refused guard guard "$(jq -nc --arg p "$LABEL_MARK" '[$p]')" guard-value '["doc[0]/machine/nodeLabels/copy"]'
  outcome_bundle 'S2 negative controls, C §15' refusal-guard

  # The interruption matrix on C.
  local step
  for step in $kill_points; do kill_case "$step"; done
  check 'S2 negative controls, C §15' 'control: after the matrix, a marked update still succeeds' updated after-kills

  # The publications on C (C §15): one that succeeds, one the compilation refuses, then one killed
  # at each interruption point; a bundle after each.
  local ref='S2 negative controls, C §15' p
  machine_w=$(sql "SELECT id FROM machine WHERE cluster = '$cluster' AND talos_endpoint::text = '$TALOS_WORKER_IP:50000'") ||
    die "s2: cannot read the worker's machine"
  [ -n "$machine_w" ] && [ "$(wc -l <<<"$machine_w")" = 1 ] || die "s2: not one machine at the worker's endpoint: run scenarios/s1 run first"
  pub_case_start success
  check "$ref" 'inject pause A and B' both pause
  check "$ref" 'publication on C: 202' publish_on_c success 202
  check "$ref" 'publication on C: claimed at generation 1 and succeeded' within 60 pub_is succeeded 1 queued,claimed,succeeded
  check "$ref" 'publication on C: one release names the operation, the draft published as it' released_once
  check "$ref" 'inject unpause A and B' both unpause
  outcome_bundle "$ref" publication-success
  pub_case_start refusal
  check "$ref" "a cluster fragment overriding the worker's machine token, selected by its assignment: 200 each" pub_override
  check "$ref" 'inject pause A and B' both pause
  check "$ref" 'refused publication on C: 202' publish_on_c refusal 202
  check "$ref" 'refused publication on C: claimed at generation 1 and failed' within 60 pub_is failed 1 queued,claimed,failed
  check "$ref" 'inject unpause A and B' both unpause
  check "$ref" 'refused publication on C: its problem names the rule base-override and the worker' \
    answers_with ".error.rule == \"base-override\" and .error.machine == \"$machine_w\"" 200 - GET "/api/v1/operations/$pub_op" "$author"
  check "$ref" 'refused publication on C: no release names the operation, the draft still open' unreleased
  outcome_bundle "$ref" publication-refusal
  for p in $pub_points; do pub_kill_case "$p"; done

  # S2 steps 1 to 7, on the Applied state seeded from the last release.
  s2_steps
  go_rows
  check 'S2 backups, C §15' 'inject db-snapshot: a dump of the bronzeward database after the updates, refusals and interruptions' \
    "$bin/inject" db-snapshot "$backup_name"
}

"$s2_mode"
rm -f -- "$EV/last.body" "$EV/last.headers"
# The final bundle: the evidence directory and the run directory scanned, as S1's step 5 does.
ev_log=$(mktemp)
if final=$("$bin/evidence" "$EV" 2>"$ev_log"); then
  cat -- "$ev_log" >&2
  if grep --quiet --fixed-strings -- 'positive control found; 0 other file(s) contain' "$ev_log"; then
    result PASS 'S2 negative controls, C §15' 'bin/evidence scanned the bundle and the run directory; no file but its control holds a fixture secret, the canary included'
  else
    result FAIL 'S2 negative controls, C §15' "the leak scan reports fixture secrets: $final/leak-scan.txt"
  fi
  if [ -e "$final/unavailable.txt" ]; then
    result FAIL 'S2 negative controls, C §15' "the bundle is incomplete: $final/unavailable.txt names what was not captured"
  else
    result PASS 'S2 negative controls, C §15' 'the bundle is complete: bin/evidence captured every source'
  fi
  # The scan above covers the dump only if the bundle holds it expanded, with the database's rows
  # in it: an interrupted claim's own row inside the staging_claim COPY block.
  if [ "${#interrupted[@]}" -gt 0 ] &&
    awk -v id="${interrupted[0]}" '
      /^COPY public\.staging_claim / { block = 1; next }
      block && /^\\\.$/ { block = 0 }
      block && index($0, id "\t") == 1 { found = 1 }
      END { exit !found }' "$final/backups/pg-$backup_name.dump.sql"; then
    result PASS 'S2 backups, C §15' 'the scanned bundle holds the database dump expanded, an interrupted draft update'"'"'s claim among its rows (control)'
  else
    result FAIL 'S2 backups, C §15' 'the scanned bundle does not hold the database dump expanded with the run'"'"'s rows: the backup went unscanned'
  fi
  # The tokens this run minted, searched in the run directory, the final bundle and every bundle the
  # run captured before it, with a control holding the last of them that must be the one file
  # listed (as s1 does).
  local_ctl=$STATE/s2-token-control
  trap 'rm -f -- "$local_ctl"' EXIT
  # An empty array has no [-1], with or without a default: the FAIL below must stay reachable.
  if [ "${#secrets[@]}" -gt 0 ]; then printf 'x %s x\n' "${secrets[-1]}" >"$local_ctl"; else : >"$local_ctl"; fi
  earlier=()
  for f in "$EV"/*-bundle; do
    [ -e "$f" ] || continue
    earlier+=("$(cat -- "$f")")
  done
  hits=$(grep --recursive --files-with-matches --fixed-strings --file=<(printf '%s\n' "${secrets[@]}") -- \
    "$EV" "$final" "${earlier[@]}" "$local_ctl") || hits=
  rm -f -- "$local_ctl"
  trap - EXIT
  if [ "${#secrets[@]}" -gt 0 ] && [ "$hits" = "$local_ctl" ]; then
    result PASS 'S2 negative controls, C §15' "none of the ${#secrets[@]} tokens this run minted is in any bundle of the run or the run directory (control found)"
  else
    printf 's2: files holding a token of this run: %s\n' "${hits:-none, not even the control}" >&2
    result FAIL 'S2 negative controls, C §15' "the tokens this run minted: ${#secrets[@]} searched, the listing is not the control alone"
  fi
else
  cat -- "$ev_log" >&2
  result FAIL 'S2 negative controls, C §15' 'bin/evidence failed'
fi
rm -f -- "$ev_log"
say "s2 $s2_mode: $failed failed; evidence in $EV, bundle ${final:-none}"
[ "$failed" -eq 0 ]
