#!/usr/bin/env bash
# Acceptance plan S7's nominal run, its preconditions and steps 1-3 and 5-11, against the fixture,
# after S4 (and S5). S7's A is the fixture's C, the interruption build, as S6's is; B is B, which runs that
# build too, so that its request can be held after it is sent; B-recovery is B started with
# -recovery-start. The fixture's A is stopped and stays stopped. Before T: an ingestion claim paused
# for review on C, C stalled after committing a worker plan (S6.1's stale owner), and a pre-entry
# plan approved that waits on the held scope. At T: the database snapshot. After T: B takes the
# operation over, retries it and is held after its request is sent, so the request lands and the
# scope stays held; a second plan approved; the pre-entry plan's approval revoked; h-all listed in
# B's deniedSubjects, then revoked; the OpenBao snapshot. Step 1 stops B and C, then restores both;
# step 2 starts B-recovery, which serves only the entry; step 3 records the entry and, through
# B-recovery, queues a publication and opens a second draft; step 5 finds the held request's
# landing on the worker. Step 6, through B-recovery: h-all's revocation re-recorded, the seed
# automation token reissued, held taken over again and an import into the second draft started.
# Step 7: both scopes accounted with one decision, held reclassified cancelled, the control plane
# paused, the worker marked ready (its mark opens the landing's drift record) and the control plane
# blocked. Step 8 releases the worker; step 9 restarts B without the flag, which runs step 3's
# publication, and a revert of the landing, approved in the new epoch, runs as S4; step 10 unpauses
# the control plane, marks and releases it; step 11 exits recovery mode. The run leaves recovery
# mode off and B running; the reissued automation token is kept nowhere, so .state/automation-token
# holds the seed token the restore made unusable. The served timelines and GET /recovery are kept.
# The closing run (ER §9.3 item 3) runs the same steps from a fresh up, outside the integrated run,
# with C as the missed stale instance: step 1 pauses C, stalled before its attempt, instead of
# stopping it, and step 4 releases and unpauses it. C's executor and publish worker end at their
# first epoch refusal and record nothing (PA §5.1); its takeover and ingestion start answer 503
# epoch-superseded. The refusals that leave no state run inline: plan and approval on an unaccounted
# scope, a second entry, a release of the blocked scope, an exit with it unreleased. The controls
# that drop a comparison are Go checks, named in SKIP lines.
# Two variants follow the run on the same up. The no-entry variant restores the database alone and
# records no entry: C, stalled before its attempt with the owner token B's later takeover replaced,
# makes its attempt once unpaused, and it passes (PA §14's last row, shown, not closed). The
# older-OpenBao variant restores OpenBao to a snapshot taken before a publication that pinned new KV
# generations, and the database to after it: after the entry the monitor reads 404 for those
# generations and alerts at once, and a publication pinning them is refused (PA §13.3).
# Each check writes PASS, FAIL or SKIP, its acceptance-plan reference and what it checked to s7.tsv
# in the evidence directory and to stdout. Exit 1 on any FAIL.
# Usage: scenarios/s7 run       (after scenarios/s5 run on the same up, as in the integrated run, or
#                                directly after scenarios/s4 run; S6 runs outside the integrated run)
#        scenarios/s7 closing   (after scenarios/s4 run on a fresh up, outside the integrated run)
#        scenarios/s7 no-entry  (after scenarios/s7 run on the same up)
#        scenarios/s7 old-bao   (after scenarios/s7 no-entry on the same up; it leaves recovery mode on)
set -euo pipefail
here=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
bin=$here/../bin
# shellcheck source-path=SCRIPTDIR source=../lib.sh
. "$here/../lib.sh"

s7_mode=${1:-}
case $s7_mode in run | closing | no-entry | old-bao) ;; *) die "usage: scenarios/s7 run|closing|no-entry|old-bao" ;; esac
need docker curl jq timeout id sleep date awk wc sha256sum
need_state
# No fixture lock of its own: inject and evidence each take the one they need.
umask 077
image_id=$(cat -- "$STATE/up-image") || die "no server image is recorded in $STATE; run fixtures/bin/up"
image_own "$image_id" || die "the recorded server image is not this run's; run fixtures/bin/down, then up"
EV=$STATE/evidence/s7-$s7_mode-$(date -u +%Y%m%dT%H%M%SZ)
mkdir -p -- "$EV" "$EV/http"
scenario=s7
# shellcheck source-path=SCRIPTDIR source=common.sh
. "$here/common.sh"
run_key=$(date -u +%s%N)
mutation_ref='S7'
ds_ref='S7'
# shellcheck source-path=SCRIPTDIR source=dispatch.sh
. "$here/dispatch.sh"
# review.sh's marks name the worker's file secret, as s1's do; s7's import takes none.
WORKER_MARK='doc[0]/machine/files/0/content'
# shellcheck source-path=SCRIPTDIR source=review.sh
. "$here/review.sh"

cluster='' machine_cp='' machine_w='' plan='' rel='' baseline='' op='' held=''
cp_log='' w_log=''
pre_plan='' pre_approval='' post_plan='' restored_epoch='' epoch=''
t_at='' bao_at='' stopped_at='' db_backup='' bao_backup='' entry_draft='' second_draft='' second_etag=''
robot_new='' ing_epoch='' s_start='' s_end='' cp_start='' cp_end='' w_start='' w_end='' marked='' w_mark='' drift_rec=''
c_owner='' w_pre='' c_commits=''

# s4_applied: S4's safe apply done: the first apply-config plan committed to an operation that
# completed.
s4_applied() {
  same "$(sql "SELECT s.state || ' ' || o.state FROM plan p JOIN plan_state s ON s.plan = p.id
    JOIN operation o ON o.id = s.operation WHERE p.kind = 'apply-config' ORDER BY p.created_at, p.id LIMIT 1")" \
    'committed completed'
}
# both_applied: the control plane and the worker each have an Applied release.
both_applied() {
  same "$(sql "SELECT count(*) FROM machine_state WHERE machine IN ('$machine_cp', '$machine_w') AND applied_release IS NOT NULL")" 2
}
# running_is <true|false> <container>: docker answers that state for the ID need_state verified. A
# failed inspection is neither state.
running_is() {
  local id state
  id=$(container_id "$2") || return 2
  state=$(docker inspect --format '{{.State.Running}}' "$id") || return 2
  [ "$state" = "$1" ]
}
running() { running_is true "$1"; }
stopped() { running_is false "$1"; }
# paused <container>: docker answers it paused, for the ID need_state verified.
paused() {
  local id state
  id=$(container_id "$1") || return 2
  state=$(docker inspect --format '{{.State.Paused}}' "$id") || return 2
  [ "$state" = true ]
}
# c_logged <line>: C's log holds the line at least once. grep reads the whole log (--count, not
# --quiet), so docker logs is never cut off by a closed pipe, which pipefail would read as a failure.
c_logged() {
  [ "$(docker logs "${verified_container_ids[$BW_C]}" 2>&1 | grep --count --fixed-strings -- "$1" || true)" -gt 0 ]
}
# kill_if_up <A|B|C|B-recovery> <container>: the instance killed if it runs, then read stopped.
kill_if_up() {
  if ! stopped "$2"; then "$bin/inject" kill "$1" || return 1; fi
  stopped "$2"
}
# b_stalls_at <step>: how many times B's log says the seam stalled it at the step.
b_stalls_at() {
  docker logs "${verified_container_ids[$BW_B]}" 2>&1 | grep --count --line-regexp --fixed-strings -- "fixture interrupt: stall at $1" || true
}
# b_held <stalls before>: op sending with one attempt and no response, and B stalled once more after
# the send.
b_held() { op_attempts 'sending 1 0' && [ "$(b_stalls_at dispatch-sent)" -gt "$1" ]; }
# waits <plan> <approval>: the plan approved by the approval with no operation, and no use-time
# check, commitment or refusal entry names it: no controller takes it up.
waits() {
  plan_is_stored "$1" approved "$2" &&
    [ "$(sql "SELECT count(*) FROM machine_event WHERE machine = '$machine_w' AND entry->>'plan' = '$1'
      AND kind IN ('use-time-check', 'commitment', 'refusal')")" = 0 ]
}
# revoked_identity <true|false>: h-all's principal is recorded revoked, or not.
revoked_identity() { same "$(sql "SELECT revoked FROM principal WHERE kind = 'human' AND sub = 'h-all'")" "${1:0:1}"; }
# revoke_h_all <key name> <reason>: h-recovery records h-all's revocation on the instance on
# call_port: 201, naming h-all.
revoke_h_all() {
  fresh h-recovery
  answers_with '.identity | type == "string"' 201 - POST /api/v1/identity-revocations "$tok" \
    "$(jq -nc --arg r "$2" '{iss: "http://issuer:5556", sub: "h-all", reason: $r}')" "$(key "$1")"
}
# held_restored: held committed with no attempt, owned by C at generation 1 in the restored epoch,
# and no ownership transition of it on the timeline.
held_restored() {
  still_held && same "$(sql "SELECT owner_gen || ' ' || owner_epoch FROM operation WHERE id = '$held'")" "1 $restored_epoch" &&
    same "$(sql "SELECT count(*) FROM machine_event WHERE kind = 'ownership-transition' AND entry->>'operation' = '$held'")" 0
}
# backup_id <file under backups>: the backup's identity, its name and digest.
backup_id() {
  local h
  h=$(sha256sum -- "$STATE/backups/$1") || return 1
  printf '%s sha256:%s' "$1" "${h%% *}"
}
# now_utc: the time, to the second, never ahead of the server's clock it shares.
now_utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }
# entry_body: the entry's request, naming both backups with the times they were taken, the stop and
# entry_reason.
entry_reason='S7 step 3: the database restored to T and OpenBao to its later snapshot'
entry_body() {
  jq -nc --arg db "$db_backup" --arg dt "$t_at" --arg pb "$bao_backup" --arg pt "$bao_at" --arg s "$stopped_at" --arg r "$entry_reason" \
    '{restored: [{family: "database", backup: $db, takenAt: $dt}, {family: "provider", backup: $pb, takenAt: $pt}],
      stoppedAt: $s, reason: $r}'
}
# enter: h-recovery records the entry on call_port: 201, a new epoch fencing the restored one, by
# h-recovery as recovery-admin, every machine marked and held, when set, among the operations taken
# over; the new epoch in epoch.
enter() {
  local who body
  fresh h-recovery
  body=$(entry_body) || return 1
  answers 201 - POST /api/v1/recovery/entries "$tok" "$body" "$(key entry)" || return 1
  who=$(who_id h-recovery) && [ -n "$who" ] || return 1
  jq -e --arg p "$restored_epoch" --arg w "$who" --arg h "$held" --argjson n "$(sql "SELECT count(*) FROM machine")" \
    '.previousEpoch == $p and .epoch != $p and .enteredBy == $w and .role == "recovery-admin" and .machines == $n
      and (.restored | map(.family) | sort) == ["database", "provider"] and ($h == "" or (.operations | index($h)) != null)' \
    "$EV/last.body" >/dev/null || return 1
  epoch=$(jq -er '.epoch' "$EV/last.body")
}
# entry_recorded: the installation in the new epoch in recovery mode, its entry record naming the
# stop and the two restored backups, each with the time it was taken.
entry_recorded() {
  same "$(sql "SELECT epoch || ' ' || recovery_mode FROM installation_state")" "$epoch true" &&
    same "$(sql "SELECT count(*) FROM recovery_epoch WHERE epoch = '$epoch' AND stopped_at = '$stopped_at'::timestamptz")" 1 &&
    same "$(sql "SELECT string_agg(family || ' ' || backup || ' ' || (taken_at = CASE family WHEN 'database' THEN '$t_at'
      WHEN 'provider' THEN '$bao_at' END::timestamptz), ',' ORDER BY family) FROM recovery_restore WHERE epoch = '$epoch'")" \
      "database $db_backup true,provider $bao_backup true"
}
# every_scope_unaccounted: every machine's scope pre-restore unaccounted.
every_scope_unaccounted() {
  same "$(sql "SELECT count(*) FILTER (WHERE scope_state <> 'pre-restore-unaccounted') || ' ' || (count(*) > 1) FROM machine")" '0 true'
}
# held_taken_over: held unresolved at generation 2 in the new epoch, under another owner than C's,
# by one ownership transition of reason recovery-entry; and no apply-config operation committed,
# sending or verifying.
held_taken_over() {
  same "$(sql "SELECT o.state || ' ' || o.owner_gen || ' ' || o.owner_epoch || ' ' || (o.owner <> e.entry->>'from')
    FROM operation o JOIN machine_event e ON e.kind = 'ownership-transition' AND e.entry->>'operation' = o.id
    WHERE o.id = '$held' AND e.entry->>'reason' = 'recovery-entry' AND e.entry->>'epoch' = '$epoch'
      AND e.entry->>'generation' = '2'")" "unresolved 2 $epoch true" &&
    same "$(sql "SELECT count(*) FROM operation WHERE kind = 'apply-config' AND state IN ('committed', 'sending', 'verifying')")" 0
}
# claim_abandoned_by_entry: tk_ing abandoned at generation 1 without its payload, committed before its
# absolute expiry; its ingestion operation failed.
claim_abandoned_by_entry() {
  claim_is abandoned 1 none &&
    same "$(sql "SELECT pg_xact_commit_timestamp(xmin) < expires_at FROM staging_claim WHERE id = '$tk_ing'")" t &&
    same "$(sql "SELECT state FROM operation WHERE id = '$tk_op'")" failed
}
# reassign_entry: the worker's assignment in the draft, the workers profile and the draft's cluster
# fragment, under the draft's ETag: 200.
reassign_entry() {
  fresh h-author
  answers 200 - PUT "/api/v1/drafts/$draft/assignments/$machine_w" "$tok" \
    '{"profiles": ["workers"], "fragments": {"cluster": ["s7-entry"]}}' "$(key assignment-entry)" "$etag" || return 1
  etag=$(etag_of_last)
  [ -n "$etag" ]
}
# publish_queued: the draft published as h-publisher under its ETag: 202, its operation in pub_op.
publish_queued() {
  fresh h-publisher
  answers 202 - POST "/api/v1/drafts/$draft/publications" "$tok" '{}' "$(key publication-entry)" "$etag" || return 1
  pub_op=$(jq -er '.id' "$EV/last.body")
}
# pub_queued: pub_op a publish job still queued, never claimed (generation 0, no claimed event),
# with no release.
pub_queued() {
  same "$(sql "SELECT kind || ' ' || state || ' ' || owner_gen FROM operation WHERE id = '$pub_op'")" 'publish queued 0' &&
    same "$(sql "SELECT count(*) FROM operation_event WHERE operation = '$pub_op' AND entry->>'type' = 'claimed'")" 0 &&
    same "$(sql "SELECT count(*) FROM release WHERE operation = '$pub_op'")" 0
}
# reissue: the seed automation token reissued with the server-side tool under h-recovery, the new
# token in robot_new.
reissue() {
  robot_new=$("$bin/bw" token rotate -identity "$robot_id" -operator h-recovery 2>>"$EV/token-rotate.log") && [ -n "$robot_new" ] || return 1
  keep_secret "$robot_new"
}
# held_retaken: held unresolved at generation 3 with the new epoch as its owner epoch, by one
# ownership transition to generation 3 in that epoch.
held_retaken() {
  same "$(sql "SELECT state || ' ' || owner_gen || ' ' || owner_epoch FROM operation WHERE id = '$held'")" "unresolved 3 $epoch" &&
    same "$(sql "SELECT count(*) FROM machine_event WHERE kind = 'ownership-transition' AND entry->>'operation' = '$held'
      AND entry->>'generation' = '3' AND entry->>'epoch' = '$epoch'")" 1
}
# ingestion_in_epoch: h-author starts an import of the worker into the second draft on call_port,
# under the ETag step 3 kept: 202, its claim owned in the new epoch; the claim in ing_epoch.
ingestion_in_epoch() {
  local body
  body=$(jq -nc --arg m "$machine_w" --arg d "$second_draft" --arg p "$WORKER_MARK" \
    '{kind: "import", source: "machine", staging: "transient", machine: $m, draft: $d, marks: [$p]}') || return 1
  answers 202 - POST /api/v1/ingestions "$author" "$body" "$(key ingestion-step6)" "$second_etag" || return 1
  ing_epoch=$(jq -er '.ingestion' "$EV/last.body") || return 1
  same "$(sql "SELECT owner_epoch FROM staging_claim WHERE id = '$ing_epoch'")" "$epoch"
}
# claim_ended: ing_epoch's claim released or abandoned.
claim_ended() {
  case $(sql "SELECT state FROM staging_claim WHERE id = '$ing_epoch'") in released | abandoned) ;; *) return 1 ;; esac
}
# scope_reads <machine>: in s_start and s_end, the observations the post-restore accounting reads for
# the machine's scope, chosen as its decision checks them (ER §7.3 step 1, §5.2): s_start the first
# successful read of the machine begun after D, the stop plus the maximum transport deadline (5 min,
# server.yaml.in); s_end the first recovery observation with a resource version begun after s_start
# was recorded and at least the settle floor (30 s) after the later of D and s_start.
scope_reads() {
  local d="(SELECT stopped_at + interval '5 minutes' FROM recovery_epoch WHERE epoch = '$epoch')"
  s_start=$(sql "SELECT o.id FROM observation o JOIN machine_event se ON se.machine = o.machine AND se.revision = o.basis
    WHERE o.machine = '$1' AND se.at > $d
      AND (o.unread->'identity' IS NULL OR o.unread->'runningVersion' IS NULL OR o.unread->'configuration' IS NULL)
    ORDER BY o.basis LIMIT 1") && [ -n "$s_start" ] || return 1
  # The settle needs the resource version at its start: a first read without one can never start it.
  [ "$(sql "SELECT count(*) FROM observation WHERE id = '$s_start' AND resource_version IS NOT NULL")" = 1 ] || return 1
  s_end=$(sql "SELECT o.id FROM observation o JOIN observation_start s ON s.machine = o.machine AND s.revision = o.basis
    JOIN machine_event se ON se.machine = o.machine AND se.revision = o.basis, observation st
    WHERE st.id = '$s_start' AND o.machine = '$1' AND s.purpose = 'recovery' AND o.resource_version IS NOT NULL
      AND se.at > st.at AND se.at >= greatest($d, st.at) + interval '30 seconds' ORDER BY o.basis LIMIT 1")
  [ -n "$s_end" ]
}
# both_settled: scope_reads of both scopes, in cp_start, cp_end, w_start and w_end.
both_settled() {
  scope_reads "$machine_cp" && cp_start=$s_start cp_end=$s_end && scope_reads "$machine_w" && w_start=$s_start w_end=$s_end
}
# account_both: h-recovery accounts both scopes with one decision on call_port: 201, the control
# plane's scope blocked and the worker's unresolved, which held holds, each on the observations sent.
account_both() {
  local body
  fresh h-recovery
  body=$(jq -nc --arg c "$machine_cp" --arg cs "$cp_start" --arg ce "$cp_end" --arg w "$machine_w" --arg ws "$w_start" --arg we "$w_end" \
    '{scopes: [{machine: $c, start: $cs, end: $ce}, {machine: $w, start: $ws, end: $we}], facts: {}}') || return 1
  answers 201 - POST /api/v1/recovery/accountings "$tok" "$body" "$(key accounting)" || return 1
  jq -e --arg c "$machine_cp" --arg cs "$cp_start" --arg ce "$cp_end" --arg w "$machine_w" --arg ws "$w_start" --arg we "$w_end" \
    '(.scopes | map({(.machine): [.state, .start, .end]}) | add) == {($c): ["blocked", $cs, $ce], ($w): ["unresolved", $ws, $we]}' \
    "$EV/last.body" >/dev/null
}
# held_cancelled: held cancelled, with no attempt.
held_cancelled() {
  same "$(sql "SELECT o.state || ' ' || count(a.id) FROM operation o LEFT JOIN attempt a ON a.operation = o.id
    WHERE o.id = '$held' GROUP BY o.state")" 'cancelled 0'
}
# mark_as <machine> <jq filter> <name>: h-recovery marks the scope on call_port: 201, its answer
# matching the filter; its restoration observation in marked.
mark_as() {
  fresh h-recovery
  answers_with "$2" 201 - POST "/api/v1/recovery/scopes/$1/marks" "$tok" '{"facts": {}}' "$(key "mark-$3")" || return 1
  marked=$(jq -er '.observation' "$EV/last.body")
}
# release_scope <machine> <name>: h-recovery releases the scope on call_port: 201, released.
release_scope() {
  fresh h-recovery
  answers_with '.state == "released"' 201 - POST "/api/v1/recovery/scopes/$1/releases" "$tok" '{"facts": {}}' "$(key "release-$2")"
}
# landing_drift: the worker's one open drift record, opened by its mark's observation, which read the
# held release's artifact; its opening revision in drift_rec.
landing_drift() {
  drift_rec=$(sql "SELECT r.opened FROM drift_record r, operation o JOIN plan p ON p.id = o.plan
    JOIN release_machine rm ON rm.release = p.release AND rm.machine = p.machine
    WHERE o.id = '$held' AND r.machine = '$machine_w' AND r.closed IS NULL AND r.observation = '$w_mark'
      AND r.observed_digest = rm.configuration_digest") && [ -n "$drift_rec" ] &&
    same "$(sql "SELECT count(*) FROM drift_record WHERE machine = '$machine_w' AND closed IS NULL")" 1
}
# desired_is_pub: the worker's Desired the release of the publication step 3 queued, in rel.
desired_is_pub() {
  rel=$(sql "SELECT id FROM release WHERE operation = '$pub_op'") && [ -n "$rel" ] &&
    same "$(sql "SELECT desired FROM machine_state WHERE machine = '$machine_w'")" "$rel"
}
# exited: h-recovery exits recovery mode on call_port: 201, naming both scopes.
exited() {
  fresh h-recovery
  answers_with "(.scopes | sort) == ([\"$machine_cp\", \"$machine_w\"] | sort)" 201 - POST /api/v1/recovery/exits "$tok" \
    '{"facts": {}}' "$(key exit)"
}
# recovery_kept: GET /recovery, kept: the epoch out of recovery mode, its entry record naming both
# backups, each with the time recorded as taken, its exit the recorded exit act, both scopes and
# only those normal.
recovery_kept() {
  local exit_act exit_by family at
  fresh h-viewer
  answers 200 - GET /api/v1/recovery "$tok" || return 1
  cp -- "$EV/last.body" "$EV/recovery.json" || return 1
  exit_act=$(sql "SELECT act || ' ' || exited_by FROM recovery_exit WHERE epoch = '$epoch'") && [ -n "$exit_act" ] || return 1
  exit_by=${exit_act#* } exit_act=${exit_act%% *}
  jq -e --arg e "$epoch" --arg db "$db_backup" --arg pb "$bao_backup" --arg act "$exit_act" --arg by "$exit_by" \
    --arg c "$machine_cp" --arg w "$machine_w" \
    '.epoch == $e and .recoveryMode == false and .exit.act == $act and .exit.exitedBy == $by
      and (.entry.restored | map([.family, .backup]) | sort) == [["database", $db], ["provider", $pb]]
      and (.scopes | map([.machine, .state]) | sort) == ([[$c, "normal"], [$w, "normal"]] | sort)' "$EV/recovery.json" >/dev/null || return 1
  while read -r family at; do
    [ "$(sql "SELECT count(*) FROM recovery_restore WHERE epoch = '$epoch' AND family = '$family' AND taken_at = '$at'::timestamptz")" = 1 ] ||
      return 1
  done < <(jq -r '.entry.restored[] | "\(.family) \(.takenAt)"' "$EV/recovery.json")
}

# The closing run's checks of C, the missed stale instance, after step 4's unpause.
# c_superseded: C's executor and publish worker each logged its epoch superseded, and ended.
c_superseded() {
  c_logged 'executor: the epoch is superseded; it dispatches nothing until restarted' &&
    c_logged 'publish worker: the epoch is superseded; it claims nothing until restarted'
}
# held_under_entry: held still unresolved at generation 2 in the new epoch, under another owner than
# C's, its journal holding no attempt: C made none.
held_under_entry() {
  same "$(sql "SELECT o.state || ' ' || o.owner_gen || ' ' || o.owner_epoch || ' ' || (o.owner <> '$c_owner') || ' ' || count(a.id)
    FROM operation o LEFT JOIN attempt a ON a.operation = o.id WHERE o.id = '$held'
    GROUP BY o.state, o.owner_gen, o.owner_epoch, o.owner")" "unresolved 2 $epoch true 0"
}
# stale_takeover: h-recovery's takeover of held from generation 2 on call_port: 503 epoch-superseded.
stale_takeover() {
  fresh h-recovery
  answers 503 epoch-superseded POST "/api/v1/operations/$held/takeovers" "$tok" \
    '{"generation": 2, "reason": "S7 step 4: through the missed stale instance"}' "$(key takeover-stale)"
}
# stale_ingestion: h-author's import of the worker into the second draft on call_port, under step 3's
# ETag: 503 epoch-superseded.
stale_ingestion() {
  local body
  fresh_author
  body=$(jq -nc --arg m "$machine_w" --arg d "$second_draft" --arg p "$WORKER_MARK" \
    '{kind: "import", source: "machine", staging: "transient", machine: $m, draft: $d, marks: [$p]}') || return 1
  answers 503 epoch-superseded POST /api/v1/ingestions "$author" "$body" "$(key ingestion-stale)" "$second_etag"
}
# unaccounted_plan: a plan of the worker as h-publisher on call_port: 409 recovery-mode-active,
# naming the worker and its pre-restore unaccounted scope.
unaccounted_plan() {
  local body
  fresh h-publisher
  body=$(plan_body) || return 1
  answers_with ".machine == \"$machine_w\" and .scope == \"pre-restore-unaccounted\"" 409 recovery-mode-active \
    POST /api/v1/plans "$tok" "$body" "$(key plan-unaccounted)"
}
# unaccounted_approval: h-approver's approval of the pre-entry plan on call_port: 409
# recovery-mode-active, naming the worker's pre-restore unaccounted scope.
unaccounted_approval() {
  fresh h-approver
  answers_with '.scope == "pre-restore-unaccounted"' 409 recovery-mode-active \
    POST "/api/v1/plans/$pre_plan/approvals" "$tok" '{}' "$(key approval-unaccounted)"
}
# second_entry: another entry under another key in the same recovery start, on call_port: 409 conflict.
second_entry() {
  local body
  fresh h-recovery
  body=$(entry_body) || return 1
  answers 409 conflict POST /api/v1/recovery/entries "$tok" "$body" "$(key entry-second)"
}
# release_refused <machine>: h-recovery releases the scope on call_port: 409 conflict, as it is not ready.
release_refused() {
  fresh h-recovery
  answers 409 conflict POST "/api/v1/recovery/scopes/$1/releases" "$tok" '{"facts": {}}' "$(key "release-refused-$1")"
}
# exit_refused: h-recovery exits recovery mode on call_port with the control plane's scope
# unreleased: 409 conflict, naming it.
exit_refused() {
  fresh h-recovery
  answers_with ".machine == \"$machine_cp\"" 409 conflict POST /api/v1/recovery/exits "$tok" '{"facts": {}}' "$(key exit-early)"
}
# c_commitments: how many commitment entries name C as their controller, on any machine and plan.
c_commitments() { sql "SELECT count(*) FROM machine_event WHERE kind = 'commitment' AND entry->>'controller' = '$c_owner'"; }
# c_committed_none: no commitment entry names C since c_commits was read, before step 4's unpause.
c_committed_none() { same "$(c_commitments)" "$c_commits"; }
# not_by_c <plan>: the plan's one commitment entry names another controller than C, and C has
# committed nothing since step 4's unpause.
not_by_c() {
  same "$(sql "SELECT count(*) FILTER (WHERE entry->>'controller' <> '$c_owner') || ' ' || count(*) FROM machine_event
    WHERE kind = 'commitment' AND entry->>'plan' = '$1'")" '1 1' && c_committed_none
}

preconditions() {
  local ref='S7 precondition'
  machines
  check "$ref" "S4 passed: its safe apply's plan, the first apply-config plan, committed to an operation that completed" s4_applied
  check "$ref" 'both machines have Applied' both_applied
  check "$ref" 'no apply-config operation holds the worker'"'"'s scope or the cluster'"'"'s rollout slot' scope_released
  check "$ref" 'no link to the worker is recorded cut' worker_joined
  check "$ref" "the mutation matcher counts an apid line of each mutating Talos API method once and of each read method not at all" \
    methods_counted
  # C is S7's A, running; the fixture's A and B stopped; neither seam told to act.
  must "$ref" 'the fixture'"'"'s A stopped' kill_if_up A "$BW_A"
  must "$ref" 'B stopped' kill_if_up B "$BW_B"
  must "$ref" "C's control file removed" interrupt -
  must "$ref" "B's control file removed" interrupt_of b -
  running "$BW_C" || must "$ref" 'inject start C' "$bin/inject" start C
  must "$ref" 'C running' running "$BW_C"
  call_port=$SERVER_C_PORT
  check "$ref" 'C answers /livez' within 30 answers 204 - GET /livez ''
  evidence_to pre || die "no pre-state: bin/evidence failed"
  check "$ref" 'the pre-state bundle: complete, no fixture secret but the scan control' scan_clean pre
  cp_log=$(apid_log "$TALOS_CONTROLPLANE_IP") || die "cannot read the control plane's apid log"
}

before_t() {
  local ref='S7 before T' n
  # S6.1's stale owner: C commits a worker plan and stalls before its attempt.
  ds_publish held
  ds_plan held
  n=$(stalls_at dispatch-committed)
  must "$ref" 'C told to stall after the commitment' interrupt dispatch-committed stall
  check "$ref" 'approved as h-approver: 201' approve_by h-approver "$plan" s7held
  check "$ref" 'the plan committed, its operation committed with no attempt; C stalls there' within 120 committed_held "$plan" "$n"
  op=$held
  # The pre-entry plan: approved, not committed, since held holds the scope.
  must "$ref" 'the pre-entry plan of the worker as h-publisher: 201' plan_by h-publisher pre
  pre_plan=$plan_id
  must "$ref" 'the pre-entry plan approved as h-approver: 201' approve_by h-approver "$pre_plan" s7pre
  pre_approval=$approval_id
  sleep 16
  check "$ref" 'three heartbeats on, the pre-entry plan waits: approved, no operation, no use-time check, commitment or refusal entry names it' \
    waits "$pre_plan" "$pre_approval"
  # The ingestion claim last, so that its absolute expiry (10 min, server.yaml.in) is still ahead at
  # the entry.
  fresh_author
  check "$ref" 'an import of the worker on C, review: true: 202' review_import s7 C
  call_port=$SERVER_C_PORT
  check "$ref" 'its claim paused for review at generation 1 with its envelope, its operation running' within 60 paused_at 1
}

at_t() {
  local ref='S7 at T'
  t_at=$(now_utc)
  must "$ref" 'inject db-snapshot s7-t' "$bin/inject" db-snapshot s7-t
  restored_epoch=$(sql "SELECT epoch FROM installation_state") && [ -n "$restored_epoch" ] || die "cannot read the epoch at T"
}

after_t() {
  local ref='S7 after T' n
  # B, its seam told to hold it after its send, takes held over, retries it and is held.
  n=$(b_stalls_at dispatch-sent)
  must "$ref" 'B told to stall after its request is sent' interrupt_of b dispatch-sent stall
  must "$ref" 'inject start B' "$bin/inject" start B
  call_port=$SERVER_B_PORT
  check "$ref" "B took the operation over at its start, one ownership transition to generation 2" within 60 started_takeover
  check "$ref" 'B sent its request and is held after the send: sending, one attempt, no response recorded' within 120 b_held "$n"
  check "$ref" "the one attempt is B's at generation 2, after its classification safe to retry" retried_by_taker
  # The other acts after T, all of which the restore erases.
  must "$ref" 'a second plan of the worker as h-publisher: 201' plan_by h-publisher post
  post_plan=$plan_id
  check "$ref" 'the second plan approved as h-approver: 201' approve_by h-approver "$post_plan" s7post
  approval_id=$pre_approval
  check "$ref" "h-approver revokes the pre-entry plan's approval: 201" revoke_approval s7pre
  must "$ref" "h-all listed in B's deniedSubjects" set_denied_of b '[{iss: "http://issuer:5556", sub: h-all}]'
  check "$ref" 'h-recovery revokes h-all: 201' revoke_h_all revoke-h-all 'S7 after T'
  check "$ref" "h-all's identity recorded revoked" revoked_identity true
  bao_at=$(now_utc)
  must "$ref" 'inject bao-snapshot s7-provider' "$bin/inject" bao-snapshot s7-provider
}

s7() {
  local ref

  # Step 1: B and C (S7's A) stopped and established stopped before either restore; in the closing
  # run C, the missed stale instance, is paused where it stalled, before its attempt, instead.
  ref='S7 step 1'
  must "$ref" 'inject kill B' "$bin/inject" kill B
  must "$ref" 'B is not running' stopped "$BW_B"
  if [ "$s7_mode" = closing ]; then
    must "$ref" 'inject pause C' "$bin/inject" pause C
    must "$ref" 'C is paused' paused "$BW_C"
  else
    must "$ref" 'inject kill C' "$bin/inject" kill C
    must "$ref" 'C is not running' stopped "$BW_C"
  fi
  must "$ref" "the fixture's A is not running" stopped "$BW_A"
  must "$ref" 'B-recovery is not running' stopped "$BW_B_RECOVERY"
  stopped_at=$(now_utc)
  must "$ref" "B's control file removed" interrupt_of b -
  # A paused C reads it only once step 4 unpauses it: its stall then ends.
  must "$ref" "C's control file removed" interrupt -
  must "$ref" 'inject db-restore s7-t' "$bin/inject" db-restore s7-t
  must "$ref" 'inject bao-restore s7-provider' "$bin/inject" bao-restore s7-provider
  db_backup=$(backup_id pg-s7-t.dump) || die "cannot read the database backup"
  bao_backup=$(backup_id bao-s7-provider.snap) || die "cannot read the OpenBao backup"
  check "$ref" 'the database is at T: the restored epoch, not in recovery mode' \
    same "$(sql "SELECT epoch || ' ' || recovery_mode FROM installation_state")" "$restored_epoch false"
  check "$ref" "held as at T: committed, no attempt, at generation 1 in the restored epoch, no ownership transition" held_restored
  c_owner=$(sql "SELECT owner FROM operation WHERE id = '$held'") && [ -n "$c_owner" ] || die "cannot read held's owner, C"
  check "$ref" "the pre-entry plan's approval as at T: approved, no operation" plan_is_stored "$pre_plan" approved "$pre_approval"
  check "$ref" 'the second plan, made after T, is gone' same "$(sql "SELECT count(*) FROM plan WHERE id = '$post_plan'")" 0
  check "$ref" "h-all's revocation, made after T, is gone" revoked_identity false
  check "$ref" 'the claim as at T: paused at generation 1 with its envelope' claim_is paused 1 payload

  # Step 2: B-recovery, B's configuration and port with the recovery-start flag.
  ref='S7 step 2'
  must "$ref" 'inject start B-recovery' "$bin/inject" start B-recovery
  call_port=$SERVER_B_PORT
  check "$ref" 'B-recovery answers /livez' within 30 answers 204 - GET /livez ''
  fresh h-viewer
  check "$ref" 'before entry, a read: 409 recovery-mode-active' answers 409 recovery-mode-active GET /api/v1/acts "$tok"
  fresh h-publisher
  check "$ref" 'before entry, a plan: 409 recovery-mode-active' \
    answers 409 recovery-mode-active POST /api/v1/plans "$tok" "$(plan_body)" "$(key plan-pre-entry)"
  fresh h-all
  check "$ref" "h-all, listed in deniedSubjects, its recorded revocation erased by the restore: 403 identity-revoked" \
    answers 403 identity-revoked GET /api/v1/acts "$tok"
  sleep 16
  check "$ref" 'three heartbeats on, no executor ran: held still committed with no attempt' still_held
  check "$ref" 'the pre-entry plan still approved, no operation' plan_is_stored "$pre_plan" approved "$pre_approval"

  # Step 3: the entry, then a publication queued and a second draft opened through B-recovery.
  ref='S7 step 3'
  check "$ref" 'h-recovery records the entry naming the database and provider backups: 201, a new epoch, every machine, held taken over' enter
  [ -n "$epoch" ] || die "s7: S7 step 3: no entry; nothing after it can run"
  check "$ref" 'the installation in the new epoch, in recovery mode; the entry records the stop and both backups' entry_recorded
  check "$ref" 'every scope pre-restore unaccounted' every_scope_unaccounted
  check "$ref" "held unresolved at generation 2 in the new epoch, taken from C by the entry; no operation committed, sending or verifying" \
    held_taken_over
  check "$ref" 'the claim abandoned without its payload before its absolute expiry; its ingestion failed' claim_abandoned_by_entry
  fresh_author
  must "$ref" 'h-author opens a draft through B-recovery: 201' draft_by h-author entry
  entry_draft=$draft
  must "$ref" "h-author drafts a cluster fragment, a node label of its own: 200" fragment_by h-author entry entry
  check "$ref" "h-author assigns it to the worker beside the workers profile: 200" reassign_entry
  check "$ref" 'h-publisher publishes it: 202' publish_queued
  sleep 16
  check "$ref" "three heartbeats on, its publish job is still queued with no release: B-recovery runs no job worker" pub_queued
  must "$ref" 'h-author opens a second draft through B-recovery: 201' draft_by h-author second
  second_draft=$draft second_etag=$etag
  printf 'entry-draft\t%s\nsecond-draft\t%s\t%s\npublish\t%s\nheld\t%s\nepoch\t%s\n' \
    "$entry_draft" "$second_draft" "$second_etag" "$pub_op" "$held" "$epoch" >"$EV/s7-state.tsv"

  if [ "$s7_mode" = closing ]; then
    check 'S7 negative controls' 'a second entry under another key in the same recovery start: 409 conflict' second_entry

    # Step 4: C, unpaused, tries its attempt, a claim of step 3's publish job and the pre-entry plan's
    # commitment; through C, a takeover of held and an import into the second draft.
    ref='S7 step 4'
    w_pre=$(apid_log "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
    c_commits=$(c_commitments) && [ -n "$c_commits" ] || die "cannot count C's commitment entries"
    must "$ref" 'inject unpause C' "$bin/inject" unpause C
    must "$ref" 'C running, not paused' running "$BW_C"
    check "$ref" "C's executor and publish worker each end at their first epoch refusal: both log the epoch superseded" \
      within 60 c_superseded
    check "$ref" "C, its executor ended at its epoch check, made no attempt: held unresolved at generation 2 under the entry's owner, no attempt" \
      held_under_entry
    no_mutation 'the worker' "$TALOS_WORKER_IP" "$w_pre" "$(apid_log "$TALOS_WORKER_IP")"
    check "$ref" "C's job claim, refused by the process-epoch comparison, took nothing: step 3's publish job still queued, never claimed, no release" \
      pub_queued
    check "$ref" "C committed nothing: no commitment entry names C since the unpause" c_committed_none
    check "$ref" "the pre-entry plan waits: approved, no operation, no use-time check, commitment or refusal entry" \
      waits "$pre_plan" "$pre_approval"
    call_port=$SERVER_C_PORT
    check "$ref" 'C answers /livez' within 30 answers 204 - GET /livez ''
    check "$ref" "through C, h-recovery's takeover of held, refused by the process-epoch comparison: 503 epoch-superseded" \
      stale_takeover
    check "$ref" "through C, h-author's import into the second draft under step 3's ETag, refused by the process-epoch comparison: 503 epoch-superseded" \
      stale_ingestion
    check 'S7 negative controls' "through C, a plan of the worker, its scope pre-restore unaccounted: 409 recovery-mode-active naming the scope" \
      unaccounted_plan
    check 'S7 negative controls' "through C, an approval of the pre-entry plan, its scope pre-restore unaccounted: 409 recovery-mode-active naming the scope" \
      unaccounted_approval
    call_port=$SERVER_B_PORT
  fi

  # Step 5: the held request landed before B was stopped.
  ref='S7 step 5'
  outcome_bundle "$ref" s7-step5
  check "$ref" "the worker's digest is the held release's artifact and its resource version moved since the pre-state" ds_landed
  no_mutation 'the control plane' "$TALOS_CONTROLPLANE_IP" "$cp_log" "$(apid_log "$TALOS_CONTROLPLANE_IP")"

  # Step 6: the revocation re-recorded, the automation token reissued, held taken over again and an
  # ingestion started, all through B-recovery in the new epoch.
  ref='S7 step 6'
  ds_ref='S7 step'
  call_port=$SERVER_B_PORT
  check "$ref" "h-recovery re-records h-all's revocation: 201" revoke_h_all revoke-h-all-again 'S7 step 6: re-recorded after the restore'
  check "$ref" "h-all's identity recorded revoked" revoked_identity true
  fresh h-all
  check "$ref" 'h-all, revoked: 403 identity-revoked' answers 403 identity-revoked GET /api/v1/acts "$tok"
  robot=$(cat -- "$STATE/automation-token") || die "no automation token in $STATE"
  redact_automation_token "$robot"
  robot_id=$(sed -n 's/^identity \(idn_[a-z2-7]*\):.*/\1/p' "$STATE/automation-identity")
  [ -n "$robot_id" ] || die "s7: no automation identity in $STATE"
  check "$ref" 'the seed automation token, issued before the restore: 401' answers 401 unauthenticated GET /api/v1/acts "$robot"
  must "$ref" 'the automation token reissued with the server-side tool under h-recovery' reissue
  check "$ref" 'the reissued token: 200' answers 200 - GET /api/v1/acts "$robot_new"
  check "$ref" 'the seed token after the reissue: 401' answers 401 unauthenticated GET /api/v1/acts "$robot"
  check "$ref" "h-recovery takes held over through B-recovery from generation 2: 201, unresolved at generation 3" take_over "$held" 6 2
  check "$ref" 'held unresolved at generation 3, the new epoch its owner epoch, by one ownership transition in that epoch' held_retaken
  fresh_author
  check "$ref" "h-author starts an import of the worker into the second draft under step 3's ETag: 202, its claim in the new epoch" \
    ingestion_in_epoch
  check "$ref" 'its claim ends, released or abandoned' within 60 claim_ended

  # Step 7: both scopes accounted with one decision after the settle floor; held reclassified; the
  # control plane paused, then both scopes marked.
  ref='S7 step 7'
  must "$ref" "each scope's settle reads: a first read after the stop plus the maximum transport deadline, a recovery read a settle floor after it" \
    within 600 both_settled
  must "$ref" "h-recovery accounts both scopes with one decision: 201, the control plane's blocked, the worker's unresolved" account_both
  must "$ref" "held, its journal holding no attempt, reclassified: cancelled with no attempt" within 120 held_cancelled
  must "$ref" 'inject pause controlplane' "$bin/inject" pause controlplane
  must "$ref" "the worker's mark: 201, ready, nothing missing" mark_as "$machine_w" '.state == "ready" and .missing == []' worker
  w_mark=$marked
  must "$ref" "its restoration observation opened the worker's one open drift record, of the held release's artifact" landing_drift
  call_limit=90
  check "$ref" "the control plane's mark, its node paused: 201, blocked on the observation" \
    mark_as "$machine_cp" '.state == "blocked" and (.missing | index("observation")) != null' controlplane-paused
  call_limit=10
  if [ "$s7_mode" = closing ]; then
    check 'S7 negative controls' "a release of the control plane's scope, blocked, not ready: 409 conflict" release_refused "$machine_cp"
  fi

  # Step 8.
  ref='S7 step 8'
  must "$ref" 'h-recovery releases the worker scope: 201, released' release_scope "$machine_w" worker
  if [ "$s7_mode" = closing ]; then
    check 'S7 negative controls' "an exit with the control plane's scope unreleased: 409 conflict naming it" exit_refused
  fi

  # Step 9: B without the flag runs step 3's publication; a revert of the landing in the new epoch.
  ref='S7 step 9'
  must "$ref" 'inject kill B-recovery' "$bin/inject" kill B-recovery
  must "$ref" 'inject start B' "$bin/inject" start B
  call_port=$SERVER_B_PORT
  check "$ref" "B's job worker runs step 3's publication: succeeded, one release" within 120 pub_succeeded
  check "$ref" "the worker's Desired is that release" desired_is_pub
  ds_plan 9
  check "$ref" 'the plan, a revert, binds the drift record the landing opened' same "$(sql "SELECT drift_record FROM plan WHERE id = '$plan'")" "$drift_rec"
  check "$ref" 'approved as h-approver: 201' approve_by h-approver "$plan" s7revert
  check "$ref" 'as an unseen overwrite' approved_unseen "$plan"
  check "$ref" 'the approval is of the new epoch' same "$approval_epoch" "$epoch"
  # ds_done's checks but its bundle, which cannot be complete while the control plane is paused: the
  # bundle and the digest read from it follow step 10's unpause.
  check "$ref" "the plan's operation completed within four minutes with 1 attempt, 1 accepted; Applied the release from the operation, the baseline revision one more" \
    within 240 ds_completed 1 1
  w_after=$(apid_log "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
  check "$ref" "the worker's apid log records exactly one mutating request since the row began, ApplyConfiguration" \
    one_apply "$w_log" "$w_after"
  check "$ref" 'the drift record closed reverted' same "$(sql "SELECT resolution FROM drift_record WHERE machine = '$machine_w' AND opened = $drift_rec")" reverted
  if [ "$s7_mode" = closing ]; then
    # C's executor ended in step 4 (PA §5.1), so it makes no commitment attempt here; the
    # process-epoch comparison's refusal of one is the Go control named below.
    check "$ref" "the plan's one commitment entry names another controller than C, and C committed nothing since step 4: its executor ended there" not_by_c "$plan"
  fi

  # Step 10.
  ref='S7 step 10'
  must "$ref" 'inject unpause controlplane' "$bin/inject" unpause controlplane
  must "$ref" "the control plane's Talos API answers" within 120 node_talos "$TALOS_CONTROLPLANE_IP" version
  outcome_bundle 'S7 step 9' ds-9
  check 'S7 step 9' "the worker's digest is the release's artifact and its resource version moved" ds_landed
  must "$ref" "the control plane's mark: 201, ready, nothing missing" mark_as "$machine_cp" '.state == "ready" and .missing == []' controlplane
  must "$ref" 'h-recovery releases the control plane scope: 201, released' release_scope "$machine_cp" controlplane

  # Step 11.
  ref='S7 step 11'
  check "$ref" 'h-recovery exits recovery mode: 201, naming both scopes' exited
  check "$ref" 'the installation out of recovery mode, every scope normal' \
    same "$(sql "SELECT count(*) || ' ' || count(*) FILTER (WHERE recovery_mode) || ' ' ||
      (SELECT count(*) FROM machine WHERE scope_state <> 'normal') FROM installation_state")" '1 0 0'
  check "$ref" "no restored operation was retried: held's journal holds no attempt" held_cancelled

  if [ "$s7_mode" = closing ]; then
    # The controls that drop a comparison need a server built without it: Go checks.
    ref='S7 negative controls'
    result SKIP "$ref" "a plan approved in the new epoch on the ready, unreleased worker scope waits for the release, and commits with the scope gate dropped (comparison 6): B-recovery runs no executor to show the wait; the Go check TestCommitmentScopeGateControl (refused_until_the_release, without_the_scope_gate, the_dispatch_filter_waits_for_the_release; internal/api)"
    result SKIP "$ref" "DB row 027's collision in the new epoch, A's write refused with the epoch term and passing with it dropped: the Go check TestFenceEpochTermRow027 (internal/staging)"
    result SKIP "$ref" "the process-epoch comparison dropped, A's job claim, takeover, ingestion start and commitment pass: the Go check TestProcessEpochControl (internal/api; without_the_process-epoch_comparison: job-claim, takeover, ingestion-start, commitment)"
  fi

  # Retained evidence: both served timelines, every page, and the entry record.
  ref='S7 retained evidence'
  check "$ref" 'GET /recovery kept: the entry record with both backups and the times they were taken, the exit, every scope normal' recovery_kept
  check "$ref" "the worker's served timeline kept, every page" keep timeline-w "/api/v1/machines/$machine_w/timeline"
  check "$ref" "it holds the accounting on the observations sent, the ready mark, the release, the exit and the drift record closed reverted" \
    kept timeline-w "any(.[]; .kind == \"scope-state\" and .entry.cause == \"post-restore-accounting\" and .entry.to == \"unresolved\"
        and .entry.start == \"$w_start\" and .entry.end == \"$w_end\")
      and any(.[]; .kind == \"scope-state\" and .entry.cause == \"restoration-mark\" and .entry.to == \"ready\" and .entry.observation == \"$w_mark\")
      and any(.[]; .kind == \"scope-state\" and .entry.cause == \"release\" and .entry.to == \"released\")
      and any(.[]; .kind == \"scope-state\" and .entry.cause == \"exit\" and .entry.to == \"normal\")
      and any(.[]; .kind == \"drift\" and (.entry.record | tostring) == \"$drift_rec\" and .entry.change == \"closed\" and .entry.resolution == \"reverted\")"
  check "$ref" "the control plane's served timeline kept, every page" keep timeline-cp "/api/v1/machines/$machine_cp/timeline"
  check "$ref" 'it holds the accounting on the observations sent, the blocked and the ready mark, the release and the exit' \
    kept timeline-cp "any(.[]; .kind == \"scope-state\" and .entry.cause == \"post-restore-accounting\" and .entry.to == \"blocked\"
        and .entry.start == \"$cp_start\" and .entry.end == \"$cp_end\")
      and any(.[]; .kind == \"scope-state\" and .entry.cause == \"restoration-mark\" and .entry.to == \"blocked\"
        and (.entry.missing | index(\"observation\")) != null)
      and any(.[]; .kind == \"scope-state\" and .entry.cause == \"restoration-mark\" and .entry.to == \"ready\")
      and any(.[]; .kind == \"scope-state\" and .entry.cause == \"release\" and .entry.to == \"released\")
      and any(.[]; .kind == \"scope-state\" and .entry.cause == \"exit\" and .entry.to == \"normal\")"
}

# The no-entry variant's checks.
# b_attempted <stalls before>: held sending with one attempt and no response, and B stalled once more
# after recording it, before sending.
b_attempted() { op_attempts 'sending 1 0' && [ "$(b_stalls_at dispatch-attempted)" -gt "$1" ]; }
# c_attempted: held's one attempt is C's, by its pre-restore owner token at generation 1 in the
# restored epoch, and no ownership transition of held is recorded.
c_attempted() {
  same "$(sql "SELECT count(*) || ' ' || bool_and(owner = '$c_owner' AND owner_gen = 1 AND owner_epoch = '$restored_epoch')
    FROM attempt WHERE operation = '$held'")" '1 true' &&
    same "$(sql "SELECT count(*) FROM machine_event WHERE kind = 'ownership-transition' AND entry->>'operation' = '$held'")" 0
}
# not_entered: the installation in the restored epoch, out of recovery mode, and no recovery epoch
# entered after it.
not_entered() {
  same "$(sql "SELECT epoch || ' ' || recovery_mode FROM installation_state")" "$restored_epoch false" &&
    same "$(sql "SELECT count(*) FROM recovery_epoch
      WHERE entered_at > (SELECT entered_at FROM recovery_epoch WHERE epoch = '$restored_epoch')")" 0
}

# no_entry: AP S7's "the same restore started normally, with no entry". C commits a worker plan and
# stalls before its attempt; at T the database snapshot; after T, B takes the operation over at its
# start and records its attempt, stalled before it sends. B is then stopped, C paused, the database
# alone restored to T, and nothing started with -recovery-start: no entry is recorded. C, unpaused,
# makes its attempt with the owner token B's takeover had replaced, and it passes.
no_entry() {
  local ref='S7 no-entry' n w_after
  ds_ref='S7 no-entry'
  machines
  must "$ref" 'B stopped' kill_if_up B "$BW_B"
  must "$ref" 'B-recovery stopped' kill_if_up B-recovery "$BW_B_RECOVERY"
  must "$ref" "the fixture's A stopped" kill_if_up A "$BW_A"
  must "$ref" "C's control file removed" interrupt -
  must "$ref" "B's control file removed" interrupt_of b -
  running "$BW_C" || must "$ref" 'inject start C' "$bin/inject" start C
  must "$ref" 'C running' running "$BW_C"
  call_port=$SERVER_C_PORT
  check "$ref" 'C answers /livez' within 30 answers 204 - GET /livez ''
  check "$ref" 'the installation out of recovery mode' same "$(sql "SELECT recovery_mode FROM installation_state")" f
  check "$ref" 'no apply-config operation holds the worker'"'"'s scope or the cluster'"'"'s rollout slot' scope_released
  evidence_to ne-pre || die "no pre-state: bin/evidence failed"
  check "$ref" 'the pre-state bundle: complete, no fixture secret but the scan control' scan_clean ne-pre

  # C commits a worker plan and stalls before its attempt.
  ds_publish ne
  ds_plan ne
  n=$(stalls_at dispatch-committed)
  must "$ref" 'C told to stall after the commitment' interrupt dispatch-committed stall
  check "$ref" 'approved as h-approver: 201' approve_by h-approver "$plan" s7ne
  must "$ref" 'the plan committed, its operation committed with no attempt; C stalls there' within 120 committed_held "$plan" "$n"
  op=$held
  c_owner=$(sql "SELECT owner FROM operation WHERE id = '$held'") && [ -n "$c_owner" ] || die "cannot read held's owner, C"

  # At T.
  t_at=$(now_utc)
  must "$ref" 'inject db-snapshot s7-ne' "$bin/inject" db-snapshot s7-ne
  restored_epoch=$(sql "SELECT epoch FROM installation_state") && [ -n "$restored_epoch" ] || die "cannot read the epoch at T"

  # After T: B takes held over and records its attempt, stalled before it sends.
  n=$(b_stalls_at dispatch-attempted)
  must "$ref" 'B told to stall after its attempt is recorded' interrupt_of b dispatch-attempted stall
  must "$ref" 'inject start B' "$bin/inject" start B
  check "$ref" 'B took the operation over at its start, one ownership transition to generation 2' within 60 started_takeover
  check "$ref" 'B recorded its attempt and stalls before sending: sending, one attempt, no response' within 120 b_attempted "$n"
  check "$ref" "the one attempt is B's at generation 2, after its classification safe to retry" retried_by_taker

  # The restore, started normally: B stopped, C paused where it stalled, the database alone restored.
  must "$ref" 'inject pause C' "$bin/inject" pause C
  must "$ref" 'C is paused' paused "$BW_C"
  must "$ref" 'inject kill B' "$bin/inject" kill B
  must "$ref" 'B is not running' stopped "$BW_B"
  must "$ref" 'B-recovery is not running' stopped "$BW_B_RECOVERY"
  must "$ref" "B's control file removed" interrupt_of b -
  must "$ref" "C's control file removed" interrupt -
  check "$ref" 'B sent nothing: no mutating request on the worker since the plan' none_sent
  must "$ref" 'inject db-restore s7-ne, OpenBao left as it is' "$bin/inject" db-restore s7-ne
  check "$ref" 'the database is at T: the restored epoch, not in recovery mode' not_entered
  check "$ref" "held as at T: committed, no attempt, C's at generation 1 in the restored epoch, no ownership transition" held_restored
  check "$ref" "held's owner token is C's, which B's takeover had replaced" \
    same "$(sql "SELECT owner FROM operation WHERE id = '$held'")" "$c_owner"

  # No entry: C's pre-restore token passes.
  w_pre=$(apid_log "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
  must "$ref" 'inject unpause C' "$bin/inject" unpause C
  must "$ref" 'C running, not paused' running "$BW_C"
  check "$ref" "C's pre-restore owner token passes: held's one attempt is C's at generation 1 in the restored epoch" within 120 c_attempted
  check "$ref" "the plan's operation completed within four minutes with 1 attempt, 1 accepted; Applied the release from the operation, the baseline revision one more" \
    within 240 ds_completed 1 1
  w_after=$(apid_log "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
  check "$ref" "the worker's apid log records exactly one mutating request since the restore, C's ApplyConfiguration" \
    one_apply "$w_pre" "$w_after"
  check "$ref" 'no entry was recorded: the restored epoch, out of recovery mode' not_entered
  outcome_bundle "$ref" s7-ne
  check "$ref" "the worker's digest is the release's artifact and its resource version moved" ds_landed
  end_state='no entry, C running'
}

# The older-OpenBao variant's checks. The KV generations the import extracted after OpenBao's
# snapshot: their dependency statuses' ids, space-separated, in old_deps.
old_deps='' ing_old='' rel_old='' old_a0=''
# old_pinned: rel_old pins the import's KV generations, at least one, each retained.
old_pinned() {
  old_deps=$(sql "SELECT string_agg(DISTINCT s.id, ' ' ORDER BY s.id) FROM dependency d
    JOIN dependency_status s USING (provider, object, version, created)
    WHERE d.release = '$rel_old' AND d.provider = 'kv' AND s.object LIKE 'gen/$cluster/$ing_old/%'") && [ -n "$old_deps" ] &&
    same "$(sql "SELECT count(*) FILTER (WHERE class <> 'retained') FROM dependency_status
      WHERE id = ANY (string_to_array('$old_deps', ' '))")" 0
}
# old_absent: each of old_deps observed since the entry, unknown, absent.
old_absent() {
  same "$(sql "SELECT count(*) FILTER (WHERE s.class = 'unknown' AND s.reason = 'absent' AND s.observed_from > e.entered_at) || ' ' || count(*)
    FROM dependency_status s, recovery_epoch e WHERE e.epoch = '$epoch' AND s.id = ANY (string_to_array('$old_deps', ' '))")" \
    "$(wc -w <<<"$old_deps") $(wc -w <<<"$old_deps")"
}
# old_alerted: since old_a0, one alert of each of old_deps, a regression of reason absent naming
# rel_old, and no other alert of them.
old_alerted() {
  same "$(sql "SELECT count(*) FILTER (WHERE kind = 'regression' AND reason = 'absent' AND '$rel_old' = ANY (releases))
      || ' ' || count(*) || ' ' || count(DISTINCT dependency)
    FROM dependency_alert WHERE seq > $old_a0 AND dependency = ANY (string_to_array('$old_deps', ' '))")" \
    "$(wc -w <<<"$old_deps") $(wc -w <<<"$old_deps") $(wc -w <<<"$old_deps")"
}
# pub_failed: pub_op failed.
pub_failed() { same "$(sql "SELECT state FROM operation WHERE id = '$pub_op'")" failed; }
# old_refused: a new draft, changing nothing, published as h-publisher on call_port: 202, then the
# operation failed 503 dependency-unavailable naming one of the import's generations, unknown,
# absent; nothing released.
old_refused() {
  local deps
  draft_by h-author old-refused || return 1
  fresh h-publisher
  answers 202 - POST "/api/v1/drafts/$draft/publications" "$tok" '{}' "$(key publication-old-refused)" "$etag" || return 1
  pub_op=$(jq -er '.id' "$EV/last.body") || return 1
  within 150 pub_failed || return 1
  same "$(sql "SELECT count(*) FROM release WHERE operation = '$pub_op'")" 0 || return 1
  deps=$(sql "SELECT json_agg(object) FROM dependency_status WHERE id = ANY (string_to_array('$old_deps', ' '))") || return 1
  fresh h-viewer
  answers_with ".state == \"failed\" and .error.status == 503 and .error.type == \"urn:bronzeward:problem:dependency-unavailable\"
      and .error.dependency.provider == \"kv\" and .error.dependency.class == \"unknown\" and .error.dependency.reason == \"absent\"
      and ($deps | index(.error.dependency.object)) != null" 200 - GET "/api/v1/operations/$pub_op" "$tok"
}

# old_bao: AP S7's variant with the OpenBao snapshot older than the database (PA §13.3). OpenBao's
# snapshot first; then an import of the worker, whose marked file content becomes new KV
# generations, published, so its release pins them; then the database snapshot at T. Both restored
# and the entry recorded through B-recovery, whose monitor runs once the entry commits: each pinned
# generation reads 404 and alerts at once, once. B, restarted normally with recovery mode still on,
# refuses a publication pinning them. The run ends in recovery mode with B running.
old_bao() {
  local ref='S7 older OpenBao'
  machines
  must "$ref" 'C stopped' kill_if_up C "$BW_C"
  must "$ref" 'B-recovery stopped' kill_if_up B-recovery "$BW_B_RECOVERY"
  must "$ref" "the fixture's A stopped" kill_if_up A "$BW_A"
  must "$ref" "B's control file removed" interrupt_of b -
  must "$ref" "C's control file removed" interrupt -
  running "$BW_B" || must "$ref" 'inject start B' "$bin/inject" start B
  must "$ref" 'B running' running "$BW_B"
  call_port=$SERVER_B_PORT
  check "$ref" 'B answers /livez' within 30 answers 204 - GET /livez ''
  check "$ref" 'the installation out of recovery mode' same "$(sql "SELECT recovery_mode FROM installation_state")" f

  # OpenBao's snapshot, then the publication pinning generations it does not hold, then T.
  bao_at=$(now_utc)
  must "$ref" 'inject bao-snapshot s7-old' "$bin/inject" bao-snapshot s7-old
  must "$ref" 'h-author opens a draft: 201' draft_by h-author old
  fresh_author
  must "$ref" "h-author imports the worker into it, its file secret marked: the claim released, the draft's ETag moved" \
    ingest "$machine_w" "$(jq -nc --arg p "$WORKER_MARK" '[$p]')" old
  ing_old=${ingested[-1]}
  must "$ref" "the import's generations written to OpenBao after its snapshot" differ "$(claim_generations "$ing_old")" 0
  must "$ref" "h-publisher publishes the draft: 202, one release, the worker's Desired" publish_by h-publisher old
  rel_old=$new_release
  must "$ref" "the release pins the import's KV generations, each retained" old_pinned
  t_at=$(now_utc)
  must "$ref" 'inject db-snapshot s7-old' "$bin/inject" db-snapshot s7-old
  restored_epoch=$(sql "SELECT epoch FROM installation_state") && [ -n "$restored_epoch" ] || die "cannot read the epoch at T"

  # Both restored, OpenBao to the older snapshot; the entry through B-recovery.
  must "$ref" 'inject kill B' "$bin/inject" kill B
  must "$ref" 'B is not running' stopped "$BW_B"
  must "$ref" 'C is not running' stopped "$BW_C"
  must "$ref" "the fixture's A is not running" stopped "$BW_A"
  stopped_at=$(now_utc)
  must "$ref" 'inject db-restore s7-old' "$bin/inject" db-restore s7-old
  must "$ref" 'inject bao-restore s7-old' "$bin/inject" bao-restore s7-old
  db_backup=$(backup_id pg-s7-old.dump) || die "cannot read the database backup"
  bao_backup=$(backup_id bao-s7-old.snap) || die "cannot read the OpenBao backup"
  check "$ref" "OpenBao is older than the database: the import's generations are gone from it, the release still recorded" \
    same "$(claim_generations "$ing_old") $(sql "SELECT count(*) FROM release WHERE id = '$rel_old'")" '0 1'
  must "$ref" 'inject start B-recovery' "$bin/inject" start B-recovery
  call_port=$SERVER_B_PORT
  check "$ref" 'B-recovery answers /livez' within 30 answers 204 - GET /livez ''
  old_a0=$(sql "SELECT coalesce(max(seq), 0) FROM dependency_alert") && [ -n "$old_a0" ] || die "cannot read the alerts"
  held=''
  entry_reason='S7 older OpenBao: the database restored to T and OpenBao to a snapshot taken before it'
  check "$ref" 'h-recovery records the entry naming the database and provider backups: 201, a new epoch, every machine' enter
  [ -n "$epoch" ] || die "s7: $ref: no entry; nothing after it can run"
  check "$ref" 'the installation in the new epoch, in recovery mode; the entry records the stop and both backups' entry_recorded
  check "$ref" "within two monitor intervals of the entry, each pinned generation observed since it: unknown, absent (OpenBao's 404)" \
    within 150 old_absent
  check "$ref" 'one alert of each, at once: a regression, absent, naming the release' old_alerted
  sleep 70
  check "$ref" 'a monitor interval later, still one alert of each: unknown alerts again only after 15 minutes' old_alerted

  # B, started normally with recovery mode on, runs the publish job and refuses it.
  must "$ref" 'inject kill B-recovery' "$bin/inject" kill B-recovery
  must "$ref" 'inject start B' "$bin/inject" start B
  check "$ref" 'B answers /livez' within 30 answers 204 - GET /livez ''
  check "$ref" "a publication pinning them, a new draft changing nothing: failed 503 dependency-unavailable naming one, unknown, absent; nothing released" \
    old_refused
  end_state='recovery mode on, B running'
}

withheld+=("$BW_CANARY")
end_state='recovery mode exited, B running'
case $s7_mode in
  no-entry) no_entry ;;
  old-bao) old_bao ;;
  *)
    preconditions
    before_t
    at_t
    after_t
    s7
    ;;
esac
rm -f -- "$EV/last.body" "$EV/last.headers"
# The final bundle: the evidence directory and the run directory scanned, as S1's step 5 does.
ev_log=$(mktemp)
if final=$("$bin/evidence" "$EV" 2>"$ev_log"); then
  cat -- "$ev_log" >&2
  if grep --quiet --fixed-strings -- 'positive control found; 0 other file(s) contain' "$ev_log"; then
    result PASS 'S7 evidence' 'bin/evidence scanned the bundle and the run directory; no file but its control holds a fixture secret'
  else
    result FAIL 'S7 evidence' "the leak scan reports fixture secrets: $final/leak-scan.txt"
  fi
  if [ -e "$final/unavailable.txt" ]; then
    result FAIL 'S7 evidence' "the bundle is incomplete: $final/unavailable.txt names what was not captured"
  else
    result PASS 'S7 evidence' 'the bundle is complete: bin/evidence captured every source'
  fi
  # The tokens this run minted, searched in the run directory, the final bundle and every bundle the
  # run captured before it, with a control holding the last of them that must be the one file
  # listed (as s6 does).
  local_ctl=$STATE/s7-token-control
  trap 'rm -f -- "$local_ctl"' EXIT
  if [ "${#secrets[@]}" -gt 0 ]; then printf 'x %s x\n' "${secrets[-1]}" >"$local_ctl"; else : >"$local_ctl"; fi
  earlier=()
  for f in "$EV"/*-bundle; do
    [ -e "$f" ] || continue
    earlier+=("$(cat -- "$f")")
  done
  hits=$(grep --recursive --files-with-matches --fixed-strings --file=<(printf '%s\n' "${secrets[@]}") -- \
    "$EV" "$final" "${earlier[@]}" "$local_ctl") || hits=
  rm -f -- "$local_ctl"
  trap - EXIT
  if [ "${#secrets[@]}" -gt 0 ] && [ "$hits" = "$local_ctl" ]; then
    result PASS 'S7 evidence' "none of the ${#secrets[@]} tokens this run minted is in any bundle of the run or the run directory (control found)"
  else
    printf 's7: files holding a token of this run: %s\n' "${hits:-none, not even the control}" >&2
    result FAIL 'S7 evidence' "the tokens this run minted: ${#secrets[@]} searched, the listing is not the control alone"
  fi
else
  cat -- "$ev_log" >&2
  result FAIL 'S7 evidence' 'bin/evidence failed'
fi
rm -f -- "$ev_log"
say "s7 $s7_mode: $failed failed; $end_state; evidence in $EV, bundle ${final:-none}"
[ "$failed" -eq 0 ]
