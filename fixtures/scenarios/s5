#!/usr/bin/env bash
# Acceptance plan S5, drift, against the fixture. `run`, steps 1 to 5 on the state S4 leaves: the
# instances restarted with a short drift interval; the worker patched out of band with a registry
# password, a new synthetic secret; the next drift observation opens a drift record, the scope not
# frozen; the database and OpenBao snapshotted (s5-step3, step 7's restore point); h-author freezes
# the scope, and an approved revert plan is never committed while it is frozen; in a new draft, a
# drift adoption leaving a copy unmarked is refused; h-author ingests the drifted configuration into
# the draft as a drift adoption, marking both secrets, after which one sent to C is killed at each of
# the pipeline's steps, each outcome scanned; h-author takes S2's label fragment out of the workers
# profile, the adopted base now holding that reference;
# h-publisher publishes it and creates an adopt plan binding the record, h-approver approves, and
# the adoption commits under the freeze: Applied the release with the baseline's digest, the
# baseline revision one more, the record closed adopted. Bronzeward sends the worker no mutating
# request after the patch, nor the control plane at all. Step 5 measures whether the artifact
# compiled from the unchanged import base reproduces the baseline digest, and records it either
# way. Step 6: the worker patched out of band again with a registry mirror, a new record opened;
# h-publisher's revert plan binding it, approved by h-approver as an unseen overwrite; h-publisher's
# unfreeze refused, h-approver's taking effect; the revert completes, the record closed reverted,
# the worker running the artifact, its one mutating request the revert. The interval is set back
# and the instances restarted at the end, or on any earlier exit.
# `roles`, step 7, outside the integrated run: step 3's snapshots restored, h-publisher,
# h-approver, h-recovery and the automation identity each freeze the scope, h-approver unfreezing
# it after each.
# Each check writes PASS, FAIL or SKIP, its acceptance-plan reference and what it checked to s5.tsv
# in the evidence directory and to stdout. Exit 1 on any FAIL.
# `pass`, the integrated run's: `run` without its negative controls (the frozen-scope revert plan,
# the non-approver unfreeze) and without the interruption matrix of the drift adoption. It keeps
# step 4's refused drift adoption: S5's pass criteria name the secret absent on rejection too.
# Usage: scenarios/s5 run|pass|roles   (run or pass after scenarios/s4 run on the same up; roles after run)
set -euo pipefail
here=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
bin=$here/../bin
# shellcheck source-path=SCRIPTDIR source=../lib.sh
. "$here/../lib.sh"

s5_mode=${1:-}
pass_only=''
case $s5_mode in run | roles) ;; pass) pass_only=1 ;; *) die "usage: scenarios/s5 run|pass|roles" ;; esac
need docker curl jq timeout id sleep date awk wc od head tr
need_state
umask 077
image_id=$(cat -- "$STATE/up-image") || die "no server image is recorded in $STATE; run fixtures/bin/up"
image_own "$image_id" || die "the recorded server image is not this run's; run fixtures/bin/down, then up"
EV=$STATE/evidence/s5-$s5_mode-$(date -u +%Y%m%dT%H%M%SZ)
mkdir -p -- "$EV" "$EV/http"
scenario=s5
# shellcheck source-path=SCRIPTDIR source=common.sh
. "$here/common.sh"
run_key=$(date -u +%s%N)
mutation_ref='S5 pass'

# The S1 file secret, still in the worker's configuration, and the registry password step 1 adds.
WORKER_MARK='doc[0]/machine/files/0/content'
# S2's node label is a reference to that secret, so the node carries its value there too, and an
# unmarked copy of a marked value is refused (compilation's guard).
LABEL_MARK='doc[0]/machine/nodeLabels/bw-s2'
REGISTRY=registry.s5.invalid
REGISTRY_MARK="doc[0]/machine/registries/config/$REGISTRY/auth/password"
# The interval S5 observes at, and the one every other scenario runs at (server.yaml.in).
SHORT=5s LONG=168h

cluster='' machine_cp='' machine_w='' baseline='' was='' opened='' plan='' op=''
machine_at() {
  sql "SELECT id FROM machine WHERE cluster = '$cluster' AND talos_endpoint::text = '$1:50000'
    AND talos_node_id NOT LIKE 's1-no-such-node-%'"
}
one_line() { [ -n "$1" ] && [ "$(wc -l <<<"$1")" = 1 ]; }
worker_joined() { [ ! -f "$STATE/linksplits" ] || counted 0 ' worker$' "$STATE/linksplits"; }
# served <jq filter>: h-viewer reads the worker and the body satisfies the filter.
served() {
  fresh h-viewer
  answers_with "$1" 200 - GET "/api/v1/machines/$machine_w" "$tok"
}
# served_observed <jq filter>: served, and the observation served as Observed is one of the worker
# that read the patched digest.
served_observed() {
  local o want
  want=$(digest_of "$EV/patched-talos-config-sha256.txt" "$TALOS_WORKER_IP")
  served "$1" && o=$(jq -er '.observed.observation | strings' "$EV/last.body") && [[ $o =~ ^[A-Za-z0-9_-]+$ ]] && [ -n "$want" ] &&
    [ "$(sql "SELECT count(*) FROM observation WHERE id = '$o' AND machine = '$machine_w'
      AND encode(configuration_digest, 'hex') = '$want'")" = 1 ]
}
# open_records: how many drift records are open on the worker.
open_records() { sql "SELECT count(*) FROM drift_record WHERE machine = '$machine_w' AND closed IS NULL"; }

# interval <value>: each instance's driftInterval set to the value, the file rewritten whole under
# another name and moved into place, in the shell: the file holds the database password. Every
# instance is tried; a failure on one fails the whole.
interval() {
  local i f tmp text rc=0
  for i in a b c; do
    f=$STATE/server/$i/config.yaml
    if ! { text=$(<"$f") && [ "$(grep -c '^  driftInterval: ' <<<"$text")" = 1 ] &&
      text=$(awk -v v="$1" '/^  driftInterval: / { print "  driftInterval: " v; next } { print }' <<<"$text") &&
      tmp=$(mktemp -- "$f.XXXXXX"); }; then
      rc=1
      continue
    fi
    if ! printf '%s\n' "$text" >"$tmp" || ! mv -f -- "$tmp" "$f"; then
      rm -f -- "$tmp"
      rc=1
    fi
  done
  return "$rc"
}
# restarted: A, B and C killed and started again, one at a time, each answering /livez: each
# reads its configuration at start. Every instance is tried.
restarted() {
  local i rc=0
  for i in A B C; do
    { "$bin/inject" kill "$i" && "$bin/inject" start "$i"; } || rc=1
  done
  return "$rc"
}
# Whatever ends the run, a signal or a die included: the patch file, which holds the registry
# password, and the token control removed; the interval set back and the instances restarted if
# this run changed it. The run's status is kept unless the cleanup itself fails.
patch_file=$STATE/s5-registry-patch local_ctl=$STATE/s5-token-control interval_changed=''
on_exit() {
  local rc=$?
  trap - EXIT
  rm -f -- "$patch_file" "$local_ctl" || rc=1
  if [ -e "$patch_file" ]; then
    printf 's5: %s still exists: it holds the registry password; remove it\n' "$patch_file" >&2
    rc=1
  fi
  if [ -n "$interval_changed" ]; then
    if interval "$LONG" && restarted; then
      printf 's5: the drift interval set back to %s on exit\n' "$LONG" >&2
    else
      printf 's5: the drift interval could not be set back to %s; run fixtures/bin/down, then up\n' "$LONG" >&2
      rc=1
    fi
  fi
  exit "$rc"
}
trap on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
# drift_observed_since <revision>: a drift observation of the worker begun after that revision of
# its timeline read its configuration.
drift_observed_since() {
  [ "$(sql "SELECT count(*) FROM observation o JOIN observation_start s ON s.machine = o.machine AND s.revision = o.basis
    WHERE s.machine = '$machine_w' AND s.purpose = 'drift' AND s.revision > $1 AND o.configuration_digest IS NOT NULL")" -ge 1 ]
}
worker_rev() { sql "SELECT coalesce(max(revision), 0) FROM machine_event WHERE machine = '$machine_w'"; }

preconditions() {
  local ref='S5 precondition' since
  cluster=$(sql "SELECT id FROM cluster WHERE name = 'bw-fixture'") || die "s5: cannot read the cluster"
  machine_cp=$(machine_at "$TALOS_CONTROLPLANE_IP") || die "s5: cannot read the control plane's machine"
  one_line "$machine_cp" || die "s5: not one machine at the control plane's endpoint: run scenarios/s1 run first"
  machine_w=$(machine_at "$TALOS_WORKER_IP") || die "s5: cannot read the worker's machine"
  one_line "$machine_w" || die "s5: not one machine at the worker's endpoint: run scenarios/s1 run first"
  interrupt - || die "cannot remove C's control file"
  was=$(sql "SELECT applied_release FROM machine_state WHERE machine = '$machine_w'")
  baseline=$(sql "SELECT baseline_revision FROM machine_state WHERE machine = '$machine_w'")
  check "$ref" "S4 passed: the worker's Applied is its Desired, from source operation" \
    same "$(sql "SELECT (applied_release = desired) || ' ' || applied_source FROM machine_state WHERE machine = '$machine_w'")" 'true operation'
  check "$ref" "no operation holds the worker's scope" \
    same "$(sql "SELECT count(*) FROM operation WHERE machine = '$machine_w' AND state IN ('committed', 'sending', 'verifying', 'unresolved')")" 0
  check "$ref" 'no drift record is open on the worker, and it is not frozen' \
    same "$(open_records) $(sql "SELECT frozen FROM machine WHERE id = '$machine_w'")" '0 f'
  check "$ref" 'no link to the worker is recorded cut' worker_joined
  check "$ref" "the mutation matcher counts an apid line of each mutating Talos API method once and of each read method not at all" \
    methods_counted
  interval_changed=1
  check "$ref" "each instance's driftInterval set to $SHORT" interval "$SHORT"
  since=$(worker_rev) || die "s5: cannot read the worker's timeline"
  check "$ref" 'inject kill and start A, B and C: each reads the interval' restarted
  check "$ref" 'A answers /livez' answers 204 - GET /livez ''
  check "$ref" "a drift observation of the worker read its configuration within a minute of the restart, and opened no record" \
    within 60 drift_observed_since "$since"
  check "$ref" 'no drift record is open on the worker' same "$(open_records)" 0
}

cp_log='' w_log='' w_patched=''
pre_state() {
  local ref='S5 precondition'
  evidence_to pre || die "no pre-state: bin/evidence failed"
  cp -- "$bundle/talos-config-sha256.txt" "$EV/pre-talos-config-sha256.txt"
  cp -- "$bundle/talos-config-version.txt" "$EV/pre-talos-config-version.txt"
  check "$ref" 'the pre-state bundle: complete, no fixture secret but the scan control' scan_clean pre
  check "$ref" 'pre-state: both nodes have a configuration digest and a resource version' \
    same "$(grep -c -E '^[0-9a-f]{64} ' "$EV/pre-talos-config-sha256.txt") $(grep -c -E '^[0-9]+ ' "$EV/pre-talos-config-version.txt")" '2 2'
  check "$ref" "the worker's pre-state digest is its Applied's" \
    same "$(digest_of "$EV/pre-talos-config-sha256.txt" "$TALOS_WORKER_IP")" \
    "$(sql "SELECT encode(applied_digest, 'hex') FROM machine_state WHERE machine = '$machine_w'")"
  cp_log=$(apid_log "$TALOS_CONTROLPLANE_IP") || die "cannot read the control plane's apid log"
  w_log=$(apid_log "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
}

# registry_patch: step 1, a registry password, a new synthetic secret, patched onto the worker out
# of band as a strategic merge patch, no reboot: Talos applies a registries change immediately,
# where a new file needs a reboot. The patch file is removed at once, and by on_exit on any other
# way out; a patch file left behind fails the step. The secret is kept only as a value to search for.
secret=''
registry_patch() {
  local hex rc=0
  hex=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n') && [ "${#hex}" -eq 32 ] || return 1
  secret=BWSYNTH-$hex
  keep_secret "$secret"
  printf 'machine:\n  registries:\n    config:\n      %s:\n        auth:\n          username: bw-s5\n          password: %s\n' \
    "$REGISTRY" "$secret" >"$patch_file" || rc=1
  [ "$rc" -ne 0 ] || node_talos "$TALOS_WORKER_IP" patch machineconfig --mode no-reboot --patch "@$patch_file" >/dev/null 2>&1 || rc=$?
  rm -f -- "$patch_file" || rc=1
  [ ! -e "$patch_file" ] || rc=1
  return "$rc"
}
# record_opened <state>: one drift record open on the worker, naming a drift observation that read
# that state's digest, Applied's digest and that observed one; its opening entry, the alert, on the
# worker's timeline names it. Its revision in opened.
record_opened() {
  local want
  want=$(digest_of "$EV/$1-talos-config-sha256.txt" "$TALOS_WORKER_IP")
  [ -n "$want" ] && [ "$(open_records)" = 1 ] || return 1
  opened=$(sql "SELECT opened FROM drift_record WHERE machine = '$machine_w' AND closed IS NULL")
  [ "$(sql "SELECT (r.applied_digest = s.applied_digest) || ' ' || encode(r.observed_digest, 'hex') || ' '
      || (o.configuration_digest = r.observed_digest) || ' ' || st.purpose
    FROM drift_record r JOIN machine_state s ON s.machine = r.machine
      JOIN observation o ON o.id = r.observation AND o.machine = r.machine
      JOIN observation_start st ON st.machine = o.machine AND st.revision = o.basis
    WHERE r.machine = '$machine_w' AND r.opened = $opened")" = "true $want true drift" ] &&
    [ "$(sql "SELECT count(*) FROM machine_event WHERE machine = '$machine_w' AND revision = $opened AND kind = 'drift'
      AND entry->>'change' = 'opened' AND (entry->>'record')::bigint = $opened
      AND entry->>'observation' = (SELECT observation FROM drift_record WHERE machine = '$machine_w' AND opened = $opened)")" = 1 ]
}
# mutations_are <n> <log before> <log now>: the log holds exactly n mutating requests past the log
# before; no count (a dropped prefix, a failed matcher) is not n.
mutations_are() {
  local got
  got=$(run_mutations "$2" "$3") || return 1
  [ "$got" = "$1" ]
}
# state_kept <state>: a bundle of that name, its digests and resource versions kept as
# <state>-talos-config-*.txt, scanned clean.
state_kept() {
  evidence_to "$1" || return 1
  cp -- "$bundle/talos-config-sha256.txt" "$EV/$1-talos-config-sha256.txt" &&
    cp -- "$bundle/talos-config-version.txt" "$EV/$1-talos-config-version.txt" &&
    scan_clean "$1"
}
# moved_by_patch: the worker's digest and resource version moved with the patch; the control
# plane's did not.
moved_by_patch() {
  local cp_digest cp_version
  cp_digest=$(digest_of "$EV/pre-talos-config-sha256.txt" "$TALOS_CONTROLPLANE_IP")
  cp_version=$(digest_of "$EV/pre-talos-config-version.txt" "$TALOS_CONTROLPLANE_IP")
  differ "$(digest_of "$EV/patched-talos-config-sha256.txt" "$TALOS_WORKER_IP")" "$(digest_of "$EV/pre-talos-config-sha256.txt" "$TALOS_WORKER_IP")" &&
    differ "$(digest_of "$EV/patched-talos-config-version.txt" "$TALOS_WORKER_IP")" "$(digest_of "$EV/pre-talos-config-version.txt" "$TALOS_WORKER_IP")" &&
    [ -n "$cp_digest" ] && [ -n "$cp_version" ] &&
    same "$(digest_of "$EV/patched-talos-config-sha256.txt" "$TALOS_CONTROLPLANE_IP")" "$cp_digest" &&
    same "$(digest_of "$EV/patched-talos-config-version.txt" "$TALOS_CONTROLPLANE_IP")" "$cp_version"
}

detect() {
  local ref='S5 step 1'
  pre_state
  check "$ref" "the worker patched out of band with the pinned talosctl, no reboot: a registry auth password, a new synthetic secret" registry_patch
  [ -n "$secret" ] || die "s5: no secret was patched; nothing after it can run"
  w_patched=$(apid_log "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
  check "$ref" "the worker's apid log records one mutating request past the pre-state: the patch" mutations_are 1 "$w_log" "$w_patched"
  check "$ref" 'the patched-state bundle: complete, no fixture secret but the scan control' state_kept patched
  check "$ref" "the worker's digest and resource version moved with the patch, the control plane's did not" moved_by_patch
  ref='S5 step 2'
  check "$ref" "within a minute a drift observation opens one record naming it, Applied's digest and the patched one; its opening entry, the alert, names the record and the observation" \
    within 60 record_opened patched
  [ -n "$opened" ] || die "s5: no drift record opened; nothing after it can run"
  check "$ref" 'the scope is not frozen by detection' same "$(sql "SELECT frozen FROM machine WHERE id = '$machine_w'")" f
  check "$ref" 'served: the open record, not frozen; Desired and Applied the release, Observed an observation that read the patched digest and matched neither' \
    served_observed ".frozen == false and .openDrift.revision == $opened and .desired == \"$was\" and .applied.release == \"$was\"
      and .observed.release == null"
  ref='S5 step 7'
  check "$ref" 'inject db-snapshot s5-step3, before step 3' "$bin/inject" db-snapshot s5-step3
  check "$ref" 'inject bao-snapshot s5-step3, before step 3' "$bin/inject" bao-snapshot s5-step3
}

# set_freeze <freezes|unfreezes> <who> <role> [reason]: POST /machines/{id}/<route> as that
# identity: 201 naming the machine, the frozen state, the principal and the role; the scope frozen
# or not; one freeze or unfreeze entry records them.
set_freeze() {
  local route=$1 role=$3 reason=${4:-S5 drift} frozen=true kind=freeze
  [ "$route" = freezes ] || frozen=false kind=unfreeze
  fresh "$2"
  answers_with ".machine == \"$machine_w\" and .frozen == $frozen and .role == \"$role\"" \
    201 - POST "/api/v1/machines/$machine_w/$route" "$tok" "$(jq -nc --arg r "$reason" '{reason: $r}')" \
    "$(key "$kind-$2-${reason//[^A-Za-z0-9]/-}")" || return 1
  [ "$(sql "SELECT frozen FROM machine WHERE id = '$machine_w'")" = "${frozen:0:1}" ] &&
    [ "$(sql "SELECT count(*) FROM machine_event WHERE machine = '$machine_w' AND kind = '$kind'
      AND entry->>'principal' = '$(who_id "$2")' AND entry->>'role' = '$role' AND entry->>'reason' = '$reason'")" = 1 ]
}
# freeze_by <who> <role> [reason]: set_freeze freezes.
freeze_by() { set_freeze freezes "$@"; }
# frozen_unselected <plan>: the plan's approval is 30 s old and still the plan is approved with no
# observation begun for it and no operation. The approval wakes the controller and its 5 s heartbeat
# wakes it again, so a live controller has passed over the plan; an idle pass records nothing, so a
# stalled one is not told apart here (the apid log's no-mutation check holds either way). The
# controller selects no plan on a frozen scope; comparison 6, which refuses one that reaches
# commitment, is a Go check (commit_test.go).
frozen_unselected() {
  [ "$(sql "SELECT count(*) FROM approval WHERE plan = '$1' AND at <= clock_timestamp() - interval '30 seconds'")" = 1 ] &&
    plan_state_is "$1" approved &&
    [ "$(sql "SELECT count(*) FROM observation_start WHERE plan = '$1'")" = 0 ] &&
    [ "$(sql "SELECT count(*) FROM operation WHERE plan = '$1'")" = 0 ]
}
cancel_by_creator() {
  fresh h-publisher
  answers 200 - POST "/api/v1/plans/$1/cancellations" "$tok" '{"reason": "S5 frozen-scope control"}' "$(key "cancel-$2")" &&
    plan_state_is "$1" cancelled
}

revert=''
freeze() {
  local ref='S5 step 3'
  check "$ref" 'h-author freezes the scope: 201, the freeze recorded under the author role' freeze_by h-author author
  # Without the freeze, the approved revert below would be committed and mutate the worker.
  [ "$(sql "SELECT frozen FROM machine WHERE id = '$machine_w'")" = t ] || die "s5: the scope is not frozen; nothing after it can run"
  # The frozen-scope control: a revert plan of the worker's Desired, which binds the open record and
  # expects its drifted digest, so that only the freeze holds it back.
  ref='S5 negative controls'
  controls_run "$ref" 'an approved revert plan on the frozen scope, passed over and cancelled' || return 0
  check "$ref" "a plan for the drifted worker as h-publisher, a revert binding the open record: 201" plan_by h-publisher frozen
  revert=$plan_id
  [ -n "$revert" ] || die "s5: no revert plan; nothing after it can run"
  check "$ref" 'the plan binds the open record' same "$(sql "SELECT drift_record FROM plan WHERE id = '$revert'")" "$opened"
  check "$ref" 'approved as h-approver: 201' approve_by h-approver "$revert" frozen
  check "$ref" 'an approved plan on the frozen scope: passed over by the controller, still approved, nothing observed for it and no operation' \
    within 120 frozen_unselected "$revert"
  check "$ref" 'the plan cancelled by its creator, h-publisher' cancel_by_creator "$revert" frozen
}

# adopted: the adopt plan committed to one completed adopt operation with one adoption record;
# Applied the release from source adoption, its digest the import base's and the patched one, the
# baseline revision one more; the record closed adopted by one closing entry; still frozen.
adopted() {
  local want
  want=$(digest_of "$EV/patched-talos-config-sha256.txt" "$TALOS_WORKER_IP")
  op=$(sql "SELECT o.id FROM plan_state s JOIN operation o ON o.id = s.operation
    WHERE s.plan = '$plan' AND s.state = 'committed' AND o.kind = 'adopt' AND o.state = 'completed'")
  [ -n "$op" ] && [ -n "$want" ] &&
    [ "$(sql "SELECT count(*) FROM adoption_record WHERE plan = '$plan' AND machine = '$machine_w'")" = 1 ] &&
    [ "$(sql "SELECT s.applied_release || ' ' || s.applied_source || ' ' || s.baseline_revision || ' '
        || (s.applied_digest = b.configuration_digest) || ' ' || encode(s.applied_digest, 'hex')
      FROM machine_state s JOIN release_machine rm ON rm.release = s.applied_release AND rm.machine = s.machine
        JOIN import_base_revision b ON b.id = rm.import_base_revision AND b.machine = rm.machine
      WHERE s.machine = '$machine_w'")" = "$new_release adoption $((baseline + 1)) true $want" ] &&
    [ "$(sql "SELECT resolution FROM drift_record WHERE machine = '$machine_w' AND opened = $opened")" = adopted ] &&
    [ "$(sql "SELECT count(*) FROM machine_event WHERE machine = '$machine_w' AND kind = 'drift'
      AND (entry->>'record')::bigint = $opened AND entry->>'change' = 'closed' AND entry->>'resolution' = 'adopted'")" = 1 ] &&
    [ "$(sql "SELECT frozen FROM machine WHERE id = '$machine_w'")" = t ]
}
# relied_after_approval: the adoption record's observation, the one of the highest basis whatever
# its purpose (a drift observation may outrun the plan's own), began after the approval and read
# the import base's digest; and the controller took an evidence observation of the plan after the
# approval.
relied_after_approval() {
  [ "$(sql "SELECT count(*) FROM adoption_record r
    JOIN approval a ON a.id = r.approval AND a.plan = r.plan
    JOIN observation o ON o.id = r.observation AND o.machine = r.machine
    JOIN release_machine rm ON rm.release = '$new_release' AND rm.machine = r.machine
    JOIN import_base_revision b ON b.id = rm.import_base_revision
    WHERE r.plan = '$plan' AND o.basis > a.revision AND o.configuration_digest = b.configuration_digest")" = 1 ] &&
    [ "$(sql "SELECT count(*) FROM observation_start s JOIN approval a ON a.plan = s.plan
      WHERE s.machine = '$machine_w' AND s.plan = '$plan' AND s.purpose = 'evidence' AND s.revision > a.revision")" -ge 1 ]
}
# unchanged_since_patch <ip>: in the latest bundle the node's digest and resource version are the
# patched state's.
unchanged_since_patch() {
  [ -n "$(digest_of "$EV/patched-talos-config-version.txt" "$1")" ] &&
    same "$(digest_of "$bundle/talos-config-sha256.txt" "$1")" "$(digest_of "$EV/patched-talos-config-sha256.txt" "$1")" &&
    same "$(digest_of "$bundle/talos-config-version.txt" "$1")" "$(digest_of "$EV/patched-talos-config-version.txt" "$1")"
}

# profile_drops <who> <name> <fragment>: the workers profile, under the draft's ETag, listing its
# head's fragment revisions but <fragment>'s, which it lists once: 200, the ETag replaced. The
# adopted import base holds S2's label as a reference, and a fragment overriding an import-base
# reference refuses publication (base-override, compilation choice §16.20), so the label's
# fragment leaves the profile; the label stays, from the base.
profile_drops() {
  local body
  fresh "$1"
  [ "$(sql "SELECT count(*) FROM profile p JOIN profile_revision_fragment f ON f.revision = p.head_revision_id
    JOIN fragment_revision r ON r.id = f.fragment_revision
    WHERE p.cluster = '$cluster' AND p.name = 'workers' AND r.name = '$3'")" = 1 ] || return 1
  body=$(sql "SELECT coalesce(jsonb_agg(f.fragment_revision ORDER BY f.position), '[]'::jsonb)
    FROM profile p JOIN profile_revision_fragment f ON f.revision = p.head_revision_id
      JOIN fragment_revision r ON r.id = f.fragment_revision
    WHERE p.cluster = '$cluster' AND p.name = 'workers' AND r.name <> '$3'") || return 1
  body=$(jq -nc --argjson l "$body" '{fragments: $l}') || return 1
  answers 200 - PUT "/api/v1/drafts/$draft/profiles/workers" "$tok" "$body" "$(key "profile-$2")" "$etag" || return 1
  differ "$(etag_of_last)" "$etag" || return 1
  etag=$(etag_of_last)
}

# node_at <path>: the inline value at that path of the first document on stdin, a trailing comment
# and plain quotes removed; nothing when the node is absent or its value is not on its key's line. The path is a mark's without its doc[0]/,
# sequence elements by index. Reads the block style Bronzeward and Talos write: a key per line,
# sequence items "- " indented under their key.
node_at() {
  awk -v want="$1" '
    function path(  i, p) { p = k[1]; for (i = 2; i <= n; i++) p = p "/" k[i]; return p }
    function key(ind, t,  name, v) {
      if (t !~ /^[^ :][^:]*:( |$)/) return
      name = t; sub(/:( .*)?$/, "", name)
      v = t; if (!sub(/^[^:]*: /, "", v)) v = ""
      while (n > 0 && ki[n] >= ind) n--
      k[++n] = name; ki[n] = ind
      sub(/[ \t]+#.*$/, "", v)
      if (v ~ /^".*"$/ || v ~ /^\047.*\047$/) v = substr(v, 2, length(v) - 2)
      if (path() == want) { if (v !~ /^[|>][-+0-9]*$/) print v; exit }
      if (v ~ /^[|>][-+0-9]*$/) skip = ind
    }
    BEGIN { skip = -1 }
    /^---/ { exit }
    /^ *(#.*)?$/ { next }
    {
      match($0, /^ */); ind = RLENGTH; t = substr($0, ind + 1)
      # A block scalar'"'"'s body, more indented than its key or item, is text, not keys.
      if (skip >= 0) { if (ind > skip) next; skip = -1 }
      if (substr(t, 1, 2) != "- ") { key(ind, t); next }
      while (n > 0 && ki[n] >= ind) n--
      p = n ? path() : ""
      k[++n] = cnt[p]++; ki[n] = ind
      if (substr(t, 3) ~ /^[|>][-+0-9]*$/) { skip = ind; next }
      key(ind + 2, substr(t, 3))
    }'
}
# reference_at <path>: the !bwref name at that path of the first document on stdin, nothing when
# the node is absent or not a reference.
reference_at() {
  local v
  v=$(node_at "$1") || return 1
  if [[ $v =~ ^!bwref\ ([^ ]+)$ ]]; then printf '%s\n' "${BASH_REMATCH[1]}"; fi
}
# adopted_references: the release's import base for the worker holds the registry password, S1's
# file content and S2's label, at their marks' paths, as !bwref references, each with its reference
# row, whose generation lies under the drift adoption's claim and is read by the metadata identity
# at version 1 (create-only); each generation in gens, by mark. The document goes from the database
# to the reader, never printed.
declare -A gens=()
adopted_references() {
  local rev mark name g v
  rev=$(sql "SELECT import_base_revision FROM release_machine WHERE release = '$new_release' AND machine = '$machine_w'") || return 1
  [ -n "$rev" ] && [ "${#ingested[@]}" -ge 1 ] || return 1
  for mark in "$REGISTRY_MARK" "$WORKER_MARK" "$LABEL_MARK"; do
    name=$(sql "SELECT document FROM import_base_revision WHERE id = '$rev'" | reference_at "${mark#'doc[0]/'}") || return 1
    g=$(sql "SELECT generation FROM import_base_reference WHERE revision = '$rev' AND name = '$name'") || return 1
    [ -n "$name" ] && [ "${g#"gen/$cluster/${ingested[-1]}/"}" != "$g" ] || {
      say "s5: the adopted base's $mark is not a reference to a generation of the drift adoption"
      return 1
    }
    v=$(BAO_TOKEN=$BW_BAO_METADATA_TOKEN bao kv metadata get -format=json -mount=secret "$g" | jq -er '.data.current_version') || return 1
    [ "$v" = 1 ] || {
      say "s5: $g is at version $v, not a create-only generation"
      return 1
    }
    gens[$mark]=$g
  done
}
# adopted_values: each mark's generation holds, as a string, the value the decrypted adopted
# baseline holds at the mark's path, and the registry password's is step 1's secret: a reference
# resolving to a wrong value fails here. Read by the OpenBao administrator; the values stay in the
# shell and its pipes, never printed or written.
adopted_values() {
  local ct plain mark want data
  [ "${#gens[@]}" = 3 ] || return 1
  ct=$(sql "SELECT encode(b.baseline_ciphertext, 'escape') FROM release_machine rm
    JOIN import_base_revision b ON b.id = rm.import_base_revision
    WHERE rm.release = '$new_release' AND rm.machine = '$machine_w'") || return 1
  [ -n "$ct" ] && plain=$(bao write -field=plaintext transit/decrypt/bw-baseline ciphertext="$ct" | base64 -d) || return 1
  for mark in "${!gens[@]}"; do
    want=$(printf '%s\n' "$plain" | node_at "${mark#'doc[0]/'}") || return 1
    data=$(bao kv get -format=json -mount=secret "${gens[$mark]}" | jq -c '.data.data') || return 1
    [ -n "$want" ] && [ "$(printf '%s' "$data" | jq -r '.kind')" = string ] &&
      [ "$(printf '%s' "$data" | jq -r '.value')" = "$want" ] || {
      say "s5: the generation of $mark does not hold the adopted baseline's value at that path as a string"
      return 1
    }
    [ "$mark" != "$REGISTRY_MARK" ] || [ "$want" = "$secret" ] || {
      say "s5: the adopted baseline's registry password is not step 1's secret"
      return 1
    }
  done
}

# The drift adoption's refusal and interruptions (compilation §15, the acceptance plan's S5 pass
# criteria), each in the adoption's draft, the refusal before the one that succeeds and the
# interruptions after it, the record open throughout.
ADOPT_MARKS=$(jq -nc --arg a "$WORKER_MARK" --arg l "$LABEL_MARK" --arg b "$REGISTRY_MARK" '[$a, $l, $b]')
# adoption_body <marks JSON array>: a drift adoption of the worker into the draft, source machine,
# transient.
adoption_body() {
  jq -nc --arg m "$machine_w" --arg d "$draft" --argjson marks "$1" \
    '{kind: "drift-adoption", source: "machine", staging: "transient", machine: $m, draft: $d, marks: $marks}'
}
# adoption_refused: the file content and the password marked, S2's label of the file content not:
# 202, then the claim abandoned without a payload and the operation failed 422 validation-failed,
# guard-value naming the label's path, its problem holding neither secret; the draft's ETag, the
# import base revisions and the claim's generations unchanged, the record still open.
adoption_refused() {
  local revisions ing op n state
  revisions=$(sql 'SELECT count(*) FROM import_base_revision') || return 1
  answers 202 - POST /api/v1/ingestions "$author" \
    "$(adoption_body "$(jq -nc --arg a "$WORKER_MARK" --arg b "$REGISTRY_MARK" '[$a, $b]')")" "$(key adoption-refused)" "$etag" || return 1
  ing=$(jq -er '.ingestion' "$EV/last.body") && op=$(jq -er '.operation' "$EV/last.body") || return 1
  for ((n = 0; n < 60; n++)); do
    state=$(sql "SELECT state FROM staging_claim WHERE id = '$ing' AND kind = 'drift-adoption' AND payload IS NULL")
    case $state in released | abandoned) break ;; esac
    sleep 1
  done
  [ "$state" = abandoned ] || { say "s5: the refused drift adoption's claim is '$state'"; return 1; }
  answers_with ".state == \"failed\" and .error.status == 422 and .error.type == \"urn:bronzeward:problem:validation-failed\"
    and .error.rule == \"guard-value\" and .error.paths == [\"$LABEL_MARK\"]" 200 - GET "/api/v1/operations/$op" "$author" || return 1
  # 1 is the only clean answer: 0 found a secret, and 2 read no pattern file or no body.
  n=0
  grep --quiet --fixed-strings --file=<(printf '%s\n' "$secret") --file="$STATE/scan-patterns.txt" -- "$EV/last.body" || n=$?
  [ "$n" = 1 ] || {
    say "s5: the refused drift adoption's problem holds a secret or could not be scanned (grep exit $n)"
    return 1
  }
  [ "$(sql 'SELECT count(*) FROM import_base_revision')" = "$revisions" ] && [ "$(claim_generations "$ing")" = 0 ] &&
    [ "$(open_records)" = 1 ] && draft_etag_is "$etag"
}
# The kill points: compilation §2.3's steps 0 to 8, as internal/seam names them. A kill from the
# generation step on leaves every generation the drift adoption makes created: the three marks' and
# the Talos schema secrets' (internal/ingest/identify.go), gen_count, read off the successful
# adoption's import base revision before the kills.
kill_points='claim read parse identify substitute guard generation construct baseline'
gen_count=''
generations_made() {
  case $1 in
    generation | construct | baseline) printf '%s\n' "$gen_count" ;;
    *) printf '0\n' ;;
  esac
}
# adoption_generations: gen_count is at least the three marks', and the successful adoption's claim
# lists that many generations.
adoption_generations() {
  [ "$gen_count" -ge 3 ] && same "$(claim_generations "${ingested[-1]}")" "$gen_count"
}
# generations_kept <step>: tk_ing lists as many generations as a kill at the step leaves.
generations_kept() {
  local got
  got=$(claim_generations) || return 1
  [ "$got" = "$(generations_made "$1")" ] || {
    say "s5: killed at $1: $got generation(s) listed under the claim, want $(generations_made "$1")"
    return 1
  }
}
# c_adoption <step>: the drift adoption of the worker, its three marks, POSTed to C under the
# draft's ETag: 202, its claim and operation in tk_ing and tk_op. A kill at the claim can end C
# after its COMMIT but before the 202 is sent; A then replays the committed answer under the key.
tk_op=''
c_adoption() {
  local body rc=0
  tk_ing='' tk_op=''
  body=$(adoption_body "$ADOPT_MARKS")
  call_port=$SERVER_C_PORT
  answers 202 - POST /api/v1/ingestions "$author" "$body" "$(key "adoption-kill-$1")" "$etag" || rc=1
  call_port=$SERVER_A_PORT
  if [ "$rc" -ne 0 ] && [ "$last_status" = 000 ]; then
    answers 202 - POST /api/v1/ingestions "$author" "$body" "$(key "adoption-kill-$1")" "$etag" &&
      grep --quiet --ignore-case '^Idempotent-Replayed: true' "$EV/last.headers" && rc=0
  fi
  [ "$rc" -eq 0 ] || return 1
  tk_ing=$(jq -er '.ingestion' "$EV/last.body") && tk_op=$(jq -er '.operation' "$EV/last.body")
}
# killed_at <step> <kills before>: C exited at the step, the claim held at generation 1 without a
# payload (a transient claim).
killed_at() { c_killed_at "$1" "$(($2 + 1))" && claim_is held 1 none; }
# abandoned_after_kill: the sweep failed tk_op ingestion-abandoned; the record still open.
abandoned_after_kill() {
  [ "$(sql "SELECT state || ' ' || (error->>'type') FROM operation WHERE id = '$tk_op'")" = 'failed urn:bronzeward:problem:ingestion-abandoned' ] &&
    [ "$(open_records)" = 1 ]
}
# adoption_kill <step>: C exits at once at the step. Once the lease lapses the sweep abandons the
# claim and fails the operation; every generation created before the kill is still listed; the
# draft's ETag is unchanged. The bundle is captured while C is still stopped, so its writable layer
# is what the kill left; C is started again after.
adoption_kill() {
  local step=$1 kills ref='S5 step 4, C §15'
  fresh_author
  kills=$(kills_at "$step")
  check "$ref" "C told to exit at once at $step" interrupt "$step" kill
  check "$ref" "drift adoption of the worker on C: 202" c_adoption "$step"
  [ -n "$tk_op" ] || die "s5: the drift adoption on C was not accepted; nothing after it can run"
  check "$ref" "C exits at $step: the claim held at generation 1 without a payload" \
    within 60 killed_at "$step" "$kills"
  check "$ref" "C's control file removed" interrupt -
  check "$ref" "killed at $step: the sweep abandons the claim once its lease lapses, not before" swept_after_lapse 45
  check "$ref" "killed at $step: the operation failed ingestion-abandoned, the record still open" within 45 abandoned_after_kill
  check "$ref" "killed at $step: every generation created before the kill still listed under the claim, none deleted" \
    generations_kept "$step"
  check "$ref" "killed at $step: the draft's ETag unchanged" draft_etag_is "$etag"
  outcome_bundle "$ref" "adoption-kill-$step"
  check "$ref" 'inject start C' "$bin/inject" start C
}
# adopted_baseline: the OpenBao administrator decrypts the release's import base baseline for the
# worker outside Bronzeward; its configuration digest is the one recorded and the patched state's.
# The plaintext stays in the pipe.
adopted_baseline() {
  local row ct recorded got want
  row=$(sql "SELECT encode(b.baseline_ciphertext, 'escape') || ' ' || encode(b.configuration_digest, 'hex')
    FROM release_machine rm JOIN import_base_revision b ON b.id = rm.import_base_revision
    WHERE rm.release = '$new_release' AND rm.machine = '$machine_w'") || return 1
  ct=${row%% *} recorded=${row##* }
  [ -n "$ct" ] || return 1
  got=$(printf '%s\n' "$(bao write -field=plaintext transit/decrypt/bw-baseline ciphertext="$ct" | base64 -d)" |
    sha256sum | cut -d' ' -f1) || return 1
  want=$(digest_of "$EV/patched-talos-config-sha256.txt" "$TALOS_WORKER_IP")
  [ -n "$want" ] && [ "$got" = "$recorded" ] && [ "$got" = "$want" ] || {
    say "s5: decrypted adopted baseline $got, recorded $recorded, patched $want"
    return 1
  }
}

# adoption_kind: the last ingestion's claim is stored as a drift adoption, and served as one.
adoption_kind() {
  [ "$(sql "SELECT kind FROM staging_claim WHERE id = '${ingested[-1]}'")" = drift-adoption ] &&
    answers_with '.kind == "drift-adoption"' 200 - GET "/api/v1/ingestions/${ingested[-1]}" "$author"
}

adopt() {
  local ref='S5 step 4' plan_body_json w_after cp_after step
  check "$ref" 'h-author opens a new draft: 201' draft_by h-author adopt
  fresh_author
  check "$ref, C §15" "a drift adoption marking the file content and the password, not S2's label of it: the claim abandoned, the operation failed 422 guard-value naming the label, no secret in its problem; the draft's ETag, the revisions and gen/ unchanged, the record open" \
    adoption_refused
  outcome_bundle "$ref, C §15" adoption-refused
  fresh_author
  ingest_kind=drift-adoption
  check "$ref" "h-author ingests the drifted configuration into it as a drift adoption, If-Match its ETag, marking the S1 file's content, S2's label of it and the registry password: 202, the claim released, the operation succeeded, the ETag moved" \
    ingest "$machine_w" "$ADOPT_MARKS" adopt
  ingest_kind=import
  check "$ref" 'the ingestion is stored and served as a drift adoption' adoption_kind
  outcome_bundle "$ref" adoption-ingestion
  # The interruptions follow the success, into the same draft under its new ETag: each is a drift
  # adoption the open record admits, and the draft and the record are unchanged by each.
  if controls_run "$ref, C §15" "the drift adoption's interruption matrix, killed at each pipeline step, with its generation-count control"; then
    gen_count=$(sql "SELECT count(*) FROM import_base_reference WHERE revision =
      (SELECT id FROM import_base_revision WHERE machine = '$machine_w' ORDER BY created_at DESC LIMIT 1)") ||
      die "s5: cannot count the adopted revision's references"
    check "$ref, C §15" "control: the drift adoption made $gen_count generations, one per reference of its revision and at least its three marks', as many as a kill after the generation step keeps" \
      adoption_generations
    for step in $kill_points; do adoption_kill "$step"; done
  fi
  check "$ref" "h-author takes S2's label fragment out of the workers profile, the adopted base holding that reference: 200, the ETag replaced" \
    profile_drops h-author adopt s2-labels
  check "$ref" 'h-publisher publishes the draft under its new ETag: 202, one release, the worker'"'"'s Desired' publish_by h-publisher adopt
  [ -n "$new_release" ] || die "s5: no release; nothing after it can run"
  check "$ref" "the release's import base for the worker: the registry password, S1's file content and S2's label are references to create-only generations of the drift adoption" \
    adopted_references
  check "$ref" "the release's import base baseline, decrypted by the administrator, has the recorded configuration digest, the patched state's" \
    adopted_baseline
  check "$ref" "each of those generations holds, as a string, the decrypted baseline's value at its mark's path; the password's is step 1's secret" \
    adopted_values
  plan_body_json=$(jq -nc --arg r "$new_release" --arg m "$machine_w" '{releaseId: $r, machine: $m, operation: "adopt"}')
  fresh h-publisher
  check "$ref" 'h-publisher creates an adopt plan of the release: 201, binding the open record' \
    answers_with ".driftRecord == $opened" 201 - POST /api/v1/plans "$tok" "$plan_body_json" "$(key plan-adopt)"
  plan=$(jq -er '.id' "$EV/last.body") || die "s5: no adopt plan; nothing after it can run"
  check "$ref" 'h-approver approves it: 201' approve_by h-approver "$plan" adopt
  check "$ref" "the adoption commits under the freeze: Applied the release from source adoption, its digest the import base's and the patched one, the baseline revision one more, the record closed adopted" \
    within 120 adopted
  [ -n "$op" ] || die "s5: the adoption did not complete; nothing after it can run"
  check "$ref" 'the adoption rests on an observation begun after the approval that read the import base digest; the controller took an evidence observation of the plan after the approval' relied_after_approval
  check "$ref" 'served: Desired and Applied the release from source adoption, Observed an observation that read the patched digest and matched it, still frozen, no open record' \
    served_observed ".desired == \"$new_release\" and .applied.release == \"$new_release\" and .applied.source == \"adoption\"
      and .observed.release == \"$new_release\" and .frozen == true and .openDrift == null"

  ref='S5 pass'
  evidence_to post || die "no post-state: bin/evidence failed"
  check "$ref" 'the post-state bundle: complete, no fixture secret but the scan control' scan_clean post
  check "$ref" "the worker's digest and resource version are the patched state's: only the patch moved them" unchanged_since_patch "$TALOS_WORKER_IP"
  check "$ref" "the control plane's digest and resource version are the pre-state's" unchanged_since_patch "$TALOS_CONTROLPLANE_IP"
  w_after=$(apid_log "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
  cp_after=$(apid_log "$TALOS_CONTROLPLANE_IP") || die "cannot read the control plane's apid log"
  no_mutation 'the worker, past the patch,' "$TALOS_WORKER_IP" "$w_patched" "$w_after"
  no_mutation 'the control plane' "$TALOS_CONTROLPLANE_IP" "$cp_log" "$cp_after"
}

# Step 5: does the artifact compiled from the unchanged import base reproduce the baseline digest?
# Recorded either way (acceptance plan S5's pass criteria).
measure() {
  local ref='S5 step 5' got
  got=$(sql "SELECT CASE WHEN rm.configuration_digest = s.applied_digest THEN 'reproduces' ELSE 'differs' END
      || ' ' || encode(rm.configuration_digest, 'hex') || ' ' || encode(s.applied_digest, 'hex')
    FROM machine_state s JOIN release_machine rm ON rm.release = s.applied_release AND rm.machine = s.machine
    WHERE s.machine = '$machine_w'") || got=
  if [ -n "$got" ]; then
    printf 'result artifact baseline\n%s\n' "$got" >"$EV/step5-measurement.txt"
    result PASS "$ref" "the artifact compiled from the import base ${got%% *} the baseline digest (step5-measurement.txt)"
  else
    result FAIL "$ref" 'the artifact and baseline digests could not be read'
  fi
}

# mirror_patch: step 6's out-of-band patch, a registry mirror, nothing secret, applied without a
# reboot as step 1's is. The patch file is removed at once, and by on_exit on any other way out.
MIRROR=mirror.s5.invalid
mirror_patch() {
  local rc=0
  printf 'machine:\n  registries:\n    mirrors:\n      %s:\n        endpoints:\n          - https://%s\n' \
    "$MIRROR" "$MIRROR" >"$patch_file" || rc=1
  [ "$rc" -ne 0 ] || node_talos "$TALOS_WORKER_IP" patch machineconfig --mode no-reboot --patch "@$patch_file" >/dev/null 2>&1 || rc=$?
  rm -f -- "$patch_file" || rc=1
  return "$rc"
}
# moved_from <state> <earlier state>: the worker's digest and resource version differ between them.
moved_from() {
  local f
  for f in sha256 version; do
    [ -n "$(digest_of "$EV/$2-talos-config-$f.txt" "$TALOS_WORKER_IP")" ] &&
      differ "$(digest_of "$EV/$1-talos-config-$f.txt" "$TALOS_WORKER_IP")" "$(digest_of "$EV/$2-talos-config-$f.txt" "$TALOS_WORKER_IP")" ||
      return 1
  done
}
# unfreeze_refused <who>: an unfreeze by that identity, holding no approver role: 403, still frozen.
unfreeze_refused() {
  fresh "$1"
  answers 403 - POST "/api/v1/machines/$machine_w/unfreezes" "$tok" '{"reason": "S5 revert"}' "$(key "unfreeze-$1")" &&
    [ "$(sql "SELECT frozen FROM machine WHERE id = '$machine_w'")" = t ]
}
# reverted: the revert plan committed to one completed apply-config operation; Applied the adopted
# release from source operation with its artifact's digest; the new record closed reverted by one
# closing entry, none open.
redrift='' rplan='' rop=''
reverted() {
  rop=$(sql "SELECT o.id FROM plan_state s JOIN operation o ON o.id = s.operation
    WHERE s.plan = '$rplan' AND s.state = 'committed' AND o.kind = 'apply-config' AND o.state = 'completed'")
  [ -n "$rop" ] &&
    [ "$(sql "SELECT s.applied_release || ' ' || s.applied_source || ' ' || (s.applied_digest = rm.configuration_digest)
      FROM machine_state s JOIN release_machine rm ON rm.release = s.applied_release AND rm.machine = s.machine
      WHERE s.machine = '$machine_w'")" = "$new_release operation true" ] &&
    [ "$(sql "SELECT resolution FROM drift_record WHERE machine = '$machine_w' AND opened = $redrift")" = reverted ] &&
    [ "$(sql "SELECT count(*) FROM machine_event WHERE machine = '$machine_w' AND kind = 'drift'
      AND (entry->>'record')::bigint = $redrift AND entry->>'change' = 'closed' AND entry->>'resolution' = 'reverted'")" = 1 ] &&
    [ "$(open_records)" = 0 ]
}
# artifact_running: in the reverted state the worker's digest is the revert artifact's, and its
# resource version moved from the repatched state's.
artifact_running() {
  local want
  want=$(sql "SELECT encode(configuration_digest, 'hex') FROM release_machine WHERE release = '$new_release' AND machine = '$machine_w'")
  [ -n "$want" ] && same "$(digest_of "$EV/reverted-talos-config-sha256.txt" "$TALOS_WORKER_IP")" "$want" &&
    moved_from reverted repatched
}

# Step 6: drifted again, the scope still frozen from step 3, then an approved revert, unfrozen.
revert_step() {
  local ref='S5 step 6' adopted_rec=$opened w_before w_repatched w_reverted cp_before cp_now
  w_before=$(apid_log "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
  cp_before=$(apid_log "$TALOS_CONTROLPLANE_IP") || die "cannot read the control plane's apid log"
  check "$ref" 'the worker patched out of band again with the pinned talosctl, no reboot: a registry mirror' mirror_patch
  w_repatched=$(apid_log "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
  check "$ref" "the worker's apid log records one mutating request past the adoption: the patch" mutations_are 1 "$w_before" "$w_repatched"
  check "$ref" 'the repatched-state bundle: complete, no fixture secret but the scan control' state_kept repatched
  check "$ref" "the worker's digest and resource version moved with the patch" moved_from repatched patched
  check "$ref" "within a minute a drift observation opens a new record naming it, Applied's digest and the repatched one; its opening entry, the alert, names the record and the observation" \
    within 60 record_opened repatched
  redrift=$opened opened=$adopted_rec
  [ -n "$redrift" ] && [ "$redrift" != "$opened" ] || die "s5: no new drift record opened; nothing after it can run"
  check "$ref" 'a plan for the drifted worker as h-publisher, a revert binding the new record: 201' plan_by h-publisher revert
  rplan=$plan_id
  [ -n "$rplan" ] || die "s5: no revert plan; nothing after it can run"
  check "$ref" 'the plan binds the new record' same "$(sql "SELECT drift_record FROM plan WHERE id = '$rplan'")" "$redrift"
  check "$ref" 'approved as h-approver: 201' approve_by h-approver "$rplan" revert
  check "$ref" 'the approval is recorded as approving an unseen overwrite, as answered and on the timeline' approved_unseen "$rplan"
  if controls_run 'S5 negative controls' 'unfreezing by h-publisher, not an approver'; then
    check 'S5 negative controls' 'unfreezing by h-publisher, not an approver: 403, the scope still frozen' unfreeze_refused h-publisher
  fi
  check "$ref" 'h-approver unfreezes the scope: 201, the unfreeze recorded under the approver role' \
    set_freeze unfreezes h-approver approver 'S5 revert'
  check "$ref" "the revert runs as S4: committed to a completed apply-config operation, Applied the adopted release from source operation with its artifact's digest, the new record closed reverted" \
    within 180 reverted
  [ -n "$rop" ] || die "s5: the revert did not complete; nothing after it can run"
  check "$ref" 'served: Desired and Applied the release, not frozen, no open record' \
    served ".desired == \"$new_release\" and .applied.release == \"$new_release\" and .frozen == false and .openDrift == null"
  check "$ref" 'the reverted-state bundle: complete, no fixture secret but the scan control' state_kept reverted
  check "$ref" "the worker's digest is the revert artifact's and its resource version moved" artifact_running
  w_reverted=$(apid_log "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
  cp_now=$(apid_log "$TALOS_CONTROLPLANE_IP") || die "cannot read the control plane's apid log"
  check 'S5 pass' "the worker's apid log records one mutating request past the second patch: the revert" \
    mutations_are 1 "$w_repatched" "$w_reverted"
  no_mutation 'the control plane, through step 6,' "$TALOS_CONTROLPLANE_IP" "$cp_before" "$cp_now"
}

# Step 7 (mode roles), outside the integrated run: S5 step 3's snapshots restored, each other role
# that may freeze the scope freezes it, the automation identity's recorded as author (its first
# qualifying role), h-approver unfreezing it after each.
restored_step3() {
  [ "$(sql "SELECT frozen FROM machine WHERE id = '$machine_w'")" = f ] && [ "$(open_records)" = 1 ] &&
    [ "$(sql "SELECT count(*) FROM machine_event WHERE machine = '$machine_w' AND kind = 'freeze'
      AND entry->>'reason' = 'S5 drift'")" = 0 ]
}
db_reads() {
  fresh h-viewer
  [ "$(call GET "/api/v1/machines/$machine_w" "$tok")" = 200 ]
}
roles() {
  local ref='S5 step 7' who role
  robot=$(cat -- "$STATE/automation-token") || die "no automation token in $STATE"
  redact_automation_token "$robot"
  robot_id=$(sed -n 's/^identity \(idn_[a-z2-7]*\):.*/\1/p' "$STATE/automation-identity")
  [ -n "$robot_id" ] || die "s5: no automation identity in $STATE"
  cluster=$(sql "SELECT id FROM cluster WHERE name = 'bw-fixture'") || die "s5: cannot read the cluster"
  machine_w=$(machine_at "$TALOS_WORKER_IP") || die "s5: cannot read the worker's machine"
  one_line "$machine_w" || die "s5: not one machine at the worker's endpoint: run scenarios/s1 run first"
  check "$ref" 'inject pause A, B and C' servers pause
  check "$ref" 'inject db-restore s5-step3' "$bin/inject" db-restore s5-step3
  check "$ref" 'inject bao-restore s5-step3' "$bin/inject" bao-restore s5-step3
  check "$ref" 'inject unpause A, B and C' servers unpause
  check "$ref" 'A reads the restored database' within 60 db_reads
  check "$ref" "restored: step 2's record open, the scope not frozen, step 3's freeze not yet made" restored_step3
  for who in h-publisher:publisher h-approver:approver h-recovery:recovery-admin robot:author; do
    role=${who#*:} who=${who%%:*}
    check "$ref" "$who freezes the scope: 201, the freeze recorded under the $role role" freeze_by "$who" "$role" "S5 step 7 $who"
    check "$ref" "h-approver unfreezes it: 201, the unfreeze recorded under the approver role" \
      set_freeze unfreezes h-approver approver "S5 step 7 after $who"
  done
}

# Back to the interval every other scenario runs at.
restore_interval() {
  local ref='S5 handoff' before=$failed
  check "$ref" "each instance's driftInterval set back to $LONG" interval "$LONG"
  check "$ref" 'inject kill and start A, B and C: each reads it' restarted
  # Set back: on_exit has nothing left to restore. Otherwise it tries once more.
  [ "$failed" -ne "$before" ] || interval_changed=''
}

backup_name=s5-$run_key
run() {
  withheld+=("$BW_CANARY")
  preconditions
  detect
  freeze
  adopt
  measure
  revert_step
  check 'S5 retained evidence' "the worker's timeline, every page, as served" keep timeline "/api/v1/machines/$machine_w/timeline"
  # The frozen-scope plan exists only where its control ran (not in the pass mode).
  local cancelled=true cancelled_text=''
  if [ -n "$revert" ]; then
    cancelled="any(.[]; .kind == \"plan-cancellation\" and .entry.plan == \"$revert\" and .entry.reason == \"S5 frozen-scope control\")"
    cancelled_text=", the frozen-scope plan's cancellation"
  fi
  check 'S5 retained evidence' "the kept timeline holds the record's opening and closing entries, the freeze$cancelled_text, the adoption and the Applied change naming the adopted release" \
    kept timeline "any(.[]; .kind == \"drift\" and (.entry.record | tostring) == \"$opened\" and .entry.change == \"opened\")
      and any(.[]; .kind == \"drift\" and (.entry.record | tostring) == \"$opened\" and .entry.change == \"closed\")
      and any(.[]; .kind == \"freeze\" and .entry.reason == \"S5 drift\")
      and $cancelled
      and any(.[]; .kind == \"adoption\" and .entry.plan == \"$plan\" and .entry.operation == \"$op\")
      and any(.[]; .kind == \"applied-change\" and .entry.plan == \"$plan\" and .entry.operation == \"$op\" and (tostring | contains(\"$new_release\")))"
  check 'S5 retained evidence' "the kept timeline holds step 6's record opening and closing reverted, the unseen-overwrite approval, the unfreeze and the revert's Applied change" \
    kept timeline "any(.[]; .kind == \"drift\" and (.entry.record | tostring) == \"$redrift\" and .entry.change == \"opened\")
      and any(.[]; .kind == \"drift\" and (.entry.record | tostring) == \"$redrift\" and .entry.change == \"closed\" and .entry.resolution == \"reverted\")
      and any(.[]; .kind == \"approval\" and .entry.plan == \"$rplan\" and .entry.unseenOverwrite == true)
      and any(.[]; .kind == \"unfreeze\" and .entry.reason == \"S5 revert\" and .entry.role == \"approver\")
      and any(.[]; .kind == \"applied-change\" and .entry.plan == \"$rplan\" and .entry.operation == \"$rop\")"
  check 'S5 retained evidence' "the worker's observation records, every page, as served" keep observations "/api/v1/machines/$machine_w/observations"
  check 'S5 retained evidence' "the kept observations hold the drift record's and the adoption's" \
    kept observations "([.[].id] | index(\"$(sql "SELECT observation FROM drift_record WHERE machine = '$machine_w' AND opened = $opened")\") != null)
      and ([.[].id] | index(\"$(sql "SELECT observation FROM adoption_record WHERE plan = '$plan'")\") != null)"
  check 'S5 backups' 'inject db-snapshot: a dump of the bronzeward database after the adoption' "$bin/inject" db-snapshot "$backup_name"
  restore_interval
}

if [ "$s5_mode" != roles ]; then
  run
else
  withheld+=("$BW_CANARY")
  roles
fi
rm -f -- "$EV/last.body" "$EV/last.headers"
# The final bundle: the evidence directory and the run directory scanned, as S4's does.
ev_log=$(mktemp)
if final=$("$bin/evidence" "$EV" 2>"$ev_log"); then
  cat -- "$ev_log" >&2
  if grep --quiet --fixed-strings -- 'positive control found; 0 other file(s) contain' "$ev_log"; then
    result PASS 'S5 evidence' 'bin/evidence scanned the bundle and the run directory; no file but its control holds a fixture secret'
  else
    result FAIL 'S5 evidence' "the leak scan reports fixture secrets: $final/leak-scan.txt"
  fi
  if [ -e "$final/unavailable.txt" ]; then
    result FAIL 'S5 evidence' "the bundle is incomplete: $final/unavailable.txt names what was not captured"
  else
    result PASS 'S5 evidence' 'the bundle is complete: bin/evidence captured every source'
  fi
  # The scan above covers the dump only if the bundle holds it expanded: the adopt operation's own
  # row inside its COPY block, whose first column is the ID. Mode roles takes no dump.
  if [ "$s5_mode" = roles ]; then
    :
  elif [ -n "$op" ] &&
    awk -v id="$op" '
      index($0, "COPY public.operation ") == 1 { block = 1; next }
      block && /^\\\.$/ { block = 0 }
      block && index($0, id "\t") == 1 { found = 1 }
      END { exit !found }' "$final/backups/pg-$backup_name.dump.sql"; then
    result PASS 'S5 backups' 'the scanned bundle holds the database dump expanded, the adopt operation among its rows (control)'
  else
    result FAIL 'S5 backups' 'the scanned bundle does not hold the database dump expanded with the run'"'"'s rows: the backup went unscanned'
  fi
  # The tokens this run minted and the registry password, searched in the run directory, the final
  # bundle and every bundle the run captured before it, with a control holding the last of them
  # that must be the one file listed.
  if [ "${#secrets[@]}" -gt 0 ]; then printf 'x %s x\n' "${secrets[-1]}" >"$local_ctl"; else : >"$local_ctl"; fi
  earlier=()
  for f in "$EV"/*-bundle; do
    [ -e "$f" ] || continue
    earlier+=("$(cat -- "$f")")
  done
  hits=$(grep --recursive --files-with-matches --fixed-strings --file=<(printf '%s\n' "${secrets[@]}") -- \
    "$EV" "$final" "${earlier[@]}" "$local_ctl") || hits=
  rm -f -- "$local_ctl"
  if [ "${#secrets[@]}" -gt 0 ] && [ "$hits" = "$local_ctl" ]; then
    result PASS 'S5 evidence' "none of the ${#secrets[@]} tokens and secrets of this run, the registry password among them, is in any bundle of the run or the run directory (control found)"
  else
    printf 's5: files holding a token or secret of this run: %s\n' "${hits:-none, not even the control}" >&2
    result FAIL 'S5 evidence' "the tokens and secrets of this run: ${#secrets[@]} searched, the listing is not the control alone"
  fi
else
  cat -- "$ev_log" >&2
  result FAIL 'S5 evidence' 'bin/evidence failed'
fi
rm -f -- "$ev_log"
say "s5 $s5_mode: $failed failed; evidence in $EV, bundle ${final:-none}"
[ "$failed" -eq 0 ]
