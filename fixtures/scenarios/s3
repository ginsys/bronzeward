#!/usr/bin/env bash
# Acceptance plan S3, the handover, against the fixture. `handover`: the S1 import draft published
# as one release, then an adopt plan for each of S1's two machines, created as h-publisher and
# approved as h-approver; each is adopted without a single Talos mutation, Applied the import base's
# digest, source adoption, baseline revision 1, the nodes' configuration digests and resource
# versions what the pre-state read, and a second adopt plan for an adopted machine refused. This is
# the state S2 starts from. `handover-controls`: the controls that refuse or hold an adoption
# before it commits, on the same precondition: the worker's configuration changed out of band, so
# its adopt plan is refused (4.4) once and the machine stays unadopted; and, on instance C with A
# and B paused, the evidence observation of the control plane stalled past the age its plan binds,
# so that its adoption is not recorded from it, nothing is refused, and it is recorded from a later
# observation. Each case gets its evidence bundle, scanned for every fixture secret. Each check
# writes PASS, FAIL or SKIP, its acceptance-plan reference and what it checked to s3.tsv in the
# evidence directory and to stdout. Exit 1 on any FAIL.
# `run`: the approval part, on the state S2 leaves. The worker has no plan but the handover's: an
# apply-config plan of the S2 release is created, read redacted and approved (steps 1 to 3); the
# controls that refuse or end a plan before its commitment (approval by the wrong identities, a
# second approval, the superseded release, expiry, cancellation by each role that may, revocation
# of an approval) leave no operation; and from a restore of the snapshots taken before step 2, the
# three self-approval cases of step 4, each approval with the reasons that hold. The controller
# dispatches an approved plan, so the part first cuts A's, B's and C's links to the worker and
# leaves them cut: the executor's evidence observation fails and nothing commits; S4 joins them
# again. The commitment-level controls are S4's.
# Usage: scenarios/s3 handover|handover-controls   (each after scenarios/s1 run on a fresh
# fixtures/bin/up: the handover is S2's precondition, the controls are their own run)
#        scenarios/s3 run   (after scenarios/s1 run, s3 handover and s2 run on the same up)
set -euo pipefail
here=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
bin=$here/../bin
# shellcheck source-path=SCRIPTDIR source=../lib.sh
. "$here/../lib.sh"

s3_mode=${1:-}
case $s3_mode in handover | handover-controls | run) ;; *) die "usage: scenarios/s3 handover|handover-controls|run" ;; esac
need docker curl jq timeout id sleep date awk wc
need_state
# No fixture lock of its own: inject and evidence each take the one they need.
umask 077
image_id=$(cat -- "$STATE/up-image") || die "no server image is recorded in $STATE; run fixtures/bin/up"
image_own "$image_id" || die "the recorded server image is not this run's; run fixtures/bin/down, then up"
EV=$STATE/evidence/s3-$s3_mode-$(date -u +%Y%m%dT%H%M%SZ)
mkdir -p -- "$EV" "$EV/http"
scenario=s3
# shellcheck source-path=SCRIPTDIR source=common.sh
. "$here/common.sh"
run_key=$(date -u +%s%N)
mutation_ref='S3 handover pass'
[ "$s3_mode" != run ] || mutation_ref='S3 approval pass'

cluster='' machine_cp='' machine_w='' import_draft='' release='' pub_op=''
# h-publisher's and h-approver's tokens, minted again as the author's is (common.sh).
publisher='' publisher_at=0 approver='' approver_at=0
fresh_publisher() {
  [ -z "$publisher" ] || [ $((SECONDS - publisher_at)) -ge 180 ] || return 0
  publisher=$(mint h-publisher) || die "cannot mint a publisher token"
  keep_secret "$publisher"
  publisher_at=$SECONDS
}
fresh_approver() {
  [ -z "$approver" ] || [ $((SECONDS - approver_at)) -ge 180 ] || return 0
  approver=$(mint h-approver) || die "cannot mint an approver token"
  keep_secret "$approver"
  approver_at=$SECONDS
}
# c_live: instance C answers /livez.
c_live() {
  local got
  call_port=$SERVER_C_PORT
  got=$(call GET /livez '')
  call_port=$SERVER_A_PORT
  [ "$got" = 204 ]
}

# The machines S1 recorded, by their Talos endpoints. S1's node-ID case also leaves a stranger at
# the control plane's endpoint, with a node ID no node has; it is no machine of the cluster's.
machine_at() {
  sql "SELECT id FROM machine WHERE cluster = '$cluster' AND talos_endpoint::text = '$1:50000'
    AND talos_node_id NOT LIKE 's1-no-such-node-%'"
}
# one_line <value>: a single non-empty line.
one_line() { [ -n "$1" ] && [ "$(wc -l <<<"$1")" = 1 ]; }

# publish_import: the S1 import draft, both machines imported into it, published as h-publisher
# under its current ETag; the release in $release, which covers both machines.
publish_import() {
  fresh_author
  fresh_publisher
  answers 200 - GET "/api/v1/drafts/$import_draft" "$author" || return 1
  etag=$(etag_of_last)
  [ -n "$etag" ] || return 1
  # An adopt plan binds the machine's assignment head as the release compiled it, so each machine
  # has an assignment, and an assignment must select something: one cluster-layer fragment, a
  # single node label, which the release then carries beyond the import (pending convergence).
  local m body
  body=$(jq -nc '{layer: "cluster", document: "machine:\n  nodeLabels:\n    bw-s3-handover: \"yes\"\n", marks: []}') || return 1
  answers 200 - PUT "/api/v1/drafts/$import_draft/fragments/s3-handover" "$author" "$body" "$(key fragment-s3-handover)" "$etag" || return 1
  etag=$(etag_of_last)
  [ -n "$etag" ] || return 1
  for m in "$machine_cp" "$machine_w"; do
    answers 200 - PUT "/api/v1/drafts/$import_draft/assignments/$m" "$author" \
      '{"profiles": [], "fragments": {"cluster": ["s3-handover"]}}' "$(key "assignment-$m")" "$etag" || return 1
    etag=$(etag_of_last)
    [ -n "$etag" ] || return 1
  done
  answers 202 - POST "/api/v1/drafts/$import_draft/publications" "$publisher" '{}' "$(key publication)" "$etag" || return 1
  pub_op=$(jq -er '.id' "$EV/last.body") || return 1
  within 120 pub_succeeded || return 1
  release=$(sql "SELECT id FROM release WHERE operation = '$pub_op'")
  [ -n "$release" ] &&
    [ "$(sql "SELECT state FROM draft WHERE id = '$import_draft'")" = published ] &&
    [ "$(sql "SELECT count(*) FROM release_machine WHERE release = '$release'")" = 2 ]
}

# make_plan <machine> <name> [extra body fields as a JSON object]: an adopt plan of the release for
# the machine, created as h-publisher; 201, its id in plan_id (common.sh's).
make_plan() {
  local body extra=${3:-'{}'}
  plan_id=''
  fresh_publisher
  body=$(jq -nc --arg r "$release" --arg m "$1" --argjson x "$extra" \
    '{releaseId: $r, machine: $m, operation: "adopt"} + $x') || return 1
  answers 201 - POST /api/v1/plans "$publisher" "$body" "$(key "plan-$2")" || return 1
  plan_id=$(jq -er '.id' "$EV/last.body")
}
# approve_plan <plan> <name>: the plan approved as h-approver: 201.
approve_plan() {
  fresh_approver
  answers 201 - POST "/api/v1/plans/$1/approvals" "$approver" '{}' "$(key "approval-$2")"
}
# plans_committed <n> <plan>...: exactly n of the plans are committed.
plans_committed() {
  local n=$1 ids
  shift
  ids=$(printf "'%s'," "$@")
  [ "$(sql "SELECT count(*) FROM plan_state WHERE state = 'committed' AND plan IN (${ids%,})")" = "$n" ]
}
# adopted_plans: the plans whose adoption the run recorded; the dump's control looks for the first.
adopted_plans=()
# adoption_recorded <machine> <node ip> <plan>: the plan committed to one completed adopt operation
# with one adoption record, the record's observation an evidence observation of that plan begun
# after the plan's approval on the machine's timeline, and the machine's Desired and Applied the
# release, source adoption, baseline revision 1, Applied's digest the import base's and the
# pre-state's read from the node, the adoption and the Applied change each on the machine's
# timeline once.
adoption_recorded() {
  local m=$1 ip=$2 p=$3 want
  want=$(digest_of "$EV/pre-talos-config-sha256.txt" "$ip")
  [ -n "$want" ] || return 1
  [ "$(sql "SELECT s.state || ' ' || o.kind || ' ' || o.state FROM plan_state s JOIN operation o ON o.id = s.operation
      WHERE s.plan = '$p'")" = 'committed adopt completed' ] &&
    [ "$(sql "SELECT count(*) FROM adoption_record WHERE plan = '$p' AND machine = '$m'")" = 1 ] &&
    [ "$(sql "SELECT count(*) FROM adoption_record r
      JOIN approval a ON a.id = r.approval AND a.plan = r.plan
      JOIN observation o ON o.id = r.observation AND o.machine = r.machine
      JOIN observation_start s ON s.machine = o.machine AND s.revision = o.basis
      WHERE r.plan = '$p' AND r.machine = '$m' AND s.plan = r.plan AND s.purpose = 'evidence' AND s.revision > a.revision")" = 1 ] &&
    [ "$(sql "SELECT desired || ' ' || applied_release || ' ' || applied_source || ' ' || baseline_revision
      FROM machine_state WHERE machine = '$m'")" = "$release $release adoption 1" ] &&
    [ "$(sql "SELECT s.applied_digest = b.configuration_digest AND encode(s.applied_digest, 'hex') = '$want'
      FROM machine_state s JOIN release_machine rm ON rm.release = s.applied_release AND rm.machine = s.machine
        JOIN import_base_revision b ON b.id = rm.import_base_revision AND b.machine = rm.machine
      WHERE s.machine = '$m'")" = t ] &&
    [ "$(sql "SELECT count(*) FROM machine_event WHERE machine = '$m' AND kind = 'adoption' AND entry->>'plan' = '$p'")" = 1 ] &&
    [ "$(sql "SELECT count(*) FROM machine_event WHERE machine = '$m' AND kind = 'applied-change'
      AND entry->>'plan' = '$p' AND entry->>'source' = 'adoption'")" = 1 ]
}
# unadopted <machine>: the machine has no Applied, no operation and no adoption record.
unadopted() {
  [ "$(sql "SELECT (SELECT count(*) FROM machine_state WHERE machine = '$1' AND applied_release IS NULL) || ' '
    || (SELECT count(*) FROM operation WHERE machine = '$1' AND kind = 'adopt') || ' '
    || (SELECT count(*) FROM adoption_record WHERE machine = '$1')")" = '1 0 0' ]
}
# unchanged_node <ip>: the node's configuration digest and resource version in the latest bundle
# are the pre-state's.
unchanged_node() {
  [ "$(digest_of "$bundle/talos-config-sha256.txt" "$1")" = "$(digest_of "$EV/pre-talos-config-sha256.txt" "$1")" ] &&
    [ -n "$(digest_of "$EV/pre-talos-config-sha256.txt" "$1")" ] &&
    [ "$(digest_of "$bundle/talos-config-version.txt" "$1")" = "$(digest_of "$EV/pre-talos-config-version.txt" "$1")" ] &&
    [ -n "$(digest_of "$EV/pre-talos-config-version.txt" "$1")" ]
}
# only_adoptions_since <operation seq>: no operation but adopt since that sequence number (the
# publication is the one other kind this run makes, before it).
only_adoptions_since() { [ "$(sql "SELECT count(*) FROM operation WHERE seq > $1 AND kind <> 'adopt'")" = 0 ]; }

preconditions() {
  local ref='S3 precondition'
  cluster=$(sql "SELECT id FROM cluster WHERE name = 'bw-fixture'") || die "s3: cannot read the cluster"
  [ -n "$cluster" ] || die "s3: no cluster bw-fixture: run scenarios/s1 run first"
  machine_cp=$(machine_at "$TALOS_CONTROLPLANE_IP") || die "s3: cannot read the control plane's machine"
  one_line "$machine_cp" || die "s3: not one machine at the control plane's endpoint: run scenarios/s1 run first"
  machine_w=$(machine_at "$TALOS_WORKER_IP") || die "s3: cannot read the worker's machine"
  one_line "$machine_w" || die "s3: not one machine at the worker's endpoint: run scenarios/s1 run first"
  interrupt - || die "cannot remove C's control file"
  check "$ref" 'A answers /livez' answers 204 - GET /livez ''
  check "$ref" 'C (the interruption build, no interruption named) answers /livez' c_live
  if [ "$s3_mode" != run ]; then
    import_draft=$(sql "SELECT id FROM draft WHERE cluster = '$cluster' AND title = 'S1 import' AND state = 'open'")
    one_line "$import_draft" || die "s3: not one open S1 import draft: run scenarios/s1 run on a fresh up first"
    check "$ref" 'no plan and no Applied release yet: the machines are not adopted' \
      same "$(sql "SELECT (SELECT count(*) FROM plan) || ' ' || (SELECT count(*) FROM machine_state WHERE applied_release IS NOT NULL)")" '0 0'
  fi
  check "$ref" "the mutation matcher counts an apid line of each mutating Talos API method once and of each read method not at all ($(grep -c . <<<"$MUTATIONS") mutating, talos-api-methods.tsv)" \
    methods_counted
  check "$ref" 'the mutation matcher gives no count, not 0, when grep fails extracting the methods or counting them' \
    matcher_fails_closed
}

# The pre-state and both nodes' apid logs: what every mode starts from. The baselines precede
# whatever the mode sends: a Talos request it caused is inside the interval the no-mutation checks
# cover.
cp_log='' w_log=''
pre_state() {
  local ref='S3 precondition'
  fresh_author
  evidence_to pre || die "no pre-state: bin/evidence failed"
  cp -- "$bundle/talos-config-sha256.txt" "$EV/pre-talos-config-sha256.txt"
  cp -- "$bundle/talos-config-version.txt" "$EV/pre-talos-config-version.txt"
  check "$ref" 'the pre-state bundle: complete, no fixture secret but the scan control' scan_clean pre
  check "$ref" 'pre-state: both nodes have a configuration digest' \
    counted 2 '^[0-9a-f]{64} ' "$EV/pre-talos-config-sha256.txt"
  check "$ref" 'pre-state: both nodes have a machine-configuration resource version' \
    counted 2 '^[0-9]+ ' "$EV/pre-talos-config-version.txt"
  cp_log=$(apid_log "$TALOS_CONTROLPLANE_IP") || die "cannot read the control plane's apid log"
  w_log=$(apid_log "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
}
# The pre-state, the S1 import draft published: what both handover modes start from.
start() {
  pre_state
  check 'S3 step 1' "the S1 import draft, both machines imported, published as one release covering both: 202, the operation succeeded" \
    publish_import
  [ -n "$release" ] || die "s3: no release; nothing after it can run"
}

handover() {
  local ref='S3 handover' plan_cp plan_w
  start
  check "$ref" 'an adopt plan for the control plane as h-publisher: 201' make_plan "$machine_cp" cp
  plan_cp=$plan_id
  check "$ref" 'an adopt plan for the worker as h-publisher: 201' make_plan "$machine_w" worker
  plan_w=$plan_id
  [ -n "$plan_cp" ] && [ -n "$plan_w" ] || die "s3: no plans; nothing after them can run"
  check "$ref" 'both plans proposed, not yet adopted' \
    same "$(sql "SELECT count(*) FROM plan_state WHERE plan IN ('$plan_cp', '$plan_w') AND state = 'proposed'")" 2
  check "$ref" 'the control plane plan approved as h-approver: 201' approve_plan "$plan_cp" cp
  check "$ref" 'the worker plan approved as h-approver: 201' approve_plan "$plan_w" worker
  check "$ref" 'both plans committed, each to a completed adopt operation' \
    within 90 plans_committed 2 "$plan_cp" "$plan_w"
  check "$ref" "the control plane's adoption recorded: Desired and Applied the release, source adoption, baseline revision 1, Applied's digest the import base's and the pre-state's" \
    adoption_recorded "$machine_cp" "$TALOS_CONTROLPLANE_IP" "$plan_cp"
  check "$ref" "the worker's adoption recorded: Desired and Applied the release, source adoption, baseline revision 1, Applied's digest the import base's and the pre-state's" \
    adoption_recorded "$machine_w" "$TALOS_WORKER_IP" "$plan_w"
  adopted_plans+=("$plan_cp" "$plan_w")
  # Anchored to this run's own publication, not to the latest publish: a later one is itself a
  # forbidden operation.
  check "$ref" 'no operation but adopt since the publication' only_adoptions_since "$(sql "SELECT seq FROM operation WHERE id = '$pub_op'")"
  check "$ref" 'an adopt plan for an adopted machine refused: 409 conflict, nothing written' \
    adopted_again "$machine_w"
  evidence_to post || die "no post-state: bin/evidence failed"
  check "$ref" 'the post-state bundle: complete, no fixture secret but the scan control' scan_clean post
  check "$ref" "the control plane's configuration digest and machine-configuration resource version are the pre-state's" \
    unchanged_node "$TALOS_CONTROLPLANE_IP"
  check "$ref" "the worker's configuration digest and machine-configuration resource version are the pre-state's" \
    unchanged_node "$TALOS_WORKER_IP"
  local cp_after w_after
  cp_after=$(apid_log "$TALOS_CONTROLPLANE_IP") || die "cannot read the control plane's apid log"
  w_after=$(apid_log "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
  no_mutation 'the control plane' "$TALOS_CONTROLPLANE_IP" "$cp_log" "$cp_after"
  no_mutation 'the worker' "$TALOS_WORKER_IP" "$w_log" "$w_after"
}
# adopted_again <machine>: a second adopt plan for an adopted machine: 409, no plan added.
adopted_again() {
  local before
  before=$(sql "SELECT count(*) FROM plan") || return 1
  fresh_publisher
  answers 409 conflict POST /api/v1/plans "$publisher" \
    "$(jq -nc --arg r "$release" --arg m "$1" '{releaseId: $r, machine: $m, operation: "adopt"}')" "$(key plan-again)" || return 1
  [ "$(sql "SELECT count(*) FROM plan")" = "$before" ]
}

# digest_patch: the worker's configuration changed out of band: a node label, no reboot, as a
# strategic merge patch (the node's configuration is multi-document, which refuses a JSON6902
# patch). Nothing of the patch is kept: the node's answer is a status only.
digest_patch() {
  local patch=$STATE/s3-label-patch rc=0
  printf 'machine:\n  nodeLabels:\n    bw-s3-control: digest\n' >"$patch"
  node_talos "$TALOS_WORKER_IP" patch machineconfig --mode no-reboot --patch "@$patch" >/dev/null 2>&1 || rc=$?
  rm -f -- "$patch"
  return "$rc"
}
# mutations_are <n> <log before> <log now>: the log holds exactly n mutating requests past the log
# before; no count (a dropped prefix, a failed matcher) is not n.
mutations_are() {
  local got
  got=$(run_mutations "$2" "$3") || return 1
  [ "$got" = "$1" ]
}
# refused_once <machine> <plan> <comparison> <cause>: one refusal entry names the plan, of T6, the
# comparison and the cause, and the plan is still approved. The cause tells the comparison's three
# contradictions apart (identity, configuration digest, assignment revision).
refused_once() {
  [ "$(refusals "$2")" = 1 ] &&
    [ "$(sql "SELECT entry->>'transaction' || ' ' || (entry->>'comparison') || ' ' || (entry->>'cause')
      FROM machine_event WHERE machine = '$1' AND kind = 'refusal' AND entry->>'plan' = '$2'")" = "T6 $3 $4" ] &&
    plan_state_is "$2" approved
}
# refusal_seen <plan>: a refusal entry names the plan.
refusal_seen() { [ "$(refusals "$1")" -ge 1 ]; }

# The age control's other pieces (obs_started, first_observation and observation_stale are
# common.sh's). relied_on_later <plan> <stalled observation> <instant>: the adoption relied on another
# observation than the stalled one, whose start entry is after the instant.
relied_on_later() {
  [ "$(sql "SELECT r.observation <> '$2' AND e.at > '$3'::timestamptz FROM adoption_record r
    JOIN observation o ON o.id = r.observation
    JOIN machine_event e ON e.machine = o.machine AND e.revision = o.basis
    WHERE r.plan = '$1'")" = t ]
}
# stalled_unrecorded <plan>: the stalled evidence observation is recorded, and the plan is still
# approved with no adoption record and no refusal entry.
stalled_unrecorded() {
  plan_state_is "$1" approved &&
    [ "$(sql "SELECT count(*) FROM adoption_record WHERE plan = '$1'")" = 0 ] &&
    [ "$(refusals "$1")" = 0 ]
}
# c_says_older: C's log records the stalled observation as no evidence, retried.
c_says_older() { c_says 'is older than the plan allows: .*retried after'; }

controls() {
  local ref='S3 handover negative controls' plan_w plan_cp stalled released_at age=10
  start

  # The digest control: the worker's configuration changed out of band before its plan. The
  # evidence shows another configuration digest than the baseline's: refused 4.4, once. The
  # baseline w_log precedes the publication; the patch is the one mutating request the worker's
  # log may hold past it (measured: a no-reboot patch leaves one ApplyConfiguration), so the
  # count is exact and nothing else, the controller's included, is hidden by the patch.
  check "$ref" "the worker's configuration changed out of band (a node label, no reboot)" digest_patch
  local w_patched
  w_patched=$(apid_log "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
  check "$ref" "since before the publication the worker's apid log holds one mutating request, the patch's" \
    mutations_are 1 "$w_log" "$w_patched"
  w_log=$w_patched
  check "$ref" 'an adopt plan for the worker as h-publisher: 201' make_plan "$machine_w" worker-digest
  plan_w=$plan_id
  [ -n "$plan_w" ] || die "s3: no worker plan; nothing after it can run"
  check "$ref" 'the worker plan approved as h-approver: 201' approve_plan "$plan_w" worker-digest
  check "$ref" "the worker's plan is refused: one refusal entry of T6, comparison 4.4, the plan still approved" \
    within 90 refusal_seen "$plan_w"
  # The loop's heartbeat is 5 s: three passes later the plan has still one refusal entry, and its
  # cause is the digest's (adoption.go: the identity and assignment contradictions have their own).
  sleep 16
  check "$ref" 'three heartbeats later: still one refusal entry, T6 4.4 for the configuration digest, the plan approved' \
    refused_once "$machine_w" "$plan_w" 4.4 "the latest observation's configuration digest is not the baseline's"
  check "$ref" 'the worker is not adopted: no Applied, no adopt operation, no adoption record' unadopted "$machine_w"
  outcome_bundle "$ref" refusal-digest
  check "$ref" "control: the worker's configuration digest in the bundle is not the pre-state's" \
    differ "$(digest_of "$bundle/talos-config-sha256.txt" "$TALOS_WORKER_IP")" "$(digest_of "$EV/pre-talos-config-sha256.txt" "$TALOS_WORKER_IP")"
  check "$ref" "the control plane's configuration digest and resource version are the pre-state's" unchanged_node "$TALOS_CONTROLPLANE_IP"
  local w_after
  w_after=$(apid_log "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
  no_mutation 'the worker, after the out-of-band change' "$TALOS_WORKER_IP" "$w_log" "$w_after"

  # The age control: C alone runs, its adoption loop stalled between the evidence observation and
  # the adoption record. Once the observation is older than the plan binds, the stall is released:
  # the stalled observation is no evidence (nothing refused), the loop observes again after its
  # lease, and the adoption relies on that observation.
  fresh_author
  check "$ref" 'inject pause A and B' both pause
  check "$ref" 'C told to stall at the adoption' interrupt adoption stall
  # A and B are paused: the plan is created and approved on C, whose loop is woken by the approval.
  call_port=$SERVER_C_PORT
  check "$ref" "an adopt plan for the control plane as h-publisher on C, its evidence at most $age s old: 201" \
    make_plan "$machine_cp" cp-age "$(jq -nc --argjson s "$age" '{maxObservationAgeSeconds: $s}')"
  plan_cp=$plan_id
  [ -n "$plan_cp" ] || die "s3: no control plane plan; nothing after it can run"
  check "$ref" 'the control plane plan approved as h-approver on C: 201' approve_plan "$plan_cp" cp-age
  call_port=$SERVER_A_PORT
  check "$ref" "C stalled after the plan's evidence observation was recorded" within 60 obs_started "$plan_cp"
  stalled=$(first_observation "$plan_cp")
  [ -n "$stalled" ] || die "s3: no stalled observation; nothing after it can run"
  check "$ref" "the stalled observation is older than the plan binds ($age s)" within 60 observation_stale "$plan_cp" "$((age + 3))"
  check "$ref" 'while stalled: the plan approved, no adoption record, no refusal entry' stalled_unrecorded "$plan_cp"
  released_at=$(sql "SELECT clock_timestamp()") || die "s3: cannot read the database clock"
  check "$ref" "C's control file removed" interrupt -
  check "$ref" 'the plan committed, from a later observation' within 90 plan_state_is "$plan_cp" committed
  check "$ref" "C's log records the stalled observation as older than the plan allows, retried after the lease" c_says_older
  check "$ref" 'the adoption relied on another observation, begun after the stall was released' \
    relied_on_later "$plan_cp" "$stalled" "$released_at"
  check "$ref" 'no refusal entry names the plan' same "$(refusals "$plan_cp")" 0
  check "$ref" "the control plane's adoption recorded: Desired and Applied the release, source adoption, baseline revision 1, Applied's digest the import base's and the pre-state's" \
    adoption_recorded "$machine_cp" "$TALOS_CONTROLPLANE_IP" "$plan_cp"
  adopted_plans+=("$plan_cp")
  check "$ref" 'inject unpause A and B' both unpause
  check "$ref" 'the worker is still not adopted' unadopted "$machine_w"
  outcome_bundle "$ref" adoption-age
  check "$ref" "the control plane's configuration digest and resource version are the pre-state's" unchanged_node "$TALOS_CONTROLPLANE_IP"
  local cp_after
  cp_after=$(apid_log "$TALOS_CONTROLPLANE_IP") || die "cannot read the control plane's apid log"
  no_mutation 'the control plane' "$TALOS_CONTROLPLANE_IP" "$cp_log" "$cp_after"
}

# The approval part (mode run). The tokens, plan_body, plan_by and approve_by are common.sh's.
s2_rel='' applied_rel='' ops0=0 act_seq=0 snap=s3-step4
# approval_names <approver human> <plan>: the approval the 201 answered names the plan, the
# approver, its role and an epoch (the last approve_by's), and is the plan's only approval; its
# act is the approver's plan.approve under that role, naming the approval, the plan and the machine.
approval_names() {
  local p
  p=$(who_id "$1") || return 1
  [ "$(sql "SELECT count(*) FROM approval WHERE plan = '$2' AND id = '$approval_id' AND approver = '$p'
      AND role = 'approver' AND epoch IS NOT NULL")" = 1 ] &&
    [ "$(sql "SELECT count(*) FROM approval WHERE plan = '$2'")" = 1 ] &&
    [ "$(sql "SELECT a.principal || ' ' || a.role || ' ' || a.action || ' ' || array_to_string(a.subjects, ',')
      FROM approval v JOIN act a ON a.id = v.act WHERE v.id = '$approval_id'")" = "$p approver plan.approve $approval_id,$2,$machine_w" ] &&
    [ "$(sql "SELECT count(*) FROM machine_event WHERE machine = '$machine_w' AND kind = 'approval'
      AND entry->>'approval' = '$approval_id' AND entry->>'plan' = '$2' AND entry->>'principal' = '$p'
      AND entry->>'role' = 'approver'")" = 1 ]
}
# reasons_are <comma-separated reasons or empty> <marked: true|false>: the last approval carries
# exactly these self-approval reasons, in the table's order, in the 201 it answered, in its row, in
# its timeline entry and as a viewer reads it back.
reasons_are() {
  local want entry
  want=$(jq -nc --arg r "$1" 'if $r == "" then [] else $r | split(",") end') || return 1
  [ "$approval_reasons" = "$want" ] || return 1
  [ "$(sql "SELECT array_to_string(self_approval, ',') FROM approval WHERE id = '$approval_id'")" = "$1" ] || return 1
  entry=$(sql "SELECT entry->'selfApproval' FROM machine_event WHERE machine = '$machine_w' AND kind = 'approval'
    AND entry->>'approval' = '$approval_id'") || return 1
  [ "$(jq -c '[.marked, .reasons]' <<<"$entry")" = "$(jq -nc --argjson w "$want" --argjson m "$2" '[$m, $w]')" ] || return 1
  fresh h-viewer
  answers_with ".id == \"$approval_id\" and .plan == \"$approval_plan\" and .approver.principal == \"$approval_by\"
      and .approver.role == \"approver\" and .epoch == \"$approval_epoch\" and .selfApproval == {marked: $2, reasons: $want}" \
    200 - GET "/api/v1/approvals/$approval_id" "$tok"
}
# no_dispatch_since <operation seq>: no apply-config operation exists since that sequence number
# (a publication, which step 4 makes, is an operation of another kind).
no_dispatch_since() { [ "$(sql "SELECT count(*) FROM operation WHERE seq > $1 AND kind = 'apply-config'")" = 0 ]; }
# plan_bound <plan>: step 2's plan binds every value of execution-recovery §2 as created: the
# kind and mode, the release (the S2 release, the worker's Desired), the assignment revision the
# release was compiled from, the baseline revision and the expected pre-dispatch digest Applied's,
# the machine's own route, the deadlines, the attempt limit, the expiry and the age bounds; created
# as h-publisher, on the machine and its cluster, in the current epoch, under the request's
# idempotency key, with the PoC's rollout limit and approval policy.
plan_bound() {
  [ "$(sql "SELECT p.kind || ' ' || p.mode || ' ' || (p.machine = '$machine_w') || ' ' || (p.cluster = '$cluster')
      || ' ' || (p.epoch = (SELECT epoch FROM installation_state)) || ' ' || (p.idempotency_key = '$(key plan-step2)')
      || ' ' || (p.rollout_limit = 1) || ' ' || (p.approval_policy = 'one-approver')
      || ' ' || (p.release = '$s2_rel') || ' ' || (p.desired_release = '$s2_rel')
      || ' ' || (p.assignment_revision = rm.assignment_revision) || ' ' || (p.baseline_revision = s.baseline_revision)
      || ' ' || (p.expected_digest = s.applied_digest) || ' ' || (p.route::text = m.talos_endpoint::text)
      || ' ' || (p.transport_deadline = interval '120 seconds') || ' ' || (p.verification_deadline = interval '300 seconds')
      || ' ' || (p.max_attempts = 2) || ' ' || (p.expires_at - p.created_at = interval '7200 seconds')
      || ' ' || (p.max_observation_age = interval '300 seconds') || ' ' || (p.check_validity = interval '600 seconds')
      || ' ' || (p.created_by = '$(who_id h-publisher)') || ' ' || (p.created_role = 'publisher')
      FROM plan p JOIN machine_state s ON s.machine = p.machine JOIN machine m ON m.id = p.machine
        JOIN release_machine rm ON rm.release = p.release AND rm.machine = p.machine
      WHERE p.id = '$1'")" = 'apply-config no-reboot true true true true true true true true true true true true true true true true true true true true' ]
}
# plan_served <plan>: a viewer reads the plan as step 2 asks: proposed, the S2 release, the diff
# from Applied's release to it withheld (the worker holds the import base's configuration, which
# has no redacted form; persistence-api §17.38), no digest answered. The release's validation the
# plan relies on (passed at publication, under the release's contract and versions and the
# machine's platform mode) and the unavailable dry run are read as stored.
plan_served() {
  local c k m pm
  read -r c k m pm < <(sql "SELECT r.contract || ' ' || r.kubernetes_version || ' ' || r.machinery_version || ' ' || coalesce(rm.mode, '')
    FROM release r JOIN release_machine rm ON rm.release = r.id AND rm.machine = '$machine_w' WHERE r.id = '$s2_rel'") || return 1
  [ -n "$c" ] && [ -n "$k" ] && [ -n "$m" ] || return 1
  fresh h-viewer
  answers_with ".id == \"$1\" and .state == \"proposed\" and .operation == \"apply-config\" and .mode == \"no-reboot\"
      and .release == \"$s2_rel\" and .desiredRelease == \"$s2_rel\" and .evidence.diff.withheld == true
      and .evidence.diff.from == \"$applied_rel\" and .evidence.diff.to == \"$s2_rel\"
      and (.evidence.diff.unified // \"\") == \"\" and (tostring | test(\"expected|digest\") | not)
      and .evidence.validation == {result: \"passed\", at: \"publication\", contract: \"$c\", kubernetesVersion: \"$k\",
        machineryVersion: \"$m\", platformMode: \"$pm\"}
      and .evidence.dryRun == {available: false, reason: \"no dry run is available for this operation\"}" \
    200 - GET "/api/v1/plans/$1" "$tok"
}
# refused_approval <who> <plan> <name>: 403 forbidden for want of the approver role (the
# automation identity: because the route is for humans only), not for another reason a 403 can
# carry; the plan still proposed with no approval.
refused_approval() {
  local why='(has("humanOnly") | not)'
  [ "$1" != robot ] || why='.humanOnly == true'
  fresh "$1"
  answers_with ".roles == [\"approver\"] and $why" 403 forbidden POST "/api/v1/plans/$2/approvals" "$tok" '{}' "$(key "approval-$3")" || return 1
  [ "$(sql "SELECT count(*) FROM approval WHERE plan = '$2'")" = 0 ] && plan_is_stored "$2" proposed none
}
# second_approval <who> <plan> <name>: 409 conflict naming the plan as approved (not expired, which
# a refused request does not store), the plan's one approval still the first.
second_approval() {
  local first
  first=$(sql "SELECT approval FROM plan_state WHERE plan = '$2'") || return 1
  fresh "$1"
  answers_with ".plan == \"$2\" and .state == \"approved\"" 409 conflict POST "/api/v1/plans/$2/approvals" "$tok" '{}' "$(key "approval-$3")" || return 1
  [ "$(sql "SELECT count(*) FROM approval WHERE plan = '$2'")" = 1 ] && plan_is_stored "$2" approved "$first"
}
# superseded_refused: a plan of the import release the handover published, which S2 superseded as
# the worker's Desired: 409 conflict naming the S2 release as the Desired, no plan created.
superseded_refused() {
  local before
  before=$(sql "SELECT count(*) FROM plan") || return 1
  fresh h-publisher
  answers_with ".desired == \"$s2_rel\"" 409 conflict POST /api/v1/plans "$tok" \
    "$(plan_body "$(jq -nc --arg r "$applied_rel" '{releaseId: $r}')")" "$(key plan-superseded)" || return 1
  [ "$(sql "SELECT count(*) FROM plan")" = "$before" ]
}
# expiry_cases: two plans that live eight seconds, one approved at once and one never approved:
# past it each reads expired, an approval of either is 409 naming the state, no operation.
expiry_cases() {
  local e_proposed e_approved
  fresh h-publisher
  fresh h-approver
  plan_by h-publisher expiry-proposed '{"expiresInSeconds": 8}' || return 1
  e_proposed=$plan_id
  plan_by h-publisher expiry-approved '{"expiresInSeconds": 8}' || return 1
  e_approved=$plan_id
  approve_by h-approver "$e_approved" expiry-approved || return 1
  within 30 plan_reads "$e_proposed" expired || return 1
  within 30 plan_reads "$e_approved" expired || return 1
  fresh h-approver
  answers_with '.state == "expired"' 409 conflict POST "/api/v1/plans/$e_proposed/approvals" "$tok" '{}' "$(key approval-expired)" || return 1
  # The approved plan's second request is refused as expired, not as a duplicate of its approval.
  answers_with ".plan == \"$e_approved\" and .state == \"expired\"" 409 conflict POST "/api/v1/plans/$e_approved/approvals" "$tok" '{}' \
    "$(key approval-expired-approved)" || return 1
  [ "$(sql "SELECT count(*) FROM operation WHERE plan IN ('$e_proposed', '$e_approved')")" = 0 ] &&
    [ "$(sql "SELECT count(*) FROM approval WHERE plan = '$e_proposed'")" = 0 ] &&
    [ "$(sql "SELECT count(*) FROM approval WHERE plan = '$e_approved' AND id = '$approval_id'")" = 1 ] &&
    [ "$(sql "SELECT count(*) FROM approval WHERE plan = '$e_approved'")" = 1 ]
}
# cancelled_as <canceller> <role> <name>: plan_id cancelled as that identity, which the plan's
# route permits under that role: 201, the plan cancelled with no approval and no operation, the
# cancellation and its act recorded under the role.
cancelled_as() {
  local p=$plan_id c
  fresh "$1"
  answers 200 - POST "/api/v1/plans/$p/cancellations" "$tok" '{"reason": "S3 negative control"}' "$(key "cancel-$3")" || return 1
  # After the request: a principal's row is made by its first authenticated one.
  c=$(who_id "$1") && [ -n "$c" ] || return 1
  [ "$(sql "SELECT cancelled_by || ' ' || role FROM plan_cancellation WHERE plan = '$p'")" = "$c $2" ] ||
    { echo "s3: $p: its cancellation is not recorded as $c under $2" >&2; return 1; }
  [ "$(sql "SELECT a.principal || ' ' || a.role || ' ' || a.action FROM plan_cancellation c JOIN act a ON a.id = c.act
      WHERE c.plan = '$p'")" = "$c $2 plan.cancel" ] ||
    { echo "s3: $p: its act is not $c under $2 plan.cancel" >&2; return 1; }
  [ "$(sql "SELECT count(*) FROM machine_event WHERE machine = '$machine_w' AND kind = 'plan-cancellation'
      AND entry->>'plan' = '$p' AND entry->>'role' = '$2'")" = 1 ] ||
    { echo "s3: $p: its timeline entry does not name $2 exactly once" >&2; return 1; }
  plan_is_stored "$p" cancelled none ||
    { echo "s3: $p: stored as $(sql "SELECT state || ' ' || coalesce(approval, 'none') || ' ' || coalesce(operation, 'none') FROM plan_state WHERE plan = '$p'")" >&2; return 1; }
  plan_reads "$p" cancelled
}
# cancel_forbidden <canceller> <name>: plan_id is not the identity's to cancel: 403 forbidden, the
# plan unchanged, no cancellation recorded.
cancel_forbidden() {
  local p=$plan_id before
  before=$(sql "SELECT state || ' ' || revision FROM plan_state WHERE plan = '$p'") || return 1
  fresh "$1"
  answers 403 forbidden POST "/api/v1/plans/$p/cancellations" "$tok" '{"reason": "S3 negative control"}' "$(key "cancel-$2")" || return 1
  [ "$(sql "SELECT state || ' ' || revision FROM plan_state WHERE plan = '$p'")" = "$before" ] &&
    [ "$(sql "SELECT count(*) FROM plan_cancellation WHERE plan = '$p'")" = 0 ] &&
    plan_is_stored "$p" proposed none
}
# revoked_as <revoker> <role> <name>: approval_id of plan_id revoked as that identity before any
# commitment: 201, the plan revoked with its approval, no operation, the revocation recorded
# under the role and its act, the approval itself unchanged.
revoked_as() {
  local p=$plan_id a=$approval_id r
  r=$(who_id "$1") || return 1
  fresh "$1"
  answers 201 - POST "/api/v1/approvals/$a/revocations" "$tok" '{"reason": "S3 negative control"}' "$(key "revoke-$3")" || return 1
  [ "$(sql "SELECT revoked_by || ' ' || role FROM approval_revocation WHERE approval = '$a'")" = "$r $2" ] &&
    [ "$(sql "SELECT a.principal || ' ' || a.role || ' ' || a.action FROM approval_revocation v JOIN act a ON a.id = v.act
      WHERE v.approval = '$a'")" = "$r $2 approval.revoke" ] &&
    [ "$(sql "SELECT count(*) FROM machine_event WHERE machine = '$machine_w' AND kind = 'approval-revocation'
      AND entry->>'approval' = '$a' AND entry->>'role' = '$2'")" = 1 ] &&
    [ "$(sql "SELECT s.state || ' ' || coalesce(s.reason, '-') || ' ' || coalesce(s.operation, 'none') FROM plan_state s
      WHERE s.plan = '$p'")" = 'revoked approval-revoked none' ] &&
    [ "$(sql "SELECT count(*) FROM approval WHERE id = '$a' AND plan = '$p'")" = 1 ] &&
    plan_reads "$p" revoked
}
# deps_classified: the monitors hold at least one dependency, and every one retained.
deps_classified() {
  [ "$(sql "SELECT count(*) FILTER (WHERE class <> 'retained') || ' ' || (count(*) > 0) FROM dependency_status")" = '0 true' ]
}
# deps_retained: every dependency the monitors classified is retained and none stale, served.
deps_retained() {
  fresh h-viewer
  answers_with '(.items | length) > 0 and ([.items[] | select(.class != "retained" or .stale)] == [])' \
    200 - GET '/api/v1/dependencies?limit=500' "$tok"
}
# dispatched_only_approved <approved> <unapproved> <revision>: the worker's timeline holds a
# use-time check of the approved plan after <revision>, and none ever of the unapproved plan.
dispatched_only_approved() {
  [ "$(sql "SELECT (count(*) FILTER (WHERE entry->>'plan' = '$1' AND revision > $3) > 0)
      || ' ' || count(*) FILTER (WHERE entry->>'plan' = '$2')
      FROM machine_event WHERE machine = '$machine_w' AND kind = 'use-time-check'")" = 'true 0' ]
}
# worker_has_only_the_handover: the worker has no plan but the handover's, committed, and no
# operation but its adopt operation.
worker_has_only_the_handover() {
  [ "$(sql "SELECT count(*) || ' ' || count(*) FILTER (WHERE p.kind = 'adopt' AND s.state = 'committed' AND p.release = '$applied_rel')
      FROM plan p JOIN plan_state s ON s.plan = p.id WHERE p.machine = '$machine_w'")" = '1 1' ] &&
    [ "$(sql "SELECT count(*) FROM operation WHERE machine = '$machine_w' AND kind <> 'adopt'")" = 0 ]
}
# release_holds_automation_revision: the S2 release holds a revision the automation identity
# authored (S2 step 7's), as does every release published after it: the reason owned-automation
# holds for its responsible human on every plan of this part.
release_holds_automation_revision() {
  [ "$(sql "SELECT count(*) FROM release_source s JOIN fragment_revision f ON f.id = s.fragment_revision
    WHERE s.release = '$s2_rel' AND f.author = '$robot_id'")" -ge 1 ]
}
# db_reads: A answers a database read again after a restore swapped the database under it.
db_reads() {
  fresh_author
  [ "$(call GET "/api/v1/releases/$applied_rel" "$author")" = 200 ]
}
# restored: the database is the snapshot's: no act after it, step 2's plan gone, the worker's
# Desired and Applied what they were when the snapshots were taken.
restored() {
  [ "$(sql "SELECT coalesce(max(seq), 0) FROM act")" = "$act_seq" ] &&
    [ "$(sql "SELECT count(*) FROM plan WHERE machine = '$machine_w' AND kind = 'apply-config'")" = 0 ] &&
    [ "$(sql "SELECT desired || ' ' || applied_release FROM machine_state WHERE machine = '$machine_w'")" = "$s2_rel $applied_rel" ]
}
# approved_idle <plan>: the plan approved by the last approval, no operation for it, and no
# apply-config operation since the baseline.
approved_idle() {
  plan_is_stored "$1" approved "$approval_id" && plan_reads "$1" approved && no_dispatch_since "$ops0"
}

# plans_approved <plan:approval>...: each plan stored approved by its own approval, and no
# apply-config operation exists.
plans_approved() {
  local x
  for x; do plan_is_stored "${x%%:*}" approved "${x#*:}" || return 1; done
  no_dispatch_since 0
}
# restored_to_step3: the database is the snapshot taken after step 3: no act after it, step 3's plan
# the only apply-config plan, approved by its approval, the worker's Desired the S2 release, and no
# apply-config operation: the state S4 starts from.
step3_plan='' step3_approval='' act_seq3=0
restored_to_step3() {
  [ "$(sql "SELECT coalesce(max(seq), 0) FROM act")" = "$act_seq3" ] &&
    [ "$(sql "SELECT count(*) FROM plan WHERE kind = 'apply-config'")" = 1 ] &&
    [ "$(sql "SELECT desired FROM machine_state WHERE machine = '$machine_w'")" = "$s2_rel" ] &&
    plan_is_stored "$step3_plan" approved "$step3_approval" && plan_reads "$step3_plan" approved && no_dispatch_since 0
}

step4_approval=''
approval_part() {
  local ref='S3 step 1' p2 pa pb pc apb apc pcancel pu case3_frag
  robot=$(cat -- "$STATE/automation-token") || die "no automation token in $STATE"
  redact_automation_token "$robot"
  robot_id=$(sed -n 's/^identity \(idn_[a-z2-7]*\):.*/\1/p' "$STATE/automation-identity")
  [ -n "$robot_id" ] || die "s3: no automation identity in $STATE"
  s2_rel=$(sql "SELECT desired FROM machine_state WHERE machine = '$machine_w'") || die "s3: cannot read the worker's Desired"
  applied_rel=$(sql "SELECT applied_release FROM machine_state WHERE machine = '$machine_w'") || die "s3: cannot read the worker's Applied"
  [ -n "$s2_rel" ] && [ -n "$applied_rel" ] || die "s3: the worker has no Desired or no Applied release: run s1, s3 handover and s2 first"
  ops0=$(sql "SELECT coalesce(max(seq), 0) FROM operation") || die "s3: cannot read the operations"
  check 'S3 precondition' "the worker's Desired is a release S2 published, not the one its adoption recorded as Applied" differ "$s2_rel" "$applied_rel"
  check 'S3 precondition' 'the worker has no plan but the handover'"'"'s completed adopt plan, and no operation but its adopt operation' \
    worker_has_only_the_handover
  check 'S3 precondition' "the S2 release holds a revision the automation identity authored: owned-automation holds for h-all on every plan of this part" \
    release_holds_automation_revision
  # The controller dispatches an approved plan: with every instance cut from the worker, its
  # evidence observation fails and nothing commits. S4 joins the links again.
  check 'S3 precondition' 'inject linksplit A, B and C from the worker: no approved plan of this part commits' worker_links linksplit
  # With a link left open, an approved plan of this part would commit and apply.
  counted 3 '^[ABC] worker$' "$STATE/linksplits" || die "s3: not every link to the worker is cut; nothing after it can run"

  # Step 1: three heartbeats (5 s) of the controller's loop have passed since S2 ended, and it has
  # made no plan and no operation. A pass with no candidate records nothing, so the interval is the
  # evidence, not a pass marker; a scheduled drift observation is S5's (ginsys/bronzeward#27). The
  # pre-state and the apid log baselines come first, so the no-mutation checks cover this interval.
  pre_state
  sleep 16
  check "$ref" "sixteen seconds (three heartbeats) after S2: no plan but the handover's, no operation but its adopt: publication alone dispatched nothing" \
    worker_has_only_the_handover
  check "$ref" 'no apply-config plan and no apply-config operation exist' \
    same "$(sql "SELECT (SELECT count(*) FROM plan WHERE kind = 'apply-config') || ' ' || (SELECT count(*) FROM operation WHERE kind = 'apply-config')")" '0 0'
  act_seq=$(sql "SELECT coalesce(max(seq), 0) FROM act") || die "s3: cannot read the acts"
  check 'S3 step 4' 'inject db-snapshot s3-step4, before step 2' "$bin/inject" db-snapshot "$snap"
  check 'S3 step 4' 'inject bao-snapshot s3-step4, before step 2' "$bin/inject" bao-snapshot "$snap"
  fresh_author

  # Steps 2 and 3.
  ref='S3 step 2'
  check "$ref" 'an apply-config plan of the S2 release as h-publisher (no-reboot, deadlines, attempts, expiry, age): 201' plan_by h-publisher step2
  p2=$plan_id
  [ -n "$p2" ] || die "s3: no plan; nothing after it can run"
  check "$ref" "the plan binds every value of execution-recovery §2: its expected digest is Applied's, its route the worker's own" plan_bound "$p2"
  check "$ref" "h-viewer reads the plan: proposed, the S2 release, the whole-configuration diff withheld (the worker holds the import base's configuration), no digest answered" \
    plan_served "$p2"
  check "$ref" 'the plan is proposed and no operation exists for it' plan_is_stored "$p2" proposed none
  ref='S3 step 3'
  check "$ref" 'h-approver approves it: 201, the approval naming the plan, the approver, its role and the epoch' approve_by h-approver "$p2" step3
  check "$ref" "the approval is the plan's one, on the machine's timeline once, with the approver's role" approval_names h-approver "$p2"
  check "$ref" 'not marked as self-approval: no reason holds' reasons_are '' false
  check "$ref" 'the plan is approved by it and no operation exists before commitment' approved_idle "$p2"
  outcome_bundle "$ref" step3
  check "$ref" "the control plane's configuration digest and resource version are the pre-state's" unchanged_node "$TALOS_CONTROLPLANE_IP"
  check "$ref" "the worker's configuration digest and resource version are the pre-state's" unchanged_node "$TALOS_WORKER_IP"
  # What S4 starts from: step 3's plan approved and nothing after it. The run ends restored to this.
  step3_plan=$p2
  step3_approval=$approval_id
  act_seq3=$(sql "SELECT coalesce(max(seq), 0) FROM act") || die "s3: cannot read the acts"
  check "$ref" 'inject db-snapshot s3-step3, after step 3' "$bin/inject" db-snapshot s3-step3
  check "$ref" 'inject bao-snapshot s3-step3, after step 3' "$bin/inject" bao-snapshot s3-step3

  # The controls that end a plan before its commitment, on the live database (P2 stays approved).
  ref='S3 negative controls'
  plan_by h-publisher approval-controls || die "s3: no plan for the approval controls"
  pcancel=$plan_id
  check "$ref" 'the automation identity approving: 403, no approval, the plan proposed' refused_approval robot "$pcancel" robot
  check "$ref" 'h-recovery alone approving: 403, no approval, the plan proposed' refused_approval h-recovery "$pcancel" recovery
  check "$ref" 'h-viewer approving: 403' refused_approval h-viewer "$pcancel" viewer
  check "$ref" 'a second approval of the approved plan, by h-approver: 409 conflict, its one approval unchanged' \
    second_approval h-approver "$p2" second
  check "$ref" 'a second approval by h-all, another approver: 409 conflict' second_approval h-all "$p2" second-all
  check "$ref" "a plan of the import release the handover published, which S2 superseded: 409 conflict naming the S2 release as Desired, no plan created" \
    superseded_refused
  check "$ref" 'a plan past its expiry reads expired, approved or not: an approval is 409, no operation' expiry_cases

  plan_by h-publisher cancel-creator || die "s3: no plan to cancel"
  check "$ref" 'a plan cancelled before commitment by its creator h-publisher: cancelled, no operation, recorded under publisher' \
    cancelled_as h-publisher publisher creator
  plan_by robot cancel-automation || die "s3: no plan to cancel"
  check "$ref" 'a plan cancelled before commitment by its creator, the automation identity: cancelled, no operation, recorded under publisher' \
    cancelled_as robot publisher automation
  plan_by h-publisher cancel-approver || die "s3: no plan to cancel"
  approve_by h-approver "$plan_id" cancel-approver || die "s3: no approval to cancel under"
  check "$ref" 'an approved plan cancelled before commitment by h-approver: cancelled, no approval kept, no operation, recorded under approver' \
    cancelled_as h-approver approver approver
  plan_by h-publisher cancel-recovery || die "s3: no plan to cancel"
  check "$ref" 'a plan cancelled before commitment by h-recovery: cancelled, no operation, recorded under recovery-admin' \
    cancelled_as h-recovery recovery-admin recovery
  plan_by robot cancel-forbidden || die "s3: no plan for the forbidden cancellation"
  check "$ref" 'h-publisher cancelling a plan the automation identity created: 403 forbidden, the plan unchanged, no cancellation' \
    cancel_forbidden h-publisher publisher

  plan_by h-publisher revoke-approver || die "s3: no plan to revoke under"
  approve_by h-approver "$plan_id" revoke-approver || die "s3: no approval to revoke"
  check "$ref" 'an approval revoked before commitment by h-approver: the plan revoked, nothing dispatched, recorded under approver' \
    revoked_as h-approver approver approver
  plan_by h-publisher revoke-recovery || die "s3: no plan to revoke under"
  approve_by h-approver "$plan_id" revoke-recovery || die "s3: no approval to revoke"
  check "$ref" 'an approval revoked before commitment by h-recovery: the plan revoked, nothing dispatched, recorded under recovery-admin' \
    revoked_as h-recovery recovery-admin recovery

  plan_by h-publisher unapproved || die "s3: no unapproved plan"
  pu=$plan_id
  # The monitors pass every 60 s: S2's last restore put OpenBao back, and each status is read again.
  check "$ref" 'the monitors classify every dependency retained' within 240 deps_classified
  check "$ref" 'every dependency retained, none stale, as served' deps_retained
  # With the links cut no plan reaches an operation, approved or not: what tells the unapproved plan
  # apart is that dispatch never begins for it. Step 3's approved plan is retried every lease, each
  # time with a use-time check; once one is recorded after this point, the unapproved plan has none.
  rev_u=$(sql "SELECT coalesce(max(revision), 0) FROM machine_event WHERE machine = '$machine_w'") || die "s3: cannot read the worker's timeline"
  sleep 16
  check "$ref" 'every dependency retained and a plan unapproved, three heartbeats on: no operation, the plan still proposed' \
    same "$(sql "SELECT (SELECT state FROM plan_state WHERE plan = '$pu') || ' ' || (SELECT count(*) FROM operation WHERE seq > $ops0 AND kind = 'apply-config')")" 'proposed 0'
  check "$ref" "the controller dispatching meanwhile: a use-time check of step 3's approved plan after that point, none ever of the unapproved plan" \
    within 40 dispatched_only_approved "$p2" "$pu" "$rev_u"
  check "$ref" 'no operation exists for any plan of this part: every one proposed, approved, expired, cancelled or revoked' \
    same "$(sql "SELECT count(*) FROM plan p JOIN operation o ON o.plan = p.id WHERE p.kind = 'apply-config'")" 0
  outcome_bundle "$ref" controls
  check "$ref" 'inject db-snapshot of the controls, for the bundle to expand and scan' "$bin/inject" db-snapshot "$backup_name-controls"

  # Step 4, from one restore of the snapshots taken before step 2. The servers are paused across
  # both restores (as S2 step 7's are) and keep running.
  ref='S3 step 4'
  check "$ref" 'inject pause A, B and C' servers pause
  check "$ref" 'inject db-restore s3-step4' "$bin/inject" db-restore "$snap"
  check "$ref" 'inject bao-restore s3-step4' "$bin/inject" bao-restore "$snap"
  check "$ref" 'inject unpause A, B and C' servers unpause
  check "$ref" 'A reads the restored database' within 60 db_reads
  check "$ref" "restored: no act after the snapshot, no apply-config plan, the worker's Desired and Applied what they were" restored
  ops0=$(sql "SELECT coalesce(max(seq), 0) FROM operation") || die "s3: cannot read the operations"
  fresh_author
  # 1: the automation identity's responsible human approves a plan the automation identity created
  # from the S2 release.
  check "$ref" 'case 1: the automation identity creates a plan of the S2 release: 201' plan_by robot case1
  pa=$plan_id
  check "$ref" "case 1: h-all, the automation identity's responsible human, approves it: 201, self-approval marked with owned-automation alone" \
    approve_by h-all "$pa" case1
  check "$ref" 'case 1: the approval carries exactly owned-automation' reasons_are owned-automation true
  step4_approval=$approval_id
  check "$ref" 'case 1: the plan is approved by it, no operation' approved_idle "$pa"
  # 2: h-all authors, publishes, plans and approves a change.
  check "$ref" 'case 2: h-all opens a draft: 201' draft_by h-all case2
  check "$ref" 'case 2: h-all authors a fragment in it: 200, the ETag replaced' fragment_by h-all case2 all role
  check "$ref" 'case 2: h-all lists it in the workers profile the worker'"'"'s assignment selects: 200, the ETag replaced' profile_by h-all case2
  check "$ref" 'case 2: h-all publishes it: 202, one release, the worker'"'"'s Desired' publish_by h-all case2
  check "$ref" 'case 2: h-all creates a plan of that release: 201' plan_by h-all case2
  pb=$plan_id
  check "$ref" 'case 2: h-all approves it: 201, naming the plan, the approver, its role and the epoch' approve_by h-all "$pb" case2
  apb=$approval_id
  check "$ref" 'case 2: the approval carries created-plan, published and authored-change, and owned-automation (the automation identity'"'"'s S2 revisions are in every release)' \
    reasons_are created-plan,published,authored-change,owned-automation true
  check "$ref" 'case 2: the plan is approved by it, no operation' approved_idle "$pb"
  # 3: a later release by others reuses h-all's fragment revision unchanged.
  check "$ref" 'case 3: h-author opens a draft: 201' draft_by h-author case3
  check "$ref" 'case 3: h-author drafts an unrelated change, a fragment: 200' fragment_by h-author case3 other
  case3_frag=$frag_rev
  check "$ref" 'case 3: h-publisher publishes it as a later release: 202, one release, the worker'"'"'s Desired' publish_by h-publisher case3
  check "$ref" "case 3: that release reuses h-all's fragment revision unchanged" \
    same "$(sql "SELECT count(*) FROM release_source s JOIN fragment_revision f ON f.id = s.fragment_revision
      WHERE s.release = '$new_release' AND f.author = '$(who_id h-all)'
        AND NOT EXISTS (SELECT FROM draft_source_entry e JOIN release r ON r.id = s.release WHERE e.draft = r.draft AND e.fragment_revision = f.id)")" 1
  check "$ref" "case 3: h-author's unrelated fragment revision is a changed head of that release, its own draft entry, not the reused one" \
    same "$(sql "SELECT count(*) FROM release_source s JOIN release r ON r.id = s.release
      JOIN draft_source_entry e ON e.draft = r.draft AND e.fragment_revision = s.fragment_revision
      WHERE s.release = '$new_release' AND s.fragment_revision = '$case3_frag'")" 1
  check "$ref" "case 3: no machine selects it: the worker's configuration digest in that release is case 2's release's" \
    same "$(sql "SELECT (SELECT configuration_digest FROM release_machine WHERE release = '$new_release' AND machine = '$machine_w')
      = (SELECT rm.configuration_digest FROM plan p JOIN release_machine rm ON rm.release = p.release AND rm.machine = p.machine
        WHERE p.id = '$pb')")" t
  check "$ref" 'case 3: h-publisher creates a plan of that release: 201' plan_by h-publisher case3
  pc=$plan_id
  check "$ref" "case 3: h-all approves h-publisher's plan: 201, naming the plan, the approver, its role and the epoch" approve_by h-all "$pc" case3
  apc=$approval_id
  check "$ref" 'case 3: the approval carries authored-reused and owned-automation' reasons_are authored-reused,owned-automation true
  check "$ref" 'case 3: the plan is approved by it, no operation' approved_idle "$pc"
  check "$ref" 'the three plans were each made from the worker'"'"'s Desired at that moment, one release apart' \
    same "$(sql "SELECT count(DISTINCT release) FROM plan WHERE id IN ('$pa', '$pb', '$pc')")" 3
  check "$ref" 'after the last publication, all three plans are still approved, each by its own approval, and no apply-config operation exists' \
    plans_approved "$pa:$step4_approval" "$pb:$apb" "$pc:$apc"
  outcome_bundle "$ref" step4
  check "$ref" "the control plane's configuration digest and resource version are the pre-state's" unchanged_node "$TALOS_CONTROLPLANE_IP"
  check "$ref" "the worker's configuration digest and resource version are the pre-state's" unchanged_node "$TALOS_WORKER_IP"
  local cp_after w_after
  cp_after=$(apid_log "$TALOS_CONTROLPLANE_IP") || die "cannot read the control plane's apid log"
  w_after=$(apid_log "$TALOS_WORKER_IP") || die "cannot read the worker's apid log"
  no_mutation 'the control plane' "$TALOS_CONTROLPLANE_IP" "$cp_log" "$cp_after"
  no_mutation 'the worker' "$TALOS_WORKER_IP" "$w_log" "$w_after"

  # The dump comes first, holding every case; then the integrated run's state is put back to what S4
  # starts from: step 3's approved plan, with none of the controls' or step 4's plans and releases.
  ref='S3 backups'
  check "$ref" 'inject db-snapshot: a dump of the bronzeward database after the adoptions and every case' "$bin/inject" db-snapshot "$backup_name"
  ref='S3 handoff'
  check "$ref" 'inject pause A, B and C' servers pause
  check "$ref" 'inject db-restore s3-step3' "$bin/inject" db-restore s3-step3
  check "$ref" 'inject bao-restore s3-step3' "$bin/inject" bao-restore s3-step3
  check "$ref" 'inject unpause A, B and C' servers unpause
  check "$ref" 'A reads the restored database' within 60 db_reads
  check "$ref" "restored to step 3: step 3's plan approved by its approval and the only apply-config plan, the worker's Desired the S2 release, no operation" \
    restored_to_step3
}

# The database dump taken after every case, for the final bundle to expand and scan (C §15:
# backups).
backup_name=s3-$run_key

run() {
  preconditions
  withheld+=("$BW_CANARY")
  case $s3_mode in
    handover) handover ;;
    handover-controls) controls ;;
    run) approval_part ;;
  esac
  # The approval part takes its dump before its final restore.
  if [ "$s3_mode" != run ]; then
    check 'S3 backups' 'inject db-snapshot: a dump of the bronzeward database after the adoptions' \
      "$bin/inject" db-snapshot "$backup_name"
  fi
}

run
rm -f -- "$EV/last.body" "$EV/last.headers"
# The final bundle: the evidence directory and the run directory scanned, as S1's step 5 does.
ev_log=$(mktemp)
if final=$("$bin/evidence" "$EV" 2>"$ev_log"); then
  cat -- "$ev_log" >&2
  if grep --quiet --fixed-strings -- 'positive control found; 0 other file(s) contain' "$ev_log"; then
    result PASS 'S3 evidence' 'bin/evidence scanned the bundle and the run directory; no file but its control holds a fixture secret'
  else
    result FAIL 'S3 evidence' "the leak scan reports fixture secrets: $final/leak-scan.txt"
  fi
  if [ -e "$final/unavailable.txt" ]; then
    result FAIL 'S3 evidence' "the bundle is incomplete: $final/unavailable.txt names what was not captured"
  else
    result PASS 'S3 evidence' 'the bundle is complete: bin/evidence captured every source'
  fi
  # The scan above covers the dump only if the bundle holds it expanded, with the database's rows
  # in it: an adoption record's (the handover's) or an approval's (run's) own row inside its COPY
  # block, whose first column is the ID.
  dump_table=adoption_record dump_id=${adopted_plans[0]:-} dump_row='an adoption record'
  if [ "$s3_mode" = run ]; then dump_table=approval dump_id=$step4_approval dump_row='a step 4 approval'; fi
  if [ -n "$dump_id" ] &&
    awk -v id="$dump_id" -v table="$dump_table" '
      index($0, "COPY public." table " ") == 1 { block = 1; next }
      block && /^\\\.$/ { block = 0 }
      block && index($0, id "\t") == 1 { found = 1 }
      END { exit !found }' "$final/backups/pg-$backup_name.dump.sql"; then
    result PASS 'S3 backups' "the scanned bundle holds the database dump expanded, $dump_row among its rows (control)"
  else
    result FAIL 'S3 backups' 'the scanned bundle does not hold the database dump expanded with the run'"'"'s rows: the backup went unscanned'
  fi
  # The tokens this run minted, searched in the run directory, the final bundle and every bundle the
  # run captured before it, with a control holding the last of them that must be the one file
  # listed (as s1 and s2 do).
  local_ctl=$STATE/s3-token-control
  trap 'rm -f -- "$local_ctl"' EXIT
  # An empty array has no [-1], with or without a default: the FAIL below must stay reachable.
  if [ "${#secrets[@]}" -gt 0 ]; then printf 'x %s x\n' "${secrets[-1]}" >"$local_ctl"; else : >"$local_ctl"; fi
  earlier=()
  for f in "$EV"/*-bundle; do
    [ -e "$f" ] || continue
    earlier+=("$(cat -- "$f")")
  done
  hits=$(grep --recursive --files-with-matches --fixed-strings --file=<(printf '%s\n' "${secrets[@]}") -- \
    "$EV" "$final" "${earlier[@]}" "$local_ctl") || hits=
  rm -f -- "$local_ctl"
  trap - EXIT
  if [ "${#secrets[@]}" -gt 0 ] && [ "$hits" = "$local_ctl" ]; then
    result PASS 'S3 evidence' "none of the ${#secrets[@]} tokens this run minted is in any bundle of the run or the run directory (control found)"
  else
    printf 's3: files holding a token of this run: %s\n' "${hits:-none, not even the control}" >&2
    result FAIL 'S3 evidence' "the tokens this run minted: ${#secrets[@]} searched, the listing is not the control alone"
  fi
else
  cat -- "$ev_log" >&2
  result FAIL 'S3 evidence' 'bin/evidence failed'
fi
rm -f -- "$ev_log"
say "s3 $s3_mode: $failed failed; evidence in $EV, bundle ${final:-none}"
[ "$failed" -eq 0 ]
