#!/usr/bin/env bash
# Measurement for ginsys/bronzeward#1040: what a changed hostname does to a Talos node, through the
# product. It names the fixture's worker, applies the release that fills its hostname, renames it,
# applies again, and reads after each apply what the node reports. Nothing here asserts a measured
# value: the reads are the record (compilation.md §6.1), and the checks only prove each step ran.
#
# Usage: scenarios/hostname-measure   (on a fresh fixtures/bin/up, after scenarios/s1 pass and
# scenarios/s3 handover: the worker is imported, published and adopted, so it has an import base and
# an Applied release, which an apply-config plan needs). The script names the worker from its node's
# hostname, as onboarding does. Every release of a row is made as scenarios/s2 makes its
# publications: a new draft, the worker imported into it with its file content marked, published.
# Step 3 is the Talos-default case, step 4 the commonest case (an import of a configuration that holds
# the hostname document), steps 5 and 6 renames. Writes $STATE/evidence/hostname-measure-<time>/, not
# committed as it is: the committed record is hand-written from it, after bin/evidence's leak scan.
#
# Talos is touched by reads (get nodename, get hostnamestatus, read /proc/uptime) and by the one
# dry run of step 2. Every mutation goes through the product's own apply-config operation, never a
# direct apply-config. The nodes are the fixture's own: lib.sh fixes STATE, CACHE and TALOSCONFIG to
# this checkout and need_state refuses without a running fixture, so a caller's TALOSCONFIG, -e or -n
# reaches no call here.
# Step 4 is written against part C of ginsys/bronzeward#1040, which removes the document the compiler
# fills; on a build without it the import keeps the original document, which the release record shows.
set -euo pipefail
here=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
bin=$here/../bin
# shellcheck source-path=SCRIPTDIR source=../lib.sh
. "$here/../lib.sh"

need docker curl jq timeout id sleep date awk
need_state
umask 077
image_id=$(cat -- "$STATE/up-image") || die "no server image is recorded in $STATE; run fixtures/bin/up"
image_own "$image_id" || die "the recorded server image is not this run's; run fixtures/bin/down, then up"
# The two addresses are the fixture's own: both lie inside its subnet, which versions.env names.
for ip in "$TALOS_CONTROLPLANE_IP" "$TALOS_WORKER_IP"; do
  [[ $ip == "${TALOS_SUBNET%.*}".* ]] || die "hostname-measure: $ip is not inside the fixture subnet $TALOS_SUBNET"
done
EV=$STATE/evidence/hostname-measure-$(date -u +%Y%m%dT%H%M%SZ)
mkdir -p -- "$EV" "$EV/http"
scenario=hostname-measure
# shellcheck source-path=SCRIPTDIR source=common.sh
. "$here/common.sh"
# shellcheck source-path=SCRIPTDIR source=dispatch.sh
. "$here/dispatch.sh"
run_key=$(date -u +%s%N)
ref='E1 hostname'

cluster='' machine_cp='' machine_w='' plan='' op='' draft='' etag=''
# The mark that sets the worker's planted file content aside as a secret (up writes it as the worker's first
# document, /var/etc/bw-s1.conf): without it the content would sit in the draft and the release, and in
# the kept release and review reads. Every import below carries it, as s1, s2 and s5 do.
WORKER_MARK='doc[0]/machine/files/0/content'
dry=$STATE/hostname-measure-dry.yaml
trap 'rm -f -- "$dry"' EXIT

# read_node <name>: the worker's nodename, hostname status and uptime, kept as one file. The machine
# configuration is never read into the record: these three resources hold a hostname and a number.
read_node() {
  {
    printf '## nodename\n'
    node_talos "$TALOS_WORKER_IP" get nodename -o yaml || return 1
    printf '## hostnamestatus\n'
    node_talos "$TALOS_WORKER_IP" get hostnamestatus -o yaml || return 1
    printf '## uptime\n'
    node_talos "$TALOS_WORKER_IP" read /proc/uptime || return 1
  } >"$EV/node-$1.txt"
}
# uptime_of <name>: the first number of the uptime line, in seconds.
uptime_of() { awk '/^## uptime/ { getline; print int($1) }' "$EV/node-$1.txt"; }
# name_is <name>: the worker's machine row holds that name.
name_is() { [ "$(sql "SELECT name FROM machine WHERE id = '$machine_w'")" = "$1" ]; }
# name_as <human> <name>: POST /machines/{id}/names: 201.
name_as() {
  fresh "$1"
  # The Idempotency-Key takes [A-Za-z0-9_-] only (internal/api/api.go), and a dotted name is not one. A
  # key that repeats with the same body is a replay of the first answer and writes nothing, which is how
  # the rename back to the first name (the key name_worker used) answered 201 and changed no row: the
  # key carries the time, so every call is a new write.
  answers 201 - POST "/api/v1/machines/$machine_w/names" "$tok" "$(jq -nc --arg n "$2" '{name: $n}')" "$(key "name-${2//[^A-Za-z0-9_-]/_}-$(date +%s%N)")"
}
# release_hostname: the worker's Desired release records its hostname source and value, kept as
# release-<name>.json (the release's own record, no configuration value).
release_hostname() {
  keep_body "release-$1" "/api/v1/releases/$(sql "SELECT desired FROM machine_state WHERE machine = '$machine_w'")"
}
# import_worker <key suffix>: the worker imported into the draft, its file content marked (an import
# needs the draft and its ETag, which draft_by leaves). The suffix is the import's own Idempotency-Key.
import_worker() {
  fresh_author
  ingest "$machine_w" "$(jq -nc --arg p "$WORKER_MARK" '[$p]')" "$1"
}
# apply_as_product <name>: a draft, the worker imported into it with its mark, its publication, the
# release's review of the worker (kept: its formOnly is the plan's verdict), an apply-config plan, its
# approval and the operation that completes; the worker's reads before and after are
# node-<name>-before/after.txt. plan_by leaves the plan's id in plan_id, which the reads below and
# dispatch.sh's `completed` take from plan.
apply_as_product() {
  local n=$1
  read_node "$n-before" || return 1
  draft_by h-author "$n" || return 1
  import_worker "$n" || return 1
  publish_by h-publisher "$n" || return 1
  release_hostname "$n" || return 1
  keep_body "review-$n" "/api/v1/releases/$new_release/machines/$machine_w/review" || return 1
  plan_by h-publisher "$n" || return 1
  plan=$plan_id
  keep_body "plan-$n" "/api/v1/plans/$plan" || return 1
  approve_by h-approver "$plan" "$n" || return 1
  within 300 completed || return 1
  read_node "$n-after"
}
# applied: the worker's Applied is its Desired.
applied() { [ "$(sql "SELECT applied_release = desired FROM machine_state WHERE machine = '$machine_w'")" = t ]; }
# row <name>: the reads of one step in one line of the table: the nodename and the uptime before
# and after, from the files read_node kept.
row() {
  printf '%s\tuptime %s -> %s s\tnodename %s -> %s\n' "$1" "$(uptime_of "$1-before")" "$(uptime_of "$1-after")" \
    "$(awk '/^## nodename/ {f=1} f && /nodename:/ {print $2; exit}' "$EV/node-$1-before.txt")" \
    "$(awk '/^## nodename/ {f=1} f && /nodename:/ {print $2; exit}' "$EV/node-$1-after.txt")" | tee -a "$EV/table.tsv"
}

# rowstep <ref> <what> <command...>: check, and where it fails say why in the step's own words and return 1,
# so that a row stops at its first failed step and a void row cannot run on. The words are the problem
# detail of the last answer when it was an error (a refusal names no configuration value), else the exit
# status of the command.
rowstep() {
  local before=$failed
  check "$@"
  [ "$failed" -ne "$before" ] || return 0
  if [ "${last_status:-0}" -ge 400 ] 2>/dev/null; then
    printf '  the step'"'"'s own error: HTTP %s %s\n' "$last_status" "$(jq -r '[.title, .detail] | map(select(. != null)) | join(": ")' "$EV/last.body" 2>/dev/null | head -c 400)"
  else
    echo "  the step's own error: its command failed; the last answer was HTTP ${last_status:-none}"
  fi
  return 1
}
# skip_row <name> <why>: the row did not run past a failed step, and says so.
skip_row() { printf 'SKIP\t%s\t%s\n' "$1" "$2" | tee -a "$EV/table.tsv"; }

# Step 0: the equivalence measurements of docs/design/research/20261118-import-analysis-and-equivalence.md
# rerun with the fixture's own pinned talosctl (the manifest pins the version the note names). Before
# `up` is used, so a failure costs nothing; its wall time is the record's, since the note holds none. gen.sh
# finds its talosctl beside itself, so it runs from a copy in $STATE with a link to the verified binary; the
# synthetic cluster it makes is under $STATE too and holds no credential of a real host.
equivalence() {
  local ev=$here/../../docs/design/research/evidence/20261118-import-equivalence w=$STATE/hostname-equivalence start=$SECONDS
  rm -rf -- "$w" && mkdir -p -- "$w/gen/bin" "$STATE/gocache" "$STATE/gotmp" || return 1
  tool_verify talosctl "$TALOSCTL_SHA256"
  ln -s -- "$CACHE/talosctl" "$w/gen/bin/talosctl" && cp -- "$ev/gen.sh" "$w/gen/" || return 1
  bash "$w/gen/gen.sh" "$w/work" >"$EV/equivalence-gen.txt" 2>&1 || return 1
  GOCACHE=$STATE/gocache GOTMPDIR=$STATE/gotmp bash "$ev/runall.sh" "$here/../.." "$w/work" "$EV/equivalence-output.txt" \
    >"$EV/equivalence-run.txt" 2>&1 || return 1
  printf 'step 0: %s s\n' "$((SECONDS - start))" | tee -a "$EV/table.tsv"
  rm -rf -- "$w"
}
check "$ref step 0" 'the equivalence measurements run with the pinned talosctl and exit 0' equivalence

machines
# name_worker: the worker is named by its node's hostname as `cluster onboard` names a machine, unless it
# already has a name (a run after s1 onboard). s1 run and s3 handover leave it unnamed.
node_hostname() { node_talos "$TALOS_WORKER_IP" get hostnamestatus -o yaml | awk '$1 == "hostname:" { print $2; exit }'; }
name_worker() {
  local n
  if [ -n "$(sql "SELECT name FROM machine WHERE id = '$machine_w'")" ]; then return 0; fi
  n=$(node_hostname) && [ -n "$n" ] || return 1
  name_as h-author "$n"
}
check "$ref" 'the worker is adopted and has an import base (s1 pass, s3 handover)' \
  test "$(sql "SELECT applied_release = desired FROM machine_state WHERE machine = '$machine_w'")" = t
check "$ref" 'the worker is named from its node'"'"'s hostname' name_worker
worker_name=$(sql "SELECT name FROM machine WHERE id = '$machine_w'")

# Step 1: the worker as it is.
check "$ref step 1" 'the worker'"'"'s nodename, hostname status and uptime are read' read_node start

# Step 2: the dry run of the filled document (the A2 proof for the steps that mutate). The machine
# configuration is written to a 0600 file under $STATE and removed at exit; it is never kept.
# strip_hostname: stdin's documents without any HostnameConfig; on stderr, how many it dropped and the top-level
# key names (never a value) of what it dropped. The node holds its own HostnameConfig, and apply-config refuses
# two ("duplicate document v1alpha1/HostnameConfig/", the first slot's step 2). The product sends one: the
# compiler composes the filled document last as a patch (internal/compile/hostname.go hostnamePatch, applied at
# compiler.go:127), which merges into the composition's HostnameConfig by key, so the result is one document with
# auto off and the name. Dropping the node's document and appending the filled one is the same result exactly
# where the dropped document has no key beyond apiVersion, kind, auto and hostname: the key names say whether it
# did.
strip_hostname() {
  awk 'function flush() { if (n > 0) { if (hc) { dropped++; allkeys = allkeys " " keys } else { if (out++) print "---"; printf "%s", doc } } doc = ""; keys = ""; n = 0; hc = 0 }
    /^---[ \t]*$/ { flush(); next }
    { doc = doc $0 "\n"; n++; if ($0 ~ /^kind:[ \t]*HostnameConfig[ \t]*$/) hc = 1; if ($0 ~ /^[A-Za-z][A-Za-z0-9]*:/) { k = $0; sub(/:.*/, "", k); keys = keys (keys == "" ? "" : ",") k } }
    END { flush(); print dropped + 0 " keys:" allkeys > "/dev/stderr" }'
}
dry_run() {
  local ps
  node_talos "$TALOS_WORKER_IP" get machineconfig v1alpha1 -o jsonpath='{.spec}' 2>"$EV/dry-get.err" |
    strip_hostname 2>"$EV/dry-dropped.txt" >"$dry"
  ps=("${PIPESTATUS[@]}")
  [ "${ps[0]}" -eq 0 ] && [ "${ps[1]}" -eq 0 ] || return 1
  printf '\n---\napiVersion: v1alpha1\nkind: HostnameConfig\nauto: off\nhostname: %s\n' "$worker_name" >>"$dry" || return 1
  talosctl_timed 60 -e "$TALOS_WORKER_IP" -n "$TALOS_WORKER_IP" apply-config --dry-run --mode no-reboot -f "$dry" >"$EV/dry-run.txt" 2>&1
}
check "$ref step 2" 'apply-config --dry-run of the configuration plus the filled document: what it reports is the record' dry_run

# Step 3, the Talos-default case, its own row: a node whose hostname is automatic, named from it at
# onboarding, gets its first release through the product, which writes `auto: off` plus that name.
# The reads answer whether a reboot is requested (uptime before and after), whether the nodename
# changes, and what the review says of the release (formOnly); no sentence is chosen here.
default_ok=0
row_default() {
  rowstep "$ref step 3 default" 'the named worker, first release applied through the product: the operation completes' apply_as_product default &&
    rowstep "$ref step 3 default" 'the worker'"'"'s Applied is its Desired after it' applied &&
    row default
}
if row_default; then default_ok=1; else skip_row default 'a step of the row failed; its reads are void'; fi

# Step 4, the commonest case, its own row: the worker's configuration now holds exactly the document
# a node with an explicit hostname holds, `auto: off` plus its name. The product path that imports it
# again is a second POST /ingestions of kind import from the machine into a new draft (startIngestion
# admits it for a machine that has an import base: internal/api/ingestions.go, no Applied check), with
# part C's removal of the document the compiler fills. It is then published, reviewed, planned and
# applied. A refusal of the import (a secret the import wants marked, a guard) is the row's result:
# the case is then "not shown", and the refusal is read from $EV/last.body, never replaced by another
# case under this name.
row_explicit() {
  rowstep "$ref step 4 explicit" 'the worker is imported again from its node, published, planned and applied: the operation completes' \
    apply_as_product explicit &&
    rowstep "$ref step 4 explicit" 'the worker'"'"'s Applied is its Desired after it' applied &&
    row explicit
}
# The row needs row default: only after it does the node hold `auto: off` plus its name.
if [ "$default_ok" -ne 1 ]; then
  skip_row explicit 'row default did not complete, so the node does not hold auto: off plus its name'
elif ! row_explicit; then
  skip_row explicit 'a step of the row failed; its reads are void'
fi

# Step 5: a rename to a dotted name, applied. The nodename read shows whether the Node name follows.
rename_ok=0
row_rename() {
  rowstep "$ref step 5" 'the worker is renamed to a dotted name by an author' name_as h-author hm-renamed.fixture.test &&
    rowstep "$ref step 5" 'the worker holds that name' name_is hm-renamed.fixture.test &&
    rowstep "$ref step 5" 'the rename, applied through the product: the operation completes' apply_as_product rename &&
    rowstep "$ref step 5" 'the worker'"'"'s Applied is its Desired after it' applied &&
    row rename
}
if row_rename; then rename_ok=1; else skip_row rename 'a step of the row failed; its reads are void'; fi

# Step 6, under its own name: a rename back to the first name, a third rename and not step 4's case.
row_back() {
  rowstep "$ref step 6 rename-back" 'the worker is renamed back to its first name' name_as h-author "$worker_name" &&
    rowstep "$ref step 6 rename-back" 'the worker holds its first name' name_is "$worker_name" &&
    rowstep "$ref step 6 rename-back" 'the rename back, applied through the product: the operation completes' apply_as_product back &&
    rowstep "$ref step 6 rename-back" 'the worker'"'"'s Applied is its Desired after it' applied &&
    row back
}
if [ "$rename_ok" -ne 1 ]; then
  skip_row back 'row rename did not complete, so there is no rename to undo'
elif ! row_back; then
  skip_row back 'a step of the row failed; its reads are void'
fi

# registerWithFQDN set against unset is not measured here: it needs a kubelet fragment the fixture
# has no scenario for. Recorded as a limit, not as a row.
# The configuration file of step 2 is gone on every path: removed here, and by the trap on a failed step.
rm -f -- "$dry"
check "$ref end" 'the configuration file of the dry run is gone' test ! -e "$dry"

# derive: the one file that leaves the fixture state, written here from the reads in place (they stay under
# $STATE, mode 0600, and die with bin/down). It holds derived results only: the table, the equivalence
# output (counts and booleans, as measure.go prints them), each release's hostname source and value and each
# review's formOnly, and of the dry run the lines that are not diff lines and the counts of the diff lines.
# No node read, no configuration and no response body is copied.
derive() {
  local d=$EV/derived.txt n
  # a failed step 2 may have left no dry-run.txt: an empty one then reads as no lines
  : >>"$EV/dry-run.txt"
  {
    echo '## table.tsv'
    cat -- "$EV/table.tsv"
    echo '## equivalence output (counts and booleans only)'
    cat -- "$EV/equivalence-output.txt"
    for n in default explicit rename back; do
      [ -f "$EV/review-$n.json" ] || continue
      # formOnly is the plan's verdict: plan.baseline.{pendingConvergence,formOnly} (PlanBaseline, no revision id)
      printf '## %s: plan baseline %s; release hostname %s\n' "$n" \
        "$(jq -c '.baseline | if . == null then null else {pendingConvergence, formOnly} end' "$EV/plan-$n.json")" \
        "$(jq -c '[.machines[]?.hostname]' "$EV/release-$n.json")"
    done
    printf '## dry run (step 2): HostnameConfig documents the node held and the dry run dropped: %s\n' \
      "$(cat -- "$EV/dry-dropped.txt" 2>/dev/null || echo unread)"
    echo '## dry run (step 2): lines that are not diff lines, then the counts of diff lines'
    awk '!/^[ +-]/' "$EV/dry-run.txt" | head -n 20
    awk '/^\+/ && !/^\+\+\+/ { a++ } /^-/ && !/^---/ { r++ } END { printf "diff lines added %d removed %d\n", a, r }' "$EV/dry-run.txt"
  } >"$d"
}
check "$ref end" 'the derived file is written' derive
check "$ref end" 'the derived file exists and is not empty (the positive control before bin/down)' test -s "$EV/derived.txt"
echo "hostname-measure: $failed failed; the derived results are in $EV/derived.txt, the reads stay under the fixture state"
[ "$failed" -eq 0 ]
