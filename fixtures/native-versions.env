# The same OpenBao and Zitadel releases as the images in versions.env, as the vendors' macOS arm64
# binaries, for the hosted macOS runner, which has no Docker (scripts/dev/native-services.sh,
# ginsys/bronzeward#892). A file of its own: the Linux fixture reads versions.env as a closed manifest
# and refuses a key it does not use. Each archive is checked against its sha256 before it is unpacked:
# OpenBao's is also the vendor's checksums.txt line, Zitadel's the digest GitHub records for the release asset.
OPENBAO_DARWIN_ARM64_URL=https://github.com/openbao/openbao/releases/download/v2.6.1/openbao_2.6.1_darwin_arm64.tar.gz
OPENBAO_DARWIN_ARM64_SHA256=7e648d6c93320ab66ced394fd88528c7122b7c1d991605c8e9b3845262459905
ZITADEL_DARWIN_ARM64_URL=https://github.com/zitadel/zitadel/releases/download/v4.19.5/zitadel-darwin-arm64.tar.gz
ZITADEL_DARWIN_ARM64_SHA256=e9de33e9278eed5d16cacc47c3ef5906d6e0bcaf2888b04a257ae0e6dc77f297
